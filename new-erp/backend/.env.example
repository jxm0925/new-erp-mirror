APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Shanghai

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
REVERB_APP_ID=erp-local
REVERB_APP_KEY=erp-local-key-20260820
REVERB_APP_SECRET=change-me-before-production
REVERB_HOST=127.0.0.1
REVERB_PORT=8083
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8083

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SKU and attachment uploads are stored in Aliyun OSS, never in local public storage.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_PREFIX=
OSS_DOMAIN=
OSS_CNAME=false
OSS_SSL=true
OSS_THROW=true

VITE_APP_NAME="${APP_NAME}"

JPUSH_ENABLED=false
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
JPUSH_APNS_PRODUCTION=false

MOBILE_ANDROID_VERSION_NAME=1.0.0
MOBILE_ANDROID_BUILD_NUMBER=1
MOBILE_ANDROID_DOWNLOAD_URL=
MOBILE_ANDROID_FORCE_UPDATE=false
MOBILE_ANDROID_CHANGELOG=

MOBILE_IOS_VERSION_NAME=1.0.0
MOBILE_IOS_BUILD_NUMBER=1
MOBILE_IOS_DOWNLOAD_URL=
MOBILE_IOS_FORCE_UPDATE=false
MOBILE_IOS_CHANGELOG=
JPUSH_DEFAULT_PLATFORM=all

DB_TIMEZONE=+08:00

# Local ERP administrator provisioned by `php artisan db:seed` / `migrate --seed`.
# Change these values before deploying any non-development environment.
ERP_SEED_ADMIN_USERNAME=admin
ERP_SEED_ADMIN_PASSWORD=
ERP_SEED_ADMIN_LEGACY_ID=1
ERP_SEED_ADMIN_RESET_PASSWORD=false

OFFICE_CONVERTER_WINDOWS_BIN='C:\Program Files\LibreOffice\program\soffice.exe'
OFFICE_CONVERTER_LINUX_BIN=/usr/bin/libreoffice
