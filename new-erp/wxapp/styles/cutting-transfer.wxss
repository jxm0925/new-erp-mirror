.transfer-mask{position:fixed;inset:0;z-index:1000;background:rgba(12,24,57,.45);display:flex;align-items:center;justify-content:center;padding:32rpx;box-sizing:border-box}.transfer-dialog{width:100%;max-width:680rpx;max-height:85vh;overflow-y:auto;background:#fff;border-radius:20rpx;padding:28rpx;box-sizing:border-box;display:flex;flex-direction:column;gap:20rpx;font-size:26rpx;word-break:break-word}.transfer-title{font-size:32rpx;font-weight:600}.transfer-fields{display:flex;flex-direction:column;gap:18rpx;min-width:0}.transfer-fields label{display:flex;flex-direction:column;gap:10rpx}.transfer-fields input{min-width:0;background:#f4f6fa;border:1rpx solid #dce2ea;border-radius:8rpx;padding:16rpx;height:48rpx}.transfer-fields button,.transfer-actions button{font-size:26rpx;white-space:normal;line-height:1.5;padding:16rpx;min-width:0;box-sizing:border-box;margin:0}.transfer-actions{display:flex;align-items:center;gap:16rpx;min-width:0;padding-top:12rpx}.transfer-actions button{flex:1}.transfer-actions button:last-child{background:#d7190b;color:#fff}.locator-list{height:34vh}.locator-list button{margin-bottom:10rpx;text-align:left}.route-item{flex-wrap:wrap}.route-item .split-btn{margin-left:auto;flex-shrink:0}
