@import "../../pages/warehouse/shared.wxss";

.return-serial-dialog {
  color: #1f2329;
  max-width: 680rpx;
}

.return-serial-body {
  min-height: 0;
  height: 68vh;
  max-height: calc(100vh - 260rpx);
  padding: 24rpx 26rpx;
  box-sizing: border-box;
}

.return-serial-name {
  font-size: 29rpx;
  font-weight: 800;
  color: #1f2329;
  margin-bottom: 12rpx;
  word-break: break-all;
}

.return-serial-body .warehouse-field {
  margin: 6rpx 0;
}

.return-serial-body .warehouse-label {
  width: 148rpx;
}

.return-serial-note {
  margin: 16rpx 0;
  padding: 12rpx 18rpx;
}

.return-serial-search {
  background: transparent;
  border: none;
  padding: 0;
  margin-bottom: 16rpx;
}

.return-serial-table {
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  overflow: hidden;
}

.return-serial-tr {
  display: flex;
  border-bottom: 1rpx solid #f1f5f9;
  align-items: stretch;
}

.return-serial-tr:last-child {
  border-bottom: 0;
}

.return-serial-th {
  background: #f8fafc;
  font-weight: 700;
  color: #475569;
  border-bottom: 1rpx solid #e2e8f0;
}

.return-serial-number {
  width: 38%;
  flex-shrink: 0;
  border-right: 1rpx solid #f1f5f9;
  padding: 16rpx;
  display: flex;
  align-items: center;
  word-break: break-all;
  font-size: 24rpx;
  font-weight: 700;
  color: #1e293b;
}

.return-serial-destination {
  flex: 1;
  padding: 12rpx 14rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  word-break: break-all;
}

.return-serial-choices {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  width: 100%;
}

.return-serial-choices button {
  width: calc(50% - 5rpx) !important;
  min-height: 58rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 8rpx;
  background: #f8fafc;
  border: 1rpx solid #dbe2ea;
  color: #475569;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.return-serial-choices button::after {
  border: 0;
}

.return-serial-choices button.selected {
  background: linear-gradient(135deg, #d81e06 0%, #ef1008 100%);
  color: #ffffff;
  border-color: transparent;
  font-weight: 800;
}

.return-serial-choices button[disabled] {
  opacity: 0.65;
}

.return-serial-summary {
  text-align: center;
  background: #fff5f5;
  border: 1rpx solid #ffccc7;
  border-radius: 16rpx;
  padding: 16rpx 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.65;
}

.return-serial-summary text {
  color: #d81e06;
  font-weight: 800;
}

.return-serial-counts {
  font-size: 23rpx;
  font-weight: 600;
  color: #64748b;
  margin-top: 4rpx;
}

.return-serial-batch {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  color: #64748b;
  font-size: 24rpx;
}

.return-serial-batch > text {
  flex-shrink: 0;
}

.return-serial-batch .warehouse-readonly {
  flex: 1;
  word-break: break-all;
  min-height: 58rpx;
}

.return-serial-error {
  text-align: center;
}
