@import "../../pages/warehouse/shared.wxss";
.return-serial-dialog { color: #111b3a; max-width: 660px; }
.return-serial-dialog .warehouse-dialog-header { justify-content: center; position: relative; font-size: 33rpx; }
.return-serial-dialog .warehouse-close { position: absolute; right: 24rpx; top: 24rpx; color: #475681; }
.return-serial-body { min-height: 0; height: 68vh; max-height: calc(100vh - 220rpx - 32px); padding: 24rpx; box-sizing: border-box; }
.return-serial-name { font-size: 28rpx; font-weight: 600; margin-bottom: 10rpx; word-break: break-all; }
.return-serial-body .warehouse-field { margin: 4rpx 0; }
.return-serial-body .warehouse-label { width: 145rpx; color: #56648d; }
.return-serial-note { margin: 16rpx 0; padding: 12rpx 18rpx; }
.return-serial-body .warehouse-search { background: transparent; padding: 0; }
.return-serial-search-field { flex: 1; display: flex; align-items: center; gap: 10rpx; background: #f7f9fc; border: 1rpx solid #dce3f0; border-radius: 8rpx; padding: 0 16rpx; }
.return-serial-search-field input { flex: 1; width: 0; padding: 12rpx 0; height: 68rpx; }
.return-serial-body .warehouse-search button { background: #fff0f2; color: #ed100a; padding: 17rpx 22rpx; }
.return-serial-table { border: 1rpx solid #dce3ed; border-radius: 8rpx; overflow: hidden; }
.return-serial-tr { display: flex; border-bottom: 1rpx solid #e3e8f1; align-items: stretch; }
.return-serial-tr:last-child { border-bottom: 0; }
.return-serial-th { background: #f6f8fb; font-weight: 500; }
.return-serial-number { width: 38%; flex-shrink: 0; border-right: 1rpx solid #e3e8f1; padding: 16rpx; display: flex; align-items: center; word-break: break-all; font-size: 25rpx; }
.return-serial-destination { flex: 1; padding: 12rpx 14rpx; display: flex; align-items: center; font-size: 25rpx; word-break: break-all; }
.return-serial-choices { display: flex; flex-wrap: wrap; gap: 9rpx; width: 100%; }
.return-serial-choices button { width: calc(50% - 5rpx); padding: 13rpx 4rpx; background: #f7f9fc; border: 1rpx solid #dbe2ed; color: #4e5c86; border-radius: 6rpx; font-size: 25rpx; }
.return-serial-choices button.selected { background: #ef1008; color: white; border-color: #ef1008; }
.return-serial-choices button[disabled] { opacity: .7; }
.return-serial-body .warehouse-pager { gap: 12rpx; justify-content: space-between; flex-wrap: nowrap; margin: 18rpx 0; font-size: 23rpx; }
.return-serial-body .warehouse-pager button { padding: 12rpx; flex-shrink: 0; font-size: 24rpx; background: #f7f9fc; }
.return-serial-summary { text-align: center; background: #fff0f2; border-radius: 6rpx; padding: 14rpx 9rpx; font-size: 31rpx; font-weight: 500; line-height: 1.7; }
.return-serial-summary text { color: #e9140a; }.return-serial-counts { font-size: 24rpx; font-weight: 400; color: #526188; }
.return-serial-batch { margin-top: 18rpx; display: flex; align-items: center; gap: 16rpx; padding: 12rpx 16rpx; border: 1rpx solid #e3e8f1; border-radius: 7rpx; color: #58668b; }
.return-serial-batch > text { flex-shrink: 0; }.return-serial-batch .warehouse-readonly { flex: 1; word-break: break-all; }
.return-serial-error { background: #fff0f2; text-align: center; padding: 12rpx; }
.return-serial-dialog .warehouse-dialog-footer { padding-top: 14rpx; }
@media (max-width: 350px) { .return-serial-body { padding: 18rpx; }.return-serial-number { width: 37%; padding: 12rpx; font-size: 23rpx; }.return-serial-destination { padding: 10rpx; }.return-serial-choices button { font-size: 23rpx; }.return-serial-body .warehouse-pager { gap: 6rpx; font-size: 21rpx; }.return-serial-body .warehouse-pager button { padding: 10rpx 8rpx; font-size: 22rpx; }.return-serial-counts { font-size: 22rpx; } }
