.dispositions {
  background:#fff;
  border:1rpx solid #f2d1cc;
  border-radius:20rpx;
  padding:24rpx;
  margin-bottom:24rpx;
  color:#1e293b;
}
.heading {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16rpx;
  font-size:28rpx;
  font-weight:600;
}
.link, .status {
  color:#d81e06;
  font-size:24rpx;
  flex-shrink:0;
}
.note {
  color:#64748b;
  font-size:24rpx;
  line-height:1.6;
  margin:12rpx 0;
  overflow-wrap:anywhere;
}
.error {
  color:#b91c1c;
}
.row, .section {
  padding-top:20rpx;
  margin-top:20rpx;
  border-top:1rpx solid #e2e8f0;
}
.actions {
  display:flex;
  flex-wrap:wrap;
  gap:16rpx;
  align-items:center;
  margin:20rpx 0;
}
.button {
  background:#d81e06;
  color:#fff;
  padding:0 24rpx;
  font-size:25rpx;
  line-height:72rpx;
  border-radius:12rpx;
  margin:12rpx 0;
}
.actions .button {
  margin:0;
}
.outline {
  background:#fff;
  color:#d81e06;
  border:1rpx solid #f0c5be;
}
.chosen {
  background:#fff0ed;
  border-color:#d81e06;
}
.mask {
  position:fixed;
  inset:0;
  background:rgba(15,23,42,.45);
  z-index:1300;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:28rpx;
  box-sizing:border-box;
}
.dialog {
  background:#fff;
  border-radius:22rpx;
  width:100%;
  max-height:85vh;
  min-width:0;
  padding:28rpx;
  box-sizing:border-box;
}
.body {
  height:65vh;
  margin-top:24rpx;
}
.reason {
  width:100%;
  min-height:130rpx;
  padding:16rpx;
  border:1rpx solid #e2e8f0;
  border-radius:12rpx;
  font-size:26rpx;
  box-sizing:border-box;
}
.unit {
  display:flex;
  align-items:center;
  margin:16rpx 0;
  font-size:25rpx;
}
