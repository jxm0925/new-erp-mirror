<view wx:if="{{open}}" class="warehouse-overlay" catchtouchmove="stop">
  <view class="warehouse-dialog locator-dialog">
    <view class="warehouse-dialog-header">
      <text>选择仓库 / 库位</text>
      <button class="warehouse-close" bindtap="cancel">
        <van-icon name="cross" />
      </button>
    </view>

    <view class="locator-panels">
      <!-- 左侧仓库栏 -->
      <view class="locator-warehouses">
        <view class="locator-pane-title">1. 仓库</view>
        <view class="locator-search">
          <input
            value="{{warehouseKeyword}}"
            data-field="warehouseKeyword"
            bindinput="input"
            bindconfirm="searchWarehouses"
            placeholder="搜索仓库"
            confirm-type="search"
          />
          <button bindtap="searchWarehouses">
            <van-icon name="search" size="28rpx" />
          </button>
        </view>
        <scroll-view scroll-y class="locator-scroll">
          <view wx:if="{{warehouseLoading}}" class="locator-empty">加载中...</view>
          <view wx:elif="{{!warehouses.length}}" class="locator-empty">暂无仓库</view>
          <block wx:else>
            <view
              wx:for="{{warehouses}}"
              wx:key="id"
              class="locator-warehouse {{selected.warehouse_id === item.id ? 'selected' : ''}}"
              data-id="{{item.id}}"
              bindtap="chooseWarehouse"
            >
              <text class="loc-wh-name">{{item.name}}</text>
              <text class="loc-wh-code">{{item.code}}</text>
            </view>
          </block>
        </scroll-view>
        <view class="locator-pager">
          <button data-pane="warehouse" data-delta="-1" disabled="{{warehousePage <= 1 || warehouseLoading}}" bindtap="turnPage">
            <van-icon name="arrow-left" />
          </button>
          <text>{{warehousePage}}/{{warehouseLast}}</text>
          <button data-pane="warehouse" data-delta="1" disabled="{{warehousePage >= warehouseLast || warehouseLoading}}" bindtap="turnPage">
            <van-icon name="arrow" />
          </button>
        </view>
      </view>

      <!-- 右侧库位栏 -->
      <view class="locator-locations">
        <view class="locator-pane-title">2. 库位</view>
        <view class="locator-search">
          <scan-input
            style="flex:1;min-width:0"
            compact
            value="{{locationKeyword}}"
            data-field="locationKeyword"
            bind:input="input"
            bind:resolved="scanLocation"
            disabled="{{locationLoading}}"
            types="{{['location']}}"
            placeholder="库位编码 / 名称"
          />
          <button disabled="{{!selected.warehouse_id}}" bindtap="searchLocations">
            <van-icon name="search" size="28rpx" />
          </button>
        </view>
        <scroll-view scroll-y class="locator-scroll">
          <view wx:if="{{locationLoading}}" class="locator-empty">加载中...</view>
          <view wx:elif="{{!selected.warehouse_id}}" class="locator-empty">请先在左侧选择仓库</view>
          <view wx:elif="{{!locations.length}}" class="locator-empty">暂无可用库位</view>
          <block wx:else>
            <view
              wx:for="{{locations}}"
              wx:key="id"
              class="locator-location {{selected.location_id === item.id ? 'is-active' : ''}}"
              data-id="{{item.id}}"
              bindtap="chooseLocation"
            >
              <van-icon
                name="{{selected.location_id === item.id ? 'checked' : 'circle'}}"
                color="{{selected.location_id === item.id ? '#d81e06' : '#cbd5e1'}}"
                size="34rpx"
              />
              <view class="loc-item-main">
                <view class="loc-item-top">
                  <text class="loc-item-code">{{item.code}}</text>
                  <text class="locator-enabled">启用</text>
                </view>
                <text class="loc-item-name">{{item.name}}</text>
                <text wx:if="{{item.areaName}}" class="warehouse-muted">{{item.areaName}}</text>
              </view>
            </view>
          </block>
        </scroll-view>
        <view class="locator-pager">
          <button data-pane="location" data-delta="-1" disabled="{{locationPage <= 1 || locationLoading}}" bindtap="turnPage">
            <van-icon name="arrow-left" />
          </button>
          <text>{{locationPage}}/{{locationLast}}</text>
          <button data-pane="location" data-delta="1" disabled="{{locationPage >= locationLast || locationLoading}}" bindtap="turnPage">
            <van-icon name="arrow" />
          </button>
        </view>
      </view>
    </view>

    <view wx:if="{{error}}" class="warehouse-error locator-error">{{error}}</view>
    <view class="locator-summary">
      <text class="locator-summary-lbl">当前已选：</text>
      <text class="locator-summary-val">{{selected.warehouse_name || '未选择仓库'}}</text>
      <text wx:if="{{selected.location_name}}" class="locator-summary-val"> / {{selected.location_name}}（{{selected.location_code}}）</text>
    </view>

    <view class="warehouse-dialog-footer">
      <button class="warehouse-secondary" bindtap="cancel">取消</button>
      <button
        class="warehouse-primary"
        disabled="{{!selected.warehouse_id || (!allowWarehouseOnly && !selected.location_id) || warehouseLoading || locationLoading}}"
        bindtap="confirm"
      >确认选择</button>
    </view>
  </view>
</view>
