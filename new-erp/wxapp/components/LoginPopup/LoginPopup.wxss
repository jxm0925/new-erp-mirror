/* 授权弹窗 */
.login-header{
    display: flex;
    align-items: center;
    padding: 20rpx 32rpx 0;
}
.top{
    flex: 1;
    min-width: 0;
    height: 70rpx;
    line-height: 70rpx;
    font-weight: bold;
    font-size: 35rpx;
}
.login-mode-switch{
    width: auto;
    margin: 0 0 0 16rpx;
    padding: 0;
    background: transparent;
    color: #d81e06;
    font-size: 24rpx;
    line-height: 50rpx;
}
.login-mode-switch::after{border: none;}
.tips{
    text-align: center;
    font-size: 29rpx;
    font-weight: lighter;
    padding-top: 20rpx;
}
.input-class{
    padding-top: 40rpx;
}
.input-class::after {
    display: none;
}
.input-button-forget{
    width: 140rpx;
    background-color: #ffffff;
    color: #a1a1a1;
    border: none;
}
.input-button-login{
    width: 140rpx;
}
.button-quick-login{
    background-color: inherit;
    position: static;
    color:#f7862a;
    width: 160rpx;
    font-size: 27rpx;
}
