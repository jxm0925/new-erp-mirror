.wr-card{border-left:6rpx solid #d81e06}.wr-note{padding:14rpx 0;border-bottom:1rpx solid #f0f0f0}.wr-note-title{font-size:25rpx;font-weight:600;color:#333}.wr-note-title .wr-source{display:block;font-weight:400;margin-top:4rpx}.wr-note-text{display:block;font-size:28rpx;line-height:1.65;white-space:pre-wrap;word-break:break-all;color:#333;margin-top:8rpx}.wr-file{display:flex;gap:20rpx;padding:20rpx 0;border-bottom:1rpx solid #f0f0f0}.wr-image{width:144rpx;height:144rpx;flex-shrink:0;border-radius:8rpx;background:#f3f3f3}.wr-file-body{flex:1;min-width:0}.wr-file-name{font-size:28rpx;font-weight:600;word-break:break-all;color:#333}.wr-source{font-size:23rpx;line-height:1.5;color:#888}.wr-version{color:#d81e06}.wr-action{font-size:26rpx;color:#d81e06;margin-top:10rpx}.wr-hint{font-size:23rpx;line-height:1.6;color:#888;margin-top:16rpx}
