<view wx:if="{{open}}" class="warehouse-overlay" catchtouchmove="stop">
  <view class="warehouse-dialog" catchtap="stop">
    <view class="warehouse-dialog-header"><text>核对序列号</text><button class="warehouse-close" bindtap="cancel">×</button></view>
    <scroll-view scroll-y class="receipt-scroll">
      <view class="warehouse-dialog-body">
        <view class="warehouse-search"><input value="{{keyword}}" placeholder="请输入序列号" bindinput="keywordInput" bindconfirm="search"/><button bindtap="search">搜索</button></view>
        <view wx:if="{{error}}" class="warehouse-error">{{error}}</view>
        <view wx:if="{{loading}}" class="warehouse-empty">加载中</view>
        <view wx:elif="{{!rows.length}}" class="warehouse-empty">暂无可处理序列号</view>
        <scroll-view wx:else scroll-x class="warehouse-table-scroll"><view class="receipt-table">
          <view class="warehouse-tr warehouse-th"><view class="serial-cell">序列号</view><view class="result-cell">处理结果</view><view class="reason-cell">拒收原因</view></view>
          <view wx:for="{{rows}}" wx:key="id" class="warehouse-tr">
            <view class="serial-cell">{{item.serial_no}}</view>
            <view class="result-cell"><view class="receipt-choice"><button class="{{item.disposition === 'accepted' ? 'chosen' : ''}}" data-id="{{item.id}}" data-disposition="accepted" bindtap="choose">签收</button><button class="{{item.disposition === 'rejected' ? 'chosen' : ''}}" data-id="{{item.id}}" data-disposition="rejected" bindtap="choose">拒收</button></view></view>
            <view class="reason-cell"><input wx:if="{{item.disposition === 'rejected'}}" class="warehouse-input" value="{{item.reason}}" maxlength="500" placeholder="必填" data-id="{{item.id}}" bindinput="reasonInput"/><text wx:else>—</text></view>
          </view>
        </view></scroll-view>
        <view class="warehouse-pager"><button disabled="{{loading || page <= 1}}" data-delta="-1" bindtap="turnPage">上一页</button><text>{{page}} / {{lastPage}}</text><button disabled="{{loading || page >= lastPage}}" data-delta="1" bindtap="turnPage">下一页</button></view>
      </view>
    </scroll-view>
    <view class="receipt-summary">本次签收 <text>{{accepted}}</text> {{unit}}　拒收 <text>{{rejected}}</text> {{unit}}</view>
    <view class="warehouse-dialog-footer"><button class="warehouse-secondary" bindtap="cancel">返回</button><button class="warehouse-primary" disabled="{{loading}}" bindtap="confirm">确认选择</button></view>
  </view>
</view>
