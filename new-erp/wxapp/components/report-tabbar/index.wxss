.fake-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(10px); 
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 110rpx; 
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1; 
  height: 100%;
  transition: all 0.2s ease; 
}

.tab-hover {
  opacity: 0.6;
  transform: scale(0.95);
}

/* 💥 核心修改：设定图片的固定宽高 💥 */
.tab-icon {
  width: 48rpx;  /* 尺寸可以根据你切图的大小微调 */
  height: 48rpx;
  margin-bottom: 6rpx;
}

.tab-text {
  font-size: 22rpx;
  color: #A1A1AA; 
  font-weight: 500;
}

.tab-text.active {
  color: #ff4d4d; 
  font-weight: bold; 
}

.tabbar-placeholder {
  height: calc(110rpx + env(safe-area-inset-bottom));
  width: 100%;
  background-color: transparent;
}