.pm-wrap { margin-top: 20rpx; }
.pm-label { margin-bottom: 14rpx; color: #646a73; font-size: 24rpx; }
.pm-items { display: flex; flex-wrap: wrap; gap: 16rpx; }
.pm-item { position: relative; width: 128rpx; height: 128rpx; border-radius: 12rpx; background: #f0f2f5; }
.pm-preview, .pm-preview image { width: 100%; height: 100%; border-radius: 12rpx; }
.pm-play { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(0,0,0,.2); color: #fff; font-size: 20rpx; border-radius: 12rpx; }
.pm-remove { position: absolute; top: -8rpx; right: -8rpx; width: 32rpx; height: 32rpx; border-radius: 50%; background: #646a73; color: #fff; display: flex; align-items: center; justify-content: center; }
.pm-add { box-sizing: border-box; border: 1rpx dashed #bbbfc4; color: #8f959e; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 20rpx; gap: 8rpx; }
.pm-video-mask { position: fixed; inset: 0; z-index: 9999; background: #000; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.pm-video-mask video { width: 100%; }
.pm-video-mask button { margin-top: 30rpx; }
