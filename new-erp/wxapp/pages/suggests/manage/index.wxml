<view class="manage-page">
  <!-- 顶部管理工作台 Header -->
  <view class="header-banner">
    <view class="banner-top">
      <view class="title-wrap">
        <text class="banner-title">改良委工作台</text>
        <van-tag type="danger" round plain color="#ffffff" custom-class="role-badge-tag">
          <van-icon name="manager-o" size="22rpx" style="margin-right: 6rpx;" />
          提案推进中心
        </van-tag>
      </view>
      <view class="user-pill" wx:if="{{userInfo && (userInfo.name || userInfo.nickName)}}">
        <van-icon name="user-circle-o" size="28rpx" color="rgba(255,255,255,0.9)" />
        <text class="user-name">{{userInfo.name || userInfo.nickName}}</text>
      </view>
    </view>

    <!-- 搜索栏充分利用 van-search -->
    <view class="search-wrap">
      <van-search
        value="{{ searchKeyword }}"
        placeholder="搜索提案人、内容或认领人..."
        shape="round"
        background="transparent"
        bind:change="onSearchInput"
        bind:clear="onSearchClear"
        custom-class="vant-search-bar"
      />
    </view>
  </view>

  <!-- 状态切换流转充分利用 van-tabs 与 van-tab -->
  <van-sticky>
    <view class="tabs-wrapper">
      <van-tabs
        active="{{ status }}"
        bind:change="changeStatus"
        color="#d81e06"
        line-width="48rpx"
        line-height="6rpx"
        title-active-color="#d81e06"
        title-inactive-color="#606266"
        border="{{ false }}"
      >
        <van-tab
          wx:for="{{ statusTabs }}"
          wx:key="key"
          title="{{ item.title }}"
          name="{{ item.key }}"
        />
      </van-tabs>
    </view>
  </van-sticky>

  <!-- 提案列表内容区 -->
  <view class="list-container">
    <!-- 提案卡片循环 -->
    <block wx:if="{{displayList && displayList.length > 0}}">
      <view
        class="suggest-card"
        wx:for="{{displayList}}"
        wx:key="id"
      >
        <!-- 卡片头部：提案人与状态徽标 -->
        <view class="card-header" data-id="{{item.id}}" bindtap="showInfo">
          <view class="proposer-meta">
            <view class="avatar-circle">
              <text>{{item._firstChar || '提'}}</text>
            </view>
            <view class="proposer-info">
              <view class="proposer-name-row">
                <text class="proposer-name">{{item._name || item.name || '匿名提案'}}</text>
                <van-tag size="small" round type="default" wx:if="{{!item.name}}">匿名</van-tag>
              </view>
              <view class="create-time-row">
                <van-icon name="clock-o" size="22rpx" color="#909399" />
                <text class="create-time">{{item.create_date}}</text>
              </view>
            </view>
          </view>

          <!-- 状态徽标充分利用 van-tag -->
          <van-tag
            round
            size="medium"
            type="{{item.status == 0 ? 'warning' : (item.status == 1 ? 'primary' : (item.status == 2 ? 'warning' : 'success'))}}"
            custom-class="card-status-tag"
          >
            {{item.status_text || statusTabs[item.status].title}}
          </van-tag>
        </view>

        <!-- 卡片主体：提案内容 -->
        <view class="card-body" data-id="{{item.id}}" bindtap="showInfo">
          <view class="proposal-content">
            <text class="proposal-text">{{item.content}}</text>
          </view>

          <!-- 提案佐证图片利用 van-grid & van-image -->
          <!-- 附件媒体展示 (单图大图预览 / 多图九宫格) -->
          <view class="media-gallery" wx:if="{{item._mediaList && item._mediaList.length > 0}}">
            <!-- 单图大图展示 -->
            <view
              class="single-image-box"
              wx:if="{{item._mediaList.length === 1}}"
              data-url="{{item._mediaList[0]}}"
              data-urls="{{item._mediaList}}"
              catchtap="previewImage"
            >
              <image
                class="single-img"
                src="{{item._mediaList[0]}}"
                mode="aspectFill"
              />
            </view>

            <!-- 多图九宫格 -->
            <view class="card-photo-grid" wx:else>
              <view
                class="card-photo-item"
                wx:for="{{item._mediaList}}"
                wx:for-item="imgUrl"
                wx:key="*this"
                data-url="{{imgUrl}}"
                data-urls="{{item._mediaList}}"
                catchtap="previewImage"
              >
                <image
                  class="card-photo-img"
                  src="{{imgUrl}}"
                  mode="aspectFill"
                />
              </view>
            </view>
          </view>

          <!-- 推进中/已完成 关键信息展板 -->
          <view class="progress-box" wx:if="{{item.status != 0}}">
            <view class="progress-row" wx:if="{{item.director_name}}">
              <view class="director-chip">
                <van-icon name="manager-o" size="24rpx" color="#1890ff" />
                <text class="director-label">认领人：</text>
                <text class="director-name">{{item.director_name}}</text>
              </view>
            </view>

            <!-- 评级与积分展示 -->
            <view class="result-highlight-row" wx:if="{{item.result_text || item.score}}">
              <van-tag type="danger" round size="medium" wx:if="{{item.result_text}}">
                评级：{{item.result_text}}
              </van-tag>
              <view class="score-pill" wx:if="{{item.score}}">
                <van-icon name="gold-coin-o" size="24rpx" color="#e6a23c" />
                <text class="score-value">+{{item.score}} 积分</text>
              </view>
            </view>

            <!-- 简短反馈说明 -->
            <view class="feedback-snippet" wx:if="{{item.result_content}}">
              <text class="snippet-label">成效反馈：</text>
              <text class="snippet-text">{{item.result_content}}</text>
            </view>
          </view>
        </view>

        <!-- 卡片底部操作栏充分利用 van-button -->
        <view class="card-footer">
          <view class="footer-left" data-id="{{item.id}}" bindtap="showInfo">
            <text class="detail-link">查看流转详情</text>
            <van-icon name="arrow" size="20rpx" color="#909399" />
          </view>

          <view class="footer-actions">
            <!-- 状态0：待认领 -->
            <block wx:if="{{item.status == 0}}">
              <van-button
                type="danger"
                size="small"
                round
                icon="plus"
                data-id="{{item.id}}"
                catch:click="accept"
              >
                立即认领
              </van-button>
            </block>

            <!-- 状态1：推进中（本人认领 vs 他人认领） -->
            <block wx:if="{{item.status == 1}}">
              <van-button
                wx:if="{{item.director == userInfo.user_id}}"
                type="info"
                size="small"
                round
                icon="edit"
                data-id="{{item.id}}"
                catch:click="result"
              >
                录入结果
              </van-button>
              <van-button
                wx:else
                type="default"
                size="small"
                round
                icon="underway-o"
                data-id="{{item.id}}"
                catch:click="showInfo"
              >
                跟进中
              </van-button>
            </block>

            <!-- 状态2：待审核 -->
            <block wx:if="{{item.status == 2}}">
              <van-button
                type="default"
                size="small"
                round
                icon="eye-o"
                data-id="{{item.id}}"
                catch:click="showInfo"
              >
                审阅详情
              </van-button>
            </block>

            <!-- 状态3：已完成 -->
            <block wx:if="{{item.status == 3}}">
              <van-button
                type="default"
                size="small"
                round
                icon="award-o"
                data-id="{{item.id}}"
                catch:click="showInfo"
              >
                成果详情
              </van-button>
            </block>
          </view>
        </view>
      </view>
    </block>

    <!-- 空状态展示充分利用 van-empty -->
    <view class="empty-wrap" wx:if="{{!loading && (!displayList || displayList.length === 0)}}">
      <van-empty
        image="search"
        description="{{searchKeyword ? '未检索到与「' + searchKeyword + '」相关的提案' : (status === 0 ? '暂无待认领提案，委员们辛苦了！' : (status === 1 ? '暂无推进中的提案' : (status === 2 ? '暂无待审核结果' : '暂无已归档提案')))}}"
      >
        <van-button
          wx:if="{{searchKeyword}}"
          round
          size="small"
          type="default"
          bind:click="onSearchClear"
        >
          清空搜索词
        </van-button>
      </van-empty>
    </view>

    <!-- 加载中与触底状态提示 -->
    <view class="list-load-status" wx:if="{{displayList && displayList.length > 0}}">
      <view class="loading-box" wx:if="{{loading}}">
        <van-loading size="28rpx" color="#909399" />
        <text class="loading-text">{{loadmoreText}}</text>
      </view>
      <view class="nomore-box" wx:elif="{{nomore}}">
        <text class="nomore-text">—— {{nomoreText}} ——</text>
      </view>
    </view>
  </view>

  <!-- 底部抽屉式详情弹窗 (Bottom Sheet 严控边界，充分利用 van-steps, van-cell-group, van-grid, van-image) -->
  <van-popup
    show="{{ infoModel }}"
    position="bottom"
    round
    closeable
    close-icon="close"
    safe-area-inset-bottom
    custom-style="height: 82vh; max-height: 85vh; border-radius: 36rpx 36rpx 0 0; overflow: hidden;"
    bind:close="onClose"
  >
    <view class="sheet-container">
      <!-- 抽屉顶部标题区 (设置右内边距防重叠关闭按钮) -->
      <view class="sheet-header">
        <view class="sheet-header-left">
          <text class="sheet-title">提案流转与成果详情</text>
          <van-tag
            wx:if="{{suggestInfo}}"
            round
            size="medium"
            type="{{suggestInfo.status == 0 ? 'warning' : (suggestInfo.status == 1 ? 'primary' : (suggestInfo.status == 2 ? 'warning' : 'success'))}}"
          >
            {{suggestInfo.status_text || (suggestInfo.status == 0 ? '待认领' : (suggestInfo.status == 1 ? '推进中' : (suggestInfo.status == 2 ? '待审核' : '已完成')))}}
          </van-tag>
        </view>
      </view>

      <!-- 严格限定高度的平滑滚动区域 (flex: 1; height: 0; min-height: 0; 绝不超出边界) -->
      <scroll-view scroll-y class="sheet-scroll-body" enhanced show-scrollbar="{{false}}">
        <!-- 详情加载中 -->
        <view class="detail-loading-box" wx:if="{{detailLoading}}">
          <van-loading size="40rpx" color="#d81e06" vertical>加载详情中...</van-loading>
        </view>

        <view class="sheet-body-content" wx:elif="{{suggestInfo}}">
          <!-- 核心特性 1：流转步骤条与阶段指示 (空间开阔，杜绝拥挤) -->
          <view class="steps-card">
            <van-steps
              steps="{{ detailSteps }}"
              active="{{ detailActiveStep }}"
              active-color="#d81e06"
              active-icon="checked"
              inactive-icon="circle"
            />
            <!-- 当前节点解读展板：全屏宽展开，杜绝横向挤压 -->
            <view class="phase-info-box phase-box-{{detailActiveStep}}">
              <view class="phase-header">
                <van-icon name="{{detailActiveStep === 3 ? 'passed' : (detailActiveStep === 0 ? 'clock-o' : 'underway-o')}}" size="28rpx" />
                <text class="phase-status-title">{{detailPhaseText}}</text>
              </view>
              <text class="phase-status-desc">{{detailPhaseDesc}}</text>
            </view>
          </view>

          <!-- 核心特性 2：提案原貌 van-cell-group inset -->
          <van-cell-group inset title="提案原貌" custom-class="sheet-group">
            <van-cell title="提案人" value="{{suggestInfo.name || '匿名提案'}}" value-class="font-bold-val" />
            <van-cell wx:if="{{suggestInfo.department}}" title="所属团队" value="{{suggestInfo.department}}" />
            <van-cell wx:if="{{suggestInfo.create_date}}" title="提交时间" value="{{suggestInfo.create_date}}" />
            <van-cell title="改善建议" label="{{suggestInfo.content}}" />

            <!-- 改良前佐证图片 -->
            <view class="cell-media-container" wx:if="{{suggestInfo.before_images_arr && suggestInfo.before_images_arr.length > 0}}">
              <view class="media-sub-title">改良前现场图片 ({{suggestInfo.before_images_arr.length}}张)：</view>
              <view class="detail-photo-grid">
                <view
                  class="detail-photo-item"
                  wx:for="{{suggestInfo.before_images_arr}}"
                  wx:for-item="bImg"
                  wx:key="*this"
                  data-url="{{bImg}}"
                  data-urls="{{suggestInfo.before_images_arr}}"
                  catchtap="previewImage"
                >
                  <image
                    class="detail-photo-img"
                    src="{{bImg}}"
                    mode="aspectFill"
                  />
                </view>
              </view>
            </view>
          </van-cell-group>

          <!-- 核心特性 3：推进责任人 van-cell-group inset -->
          <van-cell-group inset title="流转推进" custom-class="sheet-group">
            <van-cell
              title="认领推进人"
              value="{{suggestInfo.director_name || '尚未认领'}}"
              value-class="{{suggestInfo.director_name ? 'text-blue-val' : 'text-gray-val'}}"
            />
            <van-cell wx:if="{{suggestInfo.executor}}" title="参与落地人" value="{{suggestInfo.executor}}" />
          </van-cell-group>

          <!-- 核心特性 4：落地成效与评定成果 van-cell-group inset -->
          <van-cell-group inset title="落地成果与评定" custom-class="sheet-group" wx:if="{{suggestInfo.status > 0}}">
            <van-cell title="落地等级" wx:if="{{suggestInfo.result_text}}">
              <van-tag type="danger" round size="medium">{{suggestInfo.result_text}}</van-tag>
            </van-cell>
            <van-cell title="奖励积分" wx:if="{{suggestInfo.score}}">
              <text class="score-highlight">+{{suggestInfo.score}} 积分</text>
            </van-cell>
            <van-cell
              wx:if="{{suggestInfo.result_content}}"
              title="实施成效反馈"
              label="{{suggestInfo.result_content}}"
            />

            <!-- 改善后效果对比图 -->
            <view class="cell-media-container" wx:if="{{suggestInfo.after_images_arr && suggestInfo.after_images_arr.length > 0}}">
              <view class="media-sub-title">改善后成果对比 ({{suggestInfo.after_images_arr.length}}张)：</view>
              <view class="detail-photo-grid">
                <view
                  class="detail-photo-item"
                  wx:for="{{suggestInfo.after_images_arr}}"
                  wx:for-item="aImg"
                  wx:key="*this"
                  data-url="{{aImg}}"
                  data-urls="{{suggestInfo.after_images_arr}}"
                  catchtap="previewImage"
                >
                  <image
                    class="detail-photo-img"
                    src="{{aImg}}"
                    mode="aspectFill"
                  />
                </view>
              </view>
            </view>

            <view class="empty-result-hint" wx:if="{{!suggestInfo.result_text && !suggestInfo.result_content && (!suggestInfo.after_images_arr || suggestInfo.after_images_arr.length === 0)}}">
              <van-icon name="info-o" size="28rpx" color="#909399" />
              <text class="hint-text">该提案正由认领委员组织落地推进中，成果录入后在此呈现。</text>
            </view>
          </van-cell-group>
        </view>
      </scroll-view>

      <!-- 抽屉底部固定操作栏 (坚决不被撑爆，始终清晰可见) -->
      <view class="sheet-footer" wx:if="{{suggestInfo}}">
        <!-- 待认领状态：直接认领 -->
        <van-button
          wx:if="{{suggestInfo.status == 0}}"
          type="danger"
          round
          block
          icon="plus"
          data-id="{{suggestInfo.id}}"
          bind:click="accept"
          custom-class="sheet-btn-action"
        >
          立即认领该提案
        </van-button>

        <!-- 已认领且本人是认领人：前往录入结果 -->
        <van-button
          wx:elif="{{suggestInfo.status == 1 && suggestInfo.director == userInfo.user_id}}"
          type="info"
          round
          block
          icon="edit"
          data-id="{{suggestInfo.id}}"
          bind:click="result"
          custom-class="sheet-btn-action"
        >
          前往录入落地结果
        </van-button>

        <!-- 返回按钮 -->
        <van-button
          type="default"
          round
          block
          bind:click="onClose"
          custom-class="sheet-btn-close"
        >
          返回列表
        </van-button>
      </view>
    </view>
  </van-popup>

  <!-- 全局轻提示与对话框 -->
  <van-notify id="van-notify" />
  <van-dialog id="van-dialog" />
</view>