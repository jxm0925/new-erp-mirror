/* pages/war/index/index.wxss */
.contaier{
    width: 100%;
    height: 2000rpx;
    background: url(https://media.sdjiantan.com/uploads/20251016/1ad532f17955ed2ed24d97bb3411f650.png) no-repeat;
    background-size: 750rpx;
}
.top_bg {
    width: 100%;
    height: 980rpx;
    position: relative;
}
.one_box{
    width: 750rpx;
    height: 350rpx;
    position: absolute;
    left: 0;
    bottom: 5rpx;
    display: flex;
    justify-content: space-around;
}
.one_box .top3 {
    width: 210rpx;
    height: 280rpx;
}

.top_name {
    width: 100%;
    height: 55rpx;
    line-height: 60rpx;
    color: #f2f2f2;
    font-size: 30rpx;
    font-weight:900;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.top_sy {
    width: 100%;
    height: 40rpx;
    line-height: 40rpx;
    font-size: 30rpx;
    font-weight:900;
    color: rgba(255, 255, 255, 0.7);
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.top_sy ._span {
  font-size: 20rpx !important;
}

.num_one {
    position: relative;
}
.num_one .top3_head {
  width: 140rpx;
  height: 140rpx;
  border-radius: 100%;
  margin: 15rpx 0 0 30rpx;
  border: 4rpx solid #ffdd3c;
}
.num_two {
    position: relative;
    margin: 62rpx 0 0 94rpx;
}
.num_two .top3_head {
    width: 140rpx;
    height: 140rpx;
    border-radius: 100%;
    border: 4rpx solid #bcdcdf;
}
.num_three {
    position: relative;
    margin: 73rpx 0 0 -30rpx;
  }
  .num_three .top3_head {
    width: 140rpx;
    height: 140rpx;
    border-radius: 100%;
    border: 4rpx solid #e29d85;
  }
  .number_sy_box {
    width: 700rpx;
    height: 210rpx;
    background-color: #FFFFFF;
    position: absolute;
    left: 25rpx;
    border-radius: 20rpx;
    bottom: -115rpx;
    z-index: 999;
    padding: 22rpx;
    box-shadow: 3px 3px 15px 3px rgba(0, 0, 0, 0.1);
  }