<van-sticky>
<van-search value="{{ value }}" placeholder="请输入搜索关键词" bind:change="searchField" bind:clear="searchCancel"/>
</van-sticky>

<view class="box1">
  <view class="box-1">
    <van-sidebar>
      <van-sidebar-item
        wx:for="{{accessoryArray}}" wx:key="id"
        title="{{item.goodsname}}"
        badge="{{ item.badge ? item.badge : '' }}"
        data-idx="{{index}}" bind:click="accessoryClick"
      />
    </van-sidebar>
  </view>
  <scroll-view  scroll-y="true" style="height: 89%;" scroll-top="{{scrolltop}}">
    <van-empty wx:if="{{!children || children.length == 0}}" description="暂无配件" />
    <van-card
      wx:for="{{children}}" wx:key="id"
      centered="true"
      lazy-load="true"
      price="{{item.univalence?item.univalence:0}}"
      thumb-mode="aspectFill"
      tag="{{ item.badge ? item.badge : '' }}"
      title="{{item.sku_name}}"
      thumb="{{item.image?item.image:'/static/images/emp.jpg'}}"
      custom-class="cardClass">
      <view class="goods-btn" slot="footer">
        <van-icon name="add" color="#e64340" size="50rpx" data-idx="{{index}}" bind:click="addCart" />
      </view>
    </van-card>
  </scroll-view>
</view>
<van-submit-bar
  price="{{ shippingCarInfo.price }}"
  tip="{{ true }}"
  button-text="提交核价单"
  data-type="open"
  bind:submit="onChangeSubPop"
>
<van-icon name="orders-o" size="40rpx" text="配件清单" info="{{shippingCarInfo.number}}" bind:click="showCartPop"/>
</van-submit-bar>

