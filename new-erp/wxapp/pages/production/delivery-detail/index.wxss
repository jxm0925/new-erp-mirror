page { background: #f7f7f7; color: #161616; }
.detail-page { min-height: 100vh; padding: 20rpx 28rpx 150rpx; box-sizing: border-box; }.state { min-height: 70vh; display: flex; align-items: center; justify-content: center; }
.summary-card,.line-card { margin-bottom: 18rpx; padding: 26rpx; border-radius: 18rpx; background: #fff; box-shadow: 0 5rpx 20rpx rgba(0,0,0,.04); }
.summary-card { display: grid; grid-template-columns: 1fr 1fr; column-gap: 26rpx; row-gap: 20rpx; }.summary-card view { min-width: 0; display: grid; grid-template-columns: 124rpx 1fr; align-items: center; font-size: 28rpx; }.summary-card text { color: #666a72; }.summary-card strong { font-size: 28rpx; font-weight: 500; overflow-wrap: anywhere; }.red { color: #d81e06 !important; }
.line-head { padding-bottom: 20rpx; border-bottom: 1rpx solid #ececec; display: flex; justify-content: space-between; align-items: flex-start; }.line-head view { display: flex; flex-direction: column; gap: 8rpx; }.line-head strong { font-size: 31rpx; }.line-head view text { font-size: 29rpx; }.line-head > text { padding: 5rpx 13rpx; border-radius: 20rpx; color: #d81e06; background: #fff1ef; font-size: 28rpx; }
.quantity-row { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); padding: 22rpx 0; border-bottom: 1rpx solid #ececec; }.quantity-row view { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }.quantity-row text { color: #656a72; font-size: 28rpx; }.quantity-row strong { font-size: 31rpx; font-weight: 500; }
.field-row { min-height: 76rpx; margin-top: 18rpx; display: grid; grid-template-columns: 140rpx 1fr auto; gap: 14rpx; align-items: center; font-size: 29rpx; }.field-row input { height: 72rpx; padding: 0 20rpx; box-sizing: border-box; border: 1rpx solid #ccd0d5; border-radius: 9rpx; font-size: 29rpx; }
.bottom-actions { position: fixed; left: 0; right: 0; bottom: 0; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -4rpx 18rpx rgba(0,0,0,.06); display: flex; gap: 20rpx; }.bottom-actions button { flex: 1; height: 78rpx; padding: 0; border-radius: 10rpx; font-size: 30rpx; line-height: 78rpx; }.bottom-actions button::after { border: 0; }.primary { color: #fff; background: #d81e06; }.outline { color: #d81e06; background: #fff; border: 2rpx solid #d81e06; }
.quantity-row view { min-width: 0; }
.quantity-row .batch { align-items: flex-start; }
.quantity-row strong,.line-head strong,.line-head view text { overflow-wrap: anywhere; }
.line-head > view { min-width: 0; flex: 1; padding-right: 12rpx; }
.line-head > text { flex: none; }
.line-head > text.accepted { color: #008d30; background: #edf8ef; }
