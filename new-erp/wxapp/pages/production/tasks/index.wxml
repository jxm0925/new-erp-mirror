<view class="orders-page">
  <view class="hero">
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="custom-nav" style="height: {{navBarHeight}}px;">
      <view class="nav-back" bindtap="goBack"><van-icon name="arrow-left" size="42rpx" color="#fff" /></view><text class="nav-title">生产工单</text>
      <view class="scan-entry" style="right: {{scanRight}}px;" bindtap="scan"><van-icon name="scan" size="46rpx" color="#fff" /></view>
    </view>
    <view class="summary-card"><view class="summary-item"><text>工单总数</text><strong>{{summary.total}}</strong></view><view class="summary-item"><text>生产中</text><strong>{{summary.in_progress}}</strong></view><view class="summary-item"><text>待条件</text><strong>{{summary.wait_condition}}</strong></view><view class="summary-item last"><text>异常</text><strong>{{summary.exception}}</strong></view></view>
  </view>
  <view class="filter-panel">
    <view class="source-tabs"><view class="source-tab {{source==='sales'?'active':''}}" data-source="sales" bindtap="setSource">销售生产</view><view class="source-tab {{source==='stock'?'active':''}}" data-source="stock" bindtap="setSource">备货生产</view><view class="source-tab {{source==='other'?'active':''}}" data-source="other" bindtap="setSource">其他生产</view></view>
    <view class="search-row"><view class="search-box"><van-icon name="search" size="34rpx" /><input value="{{keyword}}" placeholder="搜索工单 / 来源 / 产品" bindinput="onSearch" /><van-icon wx:if="{{keyword}}" name="clear" size="30rpx" bindtap="clearSearch" /></view></view>
    <view class="status-row"><view class="status-chip {{activeStatus===''?'active':''}}" data-status="" bindtap="setStatus">全部</view><view class="status-chip {{activeStatus==='IN_PROGRESS'?'active':''}}" data-status="IN_PROGRESS" bindtap="setStatus">生产中</view><view class="status-chip {{activeStatus==='WAIT_CONDITION'?'active':''}}" data-status="WAIT_CONDITION" bindtap="setStatus">待条件</view><view class="status-chip {{activeStatus==='EXCEPTION'?'active':''}}" data-status="EXCEPTION" bindtap="setStatus">异常</view><view class="status-chip {{activeStatus==='COMPLETED'?'active':''}}" data-status="COMPLETED" bindtap="setStatus">已完成</view></view>
  </view>
  <view wx:if="{{loading}}" class="state-box"><van-loading color="#ea160c">加载中</van-loading></view>
  <view wx:elif="{{error && !rows.length}}" class="state-box state-column"><strong>{{errorTitle}}</strong><text>{{error}}</text><button wx:if="{{errorCode==='load'}}" bindtap="retry">重新加载</button></view>
  <view wx:elif="{{loaded && !rows.length}}" class="state-box"><van-empty description="暂无符合条件的生产工单" /></view>
  <view class="order-card" wx:for="{{rows}}" wx:key="id">
    <view class="card-head"><view class="document-pill">工单</view><strong class="document-no">{{item.number}}</strong><text class="status-tag {{item.statusTone}}">{{item.statusLabel}}</text></view>
    <view class="info-row"><text class="info-label">来源单据</text><text class="info-value">{{item.sourceNo}}</text></view>
    <view class="info-row" wx:if="{{item.customerName}}"><text class="info-label">客户</text><text class="info-value">{{item.customerName}}</text></view>
    <view class="info-row"><text class="info-label">产品</text><text class="info-value">{{item.productName}}</text></view>
    <view class="info-row"><text class="info-label">生产方式</text><text class="info-value">{{item.executionLabel}}</text></view>
    <view class="quantity-grid"><view><text>计划</text><strong>{{item.plannedText}}</strong></view><view><text>已完成</text><strong class="success">{{item.completedText}}</strong></view><view><text>在制</text><strong class="running-value">{{item.inProgressText}}</strong></view><view class="last"><text>异常</text><strong class="danger">{{item.exceptionText}}</strong></view></view>
    <view class="info-row"><text class="info-label">工序完成</text><text class="info-value">{{item.progressText}}</text></view>
    <view class="info-row" wx:if="{{item.deliveryDate || item.plannedDate}}"><text class="info-label">{{item.deliveryDate?'交期':'计划日期'}}</text><text class="info-value">{{item.deliveryDate || item.plannedDate}}</text></view>
    <view class="info-row" wx:if="{{item.remarkText}}"><text class="info-label">备注</text><text class="info-value">{{item.remarkText}}</text></view>
    <view class="info-row" wx:if="{{item.blockers.length}}"><text class="info-label">阻断原因</text><view class="blocker-list"><text wx:for="{{item.blockers}}" wx:for-item="blocker" wx:key="*this">{{blocker}}</text></view></view>
    <view class="card-action {{item.compact?'outline':''}}" data-id="{{item.id}}" bindtap="openRow"><text>查看工单</text><van-icon name="arrow" size="30rpx" /></view>
  </view>
  <view wx:if="{{error && rows.length}}" class="more-loading" bindtap="retry">{{error}} · 点击重试</view>
  <view wx:if="{{loadingMore}}" class="more-loading"><van-loading color="#ea160c" /></view><view class="bottom-space"></view>
</view>
