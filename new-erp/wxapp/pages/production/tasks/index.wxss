page { background: #f4f6f8; color: #151923; }
.orders-page { min-height: 100vh; overflow-x: hidden; padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.hero { background: linear-gradient(145deg, #f21c0b 0%, #df0902 72%, #d80702 100%); padding: 0 20rpx 42rpx; color: #fff; box-sizing: border-box; }
.custom-nav { position: relative; display: flex; align-items: center; justify-content: center; }
.nav-back { position: absolute; left: 0; top: 50%; width: 58rpx; height: 58rpx; transform: translateY(-50%); display: flex; align-items: center; justify-content: flex-start; }
.nav-title { font-size: 36rpx; line-height: 1; font-weight: 700; letter-spacing: 2rpx; }
.scan-entry { position: absolute; top: 50%; width: 54rpx; height: 54rpx; transform: translateY(-50%); display: flex; align-items: center; justify-content: center; }
.summary-card { height: 142rpx; margin-top: 18rpx; border: 2rpx solid rgba(255,255,255,.55); border-radius: 16rpx; display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); background: rgba(255,255,255,.04); box-sizing: border-box; }
.summary-item { min-width: 0; margin: 27rpx 0; border-right: 2rpx solid rgba(255,255,255,.78); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7rpx; }
.summary-item.last { border-right: 0; }
.summary-item text { font-size: 26rpx; white-space: nowrap; }
.summary-item strong { font-size: 45rpx; line-height: 1; font-weight: 700; }
.filter-panel { position: relative; z-index: 2; margin: -26rpx 20rpx 0; padding: 0 20rpx 20rpx; background: #fff; border-radius: 17rpx; box-shadow: 0 8rpx 28rpx rgba(47,54,67,.06); }
.source-tabs { height: 80rpx; border-bottom: 1rpx solid #eceef2; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); }
.source-tab { position: relative; min-width: 0; display: flex; align-items: center; justify-content: center; color: #6f7785; font-size: 29rpx; font-weight: 500; white-space: nowrap; }
.source-tab.active { color: #e1130b; font-weight: 700; }
.source-tab.active::after { content: ''; position: absolute; left: 50%; bottom: 0; width: 66rpx; height: 7rpx; transform: translateX(-50%); border-radius: 5rpx; background: #e51008; }
.search-box { height: 66rpx; margin-top: 20rpx; padding: 0 20rpx; border-radius: 35rpx; background: #f3f4f6; display: flex; align-items: center; gap: 14rpx; box-sizing: border-box; }
.search-box input { flex: 1; min-width: 0; height: 66rpx; color: #171b25; font-size: 26rpx; }
.status-row { margin-top: 18rpx; display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 13rpx; }
.status-chip { min-width: 0; height: 52rpx; padding: 0 5rpx; border-radius: 18rpx; background: #f4f5f7; color: #606878; font-size: 24rpx; display: flex; align-items: center; justify-content: center; white-space: nowrap; box-sizing: border-box; }
.status-chip.active { color: #e1120a; background: #fee9e8; font-weight: 700; }
.state-box { min-height: 380rpx; display: flex; align-items: center; justify-content: center; }
.order-card { margin: 16rpx 22rpx 0; padding: 19rpx 22rpx 20rpx; background: #fff; border-radius: 17rpx; box-shadow: 0 5rpx 22rpx rgba(41,51,70,.055); box-sizing: border-box; }
.card-head { min-width: 0; display: flex; align-items: center; gap: 16rpx; }
.document-pill { flex: 0 0 auto; height: 45rpx; padding: 0 14rpx; border-radius: 8rpx; background: linear-gradient(145deg,#f51d11,#d90802); color: #fff; font-size: 25rpx; line-height: 45rpx; font-weight: 700; }
.document-no { flex: 1; min-width: 0; overflow: hidden; color: #121722; font-size: 29rpx; line-height: 45rpx; text-overflow: ellipsis; white-space: nowrap; }
.status-tag { flex: 0 0 auto; min-width: 86rpx; height: 43rpx; padding: 0 12rpx; border-radius: 8rpx; font-size: 25rpx; line-height: 43rpx; text-align: center; font-weight: 700; box-sizing: border-box; }
.status-tag.running { color: #e90e08; background: #fee7e6; }
.status-tag.waiting { color: #f27600; background: #fff0de; }
.status-tag.exception { color: #d90702; background: #ffe6e4; }
.status-tag.completed { color: #159447; background: #e4f7ea; }
.info-row { min-width: 0; margin-top: 11rpx; display: flex; align-items: flex-start; font-size: 25rpx; line-height: 36rpx; }
.info-label { flex: 0 0 132rpx; color: #606878; }
.info-value { flex: 1; min-width: 0; color: #171c26; overflow-wrap: anywhere; }
.products-row { margin-top: 8rpx; }
.product-list { display: flex; flex-direction: column; }
.product-list > text { display: block; }
.product-list .wo-count { margin-top: 4rpx; color: #6d7480; font-size: 22rpx; }
.quantity-grid { height: 80rpx; margin-top: 15rpx; border-radius: 8rpx; background: linear-gradient(90deg,#fafafa,#f4f5f7,#fafafa); display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); align-items: center; }
.quantity-grid > view { min-width: 0; border-right: 1rpx solid #d9dde4; display: flex; flex-direction: column; align-items: center; gap: 3rpx; }
.quantity-grid > view.last { border-right: 0; }
.quantity-grid text { color: #616978; font-size: 22rpx; }
.quantity-grid strong { max-width: 100%; overflow: hidden; font-size: 29rpx; line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }
.success { color: #12a94b; }
.running-value { color: #2466d7; }
.danger { color: #db0a05; }
.progress-head { margin-top: 13rpx; display: flex; align-items: center; color: #606878; font-size: 25rpx; }
.progress-head strong { margin-left: auto; color: #141923; font-weight: 500; white-space: nowrap; }
.progress-track { height: 13rpx; margin-top: 8rpx; overflow: hidden; border-radius: 8rpx; background: #dfe2e8; }
.progress-track view { height: 100%; min-width: 0; border-radius: inherit; background: linear-gradient(90deg,#ee1108,#df0802); }
.lower-row { margin-top: 17rpx; }
.delivery-success { color: #139342; }
.delivery-warning { color: #f06b00; font-weight: 500; }
.delivery-muted { color: #6c7481; }
.blocker-row { margin-top: 12rpx; }
.blocker-list { flex: 1; min-width: 0; display: flex; flex-wrap: wrap; gap: 8rpx; }
.blocker-list text { max-width: 100%; padding: 5rpx 14rpx; border-radius: 8rpx; background: #fff0df; color: #f07100; font-size: 23rpx; line-height: 32rpx; overflow-wrap: anywhere; box-sizing: border-box; }
.card-action { height: 54rpx; margin-top: 15rpx; border: 2rpx solid #e5140b; border-radius: 9rpx; background: linear-gradient(100deg,#f21b10,#dc0702); color: #fff; display: flex; align-items: center; justify-content: center; gap: 6rpx; font-size: 26rpx; font-weight: 700; box-sizing: border-box; }
.card-action.outline { background: #fff; color: #e30e07; }
.more-loading { height: 90rpx; display: flex; align-items: center; justify-content: center; }
.bottom-space { height: calc(18rpx + env(safe-area-inset-bottom)); }

@media (max-width: 360px) {
  .hero { padding-left: 16rpx; padding-right: 16rpx; }
  .filter-panel { margin-left: 14rpx; margin-right: 14rpx; padding-left: 14rpx; padding-right: 14rpx; }
  .order-card { margin-left: 14rpx; margin-right: 14rpx; padding-left: 17rpx; padding-right: 17rpx; }
  .source-tab { font-size: 27rpx; }
  .status-row { gap: 7rpx; }
  .status-chip { font-size: 22rpx; }
  .document-no { font-size: 26rpx; }
  .info-label { flex-basis: 112rpx; }
}

@media (min-width: 431px) {
  .orders-page { width: 430px; margin: 0 auto; background: #f4f6f8; box-shadow: 0 0 40rpx rgba(20,30,45,.12); }
}
