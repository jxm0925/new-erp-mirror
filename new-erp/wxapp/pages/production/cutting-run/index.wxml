<view class="mt-page {{tab === 'new' && picked ? 'has-footer' : ''}}">
  <!-- 顶部精简红底栏 -->
  <view class="wo-hero">
    <view class="wo-hero-top">
      <text class="wo-hero-title">集中开料工作台</text>
      <text class="wo-hero-pill">按 BOM 批次归集</text>
    </view>
    <view class="wo-hero-spec">按单一 BOM 启动集中开料并统计实际工时，工单备料时按件数自动分摊</view>
  </view>

  <view class="mt-tabs">
    <view class="mt-tab {{tab === 'runs' ? 'on' : ''}}" data-tab="runs" bindtap="pickTab">开料批次记录</view>
    <view class="mt-tab {{tab === 'new' ? 'on' : ''}}" data-tab="new" bindtap="pickTab">新建开料批次</view>
  </view>
  <view wx:if="{{error}}" class="mt-error">{{error}}</view>

  <block wx:if="{{tab === 'runs'}}">
    <view class="mt-note" style="margin-bottom: 18rpx;">单次集中开料对应单一 BOM 并记录实际工时。「切完结束」时按件数从仓库扣料，库存不够不能结束；逐张管理的板材须先领用板材并登记余料。各工单下料工序执行「已备料」时按件数带走料和工时（批次总工时 ÷ 总件数 × 领用件数）。</view>
    <view wx:if="{{loading}}" class="mt-empty">正在读取开料批次…</view>
    <view wx:if="{{!loading && !runs.length}}" class="mt-empty">暂无集中开料批次记录，请切换至「新建开料批次」启动作业</view>
    <view wx:for="{{runs}}" wx:key="id" class="mt-card" data-id="{{item.id}}" bindtap="openRunTap">
      <view class="mt-row">
        <text class="mono" style="font-weight: 700;">{{item.run_no}}</text>
        <text class="mt-tag {{item.status === 'running' ? 'amber' : 'green'}}">{{item.status_label}}</text>
      </view>
      <view class="mt-product">{{item.output_item_name}} <text class="mt-muted">{{item.bom_no}}</text></view>
      <view class="mt-muted" wx:if="{{item.status === 'running'}}">计划开料 {{item.set_qty}} 套 · 已计工时 {{item.laborText}}<text wx:if="{{item.timing_names.length}}"> · {{item.timing_names.length}} 人计时中</text></view>
      <view class="mt-muted" wx:else>产出 {{item.total_pieces}} 件 · 总工时 {{item.laborText}} · 已分摊 {{item.allocated_pieces}} 件 · 剩余 {{item.left_pieces}} 件</view>
      <view class="mt-muted">启动人：{{item.started_by_name}} · {{item.startedText}}</view>
    </view>
    <view wx:if="{{lastPage > 1}}" class="mt-pager">
      <button class="mt-btn ghost mt-btn-mini" disabled="{{page <= 1}}" data-delta="-1" bindtap="turnPage">上一页</button>
      <text>{{page}} / {{lastPage}}</text>
      <button class="mt-btn ghost mt-btn-mini" disabled="{{page >= lastPage}}" data-delta="1" bindtap="turnPage">下一页</button>
    </view>
  </block>

  <block wx:if="{{tab === 'new'}}">
    <view class="mt-search">
      <input class="mt-input" value="{{keyword}}" bindinput="keywordInput" placeholder="搜索产品名称 / BOM 编号" confirm-type="search" bindconfirm="loadBoms" />
      <button class="mt-btn mt-btn-mini" bindtap="loadBoms">查询</button>
    </view>
    <view wx:if="{{bomLoading}}" class="mt-empty">正在读取 BOM 列表…</view>
    <view wx:if="{{!bomLoading && !boms.length}}" class="mt-empty">暂无包含下料尺寸的 BOM</view>
    <view class="mt-card" wx:if="{{boms.length}}">
      <view class="mt-card-title"><text>选择开料 BOM</text><text class="mt-muted">点击选中后设置开料套数</text></view>
      <view wx:for="{{boms}}" wx:key="bom_id" class="cr-bom {{picked && picked.bom_id === item.bom_id ? 'on' : ''}}" data-index="{{index}}" bindtap="pickBom">
        <view class="mt-row"><text class="mt-product">{{item.item_name}}</text><text class="mt-muted mono">{{item.bom_no}}</text></view>
        <view class="cr-need">
          <text>每套 {{item.pieces_per_set}} 件</text>
          <text class="{{item.need_sets > item.stock_sets ? 'short' : ''}}">工单待备 {{item.need_sets}} 套</text>
          <text>已切未领 {{item.stock_sets}} 套</text>
          <text wx:if="{{item.running}}" class="mt-tag amber">{{item.running}} 批开料中</text>
        </view>
        <view class="clean-item-spec">下料明细：{{item.linesText}}</view>
      </view>
    </view>
  </block>
</view>

<view wx:if="{{tab === 'new' && picked}}" class="mt-footer" style="flex-direction: column;">
  <view class="mt-kv" style="padding: 4rpx 0 12rpx; border-bottom: 0;">
    <text class="k" style="color: #1f2329; font-weight: 700;">{{picked.item_name}} · 本次开料套数</text>
    <view class="ct-step">
      <text class="ct-step-btn {{setQty <= 1 ? 'off' : ''}}" data-delta="-1" bindtap="changeSet">−</text>
      <input class="ct-step-input" type="number" value="{{setQty}}" bindblur="setInput" />
      <text class="ct-step-btn" data-delta="1" bindtap="changeSet">+</text>
    </view>
  </view>
  <button class="mt-btn" disabled="{{busy}}" bindtap="startRun">启动集中开料并开始计时</button>
</view>

<view wx:if="{{panel === 'run'}}" class="tk-mask" catchtouchmove="stop">
  <view class="tk-sheet">
    <view class="mt-row tk-sheet-head"><text class="mt-title mono">{{run.run_no}}</text><text class="mt-tag {{run.status === 'running' ? 'amber' : 'green'}}">{{run.status_label}}</text></view>
    <scroll-view scroll-y class="tk-sheet-body">
      <view class="mt-product">{{run.output_item_name}} <text class="mt-muted">{{run.bom_no}} · 计划 {{run.set_qty}} 套</text></view>
      <view class="cr-timer">{{run.status === 'running' ? liveText : run.laborText}}</view>
      <view class="mt-muted" wx:if="{{run.status !== 'running'}}">合计产出 {{run.total_pieces}} 件，单件工时约 {{run.minutes_per_piece}} 分钟；已分摊 {{run.allocated_pieces}} 件（{{run.allocatedText}}），剩余 {{run.left_pieces}} 件</view>
      <view class="mt-card-title mt-gap">开料作业人员（按实际工时记录）</view>
      <view wx:for="{{run.people}}" wx:key="employee_legacy_id" class="cr-person"><text>{{item.employee_name}}</text><text class="{{item.timing ? 'on' : ''}}">{{item.timing ? '计时中 · ' : ''}}{{item.minutesText}}</text></view>

      <block wx:if="{{run.sheet_items.length && run.status === 'running'}}">
        <view class="mt-card-title mt-gap">板材领用与余料管理</view>
        <view wx:for="{{run.sheet_items}}" wx:key="item_id" class="mt-row" style="padding: 10rpx 0;"><text>{{item.item_name}}</text><text class="tk-link red" data-index="{{index}}" bindtap="openSheet">领用板材 ›</text></view>
      </block>
      <view wx:if="{{run.sheet_batches.length}}" class="mt-row mt-gap"><text class="mt-muted">已关联领板 {{run.sheet_batches.length}} 批</text><text class="tk-link red" bindtap="openSheetBatches">登记余料 / 查看明细 ›</text></view>

      <view class="mt-card-title mt-gap">{{run.status === 'running' ? '实际开料产出件数（按实核改）' : '物料产出与分摊明细'}}</view>
      <block wx:for="{{run.lines}}" wx:key="line_key">
        <view class="cr-line">
          <text class="k">{{item.component_item_name}} {{item.sizeText}}<text class="mt-muted">（每套 {{item.per_set}}）</text></text>
          <block wx:if="{{run.status === 'running'}}">
            <input class="ct-input" type="number" value="{{item.input}}" data-index="{{index}}" bindinput="piecesInput" /><text>件</text>
          </block>
          <text wx:else>{{item.actual_pieces}} 件 · 已领 {{item.allocated_pieces}} · 剩 {{item.left_pieces}}</text>
        </view>
        <view wx:if="{{item.materialText}}" class="cr-stock {{item.materialShort ? 'short' : ''}}">{{item.materialText}}</view>
      </block>
      <textarea wx:if="{{run.status === 'running'}}" class="tk-textarea mt-gap" value="{{finishRemark}}" maxlength="500" placeholder="填写开料备注说明（选填）" bindinput="finishRemarkInput" />

      <block wx:if="{{run.status !== 'running'}}">
        <view class="mt-card-title mt-gap">工单备料领用记录</view>
        <view wx:if="{{!run.allocations.length}}" class="mt-muted">暂无工单领用记录；各工单下料工序执行「已备料」时将按件数自动分摊</view>
        <view wx:for="{{run.allocations}}" wx:key="index" class="mt-muted" style="padding: 6rpx 0;"><text class="mono">{{item.work_order_no}}</text> {{item.item_name}} · {{item.unit_qty}} 套 · {{item.pieces}} 件 · 分摊 {{item.labor_minutes}} 分钟 · {{item.date}}</view>
      </block>
    </scroll-view>
    <view class="tk-sheet-foot">
      <button class="mt-btn ghost side" disabled="{{busy}}" bindtap="closePanel">关闭</button>
      <block wx:if="{{run.status === 'running'}}">
        <button wx:if="{{!run.my.timing}}" class="mt-btn ghost side" disabled="{{busy}}" data-action="start" bindtap="timing">{{run.my.joined ? '继续计时' : '参与并计时'}}</button>
        <button wx:else class="mt-btn ghost side" disabled="{{busy}}" data-action="pause" bindtap="timing">暂停计时</button>
        <button class="mt-btn" disabled="{{busy}}" bindtap="finish">切完结束</button>
      </block>
    </view>
    <view wx:if="{{run.status === 'running' && !run.sheet_batches.length}}" class="tk-link mt-gap" style="text-align:center;color:#d81e06" bindtap="cancelRun">作废当前开料批次</view>
  </view>
</view>
<production-dialog id="prodDialog" />
