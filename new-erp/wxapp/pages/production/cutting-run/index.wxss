@import "../cutting/index.wxss";
.cr-need { display: flex; gap: 24rpx; flex-wrap: wrap; font-size: 25rpx; margin-top: 8rpx; color: #475569; }
.cr-need .short { color: #d81e06; font-weight: 700; }
.cr-line { display: flex; align-items: center; gap: 16rpx; font-size: 25rpx; padding: 14rpx 0; border-top: 1rpx dashed #e2e8f0; }
.cr-line .k { flex: 1; min-width: 0; }
.cr-timer { font-size: 46rpx; font-weight: 800; color: #d81e06; margin: 10rpx 0; }
.cr-person { display: flex; justify-content: space-between; font-size: 25rpx; padding: 8rpx 0; }
.cr-person .on { color: #d81e06; font-weight: 700; }
.cr-bom { padding: 18rpx 16rpx; border-bottom: 1rpx solid #f1f5f9; border-radius: 14rpx; }
.cr-bom.on { background: #fff5f5; border: 1rpx solid #fca5a5; }
