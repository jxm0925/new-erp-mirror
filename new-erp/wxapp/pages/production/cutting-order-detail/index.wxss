page {
  background: #f4f6fa;
  color: #0c1839;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 顶部单据状态 Header（优雅白底微暖红调卡片，彻底去除突兀的深墨色） */
.order-hero-card {
  position: relative;
  background: linear-gradient(140deg, #ffffff 0%, #fffbfb 100%);
  border: 1rpx solid #f2dfdc;
  border-radius: 20rpx;
  padding: 24rpx 22rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 22rpx rgba(229, 38, 19, 0.05);
  box-sizing: border-box;
}

.order-hero-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
}

.order-hero-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-type-tag {
  align-self: flex-start;
  font-size: 20rpx;
  font-weight: 700;
  color: #d7190b;
  background: #fff0ef;
  border: 1rpx solid #ffd8d4;
  padding: 2rpx 14rpx;
  border-radius: 6rpx;
  letter-spacing: 0.5rpx;
}

.order-no-wrap {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
}

.order-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #94a3b8;
}

.order-no {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-status-pill {
  flex-shrink: 0;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  color: #c2410c;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  font-size: 24rpx;
  font-weight: 700;
}

/* 通用卡片容器 */
.card {
  background: #ffffff;
  border: 1rpx solid #e8edf4;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(28, 45, 72, 0.045);
  box-sizing: border-box;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #f0f4f8;
  min-width: 0;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.title-mark {
  width: 8rpx;
  height: 30rpx;
  border-radius: 6rpx;
  background: #d7190b;
  flex-shrink: 0;
}

.title-mark.gray {
  background: #7a8ba3;
}

.section-title {
  font-size: 30rpx;
  font-weight: 750;
  color: #0c1839;
}

.count-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #fff1f0;
  color: #d7190b;
}


.header-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #d7190b;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  padding: 8rpx 10rpx;
}

/* 状态徽标 */
.state-pill {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f0f3f8;
  color: #556782;
  font-size: 22rpx;
  font-weight: 600;
}

.state-pill.running {
  background: #edf5ff;
  color: #0870e6;
  border: 1rpx solid #c8e0fd;
}

.state-pill.completed {
  background: #eef9f2;
  color: #0e8c45;
  border: 1rpx solid #c7edd4;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

/* 任务看板与计时仪表板 */
.task-dashboard {
  display: flex;
  gap: 20rpx;
  padding-top: 18rpx;
  align-items: stretch;
  min-width: 0;
}

.task-info-grid {
  flex: 1;
  min-width: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.dashboard-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.dashboard-item.wide {
  grid-column: 1 / -1;
}

.dash-label {
  font-size: 21rpx;
  color: #7d8ea6;
}

.dash-val {
  font-size: 24rpx;
  color: #101d38;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dash-val.bold {
  font-weight: 750;
  color: #0f172a;
}

.dash-val.output-name {
  color: #0f172a;
  font-size: 25rpx;
}

.dash-val.font-num {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #3b4d6b;
}

/* 本人计时卡片 */
.timer-card {
  width: 190rpx;
  border-radius: 16rpx;
  background: #f4f6fa;
  border: 1rpx solid #e2e8f1;
  padding: 16rpx 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.timer-card.active {
  background: linear-gradient(145deg, #fff7f6, #fff0ef);
  border-color: #ffd8d4;
  box-shadow: 0 4rpx 14rpx rgba(229, 38, 19, 0.08);
}

.timer-top {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.timer-title {
  font-size: 21rpx;
  font-weight: 600;
  color: #6a7c95;
}

.timer-card.active .timer-title {
  color: #d7190b;
}

.timer-value {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #0c1839;
  font-family: monospace, sans-serif;
  letter-spacing: 0.5rpx;
}

.timer-card.active .timer-value {
  color: #d7190b;
}

/* 批次物料列表 */
.batch-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-top: 18rpx;
}

.batch-item {
  background: #f8fafc;
  border: 1rpx solid #e4ebf4;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.batch-top {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  min-width: 0;
}

.plate-image {
  width: 96rpx;
  height: 92rpx;
  border-radius: 12rpx;
  background: #edf2f8;
  flex-shrink: 0;
}

.batch-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.batch-no-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  min-width: 0;
}

.batch-tag {
  font-size: 19rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #e9eff8;
  color: #3b5072;
  flex-shrink: 0;
}

.batch-source-no {
  font-size: 26rpx;
  font-weight: 750;
  color: #0f172a;
  overflow-wrap: anywhere;
  word-break: break-all;
  line-height: 1.3;
}

.batch-name {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1e293b;
  overflow-wrap: anywhere;
  word-break: break-all;
  line-height: 1.35;
}

.batch-spec {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
  overflow-wrap: anywhere;
  word-break: break-all;
  line-height: 1.35;
}

.batch-origin {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #94a3b8;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.batch-bottom {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #e4ebf4;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.batch-status-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
}

.batch-status-badge.success {
  color: #0e8c45;
  background: #eef9f2;
}

.batch-status-badge.warning {
  color: #d97706;
  background: #fef3c7;
}

.batch-status-badge.neutral {
  color: #64748b;
  background: #f1f5f9;
}

.batch-action-btn {
  height: 56rpx;
  padding: 0 20rpx;
  margin: 0;
  border-radius: 10rpx;
  font-size: 23rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6rpx;
  line-height: 56rpx;
  flex-shrink: 0;
}

.batch-action-btn::after {
  border: none;
}

.batch-action-btn.primary {
  background: linear-gradient(135deg, #e92312, #d7190b);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(215, 25, 11, 0.22);
}

.batch-action-btn.outline {
  background: #ffffff;
  color: #0870e6;
  border: 1rpx solid #c7dcf7;
}

/* 空批次与添加 */
.empty-batch-zone {
  padding: 44rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-text {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8b9cb0;
}

.empty-add-btn {
  margin-top: 20rpx;
  height: 64rpx;
  padding: 0 32rpx;
  border-radius: 12rpx;
  background: #d7190b;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 64rpx;
  border: none;
}

.empty-add-btn::after {
  border: none;
}

/* 批次分页 */
.batch-pager {
  margin-top: 16rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10rpx;
}

.bpager-btn {
  height: 48rpx;
  padding: 0 18rpx;
  margin: 0;
  border-radius: 8rpx;
  background: #f1f4f8;
  color: #2b3a54;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 48rpx;
  border: none;
}

.bpager-btn::after {
  border: none;
}

.bpager-text {
  font-size: 21rpx;
  color: #6f8097;
}

/* 结果流转管线 Grid */
.pipeline-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-top: 18rpx;
}

.pipeline-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  background: #f8fafc;
  border: 1rpx solid #e3eaf4;
  border-radius: 16rpx;
  transition: all 0.15s ease;
  min-width: 0;
}

.pipeline-hover {
  background: #f0f4f9;
}

.pipeline-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pipeline-icon-wrap.confirm {
  background: #fff0ef;
}

.pipeline-icon-wrap.handover {
  background: #edf5ff;
}

.pipeline-icon-wrap.warehouse {
  background: #eef9f2;
}

.pipeline-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.pipeline-label {
  font-size: 25rpx;
  font-weight: 700;
  color: #0c1839;
}

.pipeline-count {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: #72839b;
}

.pipeline-count .num {
  font-size: 26rpx;
  font-weight: 800;
  color: #d7190b;
}

.pipeline-count .num.blue {
  color: #0870e6;
}

.pipeline-count .num.green {
  color: #0e8c45;
}

.pipeline-tip {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  background: #f3f6fa;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 21rpx;
  color: #73849c;
  line-height: 1.45;
}

/* 生命周期管理与阻断 */
.blocker-box {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.blocker-box.danger {
  background: #fef2f2;
  border-color: #fecaca;
}

.blocker-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #92400e;
  line-height: 1.45;
}

.blocker-box.danger .blocker-text {
  color: #b91c1c;
}

.lifecycle-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.lifecycle-btn {
  flex: 1;
  height: 68rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 68rpx;
  border: none;
}

.lifecycle-btn::after {
  border: none;
}

.lifecycle-btn.close {
  background: #f1f4f9;
  color: #3b4d6b;
}

.lifecycle-btn.cancel {
  background: #fef2f2;
  color: #dc2626;
  border: 1rpx solid #fecaca;
}

/* 底部悬浮吸底操作栏 */
.bottom-placeholder {
  height: 120rpx;
}

.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #ffffff;
  border-top: 1rpx solid #e7edf5;
  box-shadow: 0 -6rpx 20rpx rgba(18, 30, 52, 0.06);
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
}

.primary-btn {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #e92312, #d7190b);
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 750;
  box-shadow: 0 6rpx 18rpx rgba(215, 25, 11, 0.3);
  line-height: 84rpx;
  border: none;
}

.primary-btn::after {
  border: none;
}

.secondary-btn {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #0c1839;
  border: 1rpx solid #cbd5e1;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 82rpx;
}

.secondary-btn::after {
  border: none;
}

/* 全局加载态 */
.loading-state {
  min-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 模态弹窗面板 */
.overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  padding: 34rpx 24rpx;
  box-sizing: border-box;
  background: rgba(10, 20, 36, 0.62);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-panel {
  width: 100%;
  max-height: 92vh;
  padding: 28rpx 22rpx 22rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.2);
}

.modal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-width: 0;
  padding-bottom: 12rpx;
}

.modal-title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 750;
  color: #0c1839;
}

.modal-subtitle {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #7b8b9f;
}

.close-icon-wrap {
  padding: 6rpx;
  flex-shrink: 0;
}

/* 弹窗原料类型 Tabs */
.type-tabs {
  margin-top: 14rpx;
  padding: 6rpx;
  border-radius: 14rpx;
  background: #eef2f7;
  display: flex;
  gap: 8rpx;
}

.type-tab {
  flex: 1;
  height: 64rpx;
  border-radius: 10rpx;
  color: #556782;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
}

.type-tab.active {
  color: #d7190b;
  background: #ffffff;
  font-weight: 750;
  box-shadow: 0 4rpx 10rpx rgba(20, 35, 60, 0.08);
}

/* 搜索栏 */
.modal-search {
  height: 72rpx;
  margin-top: 16rpx;
  padding-left: 18rpx;
  border: 1rpx solid #d8e2ed;
  border-radius: 12rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.search-input {
  min-width: 0;
  margin-left: 12rpx;
  flex: 1;
  font-size: 24rpx;
  color: #0c1839;
}

.modal-search-btn {
  height: 100%;
  padding: 0 26rpx;
  margin: 0;
  background: linear-gradient(135deg, #e92312, #d7190b);
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 10rpx 10rpx 0;
  border: none;
}

.modal-search-btn::after {
  border: none;
}

/* 选料联动主体 */
.picker-body {
  flex: 1 1 520rpx;
  max-height: 50vh;
  min-height: 380rpx;
  margin-top: 16rpx;
  border: 1rpx solid #dfe6ef;
  border-radius: 14rpx;
  display: flex;
  overflow: hidden;
}

.category-list {
  width: 154rpx;
  background: #f6f8fb;
  border-right: 1rpx solid #e7ecf2;
}

.category-item {
  min-height: 72rpx;
  padding: 20rpx 12rpx;
  box-sizing: border-box;
  color: #4b5e7d;
  font-size: 23rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  border-left: 6rpx solid transparent;
}

.category-item.active {
  border-left-color: #d7190b;
  color: #d7190b;
  background: #ffffff;
  font-weight: 750;
}

.category-item.more {
  color: #8c9cb0;
  font-size: 20rpx;
}

.category-name {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.candidate-area {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.candidate-list {
  min-height: 0;
  flex: 1;
}

.candidate-item {
  padding: 16rpx 14rpx;
  border-bottom: 1rpx solid #edf1f6;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.candidate-item.selected {
  background: #fff4f3;
}

.candidate-info {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.candidate-source-no {
  font-size: 24rpx;
  font-weight: 750;
  color: #0c1839;
}

.candidate-name {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #3b4d6a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.candidate-spec {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #72839b;
  overflow-wrap: anywhere;
}

.candidate-avail {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #556782;
}

.check-box {
  width: 38rpx;
  height: 38rpx;
  border: 2rpx solid #b8c4d4;
  border-radius: 50%;
  box-sizing: border-box;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-box.checked {
  background: #d7190b;
  border-color: #d7190b;
}

/* 弹窗分页 */
.modal-pager {
  height: 64rpx;
  border-top: 1rpx solid #e6ecf4;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx;
  box-sizing: border-box;
  background: #fafbfd;
}

.mpager-btn {
  height: 46rpx;
  margin: 0;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: #ffffff;
  border: 1rpx solid #d4deec;
  color: #1e2c48;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 44rpx;
  flex-shrink: 0;
}

.mpager-btn::after {
  border: none;
}

.mpager-text {
  font-size: 20rpx;
  color: #64758e;
}

/* 已选条与步进器 */
.selection-box {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #f4f7fb;
  border: 1rpx solid #e1e8f2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  flex-shrink: 0;
}

.selection-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.selection-text {
  font-size: 23rpx;
  color: #3b4e6c;
  font-weight: 600;
}

.selection-text .highlight {
  color: #d7190b;
  font-weight: 750;
}

.quantity-stepper {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.stepper-label {
  font-size: 22rpx;
  color: #50627d;
}

.stepper-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #cbd7e6;
  border-radius: 8rpx;
  overflow: hidden;
}

.s-btn {
  width: 48rpx;
  height: 48rpx;
  padding: 0;
  margin: 0;
  line-height: 46rpx;
  font-size: 26rpx;
  font-weight: 700;
  background: #f1f4f8;
  color: #263652;
  border: none;
  border-radius: 0;
}

.s-btn::after {
  border: none;
}

.s-input {
  width: 120rpx;
  min-width: 90rpx;
  height: 48rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #0f172a;
  padding: 0 4rpx;
  box-sizing: border-box;
}

/* 已选明细展开列表 */
.selected-list {
  max-height: 200rpx;
  margin-top: 10rpx;
  border: 1rpx solid #e1e8f2;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.selected-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 16rpx;
  border-bottom: 1rpx solid #eef2f7;
  min-width: 0;
}

.selected-row-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.sel-no {
  font-size: 23rpx;
  font-weight: 700;
  color: #0c1839;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sel-name {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #6a7b93;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.remove-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #d7190b;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 10rpx;
  flex-shrink: 0;
}

/* 弹窗底部操作按钮 */
.modal-actions {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: 1fr 1.6fr;
  gap: 16rpx;
  flex-shrink: 0;
}

.modal-cancel-btn {
  height: 76rpx;
  border-radius: 12rpx;
  background: #f1f4f9;
  color: #4b5e7d;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 76rpx;
  border: none;
}

.modal-cancel-btn::after {
  border: none;
}

.modal-confirm-btn {
  height: 76rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #e92312, #d7190b);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 76rpx;
  border: none;
  box-shadow: 0 4rpx 14rpx rgba(215, 25, 11, 0.25);
}

.modal-confirm-btn::after {
  border: none;
}

/* 流转抽屉列表 */
.flow-panel {
  max-height: 80vh;
}

.flow-list {
  flex: 1 1 480rpx;
  max-height: 52vh;
  margin-top: 16rpx;
}

.flow-card {
  padding: 20rpx 18rpx;
  border-bottom: 1rpx solid #eef2f7;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-width: 0;
}

.flow-card:active {
  background: #f8fafc;
}

.flow-card-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.flow-item-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #0c1839;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flow-item-meta {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #6d7f99;
}

/* 响应式断点适配 */
@media (max-width: 360px) {
  .page {
    padding: 16rpx 16rpx calc(48rpx + env(safe-area-inset-bottom));
  }
  .task-dashboard {
    flex-direction: column;
  }
  .timer-card {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    padding: 12rpx 20rpx;
  }
  .timer-value {
    margin-top: 0;
  }
  .plate-image {
    width: 80rpx;
    height: 76rpx;
  }
  .batch-action-btn {
    height: 50rpx;
    padding: 0 14rpx;
    font-size: 21rpx;
    line-height: 50rpx;
  }
}

@media (min-width: 431px) {
  .page {
    max-width: 860rpx;
    margin: 0 auto;
  }
  .bottom-action-bar {
    max-width: 860rpx;
    left: 50%;
    transform: translateX(-50%);
  }
  .modal-panel {
    max-width: 810rpx;
  }
}

