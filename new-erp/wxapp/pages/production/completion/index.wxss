page { background: #f7f8fa; color: #1f2329; }
.page { padding: 18rpx 18rpx 44rpx; }
.card { background: #fff; border: 1rpx solid #e5e6eb; border-radius: 14rpx; padding: 22rpx; margin-bottom: 16rpx; box-sizing: border-box; }
.product-card { display: flex; flex-wrap: wrap; gap: 20rpx; }
.product-image { width: 196rpx; height: 148rpx; flex: 0 0 196rpx; }
.product-main { flex: 1; min-width: 0; }.product-main.full { padding: 10rpx 0 6rpx; }
.product-name { font-size: 34rpx; line-height: 1.35; font-weight: 700; }
.custom-tag { display: inline-block; margin-top: 16rpx; padding: 5rpx 10rpx; color: #d81e06; border: 1rpx solid #f53f3f; border-radius: 6rpx; font-size: 22rpx; }
.product-spec { color: #646a73; margin-top: 15rpx; font-size: 24rpx; }
.order-lines { width: 100%; padding: 6rpx 10rpx 14rpx; border-bottom: 1rpx solid #e5e6eb; }
.order-lines view { display: flex; gap: 28rpx; margin-top: 10rpx; color: #4e5969; font-size: 24rpx; }.order-lines view text:first-child { width: 88rpx; }
.metrics { width: 100%; display: flex; padding-top: 8rpx; }
.metrics view { flex: 1; text-align: center; border-right: 1rpx solid #e5e6eb; }.metrics view:last-child { border-right: 0; }
.metrics text { display: block; color: #4e5969; font-size: 22rpx; }.metrics strong { font-size: 42rpx; margin-top: 12rpx; }.metrics small { margin-left: 8rpx; font-size: 22rpx; }
.card-title { display: flex; align-items: center; justify-content: space-between; font-size: 29rpx; font-weight: 700; padding-bottom: 16rpx; border-bottom: 1rpx solid #e5e6eb; }
.card-title small { color: #646a73; font-size: 22rpx; font-weight: 400; }.pass-count { color: #00b42a; font-size: 24rpx; font-weight: 500; }.pass-count.blocked { color: #f53f3f; }
.check-row { min-height: 68rpx; display: flex; align-items: center; border-bottom: 1rpx solid #f2f3f5; }.check-row:last-child { border-bottom: 0; }
.check-icon { width: 36rpx; height: 36rpx; line-height: 36rpx; text-align: center; border-radius: 50%; color: #fff; background: #00b42a; font-weight: 700; }.check-icon.blocked { background: #f53f3f; }
.check-label { flex: 1; margin-left: 16rpx; font-size: 25rpx; }.check-result { color: #00b42a; background: #e8ffea; border-radius: 5rpx; padding: 4rpx 9rpx; font-size: 21rpx; }.check-result.blocked { color: #f53f3f; background: #ffece8; }
.completion-card>.card-title { justify-content: flex-start; }
.form-row { min-height: 76rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #e5e6eb; font-size: 25rpx; }.form-row:last-child { border-bottom: 0; }
.required { color: #f53f3f; margin-left: 8rpx; }.row-value { font-size: 28rpx; color: #1f2329; }
.counter { display: flex; align-items: center; height: 62rpx; border: 1rpx solid #dcdfe6; border-radius: 7rpx; overflow: hidden; }
.counter button { width: 58rpx; height: 62rpx; line-height: 58rpx; margin: 0; padding: 0; border-radius: 0; background: #fff; font-size: 34rpx; }.counter button::after { border: 0; }.counter .minus { border-right: 1rpx solid #dcdfe6; }.counter button:last-child { border-left: 1rpx solid #dcdfe6; }
.counter view { min-width: 124rpx; text-align: center; }.counter strong { font-size: 29rpx; }.counter small { margin-left: 10rpx; font-size: 22rpx; }
.input-row input { text-align: right; flex: 1; margin-left: 24rpx; font-size: 24rpx; }
.key-note>.card-title { justify-content: flex-start; border: 0; padding-bottom: 10rpx; }.info-icon { margin-left: 10rpx; width: 28rpx; height: 28rpx; border: 2rpx solid #86909c; border-radius: 50%; text-align: center; line-height: 28rpx; color: #86909c; font-size: 20rpx; }
.key-note>text { color: #4e5969; font-size: 23rpx; line-height: 1.7; }
.submit-btn { height: 88rpx; line-height: 88rpx; background: #d81e06; color: #fff; border-radius: 10rpx; font-size: 30rpx; font-weight: 700; }.submit-btn[disabled] { background: #c9cdd4; color: #fff; }.submit-btn::after { border: 0; }
.rules { padding: 18rpx 10rpx 0; color: #646a73; font-size: 22rpx; line-height: 1.8; }.rules text { display: block; }.rules text:first-child { color: #1f2329; margin-bottom: 4rpx; }
.loading { min-height: 70vh; display: flex; align-items: center; justify-content: center; color: #86909c; }
.overlay { position: fixed; inset: 0; z-index: 999; display: flex; align-items: flex-end; background: rgba(0,0,0,.64); }
.sheet { width: 100%; box-sizing: border-box; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 16rpx 38rpx calc(30rpx + env(safe-area-inset-bottom)); }
.handle { width: 76rpx; height: 8rpx; border-radius: 8rpx; background: #c9cdd4; margin: 0 auto 28rpx; }.sheet-title { text-align: center; font-size: 34rpx; font-weight: 700; margin-bottom: 20rpx; }
.confirm-row { min-height: 70rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #e5e6eb; font-size: 25rpx; }.confirm-row text:last-child { max-width: 65%; text-align: right; }
.warning { margin: 22rpx 0; padding: 20rpx; border-radius: 9rpx; color: #ff7d00; background: #fff7e8; font-size: 23rpx; line-height: 1.55; }
.sheet-actions { display: flex; gap: 20rpx; }.sheet-actions button { flex: 1; height: 84rpx; line-height: 84rpx; background: #fff; border: 1rpx solid #c9cdd4; font-size: 28rpx; }.sheet-actions .confirm-btn { color: #fff; background: #d81e06; border-color: #d81e06; }.sheet-actions button::after { border: 0; }
