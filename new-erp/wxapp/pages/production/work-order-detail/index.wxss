page {
  background-color: #f5f6f8;
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "PingFang SC", "Hiragino Sans GB", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  box-sizing: border-box;
}

view, text, image {
  box-sizing: border-box;
}

.font-num {
  font-family: "DIN Alternate", -apple-system, "SF Pro Display", "Helvetica Neue", "PingFang SC", sans-serif;
  font-feature-settings: "tnum";
  font-variant-numeric: tabular-nums;
  -webkit-font-smoothing: antialiased;
}

.font-bold {
  font-weight: 700;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* Card Base */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin: 16rpx 24rpx 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  border: 1rpx solid #f0f2f5;
  min-width: 0;
}

/* Product Card */
.product-card {
  margin-top: 16rpx;
  padding: 24rpx 24rpx 20rpx;
}

/* Integrated Crumb Navigation inside Card */
.crumb-nav {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #8c93a0;
  white-space: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  min-width: 0;
  width: 100%;
}

.crumb-nav::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.crumb-link {
  color: #8c93a0;
  white-space: nowrap;
  flex-shrink: 0;
  cursor: pointer;
  font-size: 24rpx;
}

.crumb-link:active {
  color: #d81e06;
}

.crumb-sep {
  margin: 0 10rpx;
  color: #c0c4cc;
  flex-shrink: 0;
  font-size: 22rpx;
}

.crumb-active {
  color: #1f2329;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
  font-size: 24rpx;
}

.product-top {
  display: flex;
  align-items: center;
  min-width: 0;
}

.product-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background-color: #f7f8fa;
  border: 1rpx solid #ebeef5;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.product-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.35;
}

.product-spec, .product-qty {
  font-size: 26rpx;
  color: #606266;
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-divider {
  height: 1rpx;
  background-color: #f2f3f5;
  margin: 22rpx 0 18rpx;
  width: 100%;
}

/* 6 Metrics Grid with vertical dividers */
.metrics-grid {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.metric-col {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.col-divider {
  width: 1rpx;
  height: 48rpx;
  background-color: #f0f2f5;
  flex-shrink: 0;
  margin: 0 2rpx;
}

.metric-label {
  font-size: 22rpx;
  color: #909399;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.metric-val {
  font-size: 30rpx;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.val-num {
  font-size: 34rpx;
  font-weight: 700;
}

.val-unit {
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 2rpx;
}

.text-dark { color: #1f2329; }
.text-green { color: #00a870; }
.text-blue { color: #1989fa; }
.text-orange { color: #ff976a; }
.text-red { color: #ee0a24; }
.text-placeholder { color: #c0c4cc; }

/* Section Bar */
.section-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 28rpx 14rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}

.count-num {
  font-weight: 600;
  color: #606266;
  margin-left: 6rpx;
}

.filter-action {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #1f2329;
  cursor: pointer;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.filter-active {
  color: #d81e06;
  font-weight: 600;
}

.filter-text {
  margin-left: 8rpx;
}

/* PU Card */
.pu-list {
  min-width: 0;
}

.pu-card {
  padding: 24rpx;
  margin-bottom: 18rpx;
  transition: background-color 0.15s ease;
}

.pu-card:active {
  background-color: #fafbfc;
}

.pu-row-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-width: 0;
}

.pu-identity {
  display: flex;
  align-items: center;
  min-width: 0;
}

.pu-code {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
  margin-right: 14rpx;
  flex-shrink: 0;
  letter-spacing: 0.5rpx;
}

.pu-link {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #909399;
  flex-shrink: 0;
  padding: 4rpx;
}

.pu-link text {
  margin-right: 4rpx;
}

/* Status Pill */
.status-pill {
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  display: inline-block;
  line-height: 1.4;
}

.pill-green {
  background-color: #e8f8f0;
  color: #00a870;
}

.pill-orange {
  background-color: #fef3e6;
  color: #f59a23;
}

.pill-gray {
  background-color: #f0f2f5;
  color: #8c939d;
}

.pill-blue {
  background-color: #e8f4ff;
  color: #1989fa;
}

.pill-red {
  background-color: #ffebeb;
  color: #ee0a24;
}

/* Operation Row */
.pu-op-row {
  margin-top: 18rpx;
  display: flex;
  align-items: baseline;
  font-size: 26rpx;
  min-width: 0;
}

.pu-label {
  color: #909399;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.pu-op-name {
  color: #1f2329;
  font-weight: 700;
  font-size: 28rpx;
  margin-right: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pu-op-seq {
  color: #606266;
  font-size: 26rpx;
  flex-shrink: 0;
}

/* PU Meta 3 Columns Grid */
.pu-meta-grid {
  display: flex;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f7f8fa;
  align-items: flex-start;
  width: 100%;
}

.meta-col {
  min-width: 0;
}

.meta-col:first-child {
  flex: 1.3;
}

.meta-col:nth-child(2) {
  flex: 0.85;
  padding-left: 10rpx;
}

.meta-col:nth-child(3) {
  flex: 0.95;
  padding-left: 10rpx;
}

.col-label {
  font-size: 24rpx;
  color: #909399;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.col-val {
  min-height: 40rpx;
  display: flex;
  align-items: center;
}

.pt-code {
  font-size: 24rpx;
  font-weight: 700;
  color: #1f2329;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: -0.3rpx;
}

/* Badges */
.tag-badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-weight: 500;
  line-height: 1.35;
  display: inline-block;
  white-space: nowrap;
  flex-shrink: 0;
}

.badge-green {
  background-color: #e8f8f0;
  color: #00a870;
}

.badge-red {
  background-color: #ffebeb;
  color: #ee0a24;
}

.badge-blue {
  background-color: #e8f4ff;
  color: #1989fa;
}

.badge-orange {
  background-color: #fef3e6;
  color: #f59a23;
}

.badge-gray {
  background-color: #f0f2f5;
  color: #8c939d;
}

/* Loading & Empty */
.loading-state, .empty-state {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #909399;
  font-size: 28rpx;
}

/* Filter Modal Sheet */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.modal-sheet {
  background-color: #ffffff;
  width: 100%;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 30rpx 28rpx 50rpx;
  box-sizing: border-box;
}

.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}

.sheet-close {
  padding: 8rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-chip {
  padding: 14rpx 32rpx;
  border-radius: 36rpx;
  background-color: #f2f3f5;
  color: #606266;
  font-size: 26rpx;
  border: 1rpx solid transparent;
}

/* Brand Red Active Chip */
.filter-chip-active {
  background-color: #fff0f0;
  color: #d81e06;
  font-weight: 600;
  border-color: #d81e06;
}

/* Extra small screen adaptations (<= 360px) */
@media screen and (max-width: 360px) {
  .metric-label {
    font-size: 20rpx;
  }
  .val-num {
    font-size: 28rpx;
  }
  .pu-code {
    font-size: 30rpx;
  }
  .col-label {
    font-size: 22rpx;
  }
}
