page { background: #f4f6f8; color: #161b29; font-size: 28rpx; }
view, text, button { box-sizing: border-box; min-width: 0; }
.detail-page { width: 100%; max-width: 600px; margin: 0 auto; padding: 20rpx 20rpx calc(36rpx + env(safe-area-inset-bottom)); }
.card { background: #fff; border: 1rpx solid #edf0f4; border-radius: 18rpx; padding: 28rpx; margin-bottom: 20rpx; }
.heading { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.document-no { flex: 1; font-size: 34rpx; overflow-wrap: anywhere; }.product-name { display: block; font-size: 32rpx; margin-top: 22rpx; overflow-wrap: anywhere; }
.badge { display: inline-block; background: #f1f3f6; border-radius: 8rpx; padding: 6rpx 15rpx; font-size: 25rpx; font-weight: 600; flex-shrink: 0; }
.badge.red { background: #ffe9e9; }.badge.green { background: #e6f7e6; }.badge.blue { background: #e5f2ff; }.badge.orange { background: #fff0de; }
.red { color: #e31912; }.green { color: #089b37; }.blue { color: #1268e6; }.orange { color: #f07813; }.gray,.muted { color: #768096; }
.source-line { display: flex; flex-wrap: wrap; gap: 12rpx; justify-content: space-between; margin-top: 24rpx; color: #768096; font-size: 25rpx; overflow-wrap: anywhere; }
.link { color: #e31912; flex-shrink: 0; font-weight: 500; }.push { margin-left: auto; }
.meta { display: flex; align-items: baseline; flex-wrap: wrap; gap: 14rpx; margin-top: 22rpx; line-height: 1.6; overflow-wrap: anywhere; }.meta > text:first-child { color: #768096; flex-shrink: 0; }
.metrics { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); padding-top: 26rpx; margin-top: 26rpx; border-top: 1rpx solid #edf0f4; }
.metrics > view { text-align: center; border-right: 1rpx solid #edf0f4; padding: 0 4rpx; }.metrics > view:last-child { border: 0; }.metrics .muted { font-size: 23rpx; }
.metric-value { margin-top: 12rpx; overflow-wrap: anywhere; line-height: 1.4; }.metric-value strong { font-size: 34rpx; }.metric-value text { font-size: 23rpx; margin-left: 3rpx; }
.section-title { margin: 32rpx 10rpx 22rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }.section-title strong { font-size: 34rpx; }.section-title > text { font-size: 27rpx; }
.unit-no { font-size: 34rpx; flex: 1; overflow-wrap: anywhere; }.task-no { overflow-wrap: anywhere; flex: 1; }.conditions { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); border-top: 1rpx solid #edf0f4; margin-top: 26rpx; padding-top: 24rpx; }.conditions > view { display: flex; flex-direction: column; gap: 12rpx; align-items: flex-start; }.conditions > view + view { border-left: 1rpx solid #edf0f4; padding-left: 26rpx; }.conditions .muted { font-size: 26rpx; }
.sequence { font-size: 42rpx; }.op-name { flex: 1; overflow-wrap: anywhere; font-size: 32rpx; }.op-metrics { grid-template-columns: repeat(4,minmax(0,1fr)); border-top: 0; padding-top: 0; }.task-line { border-top: 1rpx solid #edf0f4; padding-top: 20rpx; }
button { border-radius: 12rpx; font-size: 29rpx; padding: 0 16rpx; }button::after { border: 0; }.primary { color: white; background: #ed160a; }.outline { color: #e31912; background: white; border: 2rpx solid #e31912; }
.actions { display: flex; gap: 18rpx; margin: 26rpx 10rpx 0; }.actions button { flex: 1; margin: 0; }.state { min-height: 340rpx; padding: 40rpx 24rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22rpx; text-align: center; }.state > text { color: #768096; }.state button { align-self: stretch; margin: 0; }.state.compact { min-height: 0; padding: 22rpx; }.permission { background: #edf1f5; }
.draft-banner { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; background: #fff1df; color: #9d531c; margin: -10rpx -10rpx 20rpx; padding: 12rpx 18rpx; border-radius: 10rpx; }.small { margin: 0; font-size: 25rpx; line-height: 52rpx; }
@media (max-width: 360px) { .card { padding: 22rpx; }.heading { gap: 12rpx; }.document-no,.unit-no { font-size: 31rpx; }.badge { padding: 6rpx 10rpx; font-size: 23rpx; }.metrics .muted { font-size: 22rpx; }.metric-value strong { font-size: 30rpx; }.meta { gap: 10rpx; font-size: 26rpx; }.link { font-size: 25rpx; } }
.filter-mask { position: fixed; inset: 0; z-index: 1000; padding: 36rpx; background: rgba(0,0,0,.45); display: flex; align-items: center; justify-content: center; }.filter-dialog { background: white; padding: 28rpx; border-radius: 18rpx; width: 100%; max-width: 500px; max-height: 85vh; overflow-y: auto; }.filter-choice { padding: 22rpx; border-bottom: 1rpx solid #eef0f4; }.filter-choice.chosen { color: #e31912; background: #fff0ee; }.filter-dialog button { margin-top: 18rpx; }
