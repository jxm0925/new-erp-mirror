<view class="detail-page">
  <view wx:if="{{loading}}" class="state"><van-loading color="#e31912">加载中</van-loading></view>
  <view wx:elif="{{error}}" class="card state"><van-icon name="{{errorCode==='forbidden'?'lock':(errorCode==='not_found'?'warning-o':'info-o')}}" size="64rpx" color="#e31912" /><strong>{{errorTitle}}</strong><text>{{error}}</text><button class="primary" wx:if="{{errorCode==='load'}}" bindtap="load">重新加载</button><button class="primary" wx:else bindtap="backToList">返回工单列表</button></view>
  <block wx:elif="{{workOrder}}">
    <view class="card summary">
      <view class="draft-banner" wx:if="{{workOrder.status==='DRAFT' || workOrder.status==='WAIT_RELEASE'}}"><text>{{workOrder.statusLabel}}</text></view>
      <view class="heading"><strong class="document-no">{{workOrder.work_order_no}}</strong><text class="badge {{workOrder.source_type==='sales_order'?'red':'blue'}}">{{workOrder.sourceLabel}}</text></view>
      <strong class="product-name">{{workOrder.productName}}</strong>
      <view class="source-line" wx:if="{{workOrder.sourceNo}}"><text>来源单据：{{workOrder.sourceNo}}</text><text class="link" wx:if="{{masterId && actions.view_master_order}}" bindtap="openMaster">销售生产总览 ›</text></view>
      <view class="meta" wx:if="{{mode==='quantity'}}"><text>生产方式</text><text>按数量生产</text></view>
      <view class="meta" wx:if="{{mode==='quantity'}}"><text>加工终点</text><text>{{workOrder.endpoint}}</text></view>
      <block wx:if="{{workOrder.stocking_purpose==='reserved_for_work_order'}}"><view class="meta"><text>目标工单</text><text>{{workOrder.reserved_target.work_order_no || '无权查看目标工单'}}</text></view><view class="meta" wx:if="{{workOrder.reserved_for_production_unit_id}}"><text>生产单元</text><text>{{workOrder.reserved_target.unit_no || '—'}}</text></view><view class="meta"><text>接收工序</text><text>{{workOrder.reserved_target.operation_name || '—'}}</text></view></block>
      <view class="metrics"><view wx:for="{{metrics}}" wx:key="label"><text class="muted">{{item.label}}</text><view class="metric-value {{item.color}}"><strong>{{item.value}}</strong><text>{{item.unit}}</text></view></view></view>
    </view>
    <view class="section-title"><strong>{{mode==='unit'?'生产单元':'工序进度'}}{{mode==='unit' && !rowsForbidden?'（'+rowTotal+'）':''}}</strong><text wx:if="{{!rowsForbidden}}" bindtap="openFilterPicker"><van-icon name="filter-o" /> {{activeFilterLabel || '筛选'}}</text></view>
    <view wx:if="{{rowsForbidden}}" class="card state permission"><van-icon name="lock" size="52rpx" /><strong>无权查看{{mode==='unit'?'生产单元':'工序进度'}}</strong><text>请联系管理员</text></view>
    <view wx:elif="{{!rowsLoading && !rowsError && !rows.length}}" class="card state"><text>暂无{{currentFilter?'符合条件的':''}}{{mode==='unit'?'生产单元':'工序记录'}}</text></view>
    <block wx:if="{{mode==='unit'}}">
      <view class="card execution-card" wx:for="{{rows}}" wx:key="id">
        <view class="heading"><strong class="unit-no">{{item.unit_no}}</strong><text class="badge {{item.tone}}">{{item.statusLabel}}</text><text class="link push" data-id="{{item.id}}" bindtap="openUnit">查看单元 ›</text></view>
        <view class="meta"><text>当前工序</text><strong>{{item.operationName}}</strong><text class="muted">{{item.sequenceText}}</text></view>
        <view class="meta"><text>当前工序任务</text><text class="task-no">{{item.taskNo}}</text><text wx:if="{{item.canViewTask}}" class="link push" data-id="{{item.id}}" bindtap="openTask">查看任务 ›</text></view>
        <view class="conditions"><view><text class="muted">物料齐套</text><text class="badge {{item.kittingTone}}">{{item.kittingLabel}}</text></view><view><text class="muted">前序交接</text><text class="badge {{item.handoverTone}}">{{item.handoverLabel}}</text></view></view>
      </view>
    </block>
    <block wx:else>
      <view class="card execution-card" wx:for="{{rows}}" wx:key="id">
        <view class="heading"><strong class="sequence">{{item.sequence}}</strong><strong class="op-name">{{item.operation_name}}</strong><text class="badge push {{item.tone}}">{{item.statusLabel}}</text></view>
        <view class="metrics op-metrics"><view><text class="muted">计划数量</text><view class="metric-value"><strong>{{item.planned}}</strong><text>{{item.unit}}</text></view></view><view><text class="muted">完成数量</text><view class="metric-value green"><strong>{{item.completed}}</strong><text>{{item.unit}}</text></view></view><view><text class="muted">不合格</text><view class="metric-value red"><strong>{{item.unqualified}}</strong><text>{{item.unit}}</text></view></view><view><text class="muted">报废</text><view class="metric-value red"><strong>{{item.scrapped}}</strong><text>{{item.unit}}</text></view></view></view>
        <view class="meta task-line"><text>当前工序任务</text><text class="task-no">{{item.taskNo}}</text><text wx:if="{{item.canViewTask}}" class="link push" data-id="{{item.id}}" bindtap="openTask">查看任务 ›</text></view>
      </view>
    </block>
    <view class="state compact" wx:if="{{rowsLoading}}"><van-loading color="#e31912">加载中</van-loading></view>
    <view class="state compact" wx:if="{{rowsError && !rowsForbidden}}" bindtap="retryRows">{{rowsError}} · 点击重试</view>
    <view class="actions"><button wx:if="{{actions.view_materials}}" class="outline" bindtap="openMaterials">查看物料</button><button wx:if="{{actions.view_tasks}}" class="primary" bindtap="openTasks">查看工序任务</button></view>
  </block>
</view>
<view wx:if="{{showFilter}}" class="filter-mask" catchtap="closeFilter" catchtouchmove="noop"><view class="filter-dialog" catchtap="noop"><strong>筛选状态</strong><view class="filter-choice {{currentFilter===item.key?'chosen':''}}" wx:for="{{filterOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="applyFilter">{{item.label}}</view><button bindtap="closeFilter">取消</button></view></view>
