@import "../shared.wxss";

.tk-v2-page {
  position: relative;
  overflow-x: hidden;
  padding-top: 16rpx;
}

.tk-top-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 136rpx;
  background: linear-gradient(180deg, #d81e06 0%, #ef1008 100%);
  border-radius: 0 0 38rpx 38rpx;
  z-index: 0;
  pointer-events: none;
}

/* ==================== 1. 工单与销售订单关联主卡 ==================== */
.tk-main-card {
  position: relative;
  z-index: 1;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx 24rpx 20rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
  border: 1rpx solid rgba(15, 23, 42, 0.05);
}

.tk-mc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.tk-mc-head-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
}

.tk-mc-wo-no {
  font-size: 25rpx;
  font-weight: 800;
  color: #334155;
  letter-spacing: 0.3rpx;
}

.tk-mc-detail-btn {
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 700;
  color: #475569;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.tk-mc-hero {
  padding-top: 16rpx;
}

.tk-mc-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 14rpx;
  flex-wrap: wrap;
}

.tk-mc-title {
  font-size: 33rpx;
  font-weight: 900;
  color: #1f2329;
  line-height: 1.35;
  flex: 1;
  min-width: 0;
}

.tk-mc-qty {
  font-size: 32rpx;
  color: #d81e06;
  font-weight: 900;
  flex-shrink: 0;
}

.tk-mc-spec {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
  line-height: 1.4;
}

/* 结构化 2×2 关联信息网格（清爽冷静灰底，取代拥挤粉框） */
.tk-meta-box {
  margin-top: 18rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 18rpx;
  overflow: hidden;
}

.tk-meta-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  padding: 14rpx 18rpx;
  gap: 12rpx 20rpx;
}

.tk-meta-cell {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.tk-meta-lbl {
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 600;
  flex-shrink: 0;
}

.tk-meta-val {
  font-size: 23rpx;
  font-weight: 700;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.tk-meta-val.is-so {
  color: #1e40af;
}

.tk-meta-val.is-muted {
  color: #64748b;
  font-weight: 600;
}

.tk-meta-parent {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx 18rpx;
  background: #f1f5f9;
  border-top: 1rpx solid #e2e8f0;
}

.tk-meta-parent-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.tk-meta-parent-tag {
  font-size: 20rpx;
  font-weight: 800;
  color: #b45309;
  background: #fef3c7;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.tk-meta-parent-name {
  font-size: 23rpx;
  font-weight: 700;
  color: #334155;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tk-meta-parent-no {
  font-size: 21rpx;
  color: #64748b;
  flex-shrink: 0;
}

.tk-meta-parent-link {
  font-size: 22rpx;
  font-weight: 700;
  color: #d81e06;
  flex-shrink: 0;
}

.tk-mini-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  background: #f1f5f9;
  color: #475569;
  white-space: nowrap;
  flex-shrink: 0;
  line-height: 1.3;
}
.tk-mini-tag.green {
  background: #ecfdf5;
  color: #059669;
  border: 1rpx solid #a7f3d0;
}
.tk-mini-tag.amber {
  background: #fffbeb;
  color: #b45309;
  border: 1rpx solid #fde68a;
}
.tk-mini-tag.red {
  background: #fff1f0;
  color: #d81e06;
  border: 1rpx solid #fecaca;
}
.tk-mini-tag.blue {
  background: #eff6ff;
  color: #1d4ed8;
  border: 1rpx solid #bfdbfe;
}

/* 4 列核心进度指标栏（严格基线对齐） */
.tk-kpi-bar {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  align-items: center;
}

.tk-kpi-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-right: 1rpx solid #f1f5f9;
  padding: 0 6rpx;
}
.tk-kpi-cell:last-child {
  border-right: 0;
}

.tk-kpi-val {
  height: 40rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 900;
  color: #1f2329;
  line-height: 1;
}
.tk-kpi-val.red {
  color: #d81e06;
}
.tk-kpi-val.warn {
  font-size: 26rpx;
  color: #d81e06;
  text-decoration: underline;
  text-underline-offset: 4rpx;
  align-items: center;
}
.tk-kpi-val.ok {
  font-size: 26rpx;
  color: #059669;
  align-items: center;
}

.tk-kpi-unit {
  font-size: 22rpx;
  font-weight: 700;
  color: #64748b;
  margin-left: 4rpx;
}

.tk-kpi-lbl {
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 600;
  margin-top: 8rpx;
  line-height: 1.2;
}

/* ==================== 2. 作业工时与协同人员控制台 ==================== */
.tk-timer-v2 {
  position: relative;
  z-index: 1;
  background: #ffffff;
  border-radius: 26rpx;
  padding: 24rpx 24rpx 20rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(15, 23, 42, 0.05);
}

.tk-timer-v2.on {
  border-color: rgba(216, 30, 6, 0.25);
  background: linear-gradient(180deg, #fffafa 0%, #ffffff 100%);
}

.tk-tv2-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.tk-tv2-left {
  flex: 1;
  min-width: 0;
}

.tk-tv2-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tk-pulse-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #cbd5e1;
}
.tk-pulse-dot.on {
  background: #10b981;
  box-shadow: 0 0 0 6rpx rgba(16, 185, 129, 0.16);
}

.tk-tv2-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #64748b;
}

.tk-tv2-clock {
  font-size: 56rpx;
  font-weight: 900;
  color: #1f2329;
  letter-spacing: 2rpx;
  line-height: 1.15;
  margin-top: 6rpx;
}
.tk-timer-v2.on .tk-tv2-clock {
  color: #d81e06;
}

.tk-tv2-btns {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.tk-tv2-unit-bar {
  margin-top: 14rpx;
  padding: 10rpx 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.tk-tv2-unit-lbl {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 600;
  flex-shrink: 0;
}

.tk-tv2-unit-val {
  font-size: 23rpx;
  font-weight: 800;
  color: #334155;
  word-break: break-all;
}

.tk-tv2-foot {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 23rpx;
  color: #64748b;
}

.tk-tv2-foot-left {
  flex: 1;
  min-width: 0;
  line-height: 1.45;
  word-break: break-all;
}

.tk-tv2-foot-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.tk-tv2-owner {
  color: #1f2329;
  font-weight: 800;
}

/* ==================== 3. 工作区三栏分段 Tab 切换器 ==================== */
.tk-seg-tabs {
  display: flex;
  background: #e2e8f0;
  padding: 8rpx;
  border-radius: 22rpx;
  gap: 8rpx;
  margin-bottom: 18rpx;
}

.tk-seg-item {
  flex: 1;
  height: 68rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #475569;
}

.tk-seg-item.active {
  background: #ffffff;
  color: #d81e06;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

.tk-seg-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
  background: rgba(15, 23, 42, 0.08);
  color: #475569;
  white-space: nowrap;
}
.tk-seg-item.active .tk-seg-badge {
  background: #fff1f0;
  color: #d81e06;
}
.tk-seg-badge.warn {
  background: #d81e06 !important;
  color: #ffffff !important;
}

/* ==================== 单件选择与卡片底栏流转提示 ==================== */
.tk-unit-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tk-tool-pill {
  font-size: 23rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  color: #475569;
  border: 1rpx solid #e2e8f0;
}
.tk-tool-pill.red {
  background: #fff5f5;
  color: #d81e06;
  border-color: #fecaca;
}

.tk-unit-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  border: 2rpx solid #e2e8f0;
  background: #f8fafc;
  margin-bottom: 14rpx;
}
.tk-unit-row:last-of-type {
  margin-bottom: 0;
}
.tk-unit-row.selected {
  background: #fff5f5;
  border-color: #fca5a5;
}
.tk-unit-row.off {
  opacity: 0.55;
}

.tk-unit-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tk-unit-sub {
  font-size: 22rpx;
  color: #64748b;
}

.tk-card-foot-bar {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed #e2e8f0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 23rpx;
  color: #64748b;
  line-height: 1.45;
}

.tk-cfb-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tk-flow-highlight {
  color: #d97706;
  font-weight: 800;
}

.tk-cfb-warn {
  color: #d81e06;
  font-weight: 700;
}

/* ==================== 一体化开料作业卡与内联缺料提醒栏 ==================== */
.tk-cutting-pill {
  font-size: 22rpx;
  font-weight: 700;
  color: #475569;
  background: #f1f5f9;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.tk-cutting-status {
  font-size: 25rpx;
  font-weight: 700;
  color: #059669;
  background: #ecfdf5;
  border: 1rpx solid #a7f3d0;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
}

.tk-cutting-desc {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.tk-cutting-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
}

.tk-cut-btn {
  flex: 1;
  height: 68rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tk-cut-btn.primary {
  background: #fff5f5;
  color: #d81e06;
  border: 2rpx solid #fca5a5;
}

.tk-cut-btn.ghost {
  background: #f8fafc;
  color: #334155;
  border: 2rpx solid #e2e8f0;
}

.tk-mat-inline-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  background: #ffffff;
  border: 1rpx solid #fecaca;
  border-radius: 22rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.04);
}

.tk-mq-stats {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.4;
}

.tk-mq-btn {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 800;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #fff1f0;
  color: #d81e06;
  border: 1rpx solid #fecaca;
}

/* ==================== 本道用料结构化表格 ==================== */
.tk-mat-table {
  border: 1rpx solid #e2e8f0;
  border-radius: 18rpx;
  overflow: hidden;
  background: #ffffff;
}

.tk-mt-item-wrap {
  border-bottom: 1rpx solid #e2e8f0;
}
.tk-mt-item-wrap:last-child {
  border-bottom: 0;
}

.tk-mt-tr {
  display: flex;
  align-items: center;
  padding: 16rpx 16rpx;
  border-bottom: 1rpx solid #f1f5f9;
  font-size: 24rpx;
  color: #1f2329;
}
.tk-mt-tr:last-child {
  border-bottom: 0;
}

.tk-mt-th {
  background: #f8fafc;
  border-bottom: 1rpx solid #e2e8f0;
  font-size: 22rpx;
  font-weight: 800;
  color: #475569;
  padding: 14rpx 16rpx;
}

.tk-mt-td {
  box-sizing: border-box;
  word-break: break-all;
  line-height: 1.4;
}

.tk-mt-td.col-name {
  width: 36%;
  padding-right: 10rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tk-mt-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.tk-mt-name {
  font-weight: 800;
  color: #1f2329;
  font-size: 25rpx;
}

.tk-mt-code {
  font-size: 20rpx;
  color: #94a3b8;
}

.tk-mt-remark {
  font-size: 20rpx;
  color: #b45309;
}

.tk-mt-td.col-spec {
  width: 28%;
  padding-right: 10rpx;
  font-size: 22rpx;
  color: #64748b;
}

.tk-mt-stock {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 2rpx;
}

.tk-mt-td.col-req {
  width: 18%;
  text-align: right;
  padding-right: 8rpx;
  font-size: 23rpx;
  font-weight: 700;
  color: #334155;
}

.tk-mt-unit {
  font-size: 20rpx;
  color: #94a3b8;
  margin-left: 2rpx;
}

.tk-mt-td.col-state {
  width: 18%;
  text-align: right;
  flex-shrink: 0;
}

.tk-state-pill {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 800;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  white-space: nowrap;
}
.tk-state-pill.short {
  background: #fff1f0;
  color: #d81e06;
  border: 1rpx solid #fecaca;
}
.tk-state-pill.ok {
  background: #ecfdf5;
  color: #059669;
  border: 1rpx solid #a7f3d0;
}

.tk-mt-action-bar {
  padding: 12rpx 16rpx;
  background: #fff8f6;
  border-top: 1rpx dashed #fee2e2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.tk-mt-action-hint {
  font-size: 21rpx;
  color: #94a3b8;
}

.tk-mt-order-pill {
  font-size: 22rpx;
  font-weight: 800;
  color: #d81e06;
  background: #ffffff;
  border: 1rpx solid #fca5a5;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

/* ==================== 既有通用样式与弹窗样式（完整保留） ==================== */
.wo-hero-badges {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.tk-timer-card {
  background: #ffffff;
  border-radius: 26rpx;
  padding: 26rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.tk-timer-card.on {
  border-color: rgba(216, 30, 6, 0.25);
  background: linear-gradient(180deg, #fffafa 0%, #ffffff 100%);
}

.tk-timer-left {
  flex: 1;
  min-width: 0;
}

.tk-timer-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tk-timer-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #64748b;
}

.tk-timer-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #1f2329;
  margin: 6rpx 0;
  letter-spacing: 2rpx;
  line-height: 1.15;
}

.tk-timer-card.on .tk-timer-num {
  color: #d81e06;
}

.tk-timer-sub {
  font-size: 23rpx;
  color: #64748b;
  line-height: 1.45;
  word-break: break-all;
}

.tk-timer-ops {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}

.tk-timer-btn {
  margin: 0 !important;
  padding: 0 26rpx;
  height: 64rpx;
  line-height: 1;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

.tk-timer-btn::after {
  border: 0;
}

.tk-timer-btn.primary {
  background: linear-gradient(135deg, #d81e06 0%, #ef1008 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(216, 30, 6, 0.22);
}

.tk-timer-btn.ghost {
  background: #fff5f5;
  color: #d81e06;
  border: 2rpx solid #fecaca;
}

.tk-timer-btn.collab {
  background: #f8fafc;
  color: #334155;
  border: 2rpx solid #cbd5e1;
}

/* 保留兼容深色计时卡类名（供 shipment-packing 复用或过渡） */
.tk-clock {
  background: #ffffff;
  color: #1f2329;
  border-radius: 26rpx;
  padding: 26rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(15, 23, 42, 0.05);
}
.tk-clock-label { color: #64748b; font-size: 25rpx; font-weight: 700; }
.tk-clock-num { font-size: 56rpx; font-weight: 800; color: #d81e06; margin: 8rpx 0 10rpx; letter-spacing: 2rpx; }
.tk-clock-sub { color: #64748b; font-size: 23rpx; line-height: 1.6; flex: 1; min-width: 0; white-space: pre-wrap; }
.tk-clock-ops { display: flex; gap: 28rpx; flex-shrink: 0; }

.tk-link { color: #475569; font-weight: 700; font-size: 25rpx; }
.tk-link.red { color: #d81e06; }
.tk-link.green { color: #059669; }
.tk-link.amber { color: #d97706; }

.tk-unit { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid #f1f5f9; flex-wrap: wrap; }
.tk-unit:last-of-type { border-bottom: 0; }
.tk-unit.off { opacity: .55; }
.tk-check { width: 40rpx; height: 40rpx; border-radius: 10rpx; border: 3rpx solid #cbd5e1; color: #fff; text-align: center; line-height: 34rpx; font-size: 26rpx; font-weight: 700; flex-shrink: 0; }
.tk-check.on { background: #d81e06; border-color: #d81e06; }
.tk-sn { font-size: 28rpx; font-weight: 800; color: #1f2329; flex: 1; min-width: 0; }
.tk-desc { background: #f8fafc; border-radius: 14rpx; padding: 16rpx 20rpx; line-height: 1.65; font-size: 25rpx; color: #334155; margin-bottom: 10rpx; white-space: pre-wrap; }

.tk-parent-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  background: #fff8ee;
  border: 1rpx solid #fdd7aa;
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 18rpx;
}

.tk-parent-left {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.tk-parent-no {
  font-size: 24rpx;
  font-weight: 700;
  color: #b45309;
}

.tk-parent-name {
  font-size: 25rpx;
  font-weight: 700;
  color: #1f2329;
}

.tk-parent-spec {
  font-size: 23rpx;
  color: #64748b;
}

.tk-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(15, 23, 42, .48); backdrop-filter: blur(4px); z-index: 50; display: flex; align-items: flex-end; }
.tk-sheet { background: #f5f6f8; width: 100%; border-radius: 32rpx 32rpx 0 0; padding: 26rpx 24rpx calc(22rpx + env(safe-area-inset-bottom)); max-height: 88vh; display: flex; flex-direction: column; box-sizing: border-box; }
.tk-sheet-head { margin-bottom: 18rpx; }
.tk-sheet-head-bar { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin-bottom: 18rpx; }
.tk-sheet-title { font-size: 32rpx; font-weight: 800; color: #1f2329; position: relative; padding-left: 18rpx; line-height: 1.35; }
.tk-sheet-title::before { content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 7rpx; height: 28rpx; border-radius: 4rpx; background: #d81e06; }
.tk-sheet-sub { margin-top: 6rpx; padding-left: 18rpx; font-size: 23rpx; color: #64748b; }
.tk-sheet-close { width: 52rpx; height: 52rpx; border-radius: 50%; background: #ffffff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06); }

.tk-search-bar { display: flex; align-items: center; gap: 12rpx; height: 76rpx; padding: 0 10rpx 0 24rpx; background: #ffffff; border: 2rpx solid #e2e8f0; border-radius: 999rpx; margin-bottom: 16rpx; box-sizing: border-box; }
.tk-search-input { flex: 1; min-width: 0; height: 72rpx; line-height: 72rpx; font-size: 26rpx; color: #1f2329; background: transparent; border: 0; padding: 0; }
.tk-search-clear { width: 44rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.tk-search-btn { height: 58rpx; padding: 0 28rpx; border-radius: 999rpx; background: linear-gradient(135deg, #d81e06 0%, #ef1008 100%); color: #ffffff; font-size: 25rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

.tk-sheet-body { flex: 1; min-height: 0; max-height: 62vh; background: #fff; border-radius: 24rpx; padding: 22rpx; box-sizing: border-box; }
.tk-sheet-foot { display: flex; gap: 18rpx; margin-top: 18rpx; }
.tk-sheet-foot .mt-btn { margin: 0; }
.tk-sheet-foot .side { flex: 0 0 32%; }
.tk-people-sheet { height: 84vh; overflow: hidden; }
.tk-people-sheet .tk-sheet-head-bar, .tk-people-sheet .tk-search-bar, .tk-people-sheet .tk-sheet-foot { flex-shrink: 0; }
.tk-people-sheet .tk-sheet-head-bar > view:first-child { flex: 1; min-width: 0; }
.tk-people-sheet .tk-people-body { width: 100%; height: 0; max-height: none; flex: 1; padding: 0; overflow: hidden; }
.tk-people-body-inner { padding: 20rpx; box-sizing: border-box; }
.tk-people-sheet .tk-person-card { width: 100%; box-sizing: border-box; }
.tk-people-sheet .tk-person-info { flex: 1; min-width: 0; }
.tk-people-sheet .tk-person-name, .tk-people-sheet .tk-share-name { overflow-wrap: anywhere; }
.tk-people-sheet .tk-person-card > van-tag { flex-shrink: 0; }
.tk-people-pager { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding-top: 20rpx; font-size: 24rpx; }
.tk-people-pager button { margin: 0; }

.tk-foot-btn { flex: 1; height: 84rpx; border-radius: 999rpx; font-size: 28rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.tk-foot-btn.cancel { flex: 0 0 34%; background: #ffffff; border: 2rpx solid #cbd5e1; color: #475569; }
.tk-foot-btn.cancel.full { flex: 1; }
.tk-foot-btn.confirm { background: linear-gradient(135deg, #d81e06 0%, #ef1008 100%); color: #ffffff; box-shadow: 0 8rpx 20rpx rgba(216, 30, 6, 0.24); }
.tk-foot-btn.confirm.disabled { opacity: 0.5; box-shadow: none; }

.tk-collab-card { background: #f8fafc; border: 1rpx solid #e2e8f0; border-radius: 20rpx; padding: 20rpx; margin-bottom: 18rpx; }
.tk-collab-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 14rpx; }
.tk-collab-title { font-size: 26rpx; font-weight: 800; color: #1f2329; }
.tk-equal-btn { display: inline-flex; align-items: center; gap: 6rpx; height: 48rpx; padding: 0 18rpx; border-radius: 999rpx; background: #fff5f5; border: 1rpx solid #fca5a5; color: #d81e06; font-size: 22rpx; font-weight: 700; }
.tk-mode-switch { display: flex; gap: 12rpx; flex-wrap: wrap; }
.tk-mode-pill { flex: 1; min-width: 240rpx; display: flex; align-items: center; gap: 10rpx; padding: 14rpx 18rpx; border-radius: 16rpx; background: #ffffff; border: 2rpx solid #e2e8f0; font-size: 24rpx; color: #475569; }
.tk-mode-pill.on { background: #fff5f5; border-color: #d81e06; color: #d81e06; font-weight: 700; }
.tk-collab-divider { height: 1rpx; background: #e2e8f0; margin: 16rpx 0; }
.tk-share-row { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; padding: 12rpx 0; border-bottom: 1rpx dashed #e2e8f0; }
.tk-share-row:last-child { border-bottom: 0; padding-bottom: 0; }
.tk-share-left { display: flex; align-items: center; gap: 10rpx; flex: 1; min-width: 0; flex-wrap: wrap; }
.tk-share-name { font-size: 26rpx; font-weight: 700; color: #1f2329; }
.tk-share-right { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.tk-pct-box { display: flex; align-items: center; gap: 6rpx; background: #ffffff; border: 2rpx solid #cbd5e1; border-radius: 12rpx; padding: 0 14rpx; height: 60rpx; }
.tk-pct-input { width: 96rpx; height: 56rpx; line-height: 56rpx; text-align: right; font-size: 26rpx; font-weight: 800; color: #1f2329; }
.tk-pct-unit { font-size: 23rpx; font-weight: 700; color: #64748b; }
.tk-remove-pill { display: inline-flex; align-items: center; gap: 4rpx; height: 48rpx; padding: 0 16rpx; border-radius: 999rpx; background: #fff1f0; color: #d81e06; font-size: 22rpx; font-weight: 700; }

.tk-sec-label { font-size: 25rpx; font-weight: 800; color: #475569; margin: 6rpx 0 12rpx; }
.tk-people-list { display: flex; flex-direction: column; gap: 12rpx; }
.tk-person-card { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 20rpx; border-radius: 18rpx; border: 2rpx solid #f1f5f9; background: #f8fafc; }
.tk-person-card.active { background: #fff5f5; border-color: #fca5a5; }
.tk-person-check { width: 38rpx; height: 38rpx; border-radius: 10rpx; border: 3rpx solid #cbd5e1; background: #ffffff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.tk-person-check.checked { background: #d81e06; border-color: #d81e06; }
.tk-person-avatar { width: 60rpx; height: 60rpx; border-radius: 50%; background: #e2e8f0; color: #475569; font-size: 26rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.tk-person-avatar.active { background: linear-gradient(135deg, #d81e06 0%, #ff4d3a 100%); color: #ffffff; }
.tk-person-info { flex: 1; min-width: 0; }
.tk-person-name { font-size: 27rpx; font-weight: 700; color: #1f2329; }
.tk-person-sub { font-size: 22rpx; color: #64748b; margin-top: 2rpx; }
.tk-radio { display: flex; align-items: center; gap: 14rpx; padding: 16rpx 0; flex-wrap: wrap; }
.tk-dot { width: 36rpx; height: 36rpx; border-radius: 50%; border: 3rpx solid #cbd5e1; flex-shrink: 0; }
.tk-dot.on { border: 11rpx solid #d81e06; }
.tk-chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 16rpx; }
.tk-chip { padding: 10rpx 24rpx; border-radius: 999rpx; border: 2rpx solid #e2e8f0; font-size: 25rpx; color: #475569; background: #fff; }
.tk-chip.on { border-color: #d81e06; color: #d81e06; background: #fff5f5; font-weight: 700; }
.tk-textarea { width: 100%; height: 150rpx; border: 2rpx solid #e2e8f0; border-radius: 14rpx; padding: 16rpx; font-size: 26rpx; background: #f8fafc; }
.tk-photos { display: flex; flex-wrap: wrap; gap: 16rpx; }
.tk-photo { width: 140rpx; height: 140rpx; border-radius: 14rpx; background: #f1f5f9; position: relative; overflow: hidden; }
.tk-photo image { width: 100%; height: 100%; }
.tk-photo.add { border: 2rpx dashed #cbd5e1; background: #fff; text-align: center; line-height: 136rpx; font-size: 56rpx; color: #94a3b8; }
.tk-photo-x { position: absolute; right: 0; top: 0; width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center; background: rgba(0, 0, 0, .55); color: #fff; font-size: 30rpx; border-radius: 0 0 0 12rpx; }
.tk-pct { width: 120rpx; border: 2rpx solid #e2e8f0; border-radius: 10rpx; padding: 6rpx 12rpx; text-align: right; margin-left: auto; }
.tk-qty { text-align: right; border-bottom: 2rpx solid #e2e8f0; min-width: 160rpx; }
.tk-dlv { padding: 14rpx 0; border-bottom: 1rpx solid #f1f5f9; }
.tk-dlv:last-of-type { border-bottom: 0; }
.tk-dlv-ops { display: flex; gap: 40rpx; margin-top: 12rpx; }

.ct-step { display: flex; align-items: center; gap: 12rpx; }
.ct-step-btn { width: 60rpx; height: 60rpx; line-height: 56rpx; text-align: center; border: 2rpx solid #cbd5e1; border-radius: 12rpx; font-size: 34rpx; color: #1f2329; background: #fff; }
.ct-step-btn.off { color: #cbd5e1; }
.ct-step-input { width: 110rpx; height: 60rpx; text-align: center; border: 2rpx solid #e2e8f0; border-radius: 12rpx; font-size: 28rpx; font-weight: 700; }
