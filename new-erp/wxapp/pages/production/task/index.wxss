@import "../shared.wxss";
.tk-clock { background: #14213d; color: #fff; border-radius: 20rpx; padding: 26rpx; margin-bottom: 18rpx; }
.tk-clock-label { color: #b9c5dc; font-size: 25rpx; }
.tk-clock-num { font-size: 60rpx; font-weight: 700; margin: 8rpx 0 10rpx; letter-spacing: 2rpx; }
.tk-clock-sub { color: #b9c5dc; font-size: 23rpx; line-height: 1.6; flex: 1; min-width: 0; white-space: pre-wrap; }
.tk-clock-ops { display: flex; gap: 28rpx; flex-shrink: 0; }
.tk-link { color: #1f6feb; font-weight: 600; font-size: 26rpx; }
.tk-link.green { color: #11804a; }
.tk-clock .tk-link.green { color: #4ade80; font-size: 30rpx; }
.tk-link.amber { color: #b25c00; }
.tk-clock .tk-link.amber { color: #ffb020; font-size: 30rpx; }
.tk-unit { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid #f0f2f6; flex-wrap: wrap; }
.tk-unit:last-of-type { border-bottom: 0; }
.tk-unit.off { opacity: .55; }
.tk-check { width: 40rpx; height: 40rpx; border-radius: 8rpx; border: 3rpx solid #c9d2e0; color: #fff; text-align: center; line-height: 34rpx; font-size: 26rpx; font-weight: 700; flex-shrink: 0; }
.tk-check.on { background: #11804a; border-color: #11804a; }
.tk-sn { font-size: 27rpx; }
.tk-desc { background: #f6f8fb; border-radius: 12rpx; padding: 16rpx 18rpx; line-height: 1.7; font-size: 26rpx; margin-bottom: 8rpx; white-space: pre-wrap; }
.tk-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(15, 23, 42, .45); z-index: 50; display: flex; align-items: flex-end; }
.tk-sheet { background: #f1f4f8; width: 100%; border-radius: 28rpx 28rpx 0 0; padding: 26rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); max-height: 88vh; display: flex; flex-direction: column; }
.tk-sheet-head { margin-bottom: 18rpx; }
.tk-sheet-body { flex: 1; min-height: 0; max-height: 62vh; background: #fff; border-radius: 18rpx; padding: 22rpx; }
.tk-sheet-foot { display: flex; gap: 16rpx; margin-top: 18rpx; }
.tk-sheet-foot .mt-btn { margin: 0; }
.tk-sheet-foot .side { flex: 0 0 32%; }
.tk-radio { display: flex; align-items: center; gap: 14rpx; padding: 16rpx 0; flex-wrap: wrap; }
.tk-dot { width: 36rpx; height: 36rpx; border-radius: 50%; border: 3rpx solid #c9d2e0; flex-shrink: 0; }
.tk-dot.on { border: 11rpx solid #11804a; }
.tk-chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 16rpx; }
.tk-chip { padding: 10rpx 24rpx; border-radius: 30rpx; border: 2rpx solid #d5dbe5; font-size: 25rpx; color: #5b6780; background: #fff; }
.tk-chip.on { border-color: #d92d20; color: #c0261b; background: #fff5f4; font-weight: 600; }
.tk-textarea { width: 100%; height: 150rpx; border: 2rpx solid #e3e8f0; border-radius: 12rpx; padding: 16rpx; font-size: 26rpx; }
.tk-photos { display: flex; flex-wrap: wrap; gap: 16rpx; }
.tk-photo { width: 140rpx; height: 140rpx; border-radius: 12rpx; background: #eef1f5; position: relative; overflow: hidden; }
.tk-photo image { width: 100%; height: 100%; }
.tk-photo.add { border: 2rpx dashed #c9d2e0; background: #fff; text-align: center; line-height: 136rpx; font-size: 56rpx; color: #8a95a8; }
.tk-photo-x { position: absolute; right: 0; top: 0; width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center; background: rgba(0, 0, 0, .5); color: #fff; font-size: 30rpx; border-radius: 0 0 0 12rpx; }
.tk-pct { width: 120rpx; border: 2rpx solid #e3e8f0; border-radius: 10rpx; padding: 6rpx 12rpx; text-align: right; margin-left: auto; }
.tk-qty { text-align: right; border-bottom: 2rpx solid #e3e8f0; min-width: 160rpx; }
.tk-dlv { padding: 14rpx 0; border-bottom: 1rpx solid #f0f2f6; }
.tk-dlv:last-of-type { border-bottom: 0; }
.tk-dlv-ops { display: flex; gap: 40rpx; margin-top: 12rpx; }
