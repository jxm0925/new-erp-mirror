<view class="hub-page">
  <!-- 顶部红色概览区 -->
  <view class="hero-card">
    <view class="hero-circle hero-circle-1"></view>
    <view class="hero-circle hero-circle-2"></view>

    <view class="hero-top">
      <view class="user-chip" bindtap="handleUserTap">
        <view class="user-avatar">{{userInitial}}</view>
        <view class="user-meta">
          <view class="user-name-row">
            <text class="user-name">{{hasToken ? userName : '点击登录生产账号'}}</text>
            <text class="user-role">{{hasToken ? userRole : '未登录'}}</text>
          </view>
          <text class="user-sub">{{hasToken ? statusSubtitle : '登录后同步工单、出入库、发货与统计数据'}}</text>
        </view>
      </view>

      <view wx:if="{{access.scan}}" class="scan-btn" bindtap="scanCode">
        <van-icon name="scan" size="30rpx" color="#ffffff" />
        <text>扫码作业</text>
      </view>
    </view>

    <view wx:if="{{access.workOrder || access.warehouse || access.shipment || access.stats}}" class="hero-metrics">
      <view wx:if="{{access.workOrder}}" class="metric-item" data-module="workOrder" data-tab="available" bindtap="openModule">
        <text class="metric-value">{{heroStats.availableOrders}}</text>
        <text class="metric-label">可接工单</text>
      </view>
      <view wx:if="{{access.workOrder}}" class="metric-item" data-module="workOrder" data-tab="mine" bindtap="openModule">
        <text class="metric-value">{{heroStats.activeOrders}}</text>
        <text class="metric-label">进行中工单</text>
      </view>
      <view wx:if="{{access.warehouse}}" class="metric-item" data-module="warehouse" bindtap="openModule">
        <text class="metric-value">{{heroStats.warehouseTodoCount}}</text>
        <text class="metric-label">待办出入库</text>
      </view>
      <view wx:if="{{access.shipment}}" class="metric-item" data-module="shipment" bindtap="openModule">
        <text class="metric-value">{{heroStats.shipmentPendingCount}}</text>
        <text class="metric-label">待办发货作业</text>
      </view>
      <view wx:if="{{access.stats}}" class="metric-item" data-module="stats" bindtap="openModule">
        <text class="metric-value">{{heroStats.todayHours}}</text>
        <text class="metric-label">今日报工工时</text>
      </view>
    </view>
  </view>

  <!-- 主体内容区 -->
  <view class="hub-body">
    <!-- 四大核心板块 -->
    <view wx:if="{{hasToken}}" class="section-head">
      <view class="section-title-group">
        <view class="section-dot"></view>
        <text class="section-title">业务中心</text>
      </view>
      <text class="section-sub">{{access.workOrder ? '工单 ' : ''}}{{access.warehouse ? '仓库 ' : ''}}{{access.shipment ? '发货 ' : ''}}{{access.stats ? '统计' : ''}}</text>
    </view>

    <view wx:if="{{access.workOrder || access.warehouse || access.shipment || access.stats}}" class="module-grid">
      <!-- 1. 工单 -->
      <view wx:if="{{access.workOrder}}" class="module-card module-card-red" data-module="workOrder" bindtap="openModule">
        <view class="module-top">
          <view class="module-icon-wrap icon-wrap-red">
            <van-icon name="notes-o" size="42rpx" color="#d81e06" />
          </view>
          <text class="module-badge badge-red">{{moduleStats.workOrder.badge}}</text>
        </view>
        <view class="module-main">
          <text class="module-name">工单</text>
          <text class="module-desc">领料 · 工序计时 · 按设备报工</text>
        </view>
        <view class="module-stats">
          <view class="module-stat">
            <text class="module-stat-num">{{moduleStats.workOrder.mineCount}}</text>
            <text class="module-stat-lbl">我的待做</text>
          </view>
          <view class="module-stat">
            <text class="module-stat-num">{{moduleStats.workOrder.claimableCount}}</text>
            <text class="module-stat-lbl">可接工序</text>
          </view>
        </view>
      </view>

      <!-- 2. 仓库 -->
      <view wx:if="{{access.warehouse}}" class="module-card module-card-orange" data-module="warehouse" bindtap="openModule">
        <view class="module-top">
          <view class="module-icon-wrap icon-wrap-orange">
            <van-icon name="logistics" size="42rpx" color="#ea580c" />
          </view>
          <text class="module-badge badge-orange">{{moduleStats.warehouse.badge}}</text>
        </view>
        <view class="module-main">
          <text class="module-name">仓库</text>
          <text class="module-desc">收货 · 生产发料 · 销售出库</text>
        </view>
        <view class="module-stats">
          <view class="module-stat">
            <text class="module-stat-num">{{moduleStats.warehouse.inboundToday}}</text>
            <text class="module-stat-lbl">今日入库</text>
          </view>
          <view class="module-stat">
            <text class="module-stat-num">{{moduleStats.warehouse.outboundToday}}</text>
            <text class="module-stat-lbl">今日出库</text>
          </view>
        </view>
      </view>

      <!-- 3. 发货 -->
      <view wx:if="{{access.shipment}}" class="module-card module-card-blue" data-module="shipment" bindtap="openModule">
        <view class="module-top">
          <view class="module-icon-wrap icon-wrap-blue">
            <van-icon name="send-gift-o" size="42rpx" color="#0284c7" />
          </view>
          <text class="module-badge badge-blue">{{moduleStats.shipment.badge}}</text>
        </view>
        <view class="module-main">
          <text class="module-name">发货</text>
          <text class="module-desc">试水检验 · 扫码打包 · 发货</text>
        </view>
        <view class="module-stats">
          <view class="module-stat">
            <text class="module-stat-num">{{moduleStats.shipment.waterTestCount}}</text>
            <text class="module-stat-lbl">试水检验</text>
          </view>
          <view class="module-stat">
            <text class="module-stat-num">{{moduleStats.shipment.packingCount}}</text>
            <text class="module-stat-lbl">打包中</text>
          </view>
        </view>
      </view>

      <!-- 4. 统计 -->
      <view wx:if="{{access.stats}}" class="module-card module-card-amber" data-module="stats" bindtap="openModule">
        <view class="module-top">
          <view class="module-icon-wrap icon-wrap-amber">
            <van-icon name="bar-chart-o" size="42rpx" color="#d97706" />
          </view>
          <text class="module-badge badge-amber">{{moduleStats.stats.badge}}</text>
        </view>
        <view class="module-main">
          <text class="module-name">统计</text>
          <text class="module-desc">产量汇总 · 工时 · 库存快览</text>
        </view>
        <view class="module-stats">
          <view class="module-stat">
            <text class="module-stat-num">{{moduleStats.stats.completedUnitsToday}}</text>
            <text class="module-stat-lbl">今日合格</text>
          </view>
          <view class="module-stat">
            <text class="module-stat-num">{{moduleStats.stats.secondaryValue}}</text>
            <text class="module-stat-lbl">{{moduleStats.stats.secondaryLabel}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{hasToken}}" class="recent-card order-progress-entry">
      <view class="recent-row">
        <text class="recent-code">订单生产进度</text>
        <button class="recent-btn btn-outline-red order-progress-button" bindtap="openOrderProgress">查看进度</button>
      </view>
    </view>

    <!-- 我的当前作业（直达待办） -->
    <view wx:if="{{access.workOrder || access.warehouse || access.shipment}}" class="section-head section-head-recent">
      <view class="section-title-group">
        <view class="section-dot"></view>
        <text class="section-title">我的当前作业</text>
      </view>
      <text class="section-link" bindtap="refreshAll">{{loading ? '同步中...' : '刷新待办 ›'}}</text>
    </view>

    <!-- 未登录提示 -->
    <view wx:if="{{hasToken && loadErrors.length}}" class="empty-card load-error-card">
      <text wx:for="{{loadErrors}}" wx:key="key" class="load-error-text">{{item.name}}：{{item.message}}</text>
      <button class="ghost-red-btn" bindtap="refreshAll" disabled="{{loading}}">重新加载</button>
    </view>

    <view wx:if="{{!hasToken}}" class="empty-card">
      <text class="empty-title">请先登录生产与仓储账号</text>
      <text class="empty-desc">登录后可查看您的在制工单、出入库待办、试水打包任务与实时统计看板</text>
      <button class="primary-red-btn" bindtap="openLogin">登录生产仓储账号</button>
    </view>

    <view wx:elif="{{loading}}" class="empty-card">
      <text class="empty-title">正在同步待办作业</text>
    </view>

    <!-- 已登录：当前作业直达列表 -->
    <view wx:elif="{{activeWorkList.length}}" class="recent-card">
      <view
        wx:for="{{activeWorkList}}"
        wx:key="id"
        class="recent-row"
        data-item="{{item}}"
        bindtap="openWorkItem"
      >
        <view class="recent-left">
          <view class="recent-title-line">
            <text class="recent-tag {{item.tagClass}}">{{item.tagText}}</text>
            <text class="recent-code">{{item.code}}</text>
          </view>
          <text class="recent-desc">{{item.desc}}</text>
        </view>
        <view class="recent-btn {{item.btnClass}}">{{item.btnText}}</view>
      </view>
    </view>

    <!-- 已登录但暂无待办 -->
    <view wx:elif="{{!loadErrors.length && (access.workOrder || access.warehouse || access.shipment || access.stats || access.scan)}}" class="empty-card">
      <text class="empty-title">当前暂无紧急待办作业</text>
      <text class="empty-desc">{{access.workOrder || access.warehouse || access.shipment || access.stats ? '您可以点击上方已开放的业务板块查看全部记录' : '点击上方【扫码作业】查看设备信息'}}</text>
      <view wx:if="{{access.workOrder || access.warehouse}}" class="empty-actions">
        <view wx:if="{{access.workOrder}}" class="ghost-red-btn" data-module="workOrder" bindtap="openModule">进入工单列表</view>
        <view wx:if="{{access.warehouse}}" class="ghost-red-btn" data-module="warehouse" bindtap="openModule">进入仓库工作台</view>
      </view>
    </view>
  </view>

  <view wx:if="{{hasToken && orderProgress}}" class="modal-mask order-progress-mask" bindtap="closeOrderProgress" catchtouchmove="noop">
    <view class="stats-sheet order-progress-sheet" catchtap="noop">
      <view class="sheet-header">
        <text class="sheet-title">订单生产进度</text>
        <button class="sheet-close order-progress-button" aria-label="关闭订单生产进度" bindtap="closeOrderProgress">✕</button>
      </view>
      <view class="order-progress-search">
        <input class="order-progress-input" value="{{orderProgress.input}}" maxlength="120" placeholder="搜索订单号" confirm-type="search" bindinput="orderProgressInput" bindconfirm="searchOrderProgress" />
        <button wx:if="{{orderProgress.input}}" class="sheet-close order-progress-button" aria-label="清空订单号搜索" bindtap="clearOrderProgressSearch">✕</button>
        <button class="recent-btn btn-solid-red order-progress-button" bindtap="searchOrderProgress">搜索</button>
      </view>

      <scroll-view scroll-y class="sheet-scroll order-progress-scroll">
        <text wx:if="{{orderProgress.loading}}" class="empty-desc">正在加载订单</text>
        <view wx:elif="{{orderProgress.error}}" class="load-error-card">
          <text class="load-error-text">{{orderProgress.error}}</text>
          <button class="recent-btn btn-outline-red order-progress-button" bindtap="refreshOrderProgress">重新加载</button>
        </view>
        <text wx:elif="{{!orderProgress.rows.length}}" class="empty-desc">未找到生产订单</text>
        <view wx:for="{{orderProgress.rows}}" wx:for-item="order" wx:key="id" class="order-progress-row">
          <view class="sheet-list-row">
            <view class="sheet-list-main">
              <view class="recent-title-line">
                <text class="sheet-list-title">{{order.order_no}}</text>
                <text class="sheet-list-badge">{{order.status_label}}</text>
              </view>
              <text wx:if="{{order.products}}" class="sheet-list-sub">{{order.products}}</text>
              <text wx:if="{{order.summary}}" class="sheet-list-sub">{{order.summary}}</text>
              <text wx:if="{{order.unit_text}}" class="sheet-list-sub">{{order.unit_text}}</text>
              <text wx:if="{{order.current_text}}" class="sheet-list-sub">当前：{{order.current_text}}</text>
            </view>
            <button class="recent-btn btn-outline-red order-progress-button" data-id="{{order.id}}" bindtap="toggleOrderProgress">{{orderProgress.expandedId === order.id ? '收起' : '展开'}}</button>
          </view>

          <view wx:if="{{orderProgress.expandedId === order.id}}" class="order-progress-detail">
            <view wx:if="{{orderProgress.detailError}}" class="load-error-card">
              <text class="load-error-text">{{orderProgress.detailError}}</text>
              <button class="recent-btn btn-outline-red order-progress-button" bindtap="retryOrderProgressDetail">重新加载</button>
            </view>
            <text wx:elif="{{!orderProgress.detail}}" class="sheet-list-sub">正在加载生产明细</text>
            <text wx:elif="{{!orderProgress.detail.lines.length}}" class="sheet-list-sub">暂无订单明细</text>
            <block wx:else>
              <view wx:for="{{orderProgress.detail.lines}}" wx:for-item="line" wx:key="id" class="sheet-block">
                <text class="sheet-block-title">{{line.name}}</text>
                <text wx:if="{{!line.workOrders.length}}" class="sheet-sub">暂无关联工单</text>
                <view wx:for="{{line.workOrders}}" wx:for-item="workOrder" wx:key="id" class="sheet-list order-progress-work-order">
                  <view class="sheet-list-row">
                    <view class="sheet-list-main">
                      <text class="sheet-list-title">{{workOrder.parentNo ? '子工单' : '主工单'}} · {{workOrder.work_order_no}}</text>
                      <text wx:if="{{workOrder.name}}" class="sheet-list-sub">{{workOrder.name}}</text>
                      <text wx:if="{{workOrder.parentNo}}" class="sheet-list-sub">上级工单 {{workOrder.parentNo}}</text>
                    </view>
                    <text class="sheet-list-badge">{{workOrder.status_label}}</text>
                  </view>
                  <view wx:for="{{workOrder.operations}}" wx:for-item="operation" wx:key="key" class="sheet-list-row order-progress-operation">
                    <view class="recent-title-line">
                      <text class="sheet-list-title">{{operation.name}}</text>
                      <text wx:if="{{operation.is_current}}" class="sheet-block-tag">当前</text>
                      <text class="sheet-list-sub">{{operation.status_label}}</text>
                    </view>
                    <text class="sheet-list-sub">实际接单人 {{operation.owner_name || '暂无'}}</text>
                    <text class="sheet-list-sub">正在计时 {{operation.timingText || '暂无'}}</text>
                    <view wx:if="{{operation.materials.length}}" class="order-progress-materials">
                      <text class="sheet-list-sub">收料进度（已收 / 应收）</text>
                      <view wx:for="{{operation.materials}}" wx:for-item="material" wx:key="key" class="order-progress-material">
                        <text class="sheet-list-sub">{{material.name}}</text>
                        <text class="sheet-list-title">{{material.quantityText}}</text>
                      </view>
                    </view>
                    <button wx:if="{{operation.can_open === true}}" class="recent-btn btn-outline-red order-progress-button order-progress-open-task" data-id="{{operation.id}}" data-lane="{{operation.lane}}" bindtap="openOrderProgressOperation">进入工序</button>
                  </view>
                </view>
              </view>
            </block>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{!orderProgress.loading && !orderProgress.error}}" class="sheet-footer order-progress-pager">
        <button class="recent-btn btn-outline-red order-progress-button" disabled="{{orderProgress.page <= 1}}" data-delta="-1" bindtap="turnOrderProgressPage">上一页</button>
        <text class="sheet-list-sub">{{orderProgress.page}} / {{orderProgress.lastPage}} · 共 {{orderProgress.total}} 单</text>
        <button class="recent-btn btn-outline-red order-progress-button" disabled="{{orderProgress.page >= orderProgress.lastPage}}" data-delta="1" bindtap="turnOrderProgressPage">下一页</button>
      </view>
    </view>
  </view>

  <!-- 统计看板弹窗面板 -->
  <view wx:if="{{showStatsModal && access.stats}}" class="modal-mask" bindtap="closeStatsModal">
    <view class="stats-sheet" catchtap="noop">
      <view class="sheet-header">
        <view>
          <text class="sheet-title">生产与仓储实时统计</text>
          <text class="sheet-sub">汇总工单产出、报工工时、出入库与试水打包动态</text>
        </view>
        <view class="sheet-close" bindtap="closeStatsModal">✕</view>
      </view>

      <scroll-view scroll-y="true" class="sheet-scroll">
        <view wx:if="{{!hasToken}}" class="empty-card">
          <text class="empty-title">请先登录生产与仓储账号</text>
          <button class="primary-red-btn" bindtap="openLogin">登录生产仓储账号</button>
        </view>
        <view wx:elif="{{loading}}" class="empty-card">
          <text class="empty-title">正在同步统计数据</text>
        </view>
        <view wx:elif="{{loadErrors.length}}" class="empty-card load-error-card">
          <text wx:for="{{loadErrors}}" wx:key="key" class="load-error-text">{{item.name}}：{{item.message}}</text>
          <button class="ghost-red-btn" bindtap="refreshAll">重新加载</button>
        </view>
        <!-- 生产与工时指标 -->
        <view wx:if="{{access.stats}}" class="sheet-block">
          <view class="sheet-block-head">
            <text class="sheet-block-title">生产与工时概览</text>
            <text class="sheet-block-tag">实时同步</text>
          </view>
          <view class="stats-kpi-grid">
            <view class="stats-kpi-box kpi-box-red">
              <text class="stats-kpi-val">{{statsDetail.completedUnitsToday}}</text>
              <text class="stats-kpi-lbl">今日合格设备数</text>
            </view>
            <view class="stats-kpi-box">
              <text class="stats-kpi-val">{{statsDetail.inProgressUnits}}</text>
              <text class="stats-kpi-lbl">进行中设备数</text>
            </view>
            <view class="stats-kpi-box">
              <text class="stats-kpi-val">{{statsDetail.pendingReceiptUnits}}</text>
              <text class="stats-kpi-lbl">待入库设备数</text>
            </view>
            <view class="stats-kpi-box">
              <text class="stats-kpi-val">{{statsDetail.todayHours}}</text>
              <text class="stats-kpi-lbl">今日报工工时</text>
            </view>
            <view wx:if="{{access.workOrder}}" class="stats-kpi-box" data-module="workOrder" data-tab="available" bindtap="openModuleFromSheet">
              <text class="stats-kpi-val">{{statsDetail.availableOrders}}</text>
              <text class="stats-kpi-lbl">可接工单</text>
            </view>
            <view wx:if="{{access.workOrder}}" class="stats-kpi-box" data-module="workOrder" data-tab="mine" bindtap="openModuleFromSheet">
              <text class="stats-kpi-val">{{statsDetail.activeOrders}}</text>
              <text class="stats-kpi-lbl">进行中工单</text>
            </view>
            <view class="stats-kpi-box">
              <text class="stats-kpi-val">{{statsDetail.reworkUnits}}</text>
              <text class="stats-kpi-lbl">返工/待修设备数</text>
            </view>
          </view>
        </view>

        <!-- 仓储与发货指标 -->
        <view wx:if="{{access.warehouse || access.shipment}}" class="sheet-block">
          <view class="sheet-block-head">
            <text class="sheet-block-title">仓储与发货执行</text>
            <text class="sheet-block-tag">今日动态</text>
          </view>
          <view class="stats-kpi-grid stats-kpi-grid-4">
            <view wx:if="{{access.warehouse}}" class="stats-kpi-box">
              <text class="stats-kpi-val">{{statsDetail.warehouseTodoCount}}</text>
              <text class="stats-kpi-lbl">待办出入库</text>
            </view>
            <view wx:if="{{access.warehouse}}" class="stats-kpi-box">
              <text class="stats-kpi-val">{{statsDetail.inboundToday}}</text>
              <text class="stats-kpi-lbl">今日入库单</text>
            </view>
            <view wx:if="{{access.warehouse}}" class="stats-kpi-box">
              <text class="stats-kpi-val">{{statsDetail.outboundToday}}</text>
              <text class="stats-kpi-lbl">今日出库单</text>
            </view>
            <view wx:if="{{access.shipment}}" class="stats-kpi-box">
              <text class="stats-kpi-val">{{statsDetail.shipmentPendingCount}}</text>
              <text class="stats-kpi-lbl">待办发货作业</text>
            </view>
          </view>
        </view>

        <!-- 最近报工动态 -->
        <view wx:if="{{access.stats && statsDetail.recentReports.length}}" class="sheet-block">
          <view class="sheet-block-head">
            <text class="sheet-block-title">最新工序报工记录</text>
            <text wx:if="{{access.workOrder}}" class="sheet-block-link" data-module="workOrder" bindtap="openModuleFromSheet">查看全部工单 ›</text>
          </view>
          <view class="sheet-list">
            <view wx:for="{{statsDetail.recentReports}}" wx:key="id" class="sheet-list-row">
              <view class="sheet-list-main">
                <text class="sheet-list-title">{{item.serial_no || '整机'}} · {{item.operation_name || '工序报工'}}</text>
                <text class="sheet-list-sub">{{item.reporter_name || '作业员'}} · {{item.time || item.created_at || ''}}</text>
              </view>
              <text class="sheet-list-badge">{{item.result === 'passed' ? '合格' : (item.is_rework ? '返工' : '已报')}}</text>
            </view>
          </view>
        </view>

        <!-- 最近成品入库动态 -->
        <view wx:if="{{access.stats && statsDetail.recentReceipts.length}}" class="sheet-block">
          <view class="sheet-block-head">
            <text class="sheet-block-title">最新完工入库记录</text>
            <text wx:if="{{access.warehouse}}" class="sheet-block-link" data-module="warehouse" bindtap="openModuleFromSheet">进入仓库 ›</text>
          </view>
          <view class="sheet-list">
            <view wx:for="{{statsDetail.recentReceipts}}" wx:key="id" class="sheet-list-row">
              <view class="sheet-list-main">
                <text class="sheet-list-title">{{item.receipt_no}} · {{item.product_name || '成品入库'}}</text>
                <text class="sheet-list-sub">{{item.warehouse_name || '仓库'}} · {{item.operator_name || '仓管'}}</text>
              </view>
              <text class="sheet-list-badge">{{item.qty || 0}} 台</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{access.workOrder || access.warehouse || access.shipment}}" class="sheet-footer">
        <view wx:if="{{access.workOrder}}" class="sheet-action-btn sheet-btn-outline" data-module="workOrder" bindtap="openModuleFromSheet">工单作业</view>
        <view wx:if="{{access.warehouse}}" class="sheet-action-btn sheet-btn-outline" data-module="warehouse" bindtap="openModuleFromSheet">仓库工作台</view>
        <view wx:if="{{access.shipment}}" class="sheet-action-btn sheet-btn-primary" data-module="shipment" bindtap="openModuleFromSheet">发货试水打包</view>
      </view>
    </view>
  </view>

  <!-- 扫码结果弹窗 -->
  <view wx:if="{{serialScanResult && access.scan}}" class="modal-mask" bindtap="closeScanModal">
    <view class="scan-sheet" catchtap="noop">
      <view class="sheet-header">
        <view>
          <text class="sheet-title">扫码识别结果</text>
          <text class="sheet-sub">条码/SN：{{serialScanResult.serial_no}}</text>
        </view>
        <view class="sheet-close" bindtap="closeScanModal">✕</view>
      </view>
      <view class="scan-body">
        <view class="scan-info-row">
          <text class="scan-label">产品名称</text>
          <text class="scan-val">{{serialScanResult.product_name || '-'}}</text>
        </view>
        <view class="scan-info-row">
          <text class="scan-label">关联工单</text>
          <text class="scan-val">{{serialScanResult.work_order_no || '-'}}</text>
        </view>
        <view class="scan-info-row">
          <text class="scan-label">当前状态</text>
          <text class="scan-val scan-val-highlight">{{serialScanResult.status_label || serialScanResult.status || '-'}}</text>
        </view>
        <view wx:if="{{serialScanResult.current_operation_name}}" class="scan-info-row">
          <text class="scan-label">当前工序</text>
          <text class="scan-val">{{serialScanResult.current_operation_name}}</text>
        </view>
      </view>
      <view class="sheet-footer">
        <view class="sheet-action-btn sheet-btn-outline" bindtap="closeScanModal">关闭</view>
        <view
          wx:if="{{serialScanResult.current_task_id && access.workOrder}}"
          class="sheet-action-btn sheet-btn-primary"
          data-id="{{serialScanResult.current_task_id}}"
          bindtap="openScannedTask"
        >进入当前工序</view>
        <view
          wx:elif="{{!serialScanResult.current_task_id && access.shipment}}"
          class="sheet-action-btn sheet-btn-primary"
          data-module="shipment"
          bindtap="openModuleFromSheet"
        >去试水/打包</view>
      </view>
    </view>
  </view>
</view>

<LoginPopup class="LoginPopup" default-mode="production"></LoginPopup>
<van-notify id="van-notify" />
