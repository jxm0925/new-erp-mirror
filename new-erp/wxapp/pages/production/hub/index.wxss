page {
  background: #f5f6f8;
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.hub-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  box-sizing: border-box;
}

/* 顶部红色概览区 */
.hero-card {
  position: relative;
  overflow: hidden;
  padding: 24rpx 28rpx 40rpx;
  background: linear-gradient(135deg, #d81e06 0%, #ef1008 60%, #ff4d3a 100%);
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(216, 30, 6, 0.22);
}

.hero-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  pointer-events: none;
}

.hero-circle-1 {
  width: 260rpx;
  height: 260rpx;
  top: -80rpx;
  right: -60rpx;
}

.hero-circle-2 {
  width: 160rpx;
  height: 160rpx;
  bottom: -50rpx;
  left: 36rpx;
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.user-chip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  flex: 1;
}

.user-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.48);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
  color: #ffffff;
  flex-shrink: 0;
}

.user-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.user-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #ffffff;
}

.user-role {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.user-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.86);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.scan-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.36);
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  flex-shrink: 0;
}

.scan-btn:active {
  opacity: 0.85;
}

.hero-metrics {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 22rpx;
  padding: 18rpx 10rpx;
}

.metric-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 6rpx;
}

.metric-value {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #ffffff;
}

.metric-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.88);
}

/* 主体内容区 */
.hub-body {
  padding: 0 24rpx;
  margin-top: -18rpx;
  position: relative;
  z-index: 2;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 6rpx 16rpx;
}

.section-head-recent {
  padding-top: 26rpx;
}

.section-title-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-dot {
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: #d81e06;
}

.section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1f2329;
}

.section-sub {
  font-size: 22rpx;
  color: #8c95a6;
}

.section-link {
  font-size: 23rpx;
  font-weight: 700;
  color: #d81e06;
}

/* 2x2 四大核心板块 */
.module-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.module-card {
  background: #ffffff;
  border-radius: 26rpx;
  padding: 24rpx 22rpx 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
  transition: transform 0.15s ease;
}

.module-card:active {
  transform: scale(0.985);
}

.module-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
}

.module-card-red::before {
  background: linear-gradient(90deg, #d81e06, #ff4d3a);
}

.module-card-orange::before {
  background: linear-gradient(90deg, #ea580c, #fb923c);
}

.module-card-blue::before {
  background: linear-gradient(90deg, #0284c7, #38bdf8);
}

.module-card-amber::before {
  background: linear-gradient(90deg, #d97706, #fbbf24);
}

.module-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.module-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-wrap-red {
  background: linear-gradient(135deg, #fff1f0, #ffccc7);
}

.icon-wrap-orange {
  background: linear-gradient(135deg, #fff7ed, #fed7aa);
}

.icon-wrap-blue {
  background: linear-gradient(135deg, #f0f9ff, #bae6fd);
}

.icon-wrap-amber {
  background: linear-gradient(135deg, #fffbeb, #fde68a);
}

.module-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

.badge-red {
  background: #fff1f0;
  color: #d81e06;
}

.badge-orange {
  background: #fff7ed;
  color: #c2410c;
}

.badge-blue {
  background: #f0f9ff;
  color: #0369a1;
}

.badge-amber {
  background: #fffbeb;
  color: #b45309;
}

.module-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.module-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2329;
}

.module-desc {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.35;
}

.module-stats {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.module-stat {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.module-stat-num {
  font-size: 28rpx;
  font-weight: 800;
  color: #1e293b;
}

.module-stat-lbl {
  font-size: 20rpx;
  color: #94a3b8;
}

/* 我的当前作业列表 */
.recent-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 8rpx 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid rgba(15, 23, 42, 0.05);
}

.recent-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.recent-row:last-child {
  border-bottom: none;
}

.recent-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  flex: 1;
}

.recent-title-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.recent-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.tag-red {
  background: #fff1f0;
  color: #d81e06;
}

.tag-orange {
  background: #fff7ed;
  color: #c2410c;
}

.tag-blue {
  background: #f0f9ff;
  color: #0369a1;
}

.recent-code {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.recent-desc {
  font-size: 22rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-btn {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.btn-solid-red {
  background: linear-gradient(135deg, #d81e06, #ef1008);
  color: #ffffff;
  box-shadow: 0 6rpx 14rpx rgba(216, 30, 6, 0.22);
}

.btn-outline-red {
  background: #fff1f0;
  color: #d81e06;
  border: 1rpx solid #ffa39e;
}

/* 空状态与未登录状态 */
.empty-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid rgba(15, 23, 42, 0.05);
}

.empty-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #1f2329;
  margin-bottom: 10rpx;
}

.empty-desc {
  display: block;
  font-size: 23rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.primary-red-btn {
  background: linear-gradient(135deg, #d81e06, #ef1008);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  padding: 16rpx 36rpx;
  line-height: 1.4;
  border: none;
}

.empty-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.ghost-red-btn {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #fff1f0;
  color: #d81e06;
  border: 1rpx solid #ffccc7;
  font-size: 24rpx;
  font-weight: 700;
}

/* 统计看板底部抽屉弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.52);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.stats-sheet,
.scan-sheet {
  width: 100%;
  background: #ffffff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 28rpx 28rpx 36rpx;
  box-sizing: border-box;
  max-height: 84vh;
  display: flex;
  flex-direction: column;
}

.sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2329;
}

.sheet-sub {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f5f9;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
}

.sheet-scroll {
  max-height: 60vh;
  padding: 12rpx 0;
}

.sheet-block {
  margin-top: 20rpx;
}

.sheet-block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.sheet-block-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #1f2329;
}

.sheet-block-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #fff1f0;
  color: #d81e06;
}

.sheet-block-link {
  font-size: 22rpx;
  font-weight: 700;
  color: #d81e06;
}

.stats-kpi-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.stats-kpi-grid-4 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.stats-kpi-box {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 18rpx;
  padding: 16rpx 14rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.kpi-box-red {
  background: #fff1f0;
  border-color: #ffccc7;
}

.stats-kpi-val {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2329;
}

.kpi-box-red .stats-kpi-val {
  color: #d81e06;
}

.stats-kpi-lbl {
  font-size: 20rpx;
  color: #64748b;
}

.sheet-list {
  background: #f8fafc;
  border-radius: 18rpx;
  padding: 6rpx 18rpx;
  border: 1rpx solid #e2e8f0;
}

.sheet-list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.sheet-list-row:last-child {
  border-bottom: none;
}

.sheet-list-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.sheet-list-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #1e293b;
}

.sheet-list-sub {
  font-size: 21rpx;
  color: #64748b;
}

.sheet-list-badge {
  font-size: 22rpx;
  font-weight: 800;
  color: #d81e06;
  background: #fff1f0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.sheet-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #f1f5f9;
}

.sheet-action-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.sheet-btn-outline {
  background: #f8fafc;
  color: #334155;
  border: 1rpx solid #cbd5e1;
}

.sheet-btn-primary {
  background: linear-gradient(135deg, #d81e06, #ef1008);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(216, 30, 6, 0.22);
}

/* 扫码结果弹窗 */
.scan-body {
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.scan-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 18rpx;
  background: #f8fafc;
  border-radius: 14rpx;
}

.scan-label {
  font-size: 24rpx;
  color: #64748b;
}

.scan-val {
  font-size: 25rpx;
  font-weight: 700;
  color: #1e293b;
}

.load-error-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.load-error-text {
  display: block;
  color: #b91c1c;
  font-size: 24rpx;
  overflow-wrap: anywhere;
}

.scan-val-highlight {
  color: #d81e06;
}
