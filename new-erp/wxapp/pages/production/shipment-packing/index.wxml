<import src="../order-info.wxml" />
<!-- 发货作业（试水 / 打包 / 装车）：列表和详情都按生产任务页的样子；选人、用料、质检等弹层沿用 -->
<view wx:if="{{!detailOpen}}" class="mt-page">
  <view class="mt-head"><text class="mt-title">发货作业</text><text class="mt-muted">{{userName}}</text></view>
  <view class="mt-tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="mt-tab {{scope === item.key ? 'on' : ''}}" data-scope="{{item.key}}" bindtap="pickScope">{{item.label}}<text wx:if="{{item.key !== 'all'}}"> {{counts[item.key] || 0}}</text></view>
  </view>
  <view class="mt-search">
    <input class="mt-input" value="{{keyword}}" bindinput="keywordInput" placeholder="搜索工序名称" confirm-type="search" bindconfirm="search" />
    <button class="mt-btn mt-btn-mini" bindtap="search">查询</button>
  </view>
  <view wx:if="{{error}}" class="mt-error">{{error}}</view>
  <view wx:if="{{loading && !rows.length}}" class="mt-empty">正在读取发货作业</view>
  <view wx:elif="{{!rows.length}}" class="mt-empty">{{scope === 'mine' ? '没有正在做的发货作业，去“可接”看看' : (scope === 'available' ? '暂时没有可接的发货作业' : '暂无发货作业')}}</view>
  <view wx:for="{{rows}}" wx:for-item="operation" wx:key="id" class="mt-card" data-id="{{operation.id}}" bindtap="openOperation">
    <view class="mt-row">
      <text class="mt-op">{{operation.operation_name}}</text>
      <view class="mt-tags">
        <text wx:if="{{operation.repairCount}}" class="mt-tag red">{{operation.repairCount}} 台返修</text>
        <text wx:if="{{operation.my.timing}}" class="mt-tag amber">计时中</text>
        <text class="mt-tag {{operation.statusTag}}">{{operation.statusLabel}}</text>
      </view>
    </view>
    <view class="mt-product">{{operation.productText}}<text class="mt-muted"> × {{operation.qtyText}}</text></view>
    <view class="mt-muted">{{operation.shipment_no}} · {{operation.package_no}}<text wx:if="{{operation.order_info}}"> · {{operation.order_info.customer_name}}</text></view>
    <view class="mt-row mt-gap">
      <text class="mt-muted">接单：{{operation.ownerName}}</text>
      <text class="mt-muted">我 {{operation.myMinutesText}} · 本道 {{operation.totalMinutesText}}</text>
    </view>
    <view wx:if="{{operation.order_info && operation.order_info.changed.length}}" class="mt-note">销售改过订单：{{operation.changedText}}</view>
    <button class="mt-btn {{operation.allowed_actions.claim ? '' : 'ghost'}}" data-id="{{operation.id}}" catchtap="openOperation" disabled="{{busy}}">{{operation.allowed_actions.claim ? '接单' : (operation.my.timing ? '继续作业' : '查看作业')}}</button>
  </view>
  <view wx:if="{{lastPage > 1}}" class="mt-pager">
    <button class="mt-btn ghost mt-btn-mini" disabled="{{page <= 1 || busy}}" data-delta="-1" bindtap="turnPage">上一页</button>
    <text>{{page}} / {{lastPage}}</text>
    <button class="mt-btn ghost mt-btn-mini" disabled="{{page >= lastPage || busy}}" data-delta="1" bindtap="turnPage">下一页</button>
  </view>
</view>

<view wx:if="{{detailOpen}}" class="mt-page has-footer">
  <view class="mt-head">
    <view>
      <view class="mt-title">{{operation.operation_name || '发货作业'}}<text wx:if="{{operation.productText}}"> · {{operation.productText}}</text></view>
      <view class="mt-sub">{{operation.shipment_no}} · {{operation.package_no}}<text wx:if="{{operation.order_info && operation.order_info.work_order_no}}"> · {{operation.order_info.work_order_no}}</text></view>
    </view>
    <view class="mt-tags">
      <text wx:if="{{operation.is_public_snapshot}}" class="mt-tag gray">公共工序</text>
      <text class="mt-tag {{operation.statusTag}}">{{operation.statusLabel}}</text>
    </view>
  </view>
  <view class="mt-row" style="margin-bottom: 16rpx"><text class="tk-link" bindtap="closeDetail">‹ 返回发货作业</text><text class="tk-link" bindtap="refreshDetail">刷新</text></view>
  <view wx:if="{{operationError}}" class="mt-error">{{operationError}}</view>
  <view wx:if="{{pending}}" class="mt-error">原操作结果待确认，请先点下面「查询原操作结果」。</view>
  <view wx:for="{{operation.repairRows}}" wx:for-item="serial" wx:key="inventory_serial_id" class="mt-error">
    {{serial.serial_no}} 试水不合格：{{serial.repair.label}}<text wx:if="{{serial.repair.reason}}">。原因：{{serial.repair.reason}}</text><text wx:if="{{serial.repair.work_order_no}}">（工单 {{serial.repair.work_order_no}}）</text>
    <view wx:if="{{serial.can_repair_return}}" class="mt-gap"><text class="tk-link green" data-id="{{serial.shipment_line_id}}" bindtap="openRepairReturn">返修合格返回 ›</text></view>
  </view>
  <view wx:if="{{operation.order_info && operation.order_info.changed.length}}" class="mt-error">销售开单后改过订单（{{operation.changedText}}），看下面「订单信息」。</view>

  <view class="tk-clock {{operation.my.timing ? 'on' : ''}}">
    <view class="mt-row"><text class="tk-clock-label">我在这道的工时</text><text wx:if="{{operation.my.timing}}" class="mt-tag amber">计时中</text></view>
    <view class="tk-clock-num mono">{{clockText}}</view>
    <view class="mt-row">
      <view class="tk-clock-sub"><view>{{operation.ownerName === '未接单' ? '还没人接单' : '接单：' + operation.ownerName}}</view><view>本道合计 {{operation.totalMinutesText}}<text wx:if="{{operation.labor.active_count}}"> · {{operation.labor.active_count}} 人在计时</text></view></view>
      <view class="tk-clock-ops">
        <text wx:if="{{operation.allowed_actions.pause}}" class="tk-link amber" data-action="pause" bindtap="runAction">暂停</text>
        <text wx:if="{{operation.allowed_actions.start}}" class="tk-link green" data-action="start" bindtap="runAction">{{operation.my.closed_minutes > 0 ? '继续计时' : '开始'}}</text>
      </view>
    </view>
  </view>
  <button wx:if="{{operation.allowed_actions.claim}}" class="mt-btn" disabled="{{busy}}" data-action="claim" bindtap="runAction">接单</button>

  <view wx:if="{{operation.serialResults.length}}" class="mt-card">
    <view class="mt-card-title"><text>本次作业设备</text><text class="mt-muted">选好再点下面的按钮</text></view>
    <view wx:for="{{operation.serialResults}}" wx:for-item="serial" wx:key="inventory_serial_id" class="tk-unit {{serial.canSelect ? '' : 'off'}}" data-id="{{serial.inventory_serial_id}}" bindtap="toggleSerial">
      <view class="tk-check {{serial.selected ? 'on' : ''}}">{{serial.selected ? '✓' : ''}}</view>
      <text class="mono tk-sn">{{serial.serial_no}}</text>
      <text class="mt-tag {{serial.tag}}">{{serial.statusLabel}}</text>
      <text class="mt-muted">{{serial.location_name}}</text>
    </view>
  </view>

  <view class="mt-card">
    <view class="mt-card-title"><text>包裹内容</text><text class="mt-muted">{{operation.package_no}}</text></view>
    <view wx:for="{{operation.contents}}" wx:for-item="content" wx:key="id" class="mt-kv">
      <text class="k">{{content.product_name || content.item_name}}</text>
      <view class="v"><view>{{content.packaging_scheme_name || ''}} × {{content.qtyText}}</view><view wx:if="{{content.serialText}}" class="mt-muted mono">{{content.serialText}}</view></view>
    </view>
  </view>

  <template is="orderInfo" data="{{info: operation.order_info}}" />

  <view class="mt-card">
    <view class="mt-card-title"><text>参与人员及工时</text><text wx:if="{{operation.allowed_actions.collaborators}}" class="tk-link" bindtap="openPeople">选择协同人 ›</text></view>
    <view wx:if="{{!operation.participants.length}}" class="mt-muted">还没人接单</view>
    <view wx:for="{{operation.participants}}" wx:for-item="person" wx:key="employee_legacy_id" class="mt-kv">
      <text class="k">{{person.name}} <text class="mt-muted">{{person.role === 'OWNER' ? '接单人' : '协同人'}}{{person.is_active ? '' : '（已移除）'}}</text></text>
      <text class="v">{{person.minutesText}}<text wx:if="{{person.is_timing}}" class="mt-tag amber"> 计时中</text></text>
    </view>
  </view>

  <view wx:if="{{operation.sessionRows.length}}" class="mt-card">
    <view class="mt-card-title"><text>计时记录</text><text class="mt-muted">最近 {{operation.sessionRows.length}} 段</text></view>
    <view wx:for="{{operation.sessionRows}}" wx:for-item="s" wx:key="id" class="mt-kv">
      <text class="k">{{s.employee_name}}</text><text class="v mono">{{s.timeText}} · {{s.minutesText}}</text>
    </view>
  </view>

  <view wx:if="{{operation.material_requirements.length || operation.materials.length}}" class="mt-card">
    <view class="mt-card-title"><text>用料</text><text wx:if="{{operation.allowed_actions.materials}}" class="tk-link" bindtap="openMaterials">登记实际用料 ›</text></view>
    <view wx:for="{{operation.material_requirements}}" wx:for-item="requirement" wx:key="item_id" class="mt-kv"><text class="k">{{requirement.item_name}}</text><text class="v">工艺用量 {{requirement.qtyText}}</text></view>
    <view wx:if="{{!operation.materials.length}}" class="mt-muted mt-gap">尚未登记实际用料</view>
    <view wx:for="{{operation.materials}}" wx:for-item="material" wx:key="id" class="mt-kv">
      <view class="k"><view>{{material.item_name}}</view><view wx:if="{{material.usageText}}" class="mt-muted">{{material.usageText}}</view><view wx:if="{{material.usageRemark}}" class="mt-muted">{{material.usageRemark}}</view></view>
      <text class="v">实际 {{material.base_qty}}</text>
    </view>
  </view>
</view>

<view wx:if="{{detailOpen}}" class="mt-footer">
  <button wx:if="{{pending}}" class="mt-btn" loading="{{busy}}" bindtap="recover">查询原操作结果</button>
  <block wx:else>
    <button wx:if="{{operation.allowed_actions.inspect && operation.shipment_operation_type === 'water_test'}}" class="mt-btn danger-ghost side" disabled="{{busy}}" data-result="failed" bindtap="openInspection">试水不合格</button>
    <button wx:if="{{operation.allowed_actions.inspect}}" class="mt-btn" disabled="{{busy}}" data-result="passed" bindtap="openInspection">{{operation.shipment_operation_type === 'water_test' ? '试水检验' : '作业质检'}}</button>
    <button wx:elif="{{operation.allowed_actions.complete}}" class="mt-btn" disabled="{{busy}}" data-action="complete" bindtap="runAction">{{operation.serialResults.length ? (operationSerialIds.length ? operationSerialIds.length + ' 台做完' : '先选设备') : '完成工序'}}</button>
    <button wx:elif="{{operation.allowed_actions.claim}}" class="mt-btn" disabled="{{busy}}" data-action="claim" bindtap="runAction">接单</button>
    <button wx:elif="{{operation.allowed_actions.start}}" class="mt-btn" disabled="{{busy}}" data-action="start" bindtap="runAction">开始计时</button>
    <button wx:else class="mt-btn ghost" bindtap="closeDetail">返回</button>
  </block>
</view>

<view wx:if="{{repairReturnOpen}}" class="packing-overlay packing-selector-overlay" catchtouchmove="stop">
  <view class="packing-dialog">
    <view class="packing-dialog-head"><text>返修合格返回</text><button disabled="{{busy}}" bindtap="closeRepairReturn">关闭</button></view>
    <scroll-view scroll-y class="packing-dialog-body">
      <view class="packing-content">{{repairReturnSerial.serial_no}} 已在车间返修合格。返回后先回成品库位，再自动移到这张发货单的待发区，重新试水。</view>
      <button class="packing-secondary" disabled="{{busy}}" bindtap="openFinishedLocator">{{finishedLocator.location_id ? finishedLocator.warehouse_name + ' / ' + finishedLocator.location_name : '选择成品仓库和库位'}}</button>
      <textarea class="packing-input packing-inspection-reason" value="{{repairReturnReason}}" bindinput="repairReturnInput" maxlength="500" placeholder="说明（如：更换密封圈后试压合格）"/>
      <view wx:if="{{repairReturnError}}" class="packing-error">{{repairReturnError}}</view>
    </scroll-view>
    <view class="packing-dialog-footer"><button class="packing-secondary" disabled="{{busy}}" bindtap="closeRepairReturn">取消</button><button class="packing-primary" disabled="{{busy}}" loading="{{busy}}" bindtap="saveRepairReturn">确认返回</button></view>
  </view>
</view>
<warehouse-locator open="{{finishedLocatorOpen}}" value="{{finishedLocator}}" location-purpose="finished" bind:confirm="chooseFinishedLocator" bind:cancel="closeFinishedLocator"/>

<view wx:if="{{peopleOpen}}" class="packing-overlay packing-selector-overlay" catchtouchmove="stop">
  <view class="packing-dialog"><view class="packing-dialog-head"><text>选择协同人</text><button disabled="{{busy}}" bindtap="closePeople">关闭</button></view><scroll-view scroll-y class="packing-dialog-body">
    <picker range="{{departments}}" range-key="name" value="{{departmentIndex}}" bindchange="chooseDepartment"><view class="packing-category">{{departments[departmentIndex].name}}　⌄</view></picker>
    <view class="packing-search"><input class="packing-input" value="{{peopleKeyword}}" bindinput="peopleInput" placeholder="姓名 / 账号" confirm-type="search" bindconfirm="searchPeople"/><button class="packing-primary" bindtap="searchPeople">查询</button></view>
    <view wx:for="{{peopleRows}}" wx:for-item="person" wx:key="legacy_id" class="packing-option" data-id="{{person.legacy_id}}" bindtap="togglePerson"><text class="packing-check">{{person.selected ? '☑' : '□'}}</text><view><text>{{person.nickname || person.username}}</text><view class="packing-muted">{{person.username}}</view></view></view>
    <view class="packing-pager"><button disabled="{{peoplePage <= 1}}" data-delta="-1" bindtap="turnPeople">上一页</button><text>{{peoplePage}} / {{peopleLast}}</text><button disabled="{{peoplePage >= peopleLast}}" data-delta="1" bindtap="turnPeople">下一页</button></view>
    <view class="packing-section-title">已选择 {{selectedPeople.length}} 人</view><view class="packing-selected"><view wx:for="{{selectedPeople}}" wx:for-item="person" wx:key="legacy_id" data-id="{{person.legacy_id}}" bindtap="togglePerson">{{person.nickname || person.username}} ×</view></view>
    <view class="packing-share-heading"><text class="packing-section-title">个人份额</text><button class="packing-secondary" disabled="{{busy || pending}}" bindtap="equalPeopleShares">平均分配</button></view>
    <view wx:for="{{shareRows}}" wx:for-item="person" wx:key="employee_legacy_id" class="packing-share-row"><text>{{person.employee_name}}{{person.employee_legacy_id === operation.owner_legacy_id ? '（接单人）' : person.has_labor && !person.is_active ? '（已参与）' : '（协同人）'}}</text><view><input class="packing-input" type="digit" value="{{person.percent}}" data-id="{{person.employee_legacy_id}}" bindinput="peopleShareInput" disabled="{{busy || pending}}"/><text>%</text></view></view>
    <view wx:if="{{peopleError}}" class="packing-error">{{peopleError}}</view>
  </scroll-view><view class="packing-dialog-footer"><button class="packing-secondary" disabled="{{busy}}" bindtap="closePeople">取消</button><button class="packing-primary" loading="{{busy}}" disabled="{{busy || (!pending && !shareRows.length)}}" bindtap="savePeople">{{pending ? '重试原操作' : '确认协同与份额'}}</button></view></view>
</view>

<view wx:if="{{materialsOpen}}" class="packing-overlay packing-selector-overlay" catchtouchmove="stop">
  <view class="packing-dialog"><view class="packing-dialog-head"><text>登记实际用料</text><button disabled="{{busy}}" bindtap="closeMaterials">关闭</button></view><scroll-view scroll-y class="packing-dialog-body">
    <view wx:for="{{operation.material_requirements}}" wx:for-item="requirement" wx:key="item_id" class="packing-content">{{requirement.item_name}} · 工艺用料数量 {{requirement.required_base_qty}}</view>
    <picker range="{{categories}}" range-key="category_name" value="{{categoryIndex}}" bindchange="chooseCategory"><view class="packing-category">{{categories[categoryIndex].category_name}}　⌄</view></picker>
    <view class="packing-search"><input class="packing-input" value="{{materialKeyword}}" bindinput="materialInput" placeholder="物料编码 / 名称 / 规格" confirm-type="search" bindconfirm="searchMaterials"/><button class="packing-primary" bindtap="searchMaterials">查询</button></view>
    <view wx:for="{{materialRows}}" wx:for-item="material" wx:key="id" class="packing-source"><view><view>{{material.item_code}} / {{material.item_name}}</view><view class="packing-muted">{{material.spec}}</view><view class="packing-muted">{{material.warehouse_name}} / {{material.location_name}} / {{material.batch_no}}</view><view>可用 {{material.quantity_available}} {{material.unit_name}}</view></view><button class="packing-secondary" disabled="{{material.selected}}" data-id="{{material.id}}" bindtap="chooseMaterial">{{material.selected ? '已添加' : '添加'}}</button></view>
    <view class="packing-pager"><button disabled="{{materialPage <= 1}}" data-delta="-1" bindtap="turnMaterials">上一页</button><text>{{materialPage}} / {{materialLast}}</text><button disabled="{{materialPage >= materialLast}}" data-delta="1" bindtap="turnMaterials">下一页</button></view>
    <view class="packing-section-title">已选库存来源</view>
    <view wx:for="{{materialDrafts}}" wx:for-item="material" wx:key="id" class="packing-content"><view>{{material.item_name}} / {{material.batch_no}}</view><view class="packing-field"><text>实际耗用数量</text><input class="packing-input packing-quantity" type="digit" value="{{material.base_qty}}" disabled="{{material.physical || material.serial_tracking_mode === 'required' || busy}}" data-id="{{material.id}}" bindinput="quantityInput"/><text>{{material.unit_name}}</text></view><view class="packing-usage-dimensions"><input class="packing-input" type="digit" placeholder="实际长 mm（可留空）" value="{{material.usage_dimensions.length_mm}}" data-id="{{material.id}}" data-axis="length_mm" bindinput="usageDimensionInput" disabled="{{busy || pending}}"/><input class="packing-input" type="digit" placeholder="实际宽 mm（可留空）" value="{{material.usage_dimensions.width_mm}}" data-id="{{material.id}}" data-axis="width_mm" bindinput="usageDimensionInput" disabled="{{busy || pending}}"/><input class="packing-input" type="digit" placeholder="实际厚 mm（可留空）" value="{{material.usage_dimensions.thickness_mm}}" data-id="{{material.id}}" data-axis="thickness_mm" bindinput="usageDimensionInput" disabled="{{busy || pending}}"/></view><view wx:if="{{!material.physical}}" class="packing-area"><button class="packing-secondary" data-id="{{material.id}}" bindtap="areaToggle" disabled="{{busy || pending}}">{{material.area.enabled ? '✓ 木板按面积扣库存' : '木板按面积扣库存'}}</button><block wx:if="{{material.area.enabled}}"><view class="packing-usage-dimensions"><input class="packing-input" type="digit" placeholder="整板长 mm" value="{{material.area.board_length_mm}}" data-id="{{material.id}}" data-field="board_length_mm" bindinput="areaInput" disabled="{{busy || pending}}"/><input class="packing-input" type="digit" placeholder="整板宽 mm" value="{{material.area.board_width_mm}}" data-id="{{material.id}}" data-field="board_width_mm" bindinput="areaInput" disabled="{{busy || pending}}"/></view><textarea class="packing-input packing-area-text" placeholder="裁切块，每行：长*宽*块数，例如 1200*600*2" value="{{material.area.pieces_text}}" data-id="{{material.id}}" data-field="pieces_text" bindinput="areaInput" disabled="{{busy || pending}}"/><view class="packing-field"><button class="packing-secondary {{material.area.remnant === 'return' ? 'packing-chosen' : ''}}" data-id="{{material.id}}" data-value="return" bindtap="areaRemnant">余板回库</button><button class="packing-secondary {{material.area.remnant === 'loss' ? 'packing-chosen' : ''}}" data-id="{{material.id}}" data-value="loss" bindtap="areaRemnant">余板算损耗</button></view><view class="packing-muted">{{material.area.text}}</view></block></view><input class="packing-input" placeholder="实际用料备注（可留空）" value="{{material.usage_remark}}" data-id="{{material.id}}" bindinput="usageRemarkInput" maxlength="500" disabled="{{busy || pending}}"/><button wx:if="{{material.physical || material.serial_tracking_mode !== 'none'}}" class="packing-secondary" data-id="{{material.id}}" bindtap="openIdentities" disabled="{{busy}}">{{material.physical ? '选择实物板料' : '选择序列号'}}（{{material.identities.length}}）</button><button class="packing-remove" data-id="{{material.id}}" bindtap="removeMaterial" disabled="{{busy}}">移除此来源</button></view>
    <view wx:if="{{materialError}}" class="packing-error">{{materialError}}</view>
  </scroll-view><view class="packing-dialog-footer"><button class="packing-secondary" disabled="{{busy}}" bindtap="closeMaterials">取消</button><button class="packing-primary" disabled="{{busy || pending}}" loading="{{busy}}" bindtap="saveMaterials">确认实际耗用</button></view></view>
</view>

<view wx:if="{{identityOpen}}" class="packing-overlay packing-identity-overlay" catchtouchmove="stop"><view class="packing-dialog"><view class="packing-dialog-head"><text>{{identityMaterial.physical ? '选择实物板料' : '选择序列号'}}</text><button bindtap="closeIdentities">关闭</button></view><scroll-view scroll-y class="packing-dialog-body">
  <view class="packing-search"><input class="packing-input" value="{{identityKeyword}}" bindinput="identityInput" placeholder="搜索实物编号 / 序列号" confirm-type="search" bindconfirm="searchIdentities"/><button class="packing-primary" bindtap="searchIdentities">查询</button></view>
  <view wx:for="{{identityRows}}" wx:for-item="identity" wx:key="id" class="packing-option" data-id="{{identity.id}}" bindtap="toggleIdentity"><text class="packing-check">{{identity.selected ? '☑' : '□'}}</text><view><view>{{identity.physical_no || identity.serial_no}}</view><view wx:if="{{identityMaterial.physical}}" class="packing-muted">{{identity.length_mm}} × {{identity.width_mm}} × {{identity.thickness_mm}} mm</view></view></view>
  <view class="packing-pager"><button disabled="{{identityPage <= 1}}" data-delta="-1" bindtap="turnIdentities">上一页</button><text>{{identityPage}} / {{identityLast}}</text><button disabled="{{identityPage >= identityLast}}" data-delta="1" bindtap="turnIdentities">下一页</button></view>
  <view class="packing-section-title">已选择 {{selectedIdentities.length}} 件</view><view class="packing-selected"><view wx:for="{{selectedIdentities}}" wx:for-item="identity" wx:key="id" data-id="{{identity.id}}" bindtap="toggleIdentity">{{identity.physical_no || identity.serial_no}} ×</view></view>
</scroll-view><view class="packing-dialog-footer"><button class="packing-secondary" bindtap="closeIdentities">取消</button><button class="packing-primary" bindtap="confirmIdentities">确认选择</button></view></view></view>

<view wx:if="{{inspectionOpen}}" class="packing-overlay packing-selector-overlay" catchtouchmove="stop">
  <view class="packing-dialog">
    <view class="packing-dialog-head"><text>{{operation.shipment_operation_type === 'water_test' ? '试水检验' : '作业质检'}}</text><button disabled="{{busy}}" bindtap="closeInspection">关闭</button></view>
    <scroll-view scroll-y class="packing-dialog-body">
      <view wx:if="{{operationSerialIds.length}}" class="packing-content">本次检验 {{operationSerialIds.length}} 台</view>
      <radio-group bindchange="inspectionChange"><label class="packing-option"><radio value="passed" checked="{{inspectionResult === 'passed'}}" color="#008b4b"/>合格</label><label class="packing-option"><radio value="failed" checked="{{inspectionResult === 'failed'}}" color="#008b4b"/>不合格，转返修</label></radio-group>
      <block wx:if="{{inspectionResult === 'failed' && operation.serialResults.length}}">
        <button class="packing-secondary" disabled="{{busy}}" bindtap="openRepairLocator">{{repairLocator.location_id ? repairLocator.warehouse_name + ' / ' + repairLocator.location_name : '选择返修仓库和库位'}}</button>
        <button wx:if="{{inspectionNeedsReturn}}" class="packing-secondary" disabled="{{busy}}" bindtap="openReworkOperations">{{returnOperation ? returnOperation.operation_name : '选择返工工序'}}</button>
      </block>
      <textarea class="packing-input packing-inspection-reason" value="{{inspectionReason}}" bindinput="inspectionInput" maxlength="500" placeholder="检验说明"/>
      <view wx:if="{{inspectionError}}" class="packing-error">{{inspectionError}}</view>
    </scroll-view>
    <view class="packing-dialog-footer"><button class="packing-secondary" disabled="{{busy}}" bindtap="closeInspection">取消</button><button class="packing-primary" disabled="{{busy || pending}}" loading="{{busy}}" bindtap="saveInspection">确认检验结果</button></view>
  </view>
</view>
<warehouse-locator open="{{repairLocatorOpen}}" value="{{repairLocator}}" location-purpose="repair" bind:confirm="chooseRepairLocator" bind:cancel="closeRepairLocator"/>
<view wx:if="{{reworkOpen}}" class="packing-overlay packing-identity-overlay" catchtouchmove="stop">
  <view class="packing-dialog">
    <view class="packing-dialog-head"><text>选择返工工序</text><button bindtap="closeReworkOperations">关闭</button></view>
    <scroll-view scroll-y class="packing-dialog-body">
      <view class="packing-search"><input class="packing-input" value="{{reworkKeyword}}" bindinput="reworkInput" placeholder="工序名称" confirm-type="search" bindconfirm="searchReworkOperations"/><button class="packing-primary" bindtap="searchReworkOperations">查询</button></view>
      <view wx:for="{{reworkRows}}" wx:key="id" class="packing-option" data-id="{{item.id}}" bindtap="chooseReworkOperation"><text>{{item.sequence}} · {{item.operation_name}}</text></view>
      <view class="packing-pager"><button disabled="{{reworkPage <= 1}}" data-delta="-1" bindtap="turnReworkOperations">上一页</button><text>{{reworkPage}} / {{reworkLast}}</text><button disabled="{{reworkPage >= reworkLast}}" data-delta="1" bindtap="turnReworkOperations">下一页</button></view>
      <view wx:if="{{reworkError}}" class="packing-error">{{reworkError}}</view>
    </scroll-view>
  </view>
</view>
