page {
  background: #f8fafc;
  color: #1e293b;
  font-size: 28rpx;
}
view, text, input, textarea, button, scroll-view, picker {
  box-sizing: border-box;
}
.packing-page {
  padding: 24rpx;
  min-width: 0;
}
.packing-page-head,
.packing-card-head,
.packing-dialog-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.packing-page-head {
  justify-content: flex-start;
  margin-bottom: 24rpx;
}
.packing-page-title,
.packing-title,
.packing-section-title {
  font-weight: 600;
}
.packing-page-title {
  font-size: 34rpx;
}
.packing-back,
.packing-dialog-head button {
  padding: 8rpx 16rpx;
  background: #fff;
  color: #475569;
  margin: 0;
  width: auto;
  font-size: 25rpx;
  line-height: 1.7;
  flex-shrink: 0;
}
.packing-search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 20rpx 0;
  min-width: 0;
}
.packing-input {
  min-width: 0;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  background: #fff;
  padding: 16rpx;
  flex: 1;
  width: 100%;
  font-size: 27rpx;
}
.packing-search .packing-primary {
  width: auto;
  flex-shrink: 0;
  padding: 15rpx 24rpx;
  margin: 0;
}
.packing-card {
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 22rpx;
  min-width: 0;
}
.packing-title {
  min-width: 0;
  word-break: break-all;
}
.packing-tag {
  border-radius: 8rpx;
  color: #00763f;
  background: #f0fdf4;
  padding: 5rpx 12rpx;
  font-size: 23rpx;
  flex-shrink: 0;
}
.packing-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 18rpx 0;
  min-width: 0;
}
.packing-field > text:last-child {
  min-width: 0;
  text-align: right;
  word-break: break-all;
}
.packing-content {
  padding: 18rpx 0;
  border-top: 1rpx solid #e2e8f0;
  line-height: 1.7;
  word-break: break-all;
}
.packing-primary,
.packing-secondary,
.packing-remove {
  margin: 12rpx 0 0;
  border-radius: 10rpx;
  font-size: 27rpx;
  line-height: 1.5;
  padding: 18rpx 20rpx;
}
.packing-primary {
  color: #fff;
  background: #008b4b;
}
.packing-secondary {
  color: #008b4b;
  background: #fff;
  border: 1rpx solid #bbf7d0;
}
.packing-remove {
  color: #b91c1c;
  background: #fff;
}
.packing-primary[disabled],
.packing-secondary[disabled] {
  opacity: 0.55;
}
.packing-empty {
  text-align: center;
  padding: 70rpx 20rpx;
  color: #64748b;
}
.packing-error {
  color: #b91c1c;
  padding: 18rpx 0;
  line-height: 1.7;
  word-break: break-all;
}
.packing-muted {
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.7;
}
.packing-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: 20rpx 0;
}
.packing-pager button {
  margin: 0;
  background: #fff;
  color: #008b4b;
  font-size: 24rpx;
  line-height: 1.7;
  padding: 12rpx 18rpx;
}
.packing-overlay {
  position: fixed;
  inset: 0;
  z-index: 50;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.42);
}
.packing-selector-overlay {
  z-index: 60;
}
.packing-identity-overlay {
  z-index: 70;
}
.packing-dialog {
  min-width: 0;
  width: 100%;
  max-width: 760rpx;
  max-height: 86vh;
  border-radius: 18rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.packing-dialog-head {
  padding: 22rpx;
  border-bottom: 1rpx solid #e2e8f0;
  flex-shrink: 0;
  font-weight: 600;
}
.packing-dialog-head > text {
  min-width: 0;
  word-break: break-all;
}
.packing-dialog-body {
  padding: 20rpx 22rpx;
  min-height: 0;
  max-height: 58vh;
  overflow-y: auto;
  width: 100%;
}
.packing-dialog-footer {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 18rpx 22rpx;
  border-top: 1rpx solid #e2e8f0;
  flex-shrink: 0;
}
.packing-dialog-footer button {
  flex: 1 1 42%;
  min-width: 0;
  margin: 0;
}
.packing-section-title {
  padding: 22rpx 0 14rpx;
}
.packing-participant {
  border-bottom: 1rpx solid #e2e8f0;
  padding: 14rpx 0;
}
.packing-participant > view {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin: 8rpx 0;
}
.packing-category {
  background: #f8fafc;
  padding: 16rpx;
  border-radius: 10rpx;
  color: #475569;
}
.packing-option {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx solid #e2e8f0;
  padding: 20rpx 0;
  min-width: 0;
}
.packing-option > view {
  min-width: 0;
  word-break: break-all;
}
.packing-check {
  color: #008b4b;
  font-size: 34rpx;
  flex-shrink: 0;
}
.packing-selected {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.packing-selected > view {
  background: #f0fdf4;
  color: #00763f;
  border-radius: 8rpx;
  padding: 8rpx 14rpx;
  max-width: 100%;
  word-break: break-all;
}
.packing-source {
  display: flex;
  align-items: center;
  gap: 14rpx;
  border-bottom: 1rpx solid #e2e8f0;
  padding: 18rpx 0;
}
.packing-source > view {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}
.packing-source button {
  flex-shrink: 0;
  margin: 0;
  font-size: 24rpx;
  padding: 12rpx 16rpx;
}
.packing-quantity {
  max-width: 220rpx;
}
.packing-inspection-reason {
  margin: 20rpx 0;
  height: 170rpx;
}
