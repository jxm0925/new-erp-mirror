page {
  background: #f4f6fa;
  color: #0c1839;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 错误提示横条 */
.error-strip {
  background: #fee2e2;
  border: 1rpx solid #fecaca;
  color: #dc2626;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

/* 顶部单据状态 Header（优雅白底微暖红调卡片，彻底去除突兀的深墨色） */
.order-hero-card {
  position: relative;
  background: linear-gradient(140deg, #ffffff 0%, #fffbfb 100%);
  border: 1rpx solid #f2dfdc;
  border-radius: 20rpx;
  padding: 24rpx 22rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 22rpx rgba(229, 38, 19, 0.05);
  box-sizing: border-box;
}

.order-hero-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
}

.order-hero-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-type-tag {
  align-self: flex-start;
  font-size: 20rpx;
  font-weight: 700;
  color: #d7190b;
  background: #fff0ef;
  border: 1rpx solid #ffd8d4;
  padding: 2rpx 14rpx;
  border-radius: 6rpx;
  letter-spacing: 0.5rpx;
}

.order-no-wrap {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
}

.order-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #94a3b8;
}

.order-no {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-status-pill {
  flex-shrink: 0;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  color: #b45309;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  font-size: 24rpx;
  font-weight: 700;
}

/* 通用卡片容器 */
.card {
  background: #ffffff;
  border: 1rpx solid #e8edf4;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(28, 45, 72, 0.045);
  box-sizing: border-box;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #f0f4f8;
  min-width: 0;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.title-mark {
  width: 8rpx;
  height: 30rpx;
  border-radius: 6rpx;
  background: #d7190b;
  flex-shrink: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 750;
  color: #0c1839;
}

.count-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #fff1f0;
  color: #d7190b;
}

.header-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #d7190b;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  padding: 8rpx 10rpx;
}

/* 模块 1：投入原料卡片 */
.source-lock-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #4b5f7d;
  background: #f1f4f9;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.source-body {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding-top: 18rpx;
  min-width: 0;
}

.source-thumb {
  width: 104rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: #edf2f8;
  flex-shrink: 0;
}

.source-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.source-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.source-type-label {
  font-size: 19rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #e9eff8;
  color: #3b5072;
  flex-shrink: 0;
}

.source-title-no {
  font-size: 27rpx;
  font-weight: 750;
  color: #0f172a;
  overflow-wrap: anywhere;
  word-break: break-all;
  line-height: 1.3;
}

.source-name {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1e293b;
  overflow-wrap: anywhere;
  word-break: break-all;
  line-height: 1.35;
}

.source-detail {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #6a7c95;
}

.source-batch {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8b9cb1;
}

/* 模块 2：正式产出 */
.products-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-top: 18rpx;
}

.product-card {
  background: #f8fafc;
  border: 1rpx solid #e3eaf4;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.product-card-top {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  min-width: 0;
}

.product-thumb {
  width: 96rpx;
  height: 92rpx;
  border-radius: 12rpx;
  background: #edf2f8;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 26rpx;
  font-weight: 750;
  color: #0c1839;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-code {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #4b5d79;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-spec {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #71829a;
  overflow-wrap: anywhere;
}

.product-remove-btn {
  padding: 6rpx;
  flex-shrink: 0;
}

.product-qty-row {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #e3eaf4;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.qty-field-label {
  font-size: 23rpx;
  font-weight: 600;
  color: #3b4e6c;
  flex-shrink: 0;
}

/* 步进器组件 */
.stepper-wrap {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #cbd7e6;
  border-radius: 10rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.stepper-btn {
  width: 52rpx;
  height: 52rpx;
  padding: 0;
  margin: 0;
  line-height: 50rpx;
  font-size: 28rpx;
  font-weight: 700;
  background: #f2f5f9;
  color: #1a2842;
  border: none;
  border-radius: 0;
}

.stepper-btn::after {
  border: none;
}

.stepper-btn.disabled {
  color: #adbcd0;
  background: #f8fafc;
}

.stepper-input {
  width: 130rpx;
  min-width: 100rpx;
  height: 52rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 750;
  color: #0f172a;
  padding: 0 4rpx;
  box-sizing: border-box;
}

.stepper-unit {
  padding: 0 12rpx 0 4rpx;
  font-size: 22rpx;
  color: #7d8da2;
  background: #ffffff;
}

/* 尺寸与重量测量网格 */
.measure-grid {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  background: #ffffff;
  padding: 14rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e7edf5;
}

.measure-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.measure-label {
  font-size: 20rpx;
  color: #687994;
}

.measure-input-box {
  display: flex;
  align-items: center;
  height: 56rpx;
  border: 1rpx solid #d4deec;
  border-radius: 8rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  background: #fafbfd;
}

.measure-input-box input {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #0c1839;
  font-weight: 600;
}

.measure-input-box .unit {
  font-size: 20rpx;
  color: #8b9cb0;
  flex-shrink: 0;
}

/* 空正式产出 */
.empty-product-zone {
  margin-top: 18rpx;
  padding: 44rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  border: 2rpx dashed #d5e0ec;
  border-radius: 16rpx;
  background: #fafbfd;
}

.empty-zone-title {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #8394ac;
}

.empty-add-btn {
  margin-top: 18rpx;
  height: 64rpx;
  padding: 0 32rpx;
  border-radius: 12rpx;
  background: #d7190b;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 64rpx;
  border: none;
}

.empty-add-btn::after {
  border: none;
}

/* 副产物与损耗 Grid */
.others-section {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f4f8;
}

.others-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
  min-width: 0;
}

.others-title {
  font-size: 26rpx;
  font-weight: 750;
  color: #1a2846;
}

.others-sub {
  font-size: 20rpx;
  color: #8394ac;
}

.others-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.other-card {
  background: #f8fafc;
  border: 1rpx solid #e3eaf4;
  border-radius: 14rpx;
  padding: 16rpx 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.other-card-hover {
  background: #eef3f9;
}

.other-icon-wrap {
  width: 58rpx;
  height: 58rpx;
  border-radius: 12rpx;
  background: #eef2f7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.other-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.other-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #0c1839;
}

.other-summary {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #7b8d9f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.other-summary.measured {
  color: #0e8c45;
  font-weight: 600;
}

/* 模块 3：产出去向流转 */
.routes-container {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-top: 18rpx;
}

.route-product-card {
  background: #f8fafc;
  border: 1rpx solid #e3eaf4;
  border-radius: 16rpx;
  padding: 18rpx;
  box-sizing: border-box;
}

.route-p-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}

.route-p-title-wrap {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}

.route-p-name {
  font-size: 26rpx;
  font-weight: 750;
  color: #0c1839;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-p-total {
  font-size: 22rpx;
  color: #6a7c95;
  flex-shrink: 0;
}

.split-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 52rpx;
  padding: 0 16rpx;
  margin: 0;
  border-radius: 10rpx;
  background: #ffffff;
  border: 1rpx solid #c8d9ed;
  color: #0870e6;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 50rpx;
  flex-shrink: 0;
}

.split-btn::after {
  border: none;
}

.route-progress-box {
  margin-top: 12rpx;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  background: #ffffff;
  border: 1rpx solid #e7edf5;
}

.progress-labels {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
}

.p-lab {
  color: #556782;
}

.p-lab .highlight {
  color: #0e8c45;
  font-weight: 750;
}

.p-lab.unassigned {
  color: #d97706;
  font-weight: 600;
}

.route-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 12rpx;
}

.route-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 14rpx;
  background: #ffffff;
  border: 1rpx solid #e7edf5;
  border-radius: 10rpx;
  min-width: 0;
}

.route-type-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 21rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.route-type-badge.warehouse {
  background: #eef9f2;
  color: #0e8c45;
}

.route-type-badge.next {
  background: #edf5ff;
  color: #0870e6;
}

.route-target-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #3b4d6b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-status-tag {
  font-size: 21rpx;
  color: #7b8d9f;
  flex-shrink: 0;
}

.route-tip-line {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  background: #f3f6fa;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 21rpx;
  color: #73849c;
  line-height: 1.45;
}

/* 底部吸底操作栏 */
.bottom-placeholder {
  height: 140rpx;
}

.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #ffffff;
  border-top: 1rpx solid #e7edf5;
  box-shadow: 0 -6rpx 20rpx rgba(18, 30, 52, 0.06);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.actions-wrapper {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  width: 100%;
}

.actions-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
}

.secondary-action-btn {
  flex: 1;
  min-width: 0;
  height: 82rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #0c1839;
  border: 1rpx solid #cbd5e1;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 80rpx;
}

.secondary-action-btn::after {
  border: none;
}

.primary-action-btn {
  flex: 1;
  min-width: 0;
  height: 82rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #e92312, #d7190b);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 750;
  box-shadow: 0 6rpx 18rpx rgba(215, 25, 11, 0.3);
  line-height: 82rpx;
  border: none;
}

.primary-action-btn::after {
  border: none;
}

.action-rule-tip {
  font-size: 20rpx;
  color: #8b9cb0;
  text-align: center;
  padding-top: 4rpx;
}

/* 全局加载态 */
.loading-state {
  min-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 模态弹窗面板 */
.overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  padding: 34rpx 24rpx;
  box-sizing: border-box;
  background: rgba(10, 20, 36, 0.62);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-panel {
  width: 100%;
  max-height: 92vh;
  padding: 28rpx 22rpx 22rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.2);
}

.modal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-width: 0;
  padding-bottom: 12rpx;
}

.modal-title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 750;
  color: #0c1839;
}

.modal-subtitle {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #7b8b9f;
}

.close-icon-wrap {
  padding: 6rpx;
  flex-shrink: 0;
}

/* 弹窗原料迷你条 */
.modal-source-mini {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  background: #f4f7fa;
  border: 1rpx solid #e2e8f1;
  font-size: 22rpx;
}

.mini-label {
  color: #687994;
}

.mini-val {
  font-weight: 700;
  color: #0c1839;
}

/* 搜索栏 */
.modal-search {
  height: 72rpx;
  margin-top: 14rpx;
  padding-left: 18rpx;
  border: 1rpx solid #d8e2ed;
  border-radius: 12rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.search-input {
  min-width: 0;
  margin-left: 12rpx;
  flex: 1;
  font-size: 24rpx;
  color: #0c1839;
}

.modal-search-btn {
  height: 100%;
  padding: 0 26rpx;
  margin: 0;
  background: linear-gradient(135deg, #e92312, #d7190b);
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 10rpx 10rpx 0;
  border: none;
}

.modal-search-btn::after {
  border: none;
}

/* 选产出联动主体 */
.picker-body {
  flex: 1 1 480rpx;
  max-height: 48vh;
  min-height: 360rpx;
  margin-top: 14rpx;
  border: 1rpx solid #dfe6ef;
  border-radius: 14rpx;
  display: flex;
  overflow: hidden;
}

.category-list {
  width: 154rpx;
  background: #f6f8fb;
  border-right: 1rpx solid #e7ecf2;
}

.category-item {
  min-height: 72rpx;
  padding: 20rpx 12rpx;
  box-sizing: border-box;
  color: #4b5e7d;
  font-size: 23rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  border-left: 6rpx solid transparent;
}

.category-item.active {
  border-left-color: #d7190b;
  color: #d7190b;
  background: #ffffff;
  font-weight: 750;
}

.category-item.more {
  color: #8c9cb0;
  font-size: 20rpx;
}

.category-name {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.candidate-area {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.candidate-list {
  min-height: 0;
  flex: 1;
}

.candidate-item {
  padding: 16rpx 14rpx;
  border-bottom: 1rpx solid #edf1f6;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.candidate-item.selected {
  background: #fff4f3;
}

.candidate-thumb {
  width: 80rpx;
  height: 76rpx;
  border-radius: 10rpx;
  background: #f1f4f8;
  flex-shrink: 0;
}

.candidate-info {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.candidate-name {
  font-size: 24rpx;
  font-weight: 750;
  color: #0c1839;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.candidate-spec {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: #3b4d6a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.candidate-avail {
  margin-top: 2rpx;
  font-size: 19rpx;
  color: #72839b;
  overflow-wrap: anywhere;
}

.radio-circle {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #b8c4d4;
  border-radius: 50%;
  box-sizing: border-box;
  flex-shrink: 0;
}

.radio-circle.checked {
  border: 9rpx solid #d7190b;
  background: #ffffff;
}

/* 弹窗分页 */
.modal-pager {
  height: 64rpx;
  border-top: 1rpx solid #e6ecf4;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx;
  box-sizing: border-box;
  background: #fafbfd;
}

.mpager-btn {
  height: 46rpx;
  margin: 0;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: #ffffff;
  border: 1rpx solid #d4deec;
  color: #1e2c48;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 44rpx;
  flex-shrink: 0;
}

.mpager-btn::after {
  border: none;
}

.mpager-text {
  font-size: 20rpx;
  color: #64758e;
}

/* 弹窗小空态 */
.empty-state.small {
  padding: 40rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.small-empty-text {
  font-size: 22rpx;
  color: #92a0b3;
}

/* 选中产出及步进器 */
.selected-product-box {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #f4f7fb;
  border: 1rpx solid #e1e8f2;
}

.sel-prod-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10rpx;
  min-width: 0;
}

.sel-prod-name {
  font-size: 25rpx;
  font-weight: 750;
  color: #0c1839;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sel-prod-spec {
  font-size: 21rpx;
  color: #6c7e96;
  flex-shrink: 0;
}

.sel-prod-stepper-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stepper-label {
  font-size: 22rpx;
  color: #4c5e7b;
}

.stepper-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #cbd7e6;
  border-radius: 8rpx;
  overflow: hidden;
}

.s-btn {
  width: 50rpx;
  height: 50rpx;
  padding: 0;
  margin: 0;
  line-height: 48rpx;
  font-size: 26rpx;
  font-weight: 700;
  background: #f1f4f8;
  color: #263652;
  border: none;
  border-radius: 0;
}

.s-btn::after {
  border: none;
}

.s-input {
  width: 120rpx;
  min-width: 90rpx;
  height: 50rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 700;
  color: #0f172a;
  padding: 0 4rpx;
  box-sizing: border-box;
}

.s-unit {
  padding: 0 10rpx 0 2rpx;
  font-size: 21rpx;
  color: #7a8ba1;
}

/* 弹窗测量表单 */
.modal-measure-stack {
  margin-top: 10rpx;
}

.modal-measure-grid {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.modal-measure-grid-3 {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.m-field {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.m-label {
  font-size: 21rpx;
  color: #556782;
}

.m-input {
  height: 60rpx;
  padding: 0 12rpx;
  border: 1rpx solid #d4deec;
  border-radius: 8rpx;
  background: #ffffff;
  font-size: 24rpx;
  color: #0c1839;
  box-sizing: border-box;
}

/* 弹窗操作按钮 */
.modal-actions {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: 1fr 1.6fr;
  gap: 16rpx;
  flex-shrink: 0;
}

.modal-cancel-btn {
  height: 76rpx;
  border-radius: 12rpx;
  background: #f1f4f9;
  color: #4b5e7d;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 76rpx;
  border: none;
}

.modal-cancel-btn::after {
  border: none;
}

.modal-confirm-btn {
  height: 76rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #e92312, #d7190b);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 76rpx;
  border: none;
  box-shadow: 0 4rpx 14rpx rgba(215, 25, 11, 0.25);
}

.modal-confirm-btn::after {
  border: none;
}

/* 弹窗 2：登记其他结果 */
.measure-tabs {
  margin-top: 14rpx;
  padding: 6rpx;
  border-radius: 12rpx;
  background: #eef2f7;
  display: flex;
  gap: 8rpx;
}

.measure-tab {
  flex: 1;
  height: 60rpx;
  border-radius: 9rpx;
  color: #556782;
  font-size: 23rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.measure-tab.active {
  color: #d7190b;
  background: #ffffff;
  font-weight: 750;
  box-shadow: 0 4rpx 10rpx rgba(20, 35, 60, 0.08);
}

.other-form-content {
  margin-top: 14rpx;
}

.source-note-box {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #f5f7fa;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #6a7c95;
}

.add-entry-btn {
  margin-top: 14rpx;
  height: 64rpx;
  border-radius: 10rpx;
  background: #ffffff;
  border: 1rpx solid #c8d8ec;
  color: #0870e6;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  line-height: 62rpx;
}

.add-entry-btn::after {
  border: none;
}

/* 弹窗 3：拆分去向 */
.split-modal {
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.split-modal-scroll {
  flex: 1 1 auto;
  min-height: 0;
  max-height: calc(88vh - 200rpx);
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
  padding: 4rpx 2rpx;
}

.split-stats-bar {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-around;
  padding: 14rpx 10rpx;
  background: #f4f7fb;
  border: 1rpx solid #e1e8f2;
  border-radius: 12rpx;
}

.s-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.s-lab {
  font-size: 20rpx;
  color: #7b8d9f;
}

.s-val {
  font-size: 28rpx;
  font-weight: 800;
  color: #0c1839;
  margin-top: 2rpx;
}

.s-val.green {
  color: #0e8c45;
}

.s-val.red {
  color: #d7190b;
}

.existing-routes-section {
  margin-top: 14rpx;
}

.existing-routes-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #3b4e6d;
}

.existing-routes-list {
  max-height: 240rpx;
  margin-top: 8rpx;
  border: 1rpx solid #e1e8f2;
  border-radius: 12rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.existing-route-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 14rpx 16rpx;
  border-bottom: 1rpx solid #eef2f7;
  background: #ffffff;
  box-sizing: border-box;
}

.existing-route-card:last-child {
  border-bottom: none;
}

.ex-route-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.ex-route-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.ex-route-tag.warehouse {
  background: #eef9f2;
  color: #0e8c45;
}

.ex-route-tag.next {
  background: #edf5ff;
  color: #0870e6;
}

.ex-remove-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #d7190b;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
  padding: 4rpx 8rpx;
}

.ex-locked {
  font-size: 20rpx;
  color: #8b9cb0;
  flex-shrink: 0;
}

.ex-route-bottom {
  display: flex;
  align-items: center;
  min-width: 0;
}

.ex-route-target {
  font-size: 23rpx;
  color: #475569;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.target-select-list {
  max-height: 320rpx;
  margin-top: 12rpx;
  border: 1rpx solid #e1e8f2;
  border-radius: 12rpx;
}

.target-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  border-bottom: 1rpx solid #edf1f6;
  min-width: 0;
}

.target-card.selected {
  background: #fff4f3;
}

.target-card-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.target-title {
  font-size: 23rpx;
  font-weight: 700;
  color: #0c1839;
}

.target-sub {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #6a7c95;
}

.assign-qty-box {
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #f4f7fb;
  border: 1rpx solid #e1e8f2;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 响应式断点适配 */
@media (max-width: 360px) {
  .page {
    padding: 16rpx 16rpx calc(48rpx + env(safe-area-inset-bottom));
  }
  .others-grid {
    grid-template-columns: 1fr;
  }
  .measure-grid {
    grid-template-columns: 1fr;
  }
  .source-thumb, .product-thumb {
    width: 80rpx;
    height: 76rpx;
  }
  .modal-measure-grid {
    grid-template-columns: 1fr;
  }
}

@media (min-width: 431px) {
  .page {
    max-width: 860rpx;
    margin: 0 auto;
  }
  .bottom-action-bar {
    max-width: 860rpx;
    left: 50%;
    transform: translateX(-50%);
  }
  .modal-panel {
    max-width: 810rpx;
  }
}
