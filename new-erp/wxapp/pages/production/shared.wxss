/* 生产工单 / 工序报工 / 开料 / 发货作业 统一红底工作台样式（对齐 pages/production/hub/index） */
page {
  background: #f5f6f8;
  color: #1f2329;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

view, text, input, textarea, button, scroll-view, picker {
  box-sizing: border-box;
}

.mt-page {
  min-height: 100vh;
  padding: 0 24rpx 48rpx;
  min-width: 0;
}

.mt-page.has-footer {
  padding-bottom: 190rpx;
}

/* 顶部精简红底 Hero 区（对齐 hub/index） */
.wo-hero {
  margin: 0 -24rpx 20rpx;
  padding: 20rpx 28rpx 30rpx;
  background: linear-gradient(135deg, #d81e06 0%, #ef1008 60%, #ff4d3a 100%);
  border-bottom-left-radius: 34rpx;
  border-bottom-right-radius: 34rpx;
  color: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(216, 30, 6, 0.2);
  position: relative;
  overflow: hidden;
}

.wo-hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.wo-hero-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.3;
  flex: 1;
  min-width: 0;
}

.wo-hero-pill {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.38);
  font-size: 23rpx;
  font-weight: 700;
  color: #ffffff;
  flex-shrink: 0;
  white-space: nowrap;
}

.wo-hero-spec {
  margin-top: 10rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.94);
  line-height: 1.45;
  word-break: break-all;
}

.wo-hero-meta {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.86);
  flex-wrap: wrap;
}

.wo-hero-link {
  font-size: 23rpx;
  font-weight: 700;
  color: #ffffff;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.16);
  flex-shrink: 0;
}

/* 顶部内嵌白底圆角搜索栏 */
.wo-hero-search {
  margin-top: 18rpx;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 8rpx 10rpx 8rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.08);
}

.wo-hero-input {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  font-size: 26rpx;
  color: #1f2329;
}

.wo-hero-clear {
  width: 38rpx;
  height: 38rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #e2e8f0;
  color: #475569;
  font-size: 25rpx;
  flex-shrink: 0;
}

.wo-hero-search-btn {
  margin: 0;
  padding: 0 30rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #d81e06 0%, #ef1008 100%);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.wo-hero-search-btn::after {
  border: 0;
}

/* 兼容旧抬头与文字语义类 */
.mt-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 4rpx 16rpx;
}

.mt-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2329;
}

.mt-sub {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.mt-muted {
  color: #64748b;
  font-size: 24rpx;
}

.mt-red {
  color: #d81e06;
  font-size: 24rpx;
  font-weight: 700;
}

.mt-rework {
  color: #d81e06;
}

.mt-green {
  color: #059669;
  font-weight: 700;
}

/* 白底圆角分段 Tabs */
.mt-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 22rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid rgba(15, 23, 42, 0.04);
}

.mt-tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  color: #64748b;
  font-size: 26rpx;
  border-bottom: 5rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.mt-tab.on {
  color: #d81e06;
  border-color: #d81e06;
  font-weight: 800;
}

/* 搜索栏（非 Hero 内嵌时） */
.mt-search {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.mt-input {
  flex: 1;
  min-width: 0;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 999rpx;
  padding: 14rpx 26rpx;
  font-size: 26rpx;
  height: 74rpx;
}

/* 统一白底圆角卡片（对齐 hub/index） */
.mt-card {
  background: #ffffff;
  border-radius: 26rpx;
  padding: 26rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(15, 23, 42, 0.05);
}

/* 带左侧红色竖条的卡片标题栏 */
.mt-card-title {
  font-weight: 800;
  font-size: 28rpx;
  color: #1f2329;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  position: relative;
  padding-left: 18rpx;
}

.mt-card-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 7rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: #d81e06;
}

.mt-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.mt-gap {
  margin-top: 14rpx;
}

.mt-op {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2329;
}

.mt-product {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
  margin: 8rpx 0 4rpx;
}

/* 胶囊徽标 */
.mt-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
  align-items: center;
}

.mt-tag {
  font-size: 21rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 700;
  white-space: nowrap;
}

.mt-tag.red {
  background: #fff1f0;
  color: #d81e06;
}

.mt-tag.amber {
  background: #fff7ed;
  color: #d97706;
}

.mt-tag.purple {
  background: #f3e8ff;
  color: #7c3aed;
}

.mt-tag.green {
  background: #ecfdf5;
  color: #059669;
}

.mt-tag.gray {
  background: #f1f5f9;
  color: #475569;
}

.mt-tag.blue {
  background: #f0f9ff;
  color: #0284c7;
}

/* 进度条 */
.mt-bar {
  height: 12rpx;
  background: #f1f5f9;
  border-radius: 999rpx;
  margin: 12rpx 0 4rpx;
  overflow: hidden;
}

.mt-bar-in {
  height: 100%;
  background: linear-gradient(90deg, #d81e06 0%, #ff4d3a 100%);
  border-radius: 999rpx;
}

/* 按钮体系（对齐 hub/index 红底胶囊，弹性居中消除微信 v2 button 偏移） */
.mt-btn {
  margin: 18rpx 0 0;
  width: 100%;
  min-height: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #d81e06 0%, #ef1008 100%);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0 28rpx;
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(216, 30, 6, 0.2);
  box-sizing: border-box;
}

.mt-btn::after {
  border: 0;
}

.mt-btn.ghost {
  background: #fff5f5;
  color: #d81e06;
  border: 2rpx solid #d81e06;
  box-shadow: none;
}

.mt-btn.danger {
  background: #dc2626;
  color: #ffffff;
}

.mt-btn.danger-ghost {
  background: #fff5f5;
  color: #d81e06;
  border: 2rpx solid #fca5a5;
  box-shadow: none;
}

.mt-btn[disabled] {
  opacity: 0.48;
  box-shadow: none;
}

.mt-btn-mini {
  width: auto !important;
  min-height: 70rpx;
  height: 70rpx;
  margin: 0;
  padding: 0 30rpx;
  font-size: 25rpx;
  line-height: 1.2;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 极简“左二右二”两行用料/明细项（v2 核心规范） */
.clean-item-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.clean-item-row:first-of-type {
  padding-top: 6rpx;
}

.clean-item-row:last-of-type {
  border-bottom: 0;
  padding-bottom: 4rpx;
}

.clean-item-left {
  flex: 1;
  min-width: 0;
}

.clean-item-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.4;
  word-break: break-all;
}

.clean-item-spec {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.45;
  word-break: break-all;
}

.clean-item-right {
  text-align: right;
  flex-shrink: 0;
}

.clean-item-req {
  font-size: 27rpx;
  font-weight: 800;
  color: #1f2329;
  line-height: 1.4;
}

.clean-item-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #059669;
  line-height: 1.4;
}

.clean-item-sub.short {
  color: #d81e06;
}

.mt-error {
  background: #fff1f0;
  border: 1rpx solid #ffccc7;
  color: #cf1322;
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 16rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.mt-note {
  background: #fffbeb;
  border-left: 6rpx solid #f59e0b;
  color: #92400e;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  font-size: 24rpx;
  margin-top: 12rpx;
  line-height: 1.55;
}

.mt-empty {
  background: #ffffff;
  border-radius: 26rpx;
  text-align: center;
  color: #64748b;
  padding: 72rpx 32rpx;
  margin-top: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.mt-pager {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
  margin: 14rpx 0 24rpx;
  color: #475569;
}

.mt-foot {
  text-align: center;
  color: #64748b;
  font-size: 24rpx;
  padding: 14rpx 20rpx;
}

.mt-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  box-shadow: 0 -6rpx 24rpx rgba(15, 23, 42, 0.06);
  border-top: 1rpx solid #edf2f7;
  z-index: 20;
}

.mt-footer .mt-btn {
  margin: 0;
}

.mt-footer .mt-btn.side {
  flex: 0 0 36%;
}

.mt-kv {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
  font-size: 26rpx;
}

.mt-kv:last-child {
  border-bottom: 0;
}

.mt-kv .k {
  color: #64748b;
  flex-shrink: 0;
}

.mt-kv .v {
  text-align: right;
  color: #1f2329;
  font-weight: 600;
  word-break: break-all;
}

.mono {
  font-family: Menlo, Consolas, monospace;
}

.oi-phone {
  color: #d81e06;
  font-weight: 700;
  margin-left: 8rpx;
}

/* 物料折叠摘要栏（需用几项、已齐几项、缺几项） */
.tk-mat-summary-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 16rpx 22rpx;
  margin-top: 4rpx;
}

.tk-mat-summary-text {
  font-size: 25rpx;
  color: #475569;
  font-weight: 600;
}

.tk-num-bold {
  font-weight: 800;
  color: #1e293b;
}

.tk-num-green {
  font-weight: 800;
  color: #059669;
}

.tk-num-red {
  font-weight: 800;
  color: #d81e06;
}

.tk-mat-summary-toggle {
  font-size: 23rpx;
  font-weight: 700;
  color: #d81e06;
  flex-shrink: 0;
}

/* 车间物料配送签收表格 */
.tk-dlv-table {
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  overflow: hidden;
  margin-top: 12rpx;
  background: #ffffff;
}

.tk-dlv-tr {
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
  border-bottom: 1rpx solid #f1f5f9;
  font-size: 24rpx;
  color: #1e293b;
}

.tk-dlv-tr:last-child {
  border-bottom: none;
}

.tk-dlv-th {
  background: #f8fafc;
  border-bottom: 1rpx solid #e2e8f0;
  font-size: 23rpx;
  font-weight: 700;
  color: #475569;
}

.tk-dlv-td {
  box-sizing: border-box;
  word-break: break-all;
  line-height: 1.4;
}

.tk-dlv-td.col-name {
  width: 40%;
  padding-right: 10rpx;
  font-weight: 600;
}

.tk-dlv-td.col-spec {
  width: 40%;
  padding-right: 10rpx;
  color: #475569;
  font-size: 23rpx;
}

.tk-dlv-td.col-qty {
  width: 20%;
  text-align: right;
  font-weight: 800;
  color: #d81e06;
  flex-shrink: 0;
}

.tk-dlv-th .tk-dlv-td.col-qty {
  color: #475569;
}
