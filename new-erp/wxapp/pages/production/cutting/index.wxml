<view class="mt-page has-footer">
  <!-- 顶部精简红底栏 -->
  <view class="wo-hero">
    <view class="wo-hero-top">
      <text class="wo-hero-title">随单开料 · {{opName || '下料'}}</text>
      <text class="wo-hero-pill">{{remaining > 0 ? '待开料 ' + remaining + ' 套' : '已全部开料'}}</text>
    </view>
    <view class="wo-hero-spec">按工单 BOM 规格领用板材／管材，切割完成后登记实际产出与余料</view>
  </view>

  <view wx:if="{{error}}" class="mt-error">{{error}}</view>
  <view wx:if="{{loading && !ready}}" class="mt-empty">正在读取开料资料…</view>

  <block wx:if="{{ready}}">
    <!-- 下料要求与规格型号 -->
    <view class="mt-card">
      <view class="mt-card-title"><text>下料零件与规格型号</text><text class="mt-muted">{{remaining > 0 ? '剩余 ' + remaining + ' 套待开料' : '已全部开料'}}</text></view>
      <view wx:for="{{requirements}}" wx:key="part_key" class="clean-item-row">
        <view class="clean-item-left">
          <view class="clean-item-name">{{item.part_name}}</view>
          <view class="clean-item-spec">规格型号：{{item.item_name}}{{item.specification ? ' · ' + item.specification : ''}} · {{item.sizeText}}</view>
        </view>
        <view class="clean-item-right">
          <view class="clean-item-req">本次 {{item.thisText}}</view>
        </view>
      </view>
      <view wx:if="{{canIssue}}" class="mt-kv mt-gap">
        <text class="k" style="color: #1f2329; font-weight: 700;">本次开料套数</text>
        <view class="ct-step">
          <text class="ct-step-btn {{unitQty <= 1 ? 'off' : ''}}" data-delta="-1" bindtap="changeUnits">−</text>
          <input class="ct-step-input" type="number" value="{{unitQty}}" bindblur="unitsInput" />
          <text class="ct-step-btn {{unitQty >= remaining ? 'off' : ''}}" data-delta="1" bindtap="changeUnits">+</text>
        </view>
      </view>
    </view>

    <!-- 实际领用原料 -->
    <view wx:if="{{canIssue}}" class="mt-card">
      <view class="mt-card-title"><text>实际领用原料</text><text class="tk-link red" bindtap="openSources">{{sources.length ? '重新选择 ›' : '选择库存原料 ›'}}</text></view>
      <view wx:if="{{!sources.length}}" class="mt-muted">请选择本次实际投入切割的整板、整管或库存余料</view>
      <view wx:for="{{sources}}" wx:key="source_key" class="clean-item-row">
        <view class="clean-item-left">
          <view class="clean-item-name mono">{{item.physical_no || item.batch_no}}</view>
          <view class="clean-item-spec">{{item.item_name}} · {{item.warehouse_name}} / {{item.location_name}}</view>
        </view>
        <view class="clean-item-right">
          <view class="clean-item-req {{item.mode === 'length' ? 'ct-measure' : ''}}">{{item.qtyText}}</view>
        </view>
      </view>
      <view wx:if="{{sources.length}}" class="ct-actions">
        <button class="mt-btn ghost" disabled="{{busy}}" data-retain="0" bindtap="calculate">计算排料方案</button>
      </view>
    </view>

    <!-- 原料排料与切割明细 -->
    <view wx:if="{{groups.length}}" class="mt-card">
      <view class="mt-card-title"><text>原料排料与切割明细</text><text class="mt-muted">支持人工调整件数</text></view>
      <view wx:for="{{groups}}" wx:key="source_key" wx:for-item="group" wx:for-index="g" class="ct-group">
        <view class="ct-group-head mono">{{group.name}}</view>
        <view class="mt-muted">{{group.sizeText}} · {{group.summaryText}}</view>
        <view wx:for="{{group.rows}}" wx:key="part_key" wx:for-index="r" class="ct-line mt-gap">
          <text class="k">{{item.partName}} <text class="mt-muted">{{item.partSize}}</text></text>
          <input class="ct-input" type="digit" value="{{item.qty}}" data-g="{{g}}" data-r="{{r}}" bindinput="groupQtyInput" />
          <text>{{item.partUnit}}</text>
        </view>
      </view>
      <view class="ct-actions">
        <button class="mt-btn ghost" disabled="{{busy || planChecked}}" data-retain="1" bindtap="calculate">{{planChecked ? '排料方案已校验' : '修改数量后重新校验'}}</button>
      </view>
      <view class="ct-confirm" bindtap="togglePlanConfirmed">
        <view class="tk-check {{planConfirmed ? 'on' : ''}}">{{planConfirmed ? '✓' : ''}}</view>
        <text class="{{planChecked ? '' : 'mt-muted'}}">已核对实际领用原料与各板件／管件切割数量</text>
      </view>
    </view>

    <!-- 开料批次记录 -->
    <view class="mt-card">
      <view class="mt-card-title"><text>开料批次记录</text><text class="tk-link red" bindtap="load">刷新</text></view>
      <view wx:if="{{!batches.length}}" class="mt-muted">暂无开料批次记录</view>
      <view wx:for="{{batches}}" wx:key="id" class="ct-row" data-id="{{item.id}}" bindtap="openBatch">
        <view class="ct-line">
          <text class="k mono" style="font-weight: 700;">{{item.batch_no}}</text>
          <text class="mt-tag {{item.status === 'settled' ? 'green' : 'amber'}}">{{item.statusText}}</text>
        </view>
        <view class="mt-muted">{{item.status === 'settled' ? '实际完工 ' + item.completed_unit_qty : '计划开料 ' + item.unit_qty}} 套 · {{item.sourceText}}</view>
        <view class="tk-link {{item.status === 'settled' ? '' : 'red'}} mt-gap">{{item.status === 'settled' ? '查看登记详情 ›' : item.status === 'awaiting_confirm' ? '余料待仓库确认 ›' : '登记实际产出与余料 ›'}}</view>
      </view>
    </view>
    <view wx:if="{{!canIssue && remaining > 0}}" class="mt-note">当前工单未处于生产中状态，暂不可领料开料。</view>
  </block>
</view>

<view wx:if="{{canIssue && groups.length}}" class="mt-footer">
  <button class="mt-btn" disabled="{{busy || !planChecked || !planConfirmed}}" bindtap="issue">确认排料方案并领出原料</button>
</view>

<!-- 选择库存原料弹窗 -->
<view wx:if="{{panel === 'sources'}}" class="tk-mask" catchtouchmove="stop">
  <view class="tk-sheet">
    <view class="mt-row tk-sheet-head"><text class="mt-title">选择库存原料</text><text class="mt-muted">已选 {{pickedCount}} 条</text></view>
    <production-select
      wx:if="{{items.length > 1}}"
      options="{{items}}"
      label-key="label"
      value="{{itemIndex}}"
      icon="orders-o"
      prefix="开料物料："
      bind:change="pickItem"
    />
    <view wx:else class="ct-select">{{items[0].label}}</view>
    <view class="mt-search">
      <input class="mt-input" value="{{keyword}}" bindinput="keywordInput" placeholder="搜索实物编号 / 批次 / 仓库库位" confirm-type="search" bindconfirm="searchSources" />
      <button class="mt-btn mt-btn-mini" bindtap="searchSources">查询</button>
    </view>
    <scroll-view scroll-y class="tk-sheet-body">
      <view wx:if="{{sourceError}}" class="mt-error">{{sourceError}}</view>
      <view wx:if="{{sourceLoading}}" class="mt-muted">正在读取可用库存…</view>
      <view wx:elif="{{!rows.length}}" class="mt-muted">当前物料暂无可用库存</view>
      <view wx:for="{{rows}}" wx:key="source_key" class="ct-row">
        <view class="ct-line" data-key="{{item.source_key}}" bindtap="toggleSource">
          <view class="tk-check {{picked[item.source_key] ? 'on' : ''}}">{{picked[item.source_key] ? '✓' : ''}}</view>
          <text class="k mono">{{item.nameText}}</text>
          <text class="mt-muted">可用 {{item.availableText}} {{item.unitText}}</text>
        </view>
        <view wx:if="{{item.mode === 'length'}}" class="ct-measure">{{item.sizeText}}<text wx:if="{{item.totalText}}"> · 共 {{item.totalText}}</text></view>
        <view class="mt-muted">{{item.mode === 'length' ? '' : item.sizeText + ' · '}}{{item.placeText}}</view>
        <view wx:if="{{picked[item.source_key] && item.countable}}" class="ct-line mt-gap">
          <text class="k">本次领用数量</text>
          <input class="ct-input" type="{{item.unit_kind === 'm' ? 'digit' : 'number'}}" value="{{picked[item.source_key].qty}}" data-key="{{item.source_key}}" bindinput="pickedQtyInput" />
          <text>{{item.unitText}}</text>
          <text wx:if="{{picked[item.source_key].metersText}}" class="ct-measure">= {{picked[item.source_key].metersText}}</text>
        </view>
      </view>
      <view wx:if="{{lastPage > 1}}" class="mt-pager">
        <button class="mt-btn ghost mt-btn-mini" disabled="{{page <= 1}}" data-delta="-1" bindtap="turnPage">上一页</button>
        <text>{{page}} / {{lastPage}}</text>
        <button class="mt-btn ghost mt-btn-mini" disabled="{{page >= lastPage}}" data-delta="1" bindtap="turnPage">下一页</button>
      </view>
    </scroll-view>
    <view class="tk-sheet-foot">
      <button class="mt-btn ghost side" bindtap="closePanel">取消</button>
      <button class="mt-btn" disabled="{{!pickedCount}}" bindtap="confirmSources">确认选用原料</button>
    </view>
  </view>
</view>

<!-- 登记产出与余料弹窗 -->
<view wx:if="{{panel === 'batch'}}" class="tk-mask" catchtouchmove="stop">
  <view class="tk-sheet">
    <view class="mt-row tk-sheet-head"><text class="mt-title">{{batch.status === 'issued' ? '登记实际产出与余料' : '开料登记详情'}}</text><text class="mt-muted mono">{{batch.batch_no}}</text></view><view wx:if="{{batch.waiting_reason}}" class="mt-note">{{batch.waiting_reason}}</view><button wx:if="{{batch.remnant_receipt.id}}" class="mt-btn plain" data-id="{{batch.remnant_receipt.id}}" bindtap="openRemnantReceipt">查看余料入库申请</button>
    <scroll-view scroll-y class="tk-sheet-body">
      <view class="mt-kv">
        <text class="k">实际完成套数</text>
        <view wx:if="{{batch.status === 'issued'}}" class="ct-step">
          <text class="ct-step-btn {{actualUnits <= 1 ? 'off' : ''}}" data-delta="-1" bindtap="changeActualUnits">−</text>
          <input class="ct-step-input" type="number" value="{{actualUnits}}" bindblur="changeActualUnits" />
          <text class="ct-step-btn {{actualUnits >= batch.unit_qty ? 'off' : ''}}" data-delta="1" bindtap="changeActualUnits">+</text>
        </view>
        <text wx:else>{{actualUnits}} 套</text>
      </view>
      <view wx:if="{{batch.status === 'issued' && actualUnits < batch.unit_qty}}" class="mt-muted">若实际完成套数少于计划套数，请同步核改下方各零件实际切出数量。</view>
      <view class="mt-card-title mt-gap">实际产出明细</view>
      <view wx:for="{{actual}}" wx:key="rowKey" class="ct-row">
        <view class="mt-muted mono">{{item.sourceName}}</view>
        <view class="ct-line">
          <text class="k">{{item.partName}} <text class="mt-muted">{{item.partSize}}</text></text>
          <input wx:if="{{batch.status === 'issued'}}" class="ct-input" type="digit" value="{{item.qty}}" data-index="{{index}}" bindinput="actualQtyInput" />
          <text wx:else>{{item.qty}}</text>
          <text>{{item.partUnit}}</text>
        </view>
      </view>
      <view class="mt-card-title mt-gap">余料确认（板材按面积 m²，管材按长度 m）</view>
      <view wx:for="{{remnants}}" wx:key="source_key" class="ct-row">
        <view class="ct-line">
          <text class="k mono">{{item.sourceName}}</text>
          <input wx:if="{{batch.status === 'issued'}}" class="ct-input" type="digit" value="{{item.measure_qty}}" data-index="{{index}}" bindinput="remnantInput" />
          <text wx:else>{{item.measure_qty}}</text>
          <text>{{item.unitText}}</text>
        </view>
        <view wx:if="{{item.measure_qty > 0}}" class="ct-line mt-gap">
          <text class="k mt-muted">余料回库库位</text>
          <text wx:if="{{batch.status === 'issued'}}" class="ct-locator" data-index="{{index}}" bindtap="openLocator">{{item.location_id ? item.warehouse_name + ' / ' + item.location_name : '选择仓库与库位'}} ›</text>
          <text wx:else>{{item.warehouse_name}} / {{item.location_name}}</text>
        </view>
      </view>
      <block wx:if="{{batch.status === 'issued'}}">
        <textarea class="tk-textarea mt-gap" value="{{remark}}" maxlength="500" placeholder="填写开料备注说明（选填）" bindinput="remarkInput" />
        <view class="ct-confirm" bindtap="toggleConfirmed">
          <view class="tk-check {{confirmed ? 'on' : ''}}">{{confirmed ? '✓' : ''}}</view><text>已人工核对实际产出件数与余料数据</text>
        </view>
      </block>
    </scroll-view>
    <view class="tk-sheet-foot">
      <button class="mt-btn ghost side" disabled="{{busy}}" bindtap="closePanel">关闭</button>
      <button wx:if="{{batch.status === 'issued'}}" class="mt-btn" disabled="{{busy || !confirmed}}" bindtap="settle">确认登记</button>
    </view>
  </view>
</view>

<warehouse-locator open="{{locatorOpen}}" value="{{locatorValue}}" location-purpose="general" bind:confirm="chooseLocator" bind:cancel="closeLocator"/>
<production-dialog id="prodDialog" />
