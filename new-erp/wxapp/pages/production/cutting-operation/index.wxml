<view class="operation-page" wx:if="{{!loading}}">
  <view class="error" wx:if="{{error}}" bindtap="load">{{error}}</view>
  <view class="card order-card">
    <view class="order-line"><text class="muted">工单号</text><text class="order-number">{{detail.work_order_no}}</text><text class="date">{{detail.planned_date || ''}}</text></view>
    <view class="product-hero"><image src="/static/images/cutting-plate.png" mode="aspectFit"/><view class="hero-text"><text class="hero-name">{{detail.output.item_name}}</text><text class="muted">规格：{{sizeLabel}}</text><text class="muted">计划数量：{{target.planned_base_qty}} {{detail.output.unit_name}}</text></view></view>
  </view>
  <view class="card progress-card">
    <view class="timer-row"><text class="timer-label">作业计时</text><text class="timer-value">{{timer}}</text><text class="timer-minutes">（工时：{{minutes}}分）</text><button wx:if="{{!completed}}" class="timer-button" loading="{{busy}}" disabled="{{busy}}" bindtap="toggleTimer">{{target.my_labor.status === 'ACTIVE' ? '暂停' : (target.started_at ? '继续' : '开工')}}</button></view>
    <view class="steps"><view class="step {{step >= 1 ? 'active' : ''}}"><view class="step-dot {{step > 1 ? 'done' : ''}}"><van-icon wx:if="{{step > 1}}" name="success"/><text wx:else>1</text></view><text>用料</text><text class="step-note">{{batches.length ? '已领用' : '待选择'}}</text></view><view class="step-track {{step > 1 ? 'done' : ''}}"/><view class="step {{step >= 2 ? 'active' : ''}}"><view class="step-dot {{step > 2 ? 'done' : ''}}"><van-icon wx:if="{{step > 2}}" name="success"/><text wx:else>2</text></view><text>产出</text><text class="step-note">{{step === 2 ? '进行中' : (step > 2 ? '已登记' : '-')}}</text></view><view class="step-track {{completed ? 'done' : ''}}"/><view class="step {{step === 3 ? 'active' : ''}}"><view class="step-dot {{completed ? 'done' : ''}}"><van-icon wx:if="{{completed}}" name="success"/><text wx:else>3</text></view><text>完成</text><text class="step-note">{{completed ? target.status_label : (step === 3 ? '核对结果' : '-')}}</text></view></view>
  </view>
  <view class="card material-card">
    <view class="material-summary" bindtap="toggleSource"><image src="/static/images/cutting-plate.png" mode="aspectFit"/><view class="material-summary-text"><text class="strong">{{source.id ? '已领用：' : '实际用料'}}</text><text>{{source.physical_no || source.batch_no || '待选择'}}{{source.id ? ' · ' + (source.item_name || '') + ' · ' + source.quantityLabel + (source.physical_material_id ? '张' : '根') : ''}}</text></view><view class="blue expand">{{expanded || step === 1 ? '收起' : '展开'}}<van-icon name="{{expanded || step === 1 ? 'arrow-up' : 'arrow-down'}}"/></view></view>
    <view wx:if="{{expanded || step === 1}}" class="material-content">
      <view class="batch-row {{source.id === item.id ? 'selected' : ''}}" wx:for="{{batches}}" wx:key="id" data-id="{{item.id}}" bindtap="selectBatch"><view><text class="strong">{{item.label}}</text><text class="muted">{{item.item_name}} · {{item.quantityLabel}}{{item.physical_material_id ? '张' : '根'}}</text></view><van-icon name="{{source.id === item.id ? 'checked' : 'circle'}}"/></view>
      <view class="pagination" wx:if="{{batchLastPage > 1}}"><button data-delta="-1" bindtap="batchPage" disabled="{{batchPage <= 1}}">上一页</button><text>{{batchPage}} / {{batchLastPage}}</text><button data-delta="1" bindtap="batchPage" disabled="{{batchPage >= batchLastPage}}">下一页</button></view>
      <button wx:if="{{!completed}}" class="add-material" bindtap="openMaterials"><van-icon name="plus"/>添加已收材料</button>
    </view>
  </view>
  <view class="card results-card" wx:if="{{step >= 2 && source.id}}">
    <view class="section-heading"><text class="section-title">本次加工结果</text><text class="blue" bindtap="drawings">查看图纸 <van-icon name="arrow"/></text></view>
    <view class="compact-product"><image src="/static/images/cutting-plate.png" mode="aspectFit"/><view class="compact-name"><text class="strong">{{detail.output.item_name}}</text><text class="muted">{{sizeLabel}}</text></view><view class="compact-quantity"><text class="quantity-label">加工数量</text><view class="stepper"><button disabled="{{step === 3 || busy}}" data-delta="-1" bindtap="bumpQuantity">−</button><input disabled="{{step === 3 || busy}}" type="digit" value="{{actualQty}}" bindinput="onQuantity"/><button disabled="{{step === 3 || busy}}" data-delta="1" bindtap="bumpQuantity">+</button><text class="unit">{{detail.output.unit_name}}</text></view></view></view>
    <view class="result-row" data-type="usable_remnant" bindtap="openOther"><image src="/static/images/cutting-plate.png" mode="aspectFit"/><view class="result-row-text"><text class="strong">可用余料</text><text class="muted">{{remnantSummary}}</text></view><van-icon wx:if="{{!completed}}" name="arrow"/></view>
    <view class="result-row" data-type="loss" bindtap="openOther"><van-icon class="result-icon" name="delete-o"/><view class="result-row-text"><text class="strong">废料与损耗</text><text class="muted">{{lossSummary}}</text></view><van-icon wx:if="{{!completed}}" name="arrow"/></view>
    <button wx:if="{{step === 2 && !completed}}" class="save-add blue" bindtap="saveAndAdd" disabled="{{busy}}">保存结果，继续添加用料</button>
  </view>
  <view class="card next-card" wx:if="{{step >= 2}}"><view class="section-title">下游工序</view><view class="next-operation"><van-icon name="setting-o"/><view><text class="strong">{{detail.next_operation.name || '成品入库'}}</text><text class="muted" wx:if="{{detail.next_operation}}">工序号：{{detail.next_operation.code}}</text></view><text class="muted">{{completed ? target.status_label : '待加工'}}</text></view>
    <view wx:if="{{step === 3 && !completed && target.output_mode_snapshot === 'warehouse_optional' && detail.next_operation}}" class="disposition"><button class="{{disposition === 'direct_handover' ? 'chosen' : ''}}" data-value="direct_handover" bindtap="chooseDisposition">直接交接</button><button class="{{disposition === 'warehouse' ? 'chosen' : ''}}" data-value="warehouse" bindtap="chooseDisposition">交仓库入库</button></view>
  </view>
  <view class="page-actions" wx:if="{{!completed}}"><button class="secondary" disabled="{{busy}}" bindtap="previous">上一步</button><button wx:if="{{step < 3}}" class="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="next">{{step === 1 ? '下一步：登记产出' : '下一步：核对结果'}}</button><button wx:else class="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="finish">确认完成工序</button></view>
  <button wx:else class="primary finished-back" bindtap="back">返回工序</button>
</view>
<view wx:else class="loading">加载中…</view>
<view class="overlay" wx:if="{{showMaterials}}" catchtap="closeMaterials"><view class="selector" catchtap="noop"><view class="modal-heading"><text>选择已收材料</text><van-icon name="cross" bindtap="closeMaterials"/></view><view class="search"><input placeholder="编码 / 名称 / 规格" value="{{keyword}}" bindinput="onSearch" bindconfirm="search"/><button bindtap="search">搜索</button></view><view class="selector-body"><scroll-view scroll-y class="categories"><view class="category {{!categoryId ? 'chosen' : ''}}" bindtap="category">全部</view><view class="category {{categoryId === item.id ? 'chosen' : ''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="category">{{item.category_name}}</view><button wx:if="{{categoryPage < categoryLastPage}}" bindtap="categoryMore">更多分类</button></scroll-view><scroll-view scroll-y class="candidates"><view class="candidate {{selected.key === item.key ? 'chosen' : ''}}" wx:for="{{candidates}}" wx:key="key" data-key="{{item.key}}" bindtap="chooseMaterial"><text class="strong">{{item.physical_no || item.item_code}}</text><text>{{item.item_name}}</text><text class="muted">{{item.sizeLabel}} · {{item.physical_material_id ? '1 张' : item.availableLabel + ' 根'}}</text><text class="muted">批次 {{item.batch_no}}</text></view><view class="empty" wx:if="{{!candidates.length}}">暂无可使用的已收材料</view></scroll-view></view><view class="pagination"><button data-delta="-1" bindtap="materialPage" disabled="{{page <= 1}}">上一页</button><text>{{page}} / {{lastPage}}</text><button data-delta="1" bindtap="materialPage" disabled="{{page >= lastPage}}">下一页</button></view><view class="root-quantity" wx:if="{{selected && !selected.physical_material_id}}"><text>本次使用根数</text><input type="number" value="{{rootQty}}" bindinput="onRootQty"/></view><button class="primary" disabled="{{!selected || busy}}" loading="{{busy}}" bindtap="useMaterial">确认用料</button></view></view>
<view class="overlay" wx:if="{{showOther}}" catchtap="closeOther"><view class="other-editor" catchtap="noop"><view class="modal-heading"><text>{{otherType === 'usable_remnant' ? '可用余料' : '废料与损耗'}}</text><van-icon name="cross" bindtap="closeOther"/></view><scroll-view scroll-y class="other-scroll"><view class="saved-other" wx:for="{{otherRows}}" wx:key="client_row_id"><view data-index="{{index}}" bindtap="editOther"><text>{{item.result_type === 'usable_remnant' ? '余料' : (item.result_type === 'process_loss' ? '损耗' : (item.result_type === 'recyclable_scrap' ? '回收废料' : '不合格产出'))}} · {{item.actual_qty}}</text><text wx:if="{{item.measurements.length_mm}}">{{item.measurements.length_mm}} {{item.measurements.width_mm ? '× ' + item.measurements.width_mm : ''}} mm</text></view><van-icon name="delete-o" data-index="{{index}}" bindtap="removeOther"/></view><view wx:if="{{otherType !== 'usable_remnant'}}" class="loss-types"><button class="{{otherDraft.result_type === 'process_loss' ? 'chosen' : ''}}" data-type="process_loss" bindtap="lossType">加工损耗</button><button class="{{otherDraft.result_type === 'recyclable_scrap' ? 'chosen' : ''}}" data-type="recyclable_scrap" bindtap="lossType">回收废料</button><button class="{{otherDraft.result_type === 'scrapped_output' ? 'chosen' : ''}}" data-type="scrapped_output" bindtap="lossType">不合格产出</button></view><view class="field"><text>{{otherDraft.result_type === 'usable_remnant' || otherDraft.result_type === 'scrapped_output' ? '数量' : '实际重量'}}</text><input type="digit" value="{{otherDraft.actual_qty}}" data-field="actual_qty" bindinput="otherField"/><text>{{otherDraft.result_type === 'usable_remnant' ? (source.physical_material_id ? '块' : '根') : (otherDraft.result_type === 'scrapped_output' ? '件' : 'kg')}}</text></view><block wx:if="{{otherDraft.result_type === 'usable_remnant' || otherDraft.result_type === 'scrapped_output'}}"><view class="field"><text>长度</text><input type="digit" value="{{otherDraft.length_mm}}" data-field="length_mm" bindinput="otherField"/><text>mm</text></view><view class="field" wx:if="{{source.physical_material_id}}"><text>宽度</text><input type="digit" value="{{otherDraft.width_mm}}" data-field="width_mm" bindinput="otherField"/><text>mm</text></view></block><button class="secondary" bindtap="saveOtherRow">{{editingIndex >= 0 ? '保存修改' : '添加记录'}}</button></scroll-view><button class="primary" bindtap="confirmOthers">确认</button></view></view>
