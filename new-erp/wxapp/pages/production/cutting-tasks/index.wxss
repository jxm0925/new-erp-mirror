
/* 页面基础容器与响应式适配 */
page {
  background: #f4f6fa;
  color: #0c1839;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 顶部工段看板 Hero Card */
.hero-card {
  position: relative;
  background: linear-gradient(140deg, #ffffff 0%, #fdf8f7 100%);
  border: 1rpx solid #f0e3e1;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 26rpx rgba(229, 38, 19, 0.05);
  box-sizing: border-box;
}

.hero-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
}

.hero-title-group {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.hero-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.hero-mark {
  width: 8rpx;
  height: 32rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #f23827, #d7190b);
  flex-shrink: 0;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 750;
  color: #0c1839;
  letter-spacing: 0.5rpx;
  line-height: 1.25;
}

.hero-subtitle {
  margin-top: 8rpx;
  color: #687994;
  font-size: 22rpx;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 72rpx;
  padding: 0 28rpx;
  margin: 0;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #e92312, #d7190b);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(215, 25, 11, 0.28);
  border: none;
  line-height: 72rpx;
}

.hero-btn::after {
  border: none;
}

.hero-btn-hover {
  opacity: 0.9;
  transform: scale(0.97);
}

/* 控件区：分段 Tabs 与搜索栏 */
.control-panel {
  margin-bottom: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tabs {
  display: flex;
  background: #e9eff7;
  padding: 6rpx;
  border-radius: 16rpx;
  gap: 8rpx;
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  color: #556885;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s ease;
  min-width: 0;
}

.tab-item.active {
  background: #ffffff;
  color: #d7190b;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(25, 42, 70, 0.08);
}

.tab-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.search-input-wrap {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 76rpx;
  background: #ffffff;
  border: 1rpx solid #e1e7f0;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  padding: 0 10rpx 0 18rpx;
  box-sizing: border-box;
}

.search-icon {
  flex-shrink: 0;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #0f172a;
  height: 100%;
}

.search-placeholder {
  color: #98a5b8;
  font-size: 24rpx;
}

.clear-btn {
  height: 100%;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 5;
  box-sizing: border-box;
}

.search-btn {
  flex-shrink: 0;
  height: 76rpx;
  padding: 0 32rpx;
  margin: 0;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #e92312, #d7190b);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 76rpx;
  border: none;
  box-shadow: 0 4rpx 14rpx rgba(215, 25, 11, 0.25);
}

.search-btn::after {
  border: none;
}

.search-btn-hover {
  opacity: 0.9;
  transform: scale(0.97);
}

/* 任务卡片列表 */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.task-card {
  background: #ffffff;
  border: 1rpx solid #e8edf4;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(28, 45, 72, 0.045);
  box-sizing: border-box;
  transition: transform 0.15s ease;
}

.task-card-hover {
  background: #fafcfe;
  transform: scale(0.99);
}

.task-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #f0f3f8;
  min-width: 0;
}

.task-no-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}

.task-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: #f0f3f8;
  color: #4a5d7c;
}

.task-no {
  font-size: 29rpx;
  font-weight: 750;
  color: #0c1839;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-badge {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.task-badge.running {
  background: #edf5ff;
  color: #0870e6;
  border: 1rpx solid #c8e0fd;
}

.task-badge.completed {
  background: #eef9f2;
  color: #0e8c45;
  border: 1rpx solid #c7edd4;
}

.task-badge.pending {
  background: #fff8eb;
  color: #b54708;
  border: 1rpx solid #fedf89;
}

.task-body {
  padding: 18rpx 0 14rpx;
}

.task-fact-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.fact-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.fact-icon {
  flex-shrink: 0;
}

.fact-label {
  flex-shrink: 0;
  color: #71839d;
  font-size: 23rpx;
}

.fact-val {
  min-width: 0;
  flex: 1;
  font-size: 24rpx;
  color: #101c37;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fact-val.highlight {
  color: #0f172a;
}

.fact-val.output-highlight {
  color: #0f172a;
  font-weight: 750;
}

.task-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 14rpx;
  border-top: 1rpx dashed #edf1f6;
  color: #8c9cb2;
  font-size: 22rpx;
}

.task-arrow-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 空态与加载 */
.empty-state {
  padding: 80rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

.empty-title {
  margin-top: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #4a5c78;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #92a1b5;
}

.empty-state.error .error-msg {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #d92d20;
}

.empty-state.error .retry-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #718299;
  text-decoration: underline;
}

/* 分页器 */
.pager-bar {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border: 1rpx solid #e6ecf4;
  border-radius: 18rpx;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
  gap: 12rpx;
}

.pager-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 64rpx;
  padding: 0 20rpx;
  margin: 0;
  border-radius: 12rpx;
  background: #f4f6fa;
  color: #1a2744;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 64rpx;
  border: none;
  flex-shrink: 0;
}

.pager-btn::after {
  border: none;
}

.pager-btn.disabled {
  color: #adbcd0;
  background: #f8fafc;
  opacity: 0.6;
}

.pager-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  flex: 1;
}

.pager-pages {
  font-size: 24rpx;
  font-weight: 600;
  color: #4b5d7a;
}

.pager-pages .curr {
  color: #d7190b;
  font-weight: 750;
}

.pager-total {
  font-size: 20rpx;
  color: #8e9db0;
  margin-top: 2rpx;
}

/* 响应式断点适配 */
@media (max-width: 360px) {
  .page {
    padding: 18rpx 16rpx calc(36rpx + env(safe-area-inset-bottom));
  }
  .hero-card {
    padding: 22rpx 18rpx;
  }
  .hero-title {
    font-size: 32rpx;
  }
  .hero-btn {
    height: 66rpx;
    padding: 0 20rpx;
    font-size: 24rpx;
  }
  .task-card {
    padding: 20rpx 18rpx;
  }
  .task-fact-row {
    grid-template-columns: 1fr;
    gap: 10rpx;
  }
  .pager-btn {
    padding: 0 14rpx;
    font-size: 22rpx;
  }
}

@media (min-width: 431px) {
  .page {
    max-width: 860rpx;
    margin: 0 auto;
  }
}

