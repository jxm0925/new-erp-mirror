page { background: #f5f6f8; color: #1d2129; }
.queue-page { padding: 20rpx; }
.intro,.card,.trace-card { background: #fff; border-radius: 16rpx; padding: 22rpx; margin-bottom: 16rpx; }
.intro { border-left: 7rpx solid #d81e06; display: flex; flex-direction: column; gap: 8rpx; }
.intro strong { font-size: 30rpx; }.intro text { color: #7c828c; font-size: 22rpx; line-height: 1.5; }
.state { min-height: 60vh; display: flex; align-items: center; justify-content: center; }
.head { display: flex; align-items: center; justify-content: space-between; }.head strong { font-size: 27rpx; }.head text { color: #d81e06; font-size: 23rpx; }
.product { font-size: 30rpx; font-weight: 650; margin: 18rpx 0; }
.meta { display: flex; flex-direction: column; gap: 10rpx; color: #6f7580; font-size: 23rpx; }
.notice { color: #f26722; background: #fff7ed; padding: 14rpx; margin-top: 18rpx; border-radius: 8rpx; font-size: 22rpx; }
.actions { display: flex; gap: 14rpx; margin-top: 20rpx; }
button.primary,button.outline { flex: 1; height: 68rpx; line-height: 68rpx; border-radius: 9rpx; padding: 0; font-size: 25rpx; }
button.primary { color: #fff; background: #d81e06; } button.outline { color: #d81e06; background: #fff; border: 1rpx solid #d81e06; } button::after { border: 0; }
.trace-card view { min-height: 58rpx; display: flex; justify-content: space-between; align-items: center; border-bottom: 1rpx solid #eceef1; font-size: 23rpx; }
