page { background: #f5f6f8; color: #1d2129; }
.queue-page { padding: 20rpx; }
.card,.trace-card { background: #fff; border-radius: 16rpx; padding: 26rpx; margin-bottom: 18rpx; }
.state { min-height: 60vh; display: flex; align-items: center; justify-content: center; }
.head { display: flex; align-items: center; justify-content: space-between; }.head strong { font-size: 30rpx; }.head text { color: #d81e06; font-size: 27rpx; }
.product { font-size: 32rpx; font-weight: 650; margin: 20rpx 0; }
.meta { display: flex; flex-direction: column; gap: 14rpx; color: #5f6570; font-size: 27rpx; line-height: 1.45; }
.enter { margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid #eceef1; display: flex; justify-content: flex-end; align-items: center; gap: 10rpx; color: #d81e06; font-size: 28rpx; }
.actions { display: flex; gap: 14rpx; margin-top: 20rpx; }
button.primary,button.outline { flex: 1; height: 76rpx; line-height: 76rpx; border-radius: 9rpx; padding: 0; font-size: 28rpx; }
button.primary { color: #fff; background: #d81e06; } button.outline { color: #d81e06; background: #fff; border: 1rpx solid #d81e06; } button::after { border: 0; }
.trace-card view { min-height: 66rpx; display: flex; justify-content: space-between; align-items: center; border-bottom: 1rpx solid #eceef1; font-size: 27rpx; }
.public-filter {
  display: flex;
  gap: 8rpx;
  padding: 12rpx;
  margin-bottom: 18rpx;
  border-radius: 16rpx;
  background: #fff;
  box-sizing: border-box;
}
.public-filter-item {
  flex: 1 1 0;
  min-width: 0;
  padding: 14rpx 4rpx;
  border-radius: 8rpx;
  color: #64748b;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.4;
  box-sizing: border-box;
}
.public-filter-item.active {
  color: #00763f;
  background: #f0fdf4;
  font-weight: 600;
}
.operation-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.operation-line > text {
  overflow-wrap: anywhere;
}
.public-operation-tag {
  flex-shrink: 0;
  padding: 3rpx 10rpx;
  border: 1rpx solid #bbf7d0;
  border-radius: 6rpx;
  color: #00763f;
  background: #f0fdf4;
  font-size: 22rpx;
  line-height: 1.4;
  box-sizing: border-box;
}
