<view class="workbench-page">
  <view wx:if="{{!authenticated}}" class="login-card">
    <view class="login-icon-box"><van-icon name="manager-o" size="88rpx" color="#e52613" /></view>
    <strong class="login-title">未登录统一生产账号</strong>
    <text class="login-desc">登录后查看实时生产概况和现场执行任务</text>
    <button class="login-btn" bindtap="openLogin">立即登录</button>
  </view>

  <block wx:else>
    <view class="overview-card">
      <view class="overview-header">
        <view class="overview-title-wrap"><view class="title-mark"></view><text class="overview-title">生产概况</text></view>
        <text class="trend-title">近7日生产趋势</text>
      </view>

      <view class="overview-main">
        <view class="summary-panel">
          <text class="summary-label">总任务</text>
          <strong class="summary-total">{{overview.total}}</strong>
          <view class="summary-divider"></view>
          <text class="summary-label rate-label">完成率</text>
          <strong class="summary-rate">{{overview.completionRate}}</strong>
          <view class="rate-track"><view class="rate-fill" style="width: {{overview.completionRate === '—' ? 0 : overview.completionRate}}"></view></view>
        </view>

        <view class="trend-panel">
          <view class="trend-axis"><text wx:for="{{trendTicks}}" wx:key="*this">{{item}}</text></view>
          <view class="trend-content">
            <canvas class="trend-canvas" id="trendCanvas" canvas-id="trendChart"></canvas>
            <view class="trend-labels"><text wx:for="{{trend}}" wx:key="date">{{item.label}}</text></view>
          </view>
        </view>
      </view>

      <view wx:if="{{loading}}" class="overview-loading"><van-loading color="#e52613" size="32rpx">加载生产事实</van-loading></view>

      <view class="status-row">
        <view class="status-item" data-filter="running" bindtap="goTasksWithFilter"><view class="status-label"><view class="status-dot running"></view><text>进行中</text></view><strong>{{overview.running}}</strong></view>
        <view class="status-item" data-filter="waiting" bindtap="goTasksWithFilter"><view class="status-label"><view class="status-dot waiting"></view><text>待处理</text></view><strong>{{overview.waiting}}</strong></view>
        <view class="status-item" data-filter="completed" bindtap="goTasksWithFilter"><view class="status-label"><view class="status-dot completed"></view><text>已完成</text></view><strong>{{overview.completed}}</strong></view>
        <view class="status-item" data-filter="all" bindtap="goTasksWithFilter"><view class="status-label"><view class="status-dot exception"></view><text>异常</text></view><strong>{{overview.exception}}</strong></view>
      </view>
    </view>

    <view class="shortcut-grid">
      <view class="shortcut-card" wx:for="{{shortcuts}}" wx:key="key" data-key="{{item.key}}" bindtap="openShortcut">
        <view class="badge" wx:if="{{item.count !== null && item.count > 0}}">{{item.count > 99 ? '99+' : item.count}}</view>
        <view class="shortcut-icon"><van-icon name="{{item.icon}}" size="64rpx" color="#e52613" /></view>
        <view class="shortcut-copy"><strong>{{item.title}}</strong><text>{{item.subtitle}}</text></view>
        <van-icon class="shortcut-arrow" name="arrow" size="34rpx" color="#9aa4b5" />
      </view>
    </view>
  </block>
</view>
<LoginPopup class="LoginPopup"></LoginPopup>
