page {
  background: #f3f6f9;
  color: #101725;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
}

.workbench-page {
  min-height: 100vh;
  padding: 26rpx 24rpx calc(52rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.overview-card,
.shortcut-card,
.login-card { box-sizing: border-box; background: #fff; border: 1rpx solid #eef1f5; box-shadow: 0 8rpx 28rpx rgba(38, 52, 70, 0.06); }

.overview-card { position: relative; padding: 28rpx 22rpx 24rpx; border-radius: 20rpx; overflow: hidden; }
.overview-header { display: flex; align-items: center; justify-content: space-between; min-width: 0; }
.overview-title-wrap { display: flex; align-items: center; min-width: 0; }
.title-mark { width: 9rpx; height: 38rpx; margin-right: 16rpx; border-radius: 8rpx; background: #ee2b1b; flex: 0 0 auto; }
.overview-title { font-size: 34rpx; font-weight: 700; line-height: 1.25; white-space: nowrap; }
.trend-title { color: #8994a8; font-size: 23rpx; white-space: nowrap; }

.overview-main { display: flex; gap: 18rpx; margin-top: 28rpx; min-width: 0; }
.summary-panel { width: 174rpx; min-width: 0; padding: 24rpx 22rpx 20rpx; border-radius: 18rpx; background: linear-gradient(150deg, #fff8f7, #fffafa); box-sizing: border-box; flex: 0 0 auto; }
.summary-label { display: block; color: #7f8ba0; font-size: 24rpx; }
.summary-total { display: block; margin-top: 4rpx; color: #e52613; font-size: 58rpx; line-height: 1.15; font-weight: 750; }
.summary-divider { height: 1rpx; margin: 20rpx 0 18rpx; background: #dfe4eb; }
.rate-label { margin-bottom: 4rpx; }
.summary-rate { display: block; font-size: 35rpx; line-height: 1.25; }
.rate-track { height: 13rpx; margin-top: 14rpx; overflow: hidden; border-radius: 9rpx; background: #e9edf2; }
.rate-fill { min-width: 0; max-width: 100%; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #f3311d, #de1507); }

.trend-panel { min-width: 0; flex: 1; display: flex; height: 224rpx; }
.trend-axis { width: 28rpx; padding: 6rpx 0 34rpx; color: #8c97a9; font-size: 18rpx; display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box; }
.trend-content { min-width: 0; flex: 1; }
.trend-canvas { width: 100%; height: 184rpx; }
.trend-labels { height: 34rpx; display: flex; align-items: flex-end; }
.trend-labels text { width: 14.285%; color: #778297; font-size: 18rpx; text-align: center; white-space: nowrap; transform: scale(.92); }
.overview-loading { position: absolute; inset: 82rpx 20rpx 112rpx; background: rgba(255,255,255,.82); display: flex; align-items: center; justify-content: center; }

.status-row { display: flex; margin-top: 26rpx; padding-top: 20rpx; border-top: 1rpx solid #f0f2f5; }
.status-item { position: relative; flex: 1; min-width: 0; text-align: center; }
.status-item:not(:last-child)::after { content: ""; position: absolute; top: 6rpx; right: 0; width: 1rpx; height: 66rpx; background: #e2e6ec; }
.status-label { display: flex; align-items: center; justify-content: center; gap: 8rpx; color: #303846; font-size: 23rpx; white-space: nowrap; }
.status-dot { width: 17rpx; height: 17rpx; border-radius: 50%; flex: 0 0 auto; }
.status-dot.running { background: #e52613; }
.status-dot.waiting { background: #ff941f; }
.status-dot.completed { background: #36ba73; }
.status-dot.exception { background: #9aa4b5; }
.status-item strong { display: block; margin-top: 8rpx; font-size: 34rpx; line-height: 1.15; }

.shortcut-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; margin-top: 24rpx; }
.shortcut-card { position: relative; min-width: 0; height: 274rpx; padding: 28rpx 22rpx 24rpx; border-radius: 18rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.shortcut-card:active { background: #fffafa; transform: scale(.985); }
.shortcut-icon { width: 112rpx; height: 112rpx; border-radius: 50%; background: linear-gradient(145deg, #fff3f2, #fffafa); display: flex; align-items: center; justify-content: center; }
.shortcut-copy { min-width: 0; margin-top: 18rpx; text-align: center; }
.shortcut-copy strong { display: block; font-size: 31rpx; line-height: 1.3; white-space: nowrap; }
.shortcut-copy text { display: block; margin-top: 8rpx; color: #8b96a9; font-size: 23rpx; white-space: nowrap; }
.shortcut-arrow { position: absolute; right: 18rpx; bottom: 67rpx; }
.badge { position: absolute; z-index: 2; top: 16rpx; right: 18rpx; min-width: 44rpx; height: 44rpx; padding: 0 9rpx; border-radius: 24rpx; box-sizing: border-box; color: #fff; background: #e52613; box-shadow: 0 5rpx 12rpx rgba(229,38,19,.25); font-size: 24rpx; font-weight: 600; line-height: 44rpx; text-align: center; }

.login-card { margin-top: 130rpx; padding: 64rpx 42rpx; border-radius: 20rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.login-icon-box { width: 132rpx; height: 132rpx; border-radius: 50%; background: #fff2f0; display: flex; align-items: center; justify-content: center; }
.login-title { margin-top: 26rpx; font-size: 34rpx; }
.login-desc { margin-top: 14rpx; color: #8590a3; font-size: 25rpx; line-height: 1.5; }
.login-btn { width: 300rpx; height: 78rpx; margin-top: 36rpx; border: 0; border-radius: 40rpx; color: #fff; background: #e52613; font-size: 29rpx; line-height: 78rpx; }
.login-btn::after { border: 0; }

@media (max-width: 360px) {
  .workbench-page { padding-left: 18rpx; padding-right: 18rpx; }
  .overview-card { padding-left: 18rpx; padding-right: 18rpx; }
  .overview-main { gap: 12rpx; }
  .summary-panel { width: 158rpx; padding-left: 18rpx; padding-right: 18rpx; }
  .trend-title { font-size: 21rpx; }
  .status-label { gap: 5rpx; font-size: 21rpx; }
  .status-dot { width: 14rpx; height: 14rpx; }
  .shortcut-grid { gap: 14rpx; }
  .shortcut-card { height: 260rpx; padding-left: 16rpx; padding-right: 16rpx; }
  .shortcut-copy strong { font-size: 29rpx; }
  .shortcut-copy text { font-size: 21rpx; }
}

@media (min-width: 431px) {
  .workbench-page { max-width: 860rpx; margin: 0 auto; }
  .shortcut-card { height: 250rpx; }
}
