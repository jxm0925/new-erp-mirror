page { background: #f7f7f7; color: #111; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif; }
.workbench-page { min-height: 100vh; padding: 22rpx 30rpx 50rpx; box-sizing: border-box; }
.today-card { padding: 28rpx 34rpx 24rpx; border-radius: 20rpx; color: #fff; background: linear-gradient(135deg, #f52216 0%, #d81e06 72%, #c11704 100%); box-shadow: 0 10rpx 28rpx rgba(216,30,6,.18); }
.today-title { font-size: 32rpx; }.user-name { margin-top: 10rpx; font-size: 31rpx; }
.stat-row { display: flex; margin-top: 24rpx; }
.stat-row view { flex: 1; display: flex; flex-direction: column; align-items: center; border-right: 1rpx solid rgba(255,255,255,.72); }
.stat-row view:last-child { border-right: 0; }.stat-row text { font-size: 28rpx; }.stat-row strong { margin-top: 8rpx; font-size: 48rpx; line-height: 1; }
.shortcut-grid { margin-top: 20rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.shortcut-card { min-height: 154rpx; position: relative; border-radius: 18rpx; background: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; box-shadow: 0 6rpx 20rpx rgba(0,0,0,.045); }
.shortcut-card text { font-size: 29rpx; font-weight: 500; }.badge { position: absolute; right: 14rpx; top: 12rpx; min-width: 38rpx; height: 38rpx; padding: 0 7rpx; box-sizing: border-box; border-radius: 20rpx; color: #fff; background: #e9271a; text-align: center; line-height: 38rpx; font-size: 24rpx; }
.section-title { margin: 28rpx 4rpx 14rpx; font-size: 32rpx; font-weight: 600; }
.task-card { margin-bottom: 16rpx; padding: 24rpx 26rpx; border-radius: 18rpx; background: #fff; box-shadow: 0 6rpx 20rpx rgba(0,0,0,.04); }
.task-head { display: flex; justify-content: space-between; align-items: center; }.task-head strong { font-size: 30rpx; }.task-head text { color: #d81e06; font-size: 28rpx; }
.task-line { margin-top: 15rpx; display: grid; grid-template-columns: 150rpx 1fr; font-size: 28rpx; line-height: 1.45; }.task-line text { color: #6b6f76; }.task-line strong { font-weight: 500; }
.task-card button { height: 72rpx; margin-top: 20rpx; border: 0; border-radius: 10rpx; color: #fff; background: #d81e06; font-size: 29rpx; line-height: 72rpx; }.task-card button::after { border: 0; }
.state { min-height: 260rpx; display: flex; justify-content: center; align-items: center; }
.login-card { margin-top: 180rpx; padding: 56rpx 40rpx; border-radius: 18rpx; background: #fff; display: flex; flex-direction: column; align-items: center; }.login-card strong { margin-top: 22rpx; font-size: 32rpx; }.login-card button { width: 280rpx; height: 78rpx; margin-top: 30rpx; border: 0; border-radius: 39rpx; color: #fff; background: #d81e06; font-size: 29rpx; line-height: 78rpx; }.login-card button::after { border: 0; }
