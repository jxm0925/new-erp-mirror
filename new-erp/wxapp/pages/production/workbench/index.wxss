page {
  background: #f6f7f9;
  color: #1d2129;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

.workbench-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
}

/* 未登录引导卡片 */
.login-card {
  margin-top: 140rpx;
  padding: 68rpx 48rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.login-icon-box {
  width: 136rpx;
  height: 136rpx;
  border-radius: 68rpx;
  background: #fff1f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-title {
  margin-top: 28rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1d2129;
}

.login-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #86909c;
  max-width: 480rpx;
}

.login-btn {
  width: 320rpx;
  height: 84rpx;
  margin-top: 40rpx;
  border: 0;
  border-radius: 42rpx;
  color: #ffffff;
  background: #d81e06;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 84rpx;
  box-shadow: 0 8rpx 20rpx rgba(216, 30, 6, 0.28);
}

.login-btn::after {
  border: 0;
}

/* 顶部今日作业红底卡片 */
.today-card {
  padding: 30rpx 32rpx 28rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #e3260e 0%, #d81e06 65%, #b81503 100%);
  box-shadow: 0 10rpx 26rpx rgba(216, 30, 6, 0.22);
}

.today-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.today-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.user-chip {
  max-width: 360rpx;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
}

.user-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stat-row {
  display: flex;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.stat-item:not(:last-child)::after {
  content: "";
  position: absolute;
  right: 0;
  top: 15%;
  height: 70%;
  width: 1rpx;
  background: rgba(255, 255, 255, 0.25);
}

.stat-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.stat-value {
  margin-top: 10rpx;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.1;
  font-family: -apple-system, BlinkMacSystemFont, "DIN Alternate", "Roboto", sans-serif;
}

.stat-value.highlight {
  color: #ffffff;
}

/* 6 宫格快捷业务入口 */
.shortcut-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.shortcut-card {
  height: 164rpx;
  position: relative;
  border-radius: 18rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #edf0f3;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.03);
  transition: transform 0.15s ease, background 0.15s ease;
}

.shortcut-card:active {
  background: #fafafa;
  transform: scale(0.98);
}

.shortcut-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #fff2f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shortcut-text {
  margin-top: 12rpx;
  font-size: 27rpx;
  font-weight: 500;
  color: #272a30;
}

.badge {
  position: absolute;
  right: 12rpx;
  top: 10rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  color: #ffffff;
  background: #d81e06;
  text-align: center;
  line-height: 36rpx;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(216, 30, 6, 0.35);
}

/* 区域标题 */
.section-head {
  margin: 34rpx 4rpx 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d2129;
}

.section-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 26rpx;
  color: #86909c;
}

/* 状态加载与空态 */
.state-box {
  min-height: 260rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 40rpx;
  box-sizing: border-box;
  border: 1rpx solid #edf0f3;
}

.empty-action-btn {
  margin-top: 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 32rpx;
  border: 1rpx solid #d81e06;
  border-radius: 32rpx;
  color: #d81e06;
  background: #ffffff;
  font-size: 26rpx;
}

.empty-action-btn::after {
  border: 0;
}

/* 任务卡片 */
.task-card {
  margin-bottom: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #eceef2;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.035);
}

.task-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.task-no-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.task-no-prefix {
  font-size: 24rpx;
  color: #86909c;
}

.task-no {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d2129;
  letter-spacing: 0.5rpx;
}

.status-tag {
  font-size: 24rpx;
  font-weight: 500;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  background: #f2f3f5;
  color: #4e5969;
}

.status-tag.status-IN_PROGRESS {
  background: #fff1f0;
  color: #d81e06;
  border: 1rpx solid #ffccc7;
}

.status-tag.status-PAUSED {
  background: #fff7e6;
  color: #fa8c16;
  border: 1rpx solid #ffe7ba;
}

.status-tag.status-WAIT_MATERIAL {
  background: #fffbe6;
  color: #faad14;
  border: 1rpx solid #ffe58f;
}

.status-tag.status-READY {
  background: #e6f7ff;
  color: #1890ff;
  border: 1rpx solid #91d5ff;
}

.task-body {
  padding: 16rpx 0 6rpx;
}

.task-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  font-size: 28rpx;
  line-height: 1.4;
}

.row-label {
  color: #86909c;
  min-width: 140rpx;
  flex-shrink: 0;
}

.row-value {
  font-weight: 500;
  color: #1d2129;
  text-align: right;
  word-break: break-all;
}

.row-value.product-name {
  color: #1d2129;
  font-weight: 600;
}

.row-value.shortage {
  color: #d81e06;
  font-weight: 600;
}

.row-value.labor-time {
  color: #d81e06;
  font-weight: 600;
}

.task-action-box {
  margin-top: 18rpx;
  padding-top: 16rpx;
}

.task-btn {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 12rpx;
  font-size: 29rpx;
  font-weight: 500;
  text-align: center;
}

.task-btn::after {
  border: 0;
}

.task-btn.btn-primary {
  color: #ffffff;
  background: #d81e06;
  box-shadow: 0 4rpx 14rpx rgba(216, 30, 6, 0.22);
}

.task-btn.btn-primary:active {
  background: #b81503;
}

.task-btn.btn-outline {
  color: #d81e06;
  background: #ffffff;
  border: 2rpx solid #d81e06;
}

.task-btn.btn-outline:active {
  background: #fff1f0;
}

.bottom-space {
  height: calc(130rpx + env(safe-area-inset-bottom));
}
