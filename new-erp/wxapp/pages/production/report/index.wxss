page { background: #f6f7f9; color: #1f2329; }
.page { padding: 20rpx 20rpx 48rpx; }
.card { background: #fff; border: 1rpx solid #ebeef2; border-radius: 16rpx; margin-bottom: 16rpx; padding: 24rpx; box-sizing: border-box; }
.title-row, .confirm-row, .preview view, .labor { display: flex; align-items: center; justify-content: space-between; }
.section-title { font-size: 28rpx; font-weight: 700; }
.order-no { font-size: 28rpx; font-weight: 600; }
.metrics { display: flex; margin-top: 28rpx; }
.metric { flex: 1; text-align: center; border-right: 1rpx solid #e5e6eb; color: #646a73; font-size: 22rpx; }
.metric:last-child { border-right: 0; }
.metric-value { display: block; color: #1f2329; font-size: 34rpx; margin-top: 10rpx; font-weight: 700; }
.station-name { display: block; margin-top: 16rpx; font-size: 34rpx; font-weight: 700; }
.total-card { text-align: center; }
.total-card>.section-title { display: block; text-align: left; }
.counter { display: flex; align-items: center; justify-content: space-between; margin: 16rpx 28rpx 4rpx; }
.counter button, .kind button { width: 92rpx; height: 76rpx; line-height: 72rpx; padding: 0; background: #fff; border: 1rpx solid #dcdfe6; font-size: 42rpx; }
.counter button::after, .kind button::after { border: 0; }
.big-number { font-size: 96rpx; font-weight: 500; }
.unit { margin-left: 12rpx; font-size: 26rpx; }
.range, .muted, .field-hint { color: #8f959e; font-size: 22rpx; font-weight: 400; }
.kind-grid { display: flex; gap: 12rpx; margin-top: 18rpx; }
.kind { flex: 1; min-width: 0; text-align: center; border: 1rpx solid #e5e6eb; border-radius: 12rpx; padding: 18rpx 8rpx; color: #646a73; }
.kind-value { display: block; color: #1f2329; font-size: 34rpx; margin: 12rpx 0; font-weight: 700; }
.kind view { display: flex; gap: 8rpx; justify-content: center; }
.kind button { width: 64rpx; height: 58rpx; line-height: 54rpx; font-size: 32rpx; }
.field { margin-bottom: 22rpx; }
.field>text { display: block; font-weight: 700; margin-bottom: 10rpx; }
.field input, .field textarea { width: 100%; box-sizing: border-box; border: 1rpx solid #dcdfe6; border-radius: 10rpx; padding: 18rpx; background: #fff; }
.field textarea { height: 120rpx; }
.labor { justify-content: flex-start; gap: 14rpx; }
.labor-time { color: #d81e06; font-size: 30rpx; margin-left: auto; }
.preview view { margin-top: 18rpx; color: #646a73; }
.preview-value { color: #1f2329; font-weight: 700; }.preview .red { color: #d81e06; }
.submit-btn { height: 92rpx; line-height: 92rpx; background: #d81e06; color: #fff; border-radius: 12rpx; font-size: 30rpx; font-weight: 700; }
.submit-btn::after { border: 0; }
.loading { min-height: 70vh; display: flex; align-items: center; justify-content: center; color: #8f959e; }
.overlay { position: fixed; inset: 0; background: rgba(0,0,0,.64); display: flex; align-items: flex-end; z-index: 999; }
.sheet { width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 18rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.handle { width: 80rpx; height: 8rpx; border-radius: 8rpx; background: #c9cdd4; margin: 0 auto 24rpx; }
.sheet-title { text-align: center; font-size: 34rpx; font-weight: 700; margin-bottom: 20rpx; }
.confirm-row { min-height: 68rpx; border-bottom: 1rpx solid #f0f1f2; }
.warning { margin: 24rpx 0; padding: 20rpx; background: #fff7e8; color: #ff7d00; text-align: center; border-radius: 10rpx; }
.sheet-actions { display: flex; gap: 20rpx; }.sheet-actions button { flex: 1; }.sheet-actions .confirm-btn { background: #d81e06; color: #fff; }
