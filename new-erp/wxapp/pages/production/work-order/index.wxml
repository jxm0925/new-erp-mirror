<import src="../order-info.wxml" />
<view class="mt-page wo-v2-page">
  <view wx:if="{{error}}" class="mt-error">{{error}}</view>
  <view wx:if="{{loading && !wo}}" class="mt-empty">正在读取工单详情…</view>

  <block wx:if="{{wo}}">
    <!-- 顶部精简红底背景弧线 -->
    <view class="wo-top-bg"></view>

    <!-- 1. 工单与销售订单关联主卡（主工单/半成品子工单统一 V2 白底结构化主卡） -->
    <view class="wo-main-card">
      <view class="wo-mc-top">
        <view class="wo-mc-title-wrap">
          <view class="wo-mc-title">
            <text>{{wo.productText}}</text>
            <text class="wo-mc-qty">× {{wo.plannedText}} {{wo.unit_name || '台'}}</text>
          </view>
          <view class="wo-mc-spec">
            <text>规格型号：{{wo.specText || '标准规格'}}</text>
            <text wx:if="{{wo.item_code}}" class="mono"> · {{wo.item_code}}</text>
          </view>
        </view>
        <view class="wo-mc-status-pill {{wo.is_sub_work_order ? 'sub' : ''}}">{{wo.is_sub_work_order ? '子工单 · ' : ''}}{{wo.status_label}}</view>
      </view>

      <!-- 核心关联信息区：销售订单号 + 销售员 + 客户 + 工单号 + 所属主工单 -->
      <view class="wo-order-banner">
        <view class="wo-ob-row">
          <view class="wo-ob-left">
            <text class="wo-ob-badge">{{wo.salesOrderNo ? '销售订单' : '生产来源'}}</text>
            <text wx:if="{{wo.salesOrderNo}}" class="wo-ob-so mono">{{wo.salesOrderNo}}</text>
            <text wx:else class="wo-ob-so-empty">备货生产（无关联销售单）</text>
          </view>
          <view class="wo-ob-right">
            <text wx:if="{{wo.salespersonName}}" class="wo-ob-sales">销售: {{wo.salespersonName}}</text>
            <text wx:if="{{wo.customerName}}" class="wo-ob-cust">客户: {{wo.customerName}}</text>
          </view>
        </view>

        <view class="wo-ob-row sub">
          <view class="wo-ob-left">
            <text class="wo-ob-wo-lbl">工单: <text class="mono wo-ob-wo">{{wo.work_order_no}}</text></text>
            <text wx:if="{{wo.is_sub_work_order}}" class="wo-mini-tag amber">半成品子工单</text>
            <text wx:if="{{wo.priority === 1}}" class="wo-mini-tag red">特急</text>
            <text wx:elif="{{wo.is_urgent}}" class="wo-mini-tag red">加急</text>
            <text wx:if="{{wo.is_custom}}" class="wo-mini-tag amber">定制</text>
          </view>
          <view class="wo-ob-right">
            <text class="wo-ob-due">交期: <text class="wo-ob-due-val">{{wo.dueText || '-'}}</text></text>
          </view>
        </view>

        <!-- 所属主工单关联行（半成品子工单时直接内嵌展示并可点击跳转） -->
        <view wx:if="{{wo.parent_work_order}}" class="wo-ob-row parent" data-id="{{wo.parent_work_order.id}}" bindtap="openWorkOrder">
          <view class="wo-ob-left">
            <text class="wo-mini-tag amber">所属主工单</text>
            <text class="mono wo-ob-wo">{{wo.parent_work_order.work_order_no}}</text>
            <text class="wo-ob-parent-name">{{wo.parent_work_order.product_name || wo.parent_work_order.item_name}} × {{wo.parent_work_order.plannedText}}{{wo.parent_work_order.unit_name || '台'}}</text>
          </view>
          <text class="wo-link-go">查看主工单 ›</text>
        </view>

        <!-- 待仓库确认入库提示行 -->
        <view wx:if="{{wo.pending_receipt_qty > 0}}" class="wo-ob-row parent" bindtap="openReceiptRequests">
          <text class="wo-ob-due">待仓库确认入库：{{wo.pending_receipt_qty}} {{wo.unit_name || '台'}}</text>
          <text class="wo-link-go">查看申请 ›</text>
        </view>
      </view>

      <!-- 4 列核心进度指标栏 -->
      <view class="wo-kpi-bar">
        <view class="wo-kpi-cell">
          <view class="wo-kpi-val">{{wo.plannedText}}<text class="wo-kpi-unit">{{wo.unit_name || '台'}}</text></view>
          <view class="wo-kpi-lbl">计划数量</view>
        </view>
        <view class="wo-kpi-cell">
          <view class="wo-kpi-val red">{{wo.inProgressCount}}<text class="wo-kpi-unit">{{wo.unit_name || '台'}}</text></view>
          <view class="wo-kpi-lbl">当前在制</view>
        </view>
        <view class="wo-kpi-cell">
          <view class="wo-kpi-val">{{wo.storedText}}<text class="wo-kpi-unit">{{wo.unit_name || '台'}}</text></view>
          <view class="wo-kpi-lbl">已入库</view>
        </view>
        <view class="wo-kpi-cell" data-tab="materials" bindtap="switchWoTab">
          <view class="wo-kpi-val {{materialSummary.short > 0 ? 'warn' : 'ok'}}">{{materialSummary.short > 0 ? '缺 ' + materialSummary.short + ' 项' : '已齐套'}}</view>
          <view class="wo-kpi-lbl">工序用料 ▾</view>
        </view>
      </view>
    </view>

    <!-- 异常与阻塞提醒 -->
    <view wx:for="{{wo.completion_blockers}}" wx:key="type" class="mt-note" style="margin-bottom: 16rpx;">{{item.text}}</view>
    <view wx:for="{{wo.shipment_repairs}}" wx:key="id" wx:if="{{item.state !== 'returned'}}" class="mt-error">试水返修 {{item.serial_no}}：{{item.state_label}}<text wx:if="{{item.reason}}">。原因：{{item.reason}}</text>（{{item.shipment_no}}）</view>

    <!-- 2. 三栏分段工作区切换器 -->
    <view class="wo-seg-tabs">
      <view class="wo-seg-item {{woTab === 'ops' ? 'active' : ''}}" data-tab="ops" bindtap="switchWoTab">
        <text>工序与进度</text>
        <view class="wo-seg-badge">{{ops.length}}</view>
      </view>
      <view class="wo-seg-item {{woTab === 'materials' ? 'active' : ''}}" data-tab="materials" bindtap="switchWoTab">
        <text>工序用料</text>
        <view class="wo-seg-badge {{materialSummary.short > 0 ? 'warn' : ''}}">{{materialSummary.short > 0 ? '缺' + materialSummary.short : (materialSummary.total > 0 ? '齐套' : '0')}}</view>
      </view>
      <view class="wo-seg-item {{woTab === 'docs' ? 'active' : ''}}" data-tab="docs" bindtap="switchWoTab">
        <text>图纸与订单</text>
        <view class="wo-seg-badge">{{wo.docsCount}}</view>
      </view>
    </view>

    <!-- ==================== TAB 1: 工序与进度 ==================== -->
    <block wx:if="{{woTab === 'ops'}}">
      <!-- 工序进度与直达作业卡 -->
      <view class="mt-card">
        <view class="mt-card-title">
          <text>工序进度与作业入口</text>
          <text class="mt-muted">点击工序进入报工</text>
        </view>
        <view wx:if="{{!ops.length}}" class="mt-muted">当前工单未配置车间生产工序</view>
        <view wx:for="{{ops}}" wx:key="id" class="wo-op-card" data-id="{{item.id}}" bindtap="openTask">
          <view class="wo-op-top">
            <view class="wo-op-left">
              <text class="wo-op-seq">{{index + 1}}</text>
              <text class="wo-op-name">{{item.operation_name}}</text>
              <text wx:if="{{item.work_status_label}}" class="mt-tag {{item.statusTheme}}">{{item.work_status_label}}</text>
              <text wx:if="{{item.rework_qty}}" class="mt-tag red">返工 {{item.rework_qty}}</text>
            </view>
            <view class="wo-op-btn {{item.actionPrimary ? 'primary' : ''}}">{{item.actionText}} ›</view>
          </view>
          <view class="wo-op-meta">
            <text>已完成 {{item.doneText}} / {{wo.plannedText}} {{wo.unit_name || '台'}}</text>
            <text> · 本道待做 <text class="{{item.here_qty > 0 ? 'tk-num-red' : 'tk-num-bold'}}">{{item.here_qty || 0}}</text> {{wo.unit_name || '台'}}</text>
            <text wx:if="{{item.owner_name}}"> · 主责：{{item.owner_name}}</text>
            <text wx:if="{{item.labor_minutes > 0}}"> · 工时 {{item.labor_minutes}}分</text>
          </view>
          <view class="mt-bar"><view class="mt-bar-in" style="width: {{item.percent}}%"></view></view>
        </view>
      </view>

      <!-- 下挂子工单（主工单时展示） -->
      <view wx:if="{{wo.child_work_orders && wo.child_work_orders.length}}" class="mt-card">
        <view class="mt-card-title" bindtap="toggleChildren">
          <text>下挂半成品子工单 ({{wo.child_work_orders.length}})</text>
          <text class="wo-link-go">{{showChildren ? '收起 ▴' : '展开 ▾'}}</text>
        </view>
        <view class="wo-sub-summary-bar" bindtap="toggleChildren">
          <text>子工单 {{wo.child_work_orders.length}} 个（生产：{{wo.childSummaryNames}}）</text>
          <text class="wo-link-go">{{showChildren ? '收起' : '查看'}}</text>
        </view>
        <block wx:if="{{showChildren}}">
          <view wx:for="{{wo.child_work_orders}}" wx:key="id" class="wo-child-box" data-id="{{item.id}}" bindtap="openWorkOrder">
            <view class="mt-row">
              <text class="wo-child-title">{{item.is_rework ? '返工子工单' : '子工单'}}：{{item.item_name}} × {{item.plannedText}} {{item.unit_name || '件'}}</text>
              <text class="mt-tag {{item.status === 'completed' ? 'green' : 'blue'}}">{{item.status_label}}</text>
            </view>
            <view class="wo-child-sub">
              <text class="mono">{{item.work_order_no}}</text>
              <text wx:if="{{item.specText}}"> · 规格：{{item.specText}}</text>
              <text> · 已入库 {{item.storedText}} / {{item.plannedText}}</text>
            </view>
          </view>
        </block>
      </view>

      <!-- 设备/单件序列号状态追踪 -->
      <view class="mt-card">
        <view class="mt-card-title">
          <text>{{!wo.unit_name || wo.unit_name === '台' ? '设备序列号状态追踪' : '单件工序状态追踪'}}</text>
          <text wx:if="{{units.length}}" class="mt-muted">共 {{units.length}} {{wo.unit_name || '台'}}</text>
        </view>
        <view wx:if="{{!units.length}}" class="mt-muted">当前工单按数量汇总追踪，不生成单台序列号</view>
        <view wx:for="{{units}}" wx:key="id" class="mt-kv">
          <text class="k mono" style="color: #1f2329; font-weight: 700;">{{item.serial_no || ('第 ' + item.unit_no + ' ' + (wo.unit_name || '件'))}}</text>
          <text class="mt-tag {{item.tag}}">{{item.text}}</text>
        </view>
      </view>
    </block>

    <!-- ==================== TAB 2: 工序用料（结构化表格） ==================== -->
    <block wx:if="{{woTab === 'materials'}}">
      <view class="mt-card">
        <view class="mt-card-title">
          <text>各工序用料与规格明细 ({{materialSummary.total}})</text>
        </view>
        <view wx:if="{{!kittingOps.length}}" class="mt-muted">当前工单暂无 BOM 用料明细</view>
        <block wx:else>
          <view class="tk-mat-summary-bar" style="margin-bottom: 16rpx;">
            <view class="tk-mat-summary-text">
              <text>需用 <text class="tk-num-bold">{{materialSummary.total}}</text> 项物料</text>
              <text> · 已齐 <text class="tk-num-green">{{materialSummary.ready}}</text> 项</text>
              <text> · 缺 <text class="{{materialSummary.short > 0 ? 'tk-num-red' : 'tk-num-bold'}}">{{materialSummary.short}}</text> 项</text>
            </view>
          </view>

          <view wx:for="{{kittingOps}}" wx:for-item="kop" wx:key="operation_key" class="wo-kop-group">
            <view class="mt-row wo-kop-head">
              <text class="wo-kop-name">{{kop.operation_name}}工序用料 ({{kop.materials.length}})</text>
              <text class="mt-tag {{kop.status === 'ready' ? 'green' : (kop.status === 'short' ? 'red' : 'gray')}}">{{kop.status_label}}</text>
            </view>
            <view class="wo-mat-table">
              <view class="wo-mt-tr wo-mt-th">
                <text class="wo-mt-td col-name">物料名称</text>
                <text class="wo-mt-td col-spec">规格与库存</text>
                <text class="wo-mt-td col-req">需/已领</text>
                <text class="wo-mt-td col-state">状态</text>
              </view>
              <view wx:for="{{kop.materials}}" wx:key="rowKey" class="wo-mt-tr">
                <view class="wo-mt-td col-name">
                  <text class="wo-mt-name">{{item.component_item_name}}</text>
                  <text wx:if="{{item.component_item_code}}" class="wo-mt-code mono">{{item.component_item_code}}</text>
                  <text wx:if="{{item.remark}}" class="wo-mt-remark">注：{{item.remark}}</text>
                </view>
                <view class="wo-mt-td col-spec">
                  <view>{{item.specText || '标准规格'}}</view>
                  <view class="wo-mt-stock">可用 {{item.availableText}}</view>
                </view>
                <view class="wo-mt-td col-req mono">{{item.requiredText}}/{{item.issuedText}}<text wx:if="{{item.unit_name}}" class="wo-mt-unit">{{item.unit_name}}</text></view>
                <view class="wo-mt-td col-state">
                  <text wx:if="{{item.isShort}}" class="wo-state-pill short">缺 {{item.shortDisplayText}}</text>
                  <text wx:else class="wo-state-pill ok">已齐</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>

      <view wx:if="{{wo.costFields.length}}" class="mt-card">
        <view class="mt-card-title"><text>材料成本</text></view>
        <view wx:for="{{wo.costFields}}" wx:key="label" class="mt-kv"><text class="k">{{item.label}}</text><text class="v">{{item.value}}</text></view>
      </view>
    </block>

    <!-- ==================== TAB 3: 图纸与订单 ==================== -->
    <block wx:if="{{woTab === 'docs'}}">
      <workshop-reference reference="{{wo.workshop_reference}}" />

      <view wx:if="{{!wo.hasReference}}" class="mt-card">
        <view class="mt-card-title"><text>生产要求与图纸</text></view>
        <view class="mt-muted">当前工单暂无附加生产要求或技术图纸</view>
      </view>

      <!-- 订单与客户信息 -->
      <template is="orderInfo" data="{{info: wo.order_info}}" />
    </block>
  </block>
</view>
