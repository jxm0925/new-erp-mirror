page{background:#f5f6f8;color:#1d2129;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue","PingFang SC","Microsoft YaHei",sans-serif}.todos-page{padding:20rpx}.today-card{height:178rpx;margin-bottom:18rpx;padding:30rpx 36rpx;border-radius:20rpx;background:linear-gradient(135deg,#ed291d,#d81e06 60%,#bd1603);display:flex;align-items:center;justify-content:space-between;color:#fff;box-sizing:border-box}.today-card view{display:flex;flex-direction:column}.today-card text{font-size:29rpx}.today-card strong{font-size:54rpx;margin-top:8rpx}.todo-card{height:132rpx;margin-bottom:16rpx;padding:0 24rpx;border-radius:16rpx;background:#fff;display:flex;align-items:center;gap:18rpx;box-sizing:border-box}.icon{width:80rpx;height:80rpx;border-radius:16rpx;background:#fff0ef;display:flex;align-items:center;justify-content:center}.body{display:flex;flex-direction:column;gap:8rpx;flex:1}.body strong{font-size:30rpx}.body text{font-size:27rpx;color:#707680}.count{min-width:46rpx;height:46rpx;line-height:46rpx;border-radius:23rpx;background:#d81e06;color:#fff;text-align:center;font-size:27rpx}.state{height:400rpx;display:flex;align-items:center;justify-content:center}.login-hint{text-align:center;color:#737983;font-size:27rpx;margin-top:40rpx}
