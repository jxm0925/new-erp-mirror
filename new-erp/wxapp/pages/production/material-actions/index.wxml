<view class="material-page" wx:if="{{!loading && task && target}}">
  <view class="context-card">
    <view class="context-row"><text>工单号</text><strong>{{task.work_order.work_order_no}}</strong></view>
    <view class="context-row"><text>生产单元</text><strong>{{target.production_unit_no || ('数量执行 #' + target.target_id)}}</strong></view>
    <view class="context-row"><text>当前工序</text><strong>{{task.sequence_no_snapshot}} - {{task.operation_name_snapshot}}</strong></view>
  </view>

  <view class="material-tabs">
    <view wx:if="{{canOnsite}}" class="material-tab {{activeTab==='onsite'?'active':''}}" data-tab="onsite" bindtap="switchTab">现场领料</view>
    <view class="material-tab {{activeTab==='supplement'?'active':''}}" data-tab="supplement" bindtap="switchTab">补料</view>
    <view class="material-tab {{activeTab==='return'?'active':''}}" data-tab="return" bindtap="switchTab">退料</view>
  </view>

  <view class="form-card" wx:if="{{activeTab==='supplement'}}">
    <view class="form-row">
      <text class="form-label">补料类型</text>
      <picker class="form-control" range="{{supplementTypes}}"><view class="picker-value">生产过程追加<van-icon name="arrow-down" /></view></picker>
    </view>
    <view class="form-row radio-row">
      <text class="form-label">阻断生产</text>
      <view class="radio-options">
        <view class="radio-option" data-value="true" bindtap="setBlocking"><text class="radio {{blocking?'checked':''}}"></text>是</view>
        <view class="radio-option" data-value="false" bindtap="setBlocking"><text class="radio {{!blocking?'checked':''}}"></text>否</view>
      </view>
    </view>
    <view class="form-row">
      <text class="form-label">追加原因</text>
      <picker class="form-control" range="{{supplementReasons}}" value="{{supplementReasonIndex}}" bindchange="onSupplementReason"><view class="picker-value">{{supplementReasons[supplementReasonIndex]}}<van-icon name="arrow-down" /></view></picker>
    </view>

    <view class="section-title">补料明细</view>
    <view class="supplement-table">
      <view class="table-head"><text>物料 <i>*</i></text><text>追加数量 <i>*</i></text><text></text></view>
      <view class="table-line" wx:for="{{supplementLines}}" wx:key="index">
        <text class="line-no">{{index + 1}}</text>
        <view class="material-picker" bindtap="openMaterialSelector">
          <view class="line-input {{item.materialLabel?'has-value':''}}">{{item.materialLabel || '请选择物料编码/名称'}}</view>
        </view>
        <input class="qty-input" type="digit" placeholder="请输入追加数量" value="{{item.additional_base_qty}}" data-index="{{index}}" bindinput="onSupplementQty" />
        <van-icon class="delete" name="delete-o" data-index="{{index}}" bindtap="removeSupplementLine" />
      </view>
    </view>
    <button class="add-line" bindtap="addSupplementLine"><text>＋</text> 添加明细</button>
    <view class="notice orange"><van-icon name="warning-o" /><text>追加补料会形成独立需求，不修改原标准需求</text></view>
    <button class="submit" loading="{{busy}}" bindtap="submitSupplement">提交补料申请</button>
  </view>

  <view class="return-form" wx:if="{{activeTab==='return'}}">
    <view class="return-block" wx:for="{{returnLines}}" wx:key="index">
      <view class="form-row radio-row">
        <text class="form-label">退料类型</text>
        <view class="radio-options">
          <view class="radio-option" data-value="normal_return" bindtap="setReturnType"><text class="radio {{returnType==='normal_return'?'checked':''}}"></text>正常退料</view>
          <view class="radio-option" data-value="quality_return" bindtap="setReturnType"><text class="radio {{returnType==='quality_return'?'checked':''}}"></text>质量退料</view>
        </view>
      </view>
      <view class="form-row required-row">
        <text class="form-label">退料原因</text>
        <picker class="form-control" range="{{returnReasons}}" value="{{returnReasonIndex}}" data-index="{{index}}" bindchange="onReturnReason"><view class="picker-value muted-{{returnReasonIndex<0}}">{{returnReasonIndex<0?'请选择':returnReasons[returnReasonIndex]}}<van-icon name="arrow" /></view></picker>
      </view>
      <view class="form-row">
        <text class="form-label">物料</text>
        <view class="form-control" bindtap="openMaterialSelector"><view class="picker-value muted-{{!item.materialLabel}}">{{item.materialLabel || '请选择'}}<van-icon name="arrow" /></view></view>
      </view>
      <view class="form-row"><text class="form-label">已签收数量</text><view class="form-control readonly">{{item.received_base_qty}}</view></view>
      <view class="form-row"><text class="form-label">可退数量</text><view class="form-control readonly">{{item.returnable_base_qty}}</view></view>
      <view class="form-row required-row"><text class="form-label">退料数量</text><input class="form-control input-control" type="digit" placeholder="请输入" value="{{item.return_base_qty}}" data-index="{{index}}" bindinput="onReturnQty" /></view>
      <view class="form-row">
        <text class="form-label">退料仓库</text>
        <view class="form-control readonly">{{item.warehouseLabel || '-'}}</view>
      </view>
      <view class="form-row">
        <text class="form-label">退料库位</text>
        <view class="form-control readonly">{{item.locationLabel || '-'}}</view>
      </view>
      <view class="form-row"><text class="form-label">批次号</text><view class="form-control readonly">{{item.batch_no || '-'}}</view></view>
      <van-icon wx:if="{{returnLines.length>1}}" class="return-delete" name="delete-o" data-index="{{index}}" bindtap="removeReturnLine" />
    </view>
    <button class="add-line return-add" bindtap="addReturnLine"><text>＋</text> 添加明细</button>
    <view class="notice red"><van-icon name="info" /><text>签收后的退回才是生产退料；配送现场未接收请使用拒收</text></view>
    <button class="submit" loading="{{busy}}" bindtap="submitReturn">提交生产退料</button>
  </view>

  <view class="form-card" wx:if="{{activeTab==='onsite'}}">
    <view class="notice">下料板材和长料在现场领用，由当前生产责任人确认。</view>
    <view wx:if="{{onsiteError}}" class="notice red">{{onsiteError}}</view>
    <button wx:for="{{onsitePending}}" wx:key="path" class="submit" data-path="{{item.path}}" loading="{{busy}}" disabled="{{busy}}" bindtap="recoverOnsite">核对上次领料</button>
    <view wx:if="{{onsiteLoading}}">正在查询待领物料</view>
    <view wx:if="{{!onsiteLoading && !onsiteRows.length}}">暂无待现场领用的物料</view>
    <view class="onsite-material" wx:for="{{onsiteRows}}" wx:key="id">
      <view class="section-title">{{item.item_code}} {{item.item_name}}</view><view>{{item.spec}}</view><view>配料单：{{item.task_no}}</view><view>待领：{{item.remainingText}} {{item.unit_name_snapshot}}</view>
      <view class="form-row"><text class="form-label">本次领料</text><input class="form-control input-control" type="digit" value="{{item.accepted}}" data-id="{{item.id}}" bindinput="onsiteQuantity" placeholder="填写实际数量" /></view>
      <button wx:if="{{item.material_management_mode==='physical'}}" class="add-line" data-id="{{item.id}}" data-kind="physicals" bindtap="selectOnsiteSource">选择具体板材（{{item.physicals.length}}张）</button>
      <button wx:if="{{item.serial_control_type!=='none'}}" class="add-line" data-id="{{item.id}}" data-kind="serials" bindtap="selectOnsiteSource">选择序列号（{{item.serials.length}}件）</button>
      <button wx:if="{{canReceiveOnsite}}" class="submit" data-id="{{item.id}}" loading="{{busy}}" disabled="{{busy}}" bindtap="receiveOnsite">确认现场领料</button>
    </view>
    <view class="onsite-pages"><button disabled="{{onsitePage<=1 || busy}}" data-delta="-1" bindtap="onsitePage">上一页</button><text>{{onsitePage}} / {{onsiteLastPage}}</text><button disabled="{{onsitePage>=onsiteLastPage || busy}}" data-delta="1" bindtap="onsitePage">下一页</button></view>
  </view>
  <view class="bottom-nav">
    <view class="nav-item" data-url="/pages/index/index" bindtap="switchRoot"><van-icon name="wap-home-o" /><text>首页</text></view>
    <view class="nav-item" data-url="/pages/mall/index/index" bindtap="switchRoot"><van-icon name="gift-o" /><text>商城</text></view>
    <view class="nav-item" data-url="/pages/my/index/index" bindtap="switchRoot"><van-icon name="manager-o" /><text>我的</text></view>
  </view>
</view>

<view wx:elif="{{loading}}" class="loading"><van-loading color="#d81e06">加载物料处理</van-loading></view>
<view wx:else class="loading"><van-empty description="任务不存在、尚未接单或无权操作" /></view>
<import src="../../../components/material-selector/index.wxml" />
<template is="material-selector" data="{{...selector, mode: activeTab}}" />
<warehouse-picker open="{{onsiteSourceOpen}}" title="选择现场领料原料" mode="{{onsiteSourceMode}}" query="{{onsiteSourceQuery}}" selected="{{onsiteSourceSelected}}" multiple="{{true}}" bindconfirm="acceptOnsiteSource" bindcancel="closeOnsiteSource" />
