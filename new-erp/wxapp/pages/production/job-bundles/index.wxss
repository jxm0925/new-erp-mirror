page {
  background: #f6f8fa;
  color: #33455d;
}
.bundle-page {
  padding: 24rpx;
  box-sizing: border-box;
  min-width: 0;
}
.view-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.view-tabs button {
  flex: 1;
  margin: 0;
  min-width: 0;
  font-size: 26rpx;
  color: #728098;
  background: #fff;
}
.view-tabs button.active {
  color: #008b4b;
  background: #f0fdf4;
}
.bundle-card, .error-card, .empty-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  overflow-wrap: anywhere;
}
.card-title {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
  font-weight: 600;
}
.card-title>text:first-child {
  min-width: 0;
  flex: 1;
}
.status-label {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #008b4b;
  background: #f0fdf4;
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
}
.secondary-text {
  color: #728098;
  font-size: 24rpx;
  margin-top: 12rpx;
}
.labor-total {
  margin-top: 18rpx;
  font-weight: 600;
}
.fact-grid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 20rpx;
  margin: 24rpx 0;
}
.fact-grid>view {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.fact-label {
  color: #728098;
  font-size: 22rpx;
}
.search-bar, .line-actions, .job-actions, .report-footer {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}
.search-bar {
  margin-bottom: 24rpx;
}
.search-bar input {
  flex: 1 1 240rpx;
  min-width: 0;
  background: #fff;
  border: 1rpx solid #dfe5eb;
  padding: 16rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
}
.primary-button, .secondary-button {
  margin: 0;
  font-size: 24rpx;
  line-height: 1.5;
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
}
.primary-button {
  color: #fff;
  background: #008b4b;
}
.secondary-button {
  color: #33455d;
  background: #fff;
  border: 1rpx solid #dfe5eb;
}
.line-actions>button {
  flex: 1 1 150rpx;
}
.job-actions {
  margin: 24rpx 0;
}
.job-actions>button {
  flex: 1 1 220rpx;
}
.empty-card {
  text-align: center;
  color: #728098;
}
.error-card {
  color: #a65c00;
}
.report-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(0,0,0,.4);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}
.report-dialog {
  width: 100%;
  max-width: 900rpx;
  max-height: 85vh;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.report-title {
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
  overflow-wrap: anywhere;
}
.report-body {
  padding: 0 24rpx;
  box-sizing: border-box;
  min-height: 0;
  max-height: 60vh;
}
.report-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
}
.report-field input {
  border: 1rpx solid #dfe5eb;
  border-radius: 8rpx;
  padding: 14rpx;
  min-width: 0;
}
.report-footer {
  padding: 24rpx;
  flex-shrink: 0;
}
.report-footer>button {
  flex: 1;
  min-width: 0;
}
