view, input, button, picker, scroll-view { box-sizing: border-box; min-width: 0; }
.form-page { width: 100%; max-width: 900px; margin: 0 auto; padding: 28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.notice { color: #e31912; background: #fff5f5; border: 1rpx solid #fee4e4; border-radius: 16rpx; padding: 24rpx; margin-bottom: 18rpx; }
.card { background: #fff; border-radius: 20rpx; margin-bottom: 18rpx; padding: 12rpx 24rpx; box-shadow: 0 3rpx 16rpx rgba(30,35,40,.035); }
.number-card { padding: 26rpx; }.number-row { display: flex; align-items: center; gap: 16rpx; justify-content: space-between; margin-top: 14rpx; font-size: 32rpx; font-weight: 600; overflow-wrap: anywhere; }
.status { color: #e31912; font-size: 24rpx; flex-shrink: 0; }.muted { color: #85878d; font-size: 25rpx; }
.field { display: flex; align-items: center; gap: 14rpx; min-height: 88rpx; padding: 20rpx 0; border-bottom: 1rpx solid #eef0f2; }.field:last-child { border: 0; }.label { flex: 0 0 144rpx; }.value { flex: 1; text-align: right; overflow-wrap: anywhere; }.code { display: block; margin-top: 8rpx; }.arrow { color: #92959c; flex: 0 0 20rpx; font-size: 38rpx; }.unit { flex-shrink: 0; }
.card-title { font-size: 30rpx; font-weight: 600; padding-top: 18rpx; }.overview .field { min-height: 65rpx; padding: 14rpx 0; border: 0; }.route-node { color: #666; padding: 8rpx 0; overflow-wrap: anywhere; }
.actions { display: flex; flex-direction: column; gap: 18rpx; padding-top: 12rpx; }.actions button { width: 100%; }button { font-size: 28rpx; border-radius: 12rpx; }button.primary { background: #ed160a; color: #fff; }button[disabled] { opacity: .5; }.state { text-align: center; color: #85878d; padding: 40rpx 14rpx; }.error { color: #c52b26; padding: 18rpx 0; overflow-wrap: anywhere; }
.mask { position: fixed; inset: 0; z-index: 1000; padding: 28rpx; background: rgba(0,0,0,.45); display: flex; align-items: center; justify-content: center; }.selector { width: 100%; max-width: 760px; height: 82vh; background: white; border-radius: 22rpx; padding: 24rpx; display: flex; flex-direction: column; gap: 18rpx; }.selector-head { display: flex; justify-content: space-between; gap: 16rpx; font-weight: 600; }.selector-head text:last-child { color: #85878d; font-weight: 400; }.search { display: flex; gap: 12rpx; }.search input { flex: 1; background: #f6f7f9; border-radius: 8rpx; padding: 12rpx; height: 66rpx; }.selector-body { flex: 1; min-height: 0; display: flex; gap: 14rpx; }.categories { width: 26%; flex-shrink: 0; display: flex; flex-direction: column; background: #f7f8fa; }.category-scroll { flex: 1; min-height: 0; height: 100%; }.category { padding: 18rpx 10rpx; overflow-wrap: anywhere; font-size: 24rpx; }.option-scroll { flex: 1; height: 100%; }.option { padding: 20rpx 14rpx; border-bottom: 1rpx solid #eceef1; }.option text { display: block; overflow-wrap: anywhere; }.selected { color: #e31912; background: #fff0ee; }.pages { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }.pages button { margin: 0; }.category-pages { display: flex; flex-direction: column; align-items: center; gap: 6rpx; font-size: 22rpx; padding: 6rpx; }.category-pages button { padding: 0 12rpx; font-size: 22rpx; }.selection { font-size: 24rpx; overflow-wrap: anywhere; }.selector > button { width: 100%; flex-shrink: 0; }
@media (min-width: 600px) { .form-page { padding: 28px; }.mask { padding: 28px; } }
.form-page { max-width: 600px; padding: 24rpx 24rpx calc(36rpx + env(safe-area-inset-bottom)); }
.purpose-tabs { display: flex; margin: 0 12rpx 24rpx; border: 1rpx solid #dce0e7; border-radius: 10rpx; background: #f6f7fa; overflow: hidden; }.purpose-tab { flex: 1; text-align: center; padding: 23rpx 8rpx; color: #596278; font-size: 30rpx; font-weight: 600; }.purpose-tab.active { background: #ed160a; color: white; }
.field { min-height: 96rpx; }.value { text-align: left; }.number-value { font-size: 29rpx; }.label { flex-basis: 168rpx; }.fields .muted { font-size: 27rpx; }
.target-title { margin: -12rpx -24rpx 0; padding: 18rpx 24rpx; background: #f0f2f7; border-radius: 20rpx 20rpx 0 0; }.target-hint { padding: 10rpx 0 18rpx; }
.route-nodes { display: flex; flex-wrap: wrap; gap: 24rpx; padding: 26rpx 0 14rpx; }.route-node { flex: 0 1 calc(33.333% - 16rpx); display: flex; flex-direction: column; align-items: center; gap: 12rpx; color: #222b3d; text-align: center; }.route-sequence { border: 1rpx solid #e31912; color: #e31912; border-radius: 50%; width: 65rpx; height: 65rpx; line-height: 63rpx; }
.actions { margin-top: 16rpx; }.pending-card { text-align: center; padding: 28rpx; }.pending-card > text { display: block; margin-top: 12rpx; }.option-top { display: flex; align-items: center; gap: 12rpx; }.option-name { flex: 1; }.radio { color: #e31912; font-size: 34rpx; }.option .status { font-size: 21rpx; }.option > .muted { padding-left: 44rpx; padding-top: 8rpx; }.selector { max-width: 600px; }.categories { width: 24%; }
@media (max-width: 360px) { .form-page { padding-left: 18rpx; padding-right: 18rpx; }.card { padding-left: 20rpx; padding-right: 20rpx; }.label { flex-basis: 148rpx; }.selector { padding: 18rpx; }.mask { padding: 18rpx; }.option { padding-left: 6rpx; padding-right: 6rpx; }.number-value { font-size: 26rpx; } }
.form-page { padding: 0 0 calc(36rpx + env(safe-area-inset-bottom)); }
.form-page > .error { margin: 0 32rpx; }
.work-summary { background: #fff; padding: 30rpx 36rpx 38rpx; margin-bottom: 20rpx; }
.summary-status { display: inline-block; background: #ffe9eb; color: #ed160a; border-radius: 8rpx; padding: 5rpx 18rpx; font-size: 27rpx; }
.summary-number { margin-top: 14rpx; font-size: 43rpx; line-height: 1.25; font-weight: 700; overflow-wrap: anywhere; }
.summary-product { font-size: 37rpx; font-weight: 600; line-height: 1.45; margin-top: 16rpx; overflow-wrap: anywhere; }
.summary-source { color: #788397; font-size: 29rpx; margin-top: 12rpx; }
.summary-metrics { display: flex; margin-top: 25rpx; padding-top: 25rpx; border-top: 1rpx solid #e9edf2; }
.summary-metrics > view { flex: 1; text-align: center; }.summary-metrics > view + view { border-left: 1rpx solid #e9edf2; }
.metric-label { display: block; font-size: 25rpx; color: #788397; line-height: 1.5; }.metric-value { display: inline-block; font-size: 43rpx; font-weight: 600; margin-top: 4rpx; }.quantity { color: #ed160a; }.metric-unit { margin-left: 12rpx; color: #536178; font-size: 25rpx; font-weight: 400; }
.preparation-tabs { display: flex; background: #fff; border-bottom: 1rpx solid #e9edf2; }
.preparation-tab { position: relative; flex: 1; text-align: center; padding: 24rpx 6rpx; color: #6c778a; font-size: 29rpx; font-weight: 600; }
.preparation-tab.active { color: #ed160a; }.preparation-tab.active::after { content: ''; position: absolute; height: 4rpx; border-radius: 4rpx; background: #ed160a; bottom: 0; left: 14%; right: 14%; }
.technical-section { background: #fff; padding: 34rpx 34rpx 22rpx; margin-bottom: 20rpx; }
.technical-heading { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx 18rpx; margin-bottom: 22rpx; }
.technical-title { font-size: 32rpx; font-weight: 600; }.attachment-count { color: #6c778a; font-weight: 400; margin-left: 8rpx; }
.drawing-version { flex: 1; display: flex; justify-content: flex-end; align-items: center; flex-wrap: wrap; gap: 12rpx; color: #788397; font-size: 22rpx; }.drawing-reference { color: #17191c; overflow-wrap: anywhere; }.confirmed-badge { color: #0b921e; background: #e1f6e5; border-radius: 6rpx; padding: 7rpx 9rpx; flex-shrink: 0; }
.attachment-row { display: flex; align-items: center; gap: 24rpx; padding: 22rpx 0; border-bottom: 1rpx solid #e9edf2; }.attachment-row:last-child { border: 0; }
.file-icon { width: 82rpx; height: 94rpx; border-radius: 10rpx; background: #fff0f2; color: #ed160a; font-size: 25rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }.file-icon.cad { background: #edf4ff; color: #1671ee; }
.file-info { flex: 1; }.file-name { font-size: 27rpx; line-height: 1.5; overflow-wrap: anywhere; }.file-meta { margin-top: 8rpx; color: #8190a7; font-size: 24rpx; }
button.file-action { background: #fff0f2; color: #ed160a; font-size: 27rpx; padding: 0 20rpx; line-height: 56rpx; margin: 0; min-width: 118rpx; flex-shrink: 0; border-radius: 9rpx; }button.file-action::after { border: 0; }
.materials-section { padding-top: 30rpx; }.material-row { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 0; border-bottom: 1rpx solid #e9edf2; }.material-name { flex: 0 1 128rpx; font-size: 27rpx; overflow-wrap: anywhere; }.material-spec { flex: 1; font-size: 27rpx; line-height: 1.5; overflow-wrap: anywhere; }.material-quantity { flex: 0 0 136rpx; border-left: 1rpx solid #e9edf2; padding-left: 26rpx; }.material-quantity .quantity { font-size: 33rpx; font-weight: 600; }
button.next-step { border: 1rpx solid #ed160a; background: #fff; color: #ed160a; font-size: 30rpx; line-height: 82rpx; font-weight: 500; margin-top: 42rpx; }button.next-step::after { border: 0; }
.form-page > .card, .form-page > .actions, .form-page > .purpose-tabs { margin: 20rpx 24rpx; }.actions .next-step { margin-top: 0; }
@media (max-width: 360px) { .summary-number { font-size: 39rpx; }.technical-heading { align-items: flex-start; }.drawing-version { flex-basis: 100%; justify-content: flex-start; }.attachment-row { gap: 14rpx; }.material-row { gap: 14rpx; }.material-name { flex-basis: 108rpx; }.material-quantity { flex-basis: 126rpx; padding-left: 18rpx; } }
