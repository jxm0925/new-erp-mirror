.banner-section { background: #ffffff; padding: 24rpx; border-radius: 0 0 32rpx 32rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03); }
.report-banner { width: 100%; height: 280rpx; border-radius: 16rpx; overflow: hidden; }
.banner-img { width: 100%; height: 100%; border-radius: 16rpx; }
page { background-color: #F4F6F9; padding-bottom: 160rpx; }
.form-body { padding: 30rpx; }
.form-card { background: #fff; border-radius: 16rpx; padding: 30rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02); }
.field-label { font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 20rpx; display: flex; align-items: center; }
.label-text { flex: 0 1 auto; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.text-danger { color: #ff4d4d; margin-left: 8rpx; font-weight: normal; flex-shrink: 0; }
.uploader-wrap { margin-top: 20rpx; }
.simple-list-wrap { background: #fafafa; border-radius: 12rpx; padding: 0 20rpx; border: 1rpx solid #f0f0f0; }

.simple-row { display: flex; align-items: flex-start; padding: 24rpx 0; border-bottom: 1rpx dashed #eee; position: relative; }
.simple-row:last-of-type { border-bottom: none; }
.row-idx { font-size: 32rpx; font-weight: bold; margin-right: 16rpx; margin-top: 2rpx; font-family: DIN, sans-serif; }
.row-content { flex: 1; width: 100%; padding-right: 50rpx; box-sizing: border-box; }
.row-del-icon { color: #ccc; padding: 10rpx; position: absolute; right: 0; top: 20rpx; z-index: 10; }

.child-label { font-size: 26rpx; color: #888; font-weight: bold; }

/* 💥 高级设计：时段项的 一行流 Flex 布局 💥 */
.inline-time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}
.inline-time-label {
  font-size: 26rpx;
  color: #888;
  font-weight: bold;
  flex: 1;
  margin-right: 20rpx;
}
.minute-input-wrap {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border: 1rpx solid #e4e7ed;
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  width: 180rpx;
  flex-shrink: 0;
  transition: all 0.2s;
}
.minute-input-wrap:focus-within {
  border-color: #ff4d4d;
  background: #fff;
}
.minute-input {
  flex: 1;
  font-size: 32rpx;
  color: #ff4d4d; /* 💥 填入的数字极其醒目 💥 */
  font-family: DIN, sans-serif;
  font-weight: bold;
  text-align: right; /* 右侧对齐 */
}
.minute-unit {
  font-size: 26rpx;
  color: #666;
  margin-left: 10rpx;
  white-space: nowrap;
}

.custom-radio-group { display: grid; gap: 20rpx 12rpx; margin-top: 16rpx; margin-bottom: 10rpx; width: 100%; }
.custom-radio-group.opt-many { grid-template-columns: repeat(5, 1fr); }
.custom-radio-group.opt-few { grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); }
.radio-btn { padding: 14rpx 0; font-size: 26rpx; color: #666; background: #f8f9fa; border: 2rpx solid #e4e7ed; border-radius: 12rpx; text-align: center; transition: all 0.2s; white-space: nowrap; box-sizing: border-box; display: flex; align-items: center; justify-content: center; }
.radio-btn.active { color: #ff4d4d; background: #fff0f0; border-color: #ff4d4d; font-weight: bold; box-shadow: 0 4rpx 12rpx rgba(255, 77, 77, 0.15); }

.simple-add-btn { display: flex; align-items: center; justify-content: center; padding: 24rpx 0; border-top: 1rpx solid #eee; margin-top: -1rpx; }
.add-text { color: #ff4d4d; font-size: 28rpx; font-weight: bold; }
.popup-header { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 40rpx; border-bottom: 1rpx solid #f0f0f0; background: #fff; border-radius: 32rpx 32rpx 0 0; }
.popup-title { font-size: 32rpx; font-weight: bold; color: #333; }
.cancel-btn { font-size: 30rpx; color: #999; padding: 10rpx 0; }
.confirm-btn { font-size: 30rpx; color: #ff4d4d; font-weight: bold; padding: 10rpx 0; }
.user-list-scroll { height: calc(100% - 200rpx); background-color: #F4F6F9; }
.user-cell { margin: 16rpx 30rpx; border-radius: 16rpx; background: #fff !important; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02); }
.bottom-action { position: fixed; bottom: 0; left: 0; width: 100%; padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.04); box-sizing: border-box; z-index: 100; display: flex; justify-content: space-between; }
.draft-btn { width: 260rpx !important; border-radius: 12rpx !important; font-weight: bold !important; font-size: 30rpx !important; }
.submit-btn { width: 400rpx !important; border-radius: 12rpx !important; font-weight: bold !important; font-size: 32rpx !important; }
.float-history-btn { position: fixed; right: 0; top: 40%; background: rgba(255, 77, 77, 0.9); color: #fff; padding: 12rpx 20rpx 12rpx 24rpx; border-radius: 40rpx 0 0 40rpx; display: flex; align-items: center; gap: 8rpx; z-index: 90; box-shadow: -4rpx 4rpx 12rpx rgba(255, 77, 77, 0.3); font-size: 24rpx; font-weight: bold; }
.y-popup-header { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 40rpx; background: #fff; border-radius: 32rpx 32rpx 0 0; }
.y-title { font-size: 32rpx; font-weight: bold; color: #333; }
.y-scroll-view { height: calc(100% - 100rpx); padding: 0 40rpx; box-sizing: border-box; background: #F8F9FA; }
.y-item { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-top: 20rpx; border: 1rpx solid #eee; }
.y-label { font-size: 26rpx; color: #888; margin-bottom: 12rpx; font-weight: bold; }
.y-value { font-size: 28rpx; color: #333; line-height: 1.5; word-break: break-all; }
.y-simple-list { padding-top: 8rpx; }
.y-simple-row { display: flex; align-items: flex-start; margin-bottom: 12rpx; font-size: 28rpx; line-height: 1.5; }
.y-index { color: #999; margin-right: 12rpx; font-family: DIN, sans-serif; font-weight: bold; }
.y-row-content { flex: 1; word-break: break-all; }
.y-val-text { color: #444; }
.y-divider { display: inline-block; width: 12rpx; }
.section-main-title { display: flex; align-items: center; font-size: 34rpx; font-weight: 900; color: #333; margin: 0 0 10rpx 0; }
.title-bar { width: 8rpx; height: 32rpx; background: #00B094; border-radius: 4rpx; margin-right: 16rpx; }