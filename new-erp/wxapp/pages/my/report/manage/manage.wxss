page { background-color: #F4F6F9; padding-bottom: 140rpx; }

.header-action { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 40rpx 20rpx; }
.section-title { font-size: 32rpx; font-weight: bold; color: #333; }

.create-btn { display: flex; align-items: center; font-size: 28rpx; color: #ff4d4d; font-weight: 500; background: rgba(255, 77, 77, 0.1); padding: 10rpx 20rpx; border-radius: 30rpx; }
.create-btn:active { opacity: 0.7; }

.manage-group { box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02) !important; margin-top: 10rpx !important; }

/* 列表项里的图标和文字排版 */
.cell-title-wrap { display: flex; align-items: center; padding: 10rpx 0; }
.icon-box { width: 72rpx; height: 72rpx; border-radius: 16rpx; display: flex; justify-content: center; align-items: center; margin-right: 24rpx; flex-shrink: 0; transition: background-color 0.3s; }
.icon-img { width: 36rpx; height: 36rpx; }
.text-box { display: flex; flex-direction: column; justify-content: center; }
.tpl-name { font-size: 30rpx; color: #333; font-weight: bold; margin-bottom: 8rpx; display: flex; align-items: center; }
.tpl-desc { font-size: 24rpx; color: #999; }

/* === 新增样式 === */
.status-tag { font-size: 20rpx; color: #999; background: #f0f0f0; padding: 2rpx 10rpx; border-radius: 6rpx; margin-left: 14rpx; font-weight: normal; }
.cell-disabled { opacity: 0.6; }

/* 左滑菜单操作按钮 */
.swipe-actions { display: flex; height: 100%; }
.swipe-btn { display: flex; align-items: center; justify-content: center; width: 65px; color: #fff; font-size: 28rpx; }
.btn-warning { background-color: #ff9500; }
.btn-danger { background-color: #ff4d4d; }

.loading-text { text-align: center; font-size: 24rpx; color: #999; padding: 40rpx 0; }