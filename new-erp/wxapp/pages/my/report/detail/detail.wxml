<wxs module="starTool">
  var getStars = function(label) {
    if (!label) return [];
    if (label.indexOf('重要且紧急') !== -1) return [1,2,3,4,5];
    if (label.indexOf('重要不紧急') !== -1) return [1,2,3];
    if (label.indexOf('紧急不重要') !== -1) return [1,2];
    return [];
  }
  module.exports = { getStars: getStars };
</wxs>

<view class="container">
  <view class="detail-card header-section">
    <view class="report-title">{{detail.submitter_name || '我'}}提交的{{detail.template_name}}</view>
    <view class="report-no">汇报编号：{{detail.report_no}}</view>
    <view class="dept-info">
      <van-icon name="stop-circle" color="#409EFF" size="16px" custom-class="dept-icon" />
      <text>所在部门：{{detail.department_name || '暂无部门'}}</text> 
    </view>
  </view>

  <view class="content-section">
    <block wx:for="{{renderList}}" wx:key="index">
      
      <view wx:if="{{item.type === 'section_title'}}" class="section-main-title">
        <view class="title-bar"></view>
        <text>{{item.label}}</text>
      </view>
      
      <view class="detail-card field-item" wx:if="{{item.type === 'text' || item.type === 'textarea'}}">
        <view class="field-label">{{item.label}}</view>
        <view class="field-value">{{item.value || '无'}}</view>
      </view>

      <view class="detail-card field-item" wx:elif="{{item.type === 'rate'}}">
        <view class="field-label">{{item.label}}</view>
        <view class="rate-value-wrap">
          <van-rate value="{{item.value || 0}}" size="22" color="#ffd21e" readonly />
          <text class="rate-text">{{item.value ? item.value + ' 分' : '未评分'}}</text>
        </view>
      </view>

      <view class="detail-card field-item" wx:elif="{{item.type === 'image'}}">
        <view class="field-label">{{item.label}}</view>
        <view class="field-value" wx:if="{{!item.value || item.value.length === 0}}">无</view>
        <view class="image-grid" wx:else>
          <image wx:for="{{item.value}}" wx:for-item="img" wx:key="index" src="{{img.url}}" class="preview-img" mode="aspectFill" bindtap="previewImage" data-url="{{img.url}}" data-urls="{{item.value}}"></image>
        </view>
      </view>

      <view class="list-module" wx:elif="{{item.type === 'detail_list'}}">
        <view class="sub-section-title" style="display: flex; align-items: center;">
          <text style="flex-shrink: 0;">{{item.label}}</text>
          <view wx:if="{{starTool.getStars(item.label).length > 0}}" style="display: flex; align-items: center; margin-left: 16rpx; flex-shrink: 0;">
            <van-icon name="star" color="#ff4d4d" size="20px" wx:for="{{starTool.getStars(item.label)}}" wx:key="*this" style="margin-right: 4rpx;" />
          </view>
        </view>

        <view class="detail-card" wx:if="{{!item.value || item.value.length === 0}}">
          <view class="field-value" style="color: #999;">无</view>
        </view>
        
        <view class="simple-list" wx:else>
          <view class="detail-card row-card" wx:for="{{item.value}}" wx:for-item="row" wx:for-index="rIndex" wx:key="index">
            <view class="row-body">
              <block wx:for="{{item.children}}" wx:for-item="child" wx:for-index="cIndex" wx:key="index">
                <view class="child-val-line {{cIndex < item.children.length - 1 ? 'dashed-border' : ''}}" wx:if="{{row['child_' + cIndex]}}">
                  <view class="child-label" wx:if="{{item.children.length > 1}}">{{child.label || child.placeholder}}</view>
                  <view class="val-text {{child.type === 'radio' || child.type === 'time_list' ? 'highlight-text' : ''}}">{{row['child_' + cIndex] === 'nothing' ? '无' : row['child_' + cIndex]}}</view>                </view>
              </block>
            </view>
          </view>
        </view>
      </view>

    </block>
  </view>

  <view class="footer-time">提交时间：{{detail.create_date}}</view>

  <view class="review-section" wx:if="{{reviews.length > 0}}">
    <view class="section-title">
      <view class="title-line" style="background: #409EFF;"></view>
      <text>流转与回应记录</text>
    </view>
    <view class="timeline-container">
      <view class="timeline-item" wx:for="{{reviews}}" wx:key="id">
        <view class="timeline-icon {{item.user_id == detail.user_id ? 'icon-self' : 'icon-leader'}}">{{item.avatar_text}}</view>
        <view class="timeline-line" wx:if="{{index !== reviews.length - 1}}"></view>
        <view class="timeline-content">
          <view class="oa-flow-card">
            <view class="flow-card-header">
              <view class="flow-user-info"><text class="flow-name">{{item.nickname}}</text></view>
              <text class="flow-time">{{item.createtime_text}}</text>
            </view>
            <view class="flow-card-body"><text class="flow-content">{{item.content}}</text></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-spacer"></view>

  <view class="bottom-action-bar van-hairline--top" wx:if="{{ canReview }}">
    <view class="action-btn-group">
      <view class="btn-item" wx:if="{{ is_super_admin && !detail.score_id}}">
        <van-button custom-class="oa-action-btn point-btn" icon="award-o" round block plain color="#ff976a" bind:click="showPointsPopup">给予加分</van-button>
      </view>
      <view class="btn-item">
        <van-button custom-class="oa-action-btn" icon="edit" round block color="#ff4d4d" bind:click="showReviewPopup">添加回应</van-button>
      </view>
    </view>
  </view>
</view>

<van-popup show="{{ showReview }}" position="bottom" bind:close="hideReviewPopup" round custom-style="padding: 40rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));">
  <view class="popup-title">添加回应</view>
  <view class="textarea-box">
    <textarea class="oa-textarea" placeholder="请输入您的意见..." value="{{ reviewContent }}" bindinput="onReviewInput" fixed="true" show-confirm-bar="{{false}}" cursor-spacing="120"></textarea>
  </view>
  <van-button custom-class="oa-submit-btn" round block color="#ff4d4d" bind:click="submitReview">确认提交</van-button>
</van-popup>

<van-popup show="{{ showPoints }}" position="bottom" bind:close="hidePointsPopup" round custom-style="padding: 40rpx 30rpx calc(40rpx + env(safe-area-inset-bottom)); background: #fff;">
  <view class="popup-title">打分/加积分</view>
  <view class="points-box" style="margin-bottom: 24rpx;">
    <view class="points-left">
      <van-icon name="gem-o" size="24px" color="#ff976a" />
      <text class="points-label">奖励表现积分：</text>
    </view>
    <van-stepper value="{{ pointsValue }}" min="1" max="10" integer bind:change="onPointsChange" button-size="32px" input-width="80px" />
  </view>
  <view class="textarea-box" style="margin-bottom: 40rpx;">
    <textarea class="oa-textarea" style="height: 160rpx;" placeholder="请输入加分理由/备注 (选填)..." value="{{ pointsRemark }}" bindinput="onPointsRemarkInput" fixed="true" show-confirm-bar="{{false}}" cursor-spacing="120"></textarea>
  </view>
  <van-button custom-class="oa-submit-btn" round block color="#ff976a" bind:click="submitPoints">确认加分</van-button>
</van-popup>