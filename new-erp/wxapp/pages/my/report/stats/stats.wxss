page { background-color: #F4F6F9; height: 100vh; display: flex; flex-direction: column; }
.container { display: flex; flex-direction: column; height: 100%; }

/* 头部固定区 */
.template-bar { display: flex; align-items: center; padding: 10rpx 30rpx; background: #fff; z-index: 100; }
.label { font-size: 28rpx; color: #333; flex-shrink: 0; font-weight: bold; }
.dropdown-wrap { flex: 1; margin-left: 20rpx; }
.dropdown-wrap .van-dropdown-menu { height: 70rpx !important; box-shadow: none !important; background: transparent !important; }
.dropdown-wrap .van-dropdown-menu__title { font-size: 28rpx !important; color: #333 !important; padding: 0 40rpx 0 10rpx !important; }

.mode-tabs { background: #fff; }

.date-header { display: flex; align-items: center; justify-content: space-between; background: #fff; padding: 20rpx 40rpx; }
.date-btn { padding: 10rpx 30rpx; color: #666; font-size: 32rpx; }
.current-date { display: flex; align-items: center; font-size: 30rpx; font-weight: bold; color: #333; }
.cal-icon { margin-right: 10rpx; }

/* 滚动区域 */
.main-scroll { flex: 1; height: 0; box-sizing: border-box; }

/* ========================================== */
/* 💥 钉钉风：顶部数据看板与图表 💥 */
/* ========================================== */
.dashboard-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx;
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.chart-section {
  width: 220rpx;
  display: flex;
  justify-content: center;
  position: relative;
}
.circle-text-wrap {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.circle-num { font-size: 36rpx; font-weight: 900; color: #333; }
.circle-lbl { font-size: 22rpx; color: #999; margin-top: 4rpx; }

.data-section {
  flex: 1;
  display: flex;
  justify-content: space-around;
  padding-left: 20rpx;
}
.data-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.d-num { font-size: 44rpx; font-weight: bold; color: #333; margin-bottom: 8rpx; font-family: DIN, sans-serif; }
.d-lbl { font-size: 24rpx; color: #666; }

/* 颜色状态 */
.success { color: #00B094 !important; }
.danger { color: #ff4d4d !important; }

/* ========================================== */
/* 下方明细列表区域 */
/* ========================================== */
.list-section {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 24rpx 24rpx;
  padding-top: 30rpx;
  min-height: 500rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}
.section-title { display: flex; align-items: center; font-size: 30rpx; font-weight: bold; color: #333; padding: 0 30rpx 20rpx; border-bottom: 1rpx solid #f5f5f5; }
.title-line { width: 6rpx; height: 28rpx; background: #ff4d4d; border-radius: 4rpx; margin-right: 16rpx; }

.user-row { display: flex; justify-content: space-between; align-items: center; padding: 30rpx; border-bottom: 1rpx solid #f9f9f9; }
.user-info { display: flex; align-items: center; }
.avatar-wrap { width: 76rpx; height: 76rpx; border-radius: 50%; background: #ff4d4d; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: bold; margin-right: 24rpx; }
.success-bg { background: #00B094; }
.warning-bg { background: #faad14; }
.name-wrap { display: flex; flex-direction: column; }
.nickname { font-size: 30rpx; color: #333; font-weight: 500; margin-bottom: 6rpx; }
.dept { font-size: 22rpx; color: #999; }

.status-tag { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 8rpx; }
.status-time { font-size: 26rpx; color: #999; font-family: DIN, sans-serif; }

/* 月度统计专属样式 */
.month-stats { text-align: right; }
.m-stat-item { font-size: 24rpx; color: #666; line-height: 1.6; }
.m-val { font-size: 30rpx; font-weight: bold; margin-right: 6rpx; font-family: DIN, sans-serif; }
.detail-btn { 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  justify-content: center; 
  margin-left: 30rpx; 
  padding-left: 30rpx; 
  border-left: 1rpx solid #eee; 
}
.detail-btn text { font-size: 22rpx; color: #999; margin-top: 8rpx; }

.detail-scroll { height: calc(100% - 120rpx); padding: 0 40rpx; box-sizing: border-box; }

/* 像 GitHub 提交一样的打卡方块网格 */
.calendar-grid { 
  display: grid; 
  grid-template-columns: repeat(7, 1fr); /* 一排7天 */
  gap: 20rpx; 
  padding-bottom: 60rpx; 
}
.detail-btn { 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  justify-content: center; 
  margin-left: 30rpx; 
  padding-left: 30rpx; 
  border-left: 1rpx solid #eee; 
}
.detail-btn text { font-size: 22rpx; color: #999; margin-top: 8rpx; }

/* 弹窗头部 */
.detail-popup-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 36rpx 40rpx 20rpx;
  position: relative;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
}
.detail-popup-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #333;
}
.detail-close-icon {
  position: absolute;
  right: 40rpx;
  top: 36rpx;
  padding: 10rpx;
}

/* 图例 */
.detail-legend {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0 40rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.legend-item { display: flex; align-items: center; margin: 0 20rpx; font-size: 24rpx; color: #666; }
.legend-dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-right: 10rpx; }
.legend-dot.submitted { background: #00B094; }
.legend-dot.missed { background: #ff4d4d; }

/* 滚动区域 */
.detail-scroll { 
  height: calc(100% - 160rpx); 
  padding: 40rpx; 
  box-sizing: border-box; 
}

/* 打卡方块网格 */
.calendar-grid { 
  display: grid; 
  grid-template-columns: repeat(7, 1fr); 
  gap: 20rpx 16rpx; 
}

.cal-day { 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  justify-content: center; 
  border-radius: 12rpx; 
  padding: 18rpx 0; 
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
  background: #fff;
}

/* 颜色状态与精致描边 */
.cal-day.submitted { 
  background: #f0fbf9; 
  color: #00B094; 
  border: 1rpx solid #bcf0e6; 
}
.cal-day.missed { 
  background: #fff0f0; 
  color: #ff4d4d; 
  border: 1rpx solid #ffd4d4; 
}

.cal-day .d-num { font-size: 30rpx; font-weight: bold; margin-bottom: 6rpx; font-family: DIN, sans-serif; }
.cal-day .d-icon { font-size: 20rpx; font-weight: bold; }
