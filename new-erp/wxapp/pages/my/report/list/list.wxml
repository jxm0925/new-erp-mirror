<view class="container">
  
  <view class="search-box">
    <van-search value="{{ keyword }}" placeholder="搜索汇报内容/提交人" bind:change="onSearchInput" shape="round" />
  </view>

  <view class="nav-bar">
    <view class="tabs-wrap">
      <van-tabs active="{{ currentTab }}" color="#ff4d4d" bind:change="switchTab" line-width="60">
        <van-tab wx:if="{{ isBoss }}" title="全员" name="all_staff"></van-tab>
        <van-tab title="我收到的" name="received"></van-tab>
        <van-tab title="我提交的" name="submitted"></van-tab>
      </van-tabs>
    </view>
    
    <view class="export-trigger" bindtap="exportListContent">
      <van-icon name="down" size="16px" color="#ff4d4d" />
      <text class="export-text">导出</text>
    </view>

    <view class="filter-trigger" bindtap="showFilterPopup">
      <van-icon name="filter-o" size="16px" color="#666" />
      <text class="filter-text">筛选</text>
    </view>
  </view>

  <view class="action-bar" wx:if="{{currentTab === 'received'}}">
    <van-checkbox value="{{ showUnreadOnly }}" checked-color="#ff4d4d" icon-size="16px" bind:change="toggleUnread">仅显示未读</van-checkbox>
    <text class="mark-read-btn" bindtap="markAllRead">全部标记为已读</text>
  </view>

  <scroll-view scroll-y class="list-scroll" bindscrolltolower="loadMore">
    <van-empty wx:if="{{listData.length === 0}}" description="暂无符合条件的汇报" />
    
    <block wx:for="{{listData}}" wx:key="id">
      <view class="oa-card" bindtap="goToDetail" data-id="{{item.id}}">
        <view class="card-header">
          <view class="title-wrap">
            <view class="unread-dot" wx:if="{{!item.is_read}}"></view>
            <text class="card-title {{item.is_read ? 'text-read' : 'text-unread'}}">{{item.title}}</text>
          </view>
          <view class="custom-tag {{item.status === 'pending' ? 'tag-danger' : 'tag-default'}}">
            {{item.statusText}}
          </view>
        </view>

        <view class="card-body">
          <view class="info-row" wx:for="{{item.summary}}" wx:key="label" wx:for-item="sum">
            <text class="row-label">{{sum.label}}:</text>
            <text class="row-value">{{sum.value}}</text>
          </view>
        </view>

        <view class="card-footer van-hairline--top">
          <view class="footer-left">
            <van-icon name="user-o" size="14px" custom-class="footer-icon" />
            <text class="sub-text">{{item.submitter}} 提交</text>
          </view>
          <view class="footer-right">
            <van-icon name="clock-o" size="14px" custom-class="footer-icon" />
            <text class="sub-text">{{item.date}}</text>
          </view>
        </view>

        <view class="edit-action-wrap" wx:if="{{currentTab === 'submitted' && item.status === 'pending'}}">
          <van-button size="small" round plain color="#ff4d4d" catchtap="goToEdit" data-id="{{item.id}}" data-tid="{{item.template_id}}">修改内容</van-button>
        </view>
      </view>
    </block>

    <view wx:if="{{listData.length > 0}}" style="text-align: center; padding: 30rpx 0; color: #999; font-size: 24rpx; padding-bottom: 60rpx;">
      {{ listData.length >= total ? '— 已经到底啦 —' : '上拉加载更多...' }}
    </view>
  </scroll-view>
</view>

<van-popup show="{{ isFilterShow }}" position="bottom" z-index="10000" custom-style="height: 85%; border-radius: 24rpx 24rpx 0 0;" bind:close="hideFilterPopup">
  <view class="filter-drawer">
    <view class="filter-header van-hairline--bottom">
      <text class="btn-reset" bindtap="resetFilter">重置</text>
      <text class="title">数据筛选</text>
      <text class="btn-confirm" bindtap="confirmFilter">确定</text>
    </view>
    
    <scroll-view scroll-y class="filter-body">
      <view class="filter-section">
        <view class="filter-section-title">汇报模板</view>
        <view class="tag-grid">
          <view class="filter-tag {{ item.selected ? 'active' : '' }}" wx:for="{{ dynamicTypes }}" wx:key="id" bindtap="toggleType" data-index="{{index}}">
            <text>{{item.name}}</text>
            <van-icon wx:if="{{item.selected}}" name="cross" custom-class="close-icon" />
          </view>
        </view>
      </view>

      <view class="filter-section">
        <view class="filter-section-title">快捷时间</view>
        <view class="tag-grid">
          <view class="filter-tag {{ timeRange === item.value ? 'active' : '' }}" wx:for="{{ timeOptions }}" wx:key="value" bindtap="selectTime" data-val="{{item.value}}">
            <text>{{item.label}}</text>
            <van-icon wx:if="{{timeRange === item.value}}" name="cross" custom-class="close-icon" />
          </view>
        </view>
      </view>

      <view class="filter-section">
        <view class="filter-section-title">自定义时间范围</view>
        <view class="input-box" bindtap="openCalendar">
          <input placeholder="点击选择日期区间" disabled value="{{customDate}}" style="pointer-events: none;" />
        </view>
      </view>

      <view class="filter-section">
        <view class="filter-section-title">提交人员</view>
        <view class="input-box">
          <input placeholder="请输入提交人员姓名" value="{{selectedUser}}" bindinput="onUserInput" />
        </view>
      </view>
    </scroll-view>
  </view>
</van-popup>

<van-popup show="{{ show_date_choose }}" round custom-style="height:60%" bind:close="hidePop" position="bottom" z-index="10001" data-type="search-date">
    <view style="width: 100%; height: 100%; padding-top: 20rpx; box-sizing: border-box;" wx:if="{{ renderCalendar }}">
      <calendar config="{{calendarConfig}}" bind:afterTapDate="afterTapDate" />
    </view>
</van-popup>

<report-tabbar current="list"></report-tabbar>