page {
  height: 100vh; 
  display: flex;
  flex-direction: column;
  background-color: #F4F6F9;
}
  
.container {
  display: flex;
  flex-direction: column;
  height: 100%; 
}

.search-box { background: #fff; padding: 10rpx 0; }
.nav-bar { display: flex; align-items: center; background: #fff; padding-right: 30rpx; position: relative; }
.tabs-wrap { flex: 1; overflow: hidden; }

/* 💥 追加：导出按钮样式 💥 */
.export-trigger { display: flex; align-items: center; justify-content: center; padding: 0 20rpx; }
.export-text { font-size: 26rpx; color: #ff4d4d; margin-left: 8rpx; font-weight: bold;}

.filter-trigger { display: flex; align-items: center; justify-content: center; padding-left: 20rpx; border-left: 1rpx solid #eee; height: 40rpx; }
.filter-text { font-size: 26rpx; color: #666; margin-left: 8rpx; }

.action-bar { display: flex; justify-content: space-between; align-items: center; padding: 25rpx 30rpx 10rpx 30rpx; background: #F4F6F9; font-size: 26rpx; color: #666; }
.mark-read-btn { color: #007AFF; } 

.list-scroll { 
  flex: 1; 
  padding: 0 30rpx; 
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); 
  height: 0; 
  box-sizing: border-box; 
}
.oa-card { background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02); margin-top: 15rpx;}

/* 卡片头部排版优化 */
.card-header { display: flex; justify-content: space-between; align-items: flex-start; padding: 0 0 24rpx; }
.title-wrap { display: flex; align-items: center; flex: 1; padding-right: 20rpx; }
.unread-dot { width: 14rpx; height: 14rpx; background-color: #ff4d4d; border-radius: 50%; margin-right: 12rpx; flex-shrink: 0; box-shadow: 0 0 8rpx rgba(255, 77, 77, 0.4); }
.card-title { font-size: 32rpx; line-height: 1.4; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.text-unread { font-weight: bold; color: #333; }
.text-read { font-weight: 500; color: #999; }

/* 纯手工精美状态标签 */
.custom-tag {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-weight: bold;
  white-space: nowrap;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.tag-danger { color: #ff4d4d; background-color: rgba(255, 77, 77, 0.1); }
.tag-default { color: #999; background-color: #f5f5f5; }

/* 卡片内容排版优化 */
.card-body { margin-bottom: 24rpx; }
.info-row { display: flex; font-size: 26rpx; color: #666; margin-bottom: 12rpx; line-height: 1.6; }
.row-label { color: #888; margin-right: 16rpx; flex-shrink: 0; }
.row-value { color: #444; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 底部排版 */
.card-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 24rpx; }
.footer-left, .footer-right { display: flex; align-items: center; color: #999; font-size: 24rpx; }
.footer-icon { margin-right: 8rpx; opacity: 0.8; }
.sub-text { font-size: 24rpx; color: #999; }

.edit-action-wrap { display: flex; justify-content: flex-end; margin-top: 20rpx; }

/* 筛选弹窗内部样式 */
.filter-drawer { height: 100%; display: flex; flex-direction: column; background: #fff; }
.filter-header { display: flex; justify-content: space-between; align-items: center; padding: 30rpx; font-size: 30rpx; }
.btn-reset { color: #999; }
.title { font-weight: bold; color: #333; }
.btn-confirm { color: #ff4d4d; font-weight: bold; }

.filter-body { flex: 1; padding: 0 30rpx 40rpx; box-sizing: border-box; }
.filter-section { margin-top: 40rpx; }
.filter-section-title { font-size: 26rpx; color: #333; font-weight: bold; margin-bottom: 24rpx; }

.tag-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.filter-tag { width: 30%; height: 64rpx; background: #F8F9FA; border: 1rpx solid #E5E5E5; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #333; position: relative; box-sizing: border-box; }
.filter-tag.active { background: rgba(255, 77, 77, 0.05); border-color: #ff4d4d; color: #ff4d4d; font-weight: bold; }
.close-icon { font-size: 20rpx !important; color: #ff4d4d; margin-left: 8rpx; }

.input-box { background: #F8F9FA; border-radius: 8rpx; padding: 20rpx; border: 1rpx solid #E5E5E5; }
.input-box input { font-size: 26rpx; color: #333; width: 100%; }