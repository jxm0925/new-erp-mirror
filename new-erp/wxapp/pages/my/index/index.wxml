<view class="container">
  <!-- 顶部渐变身份 Header -->
  <view class="user-section">
    <view class="user-header-bg">
      <view class="bg-circle bg-circle-1"></view>
      <view class="bg-circle bg-circle-2"></view>
    </view>
    <view class="user-info-box" bindtap="closeTank">
      <view class="portrait-box">
        <image class="portrait" src='{{userInfo.avatar ? userInfo.avatar : "/static/images/missing_face.png"}}' mode="aspectFill"></image>
      </view>
      <view class="info-box">
        <view class="name-row">
          <text class="username">{{userInfo.name ? userInfo.name : '点击登录'}}</text>
          <van-button wx:if="{{userInfo.is_login && !userInfo.user_id}}" custom-class="bind-btn" type="default" size="mini" round bind:tap="loginPop">绑定账号</van-button>
          <view wx:if="{{userInfo.is_login && (erpUser.role_name || erpUser.nickname)}}" class="role-pill">
            <text>{{erpUser.role_name || erpUser.nickname}}</text>
          </view>
        </view>
        <view class="sub-row">
          <text wx:if="{{userInfo.is_login}}" class="points">个人积分：{{score || 0}}</text>
          <text wx:else class="login-tip">登录开启生产报工与全员协同服务</text>
        </view>
      </view>
      <button
        wx:if="{{userInfo.is_login || unifiedLoggedIn}}"
        class="profile-logout"
        loading="{{logoutBusy}}"
        disabled="{{logoutBusy}}"
        catchtap="logoutAll"
      >退出</button>
    </view>
  </view>

  <!-- 悬浮核心数据资产卡片 -->
  <view class="stats-card">
    <view class="stats-item" data-url="/pages/mall/score/index" data-auth="true" bindtap="navTo">
      <view class="stats-num">{{userInfo.is_login ? score : 0}}</view>
      <view class="stats-label">
        <van-icon name="gold-coin" size="24rpx" color="#ff9500" />
        <text>可用积分</text>
      </view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item" data-url="/pages/suggests/index/index" data-auth="true" bindtap="navTo">
      <view class="stats-num stats-icon-num">
        <van-icon name="records" size="38rpx" color="#e52613" />
      </view>
      <view class="stats-label">
        <text>我的提案</text>
      </view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item" data-url="/pages/production/my-tasks/index" data-auth="true" bindtap="navTo">
      <view class="stats-num stats-icon-num">
        <van-icon name="todo-list-o" size="38rpx" color="#1890ff" />
      </view>
      <view class="stats-label">
        <text>工单任务</text>
      </view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item" data-url="/pages/mall/index/index" data-tab="true" bindtap="navTo">
      <view class="stats-num stats-icon-num">
        <van-icon name="shop-collect-o" size="38rpx" color="#ff4d4f" />
      </view>
      <view class="stats-label">
        <text>积分商城</text>
      </view>
    </view>
  </view>

  <!-- 功能模块区 -->
  <view class="section-container">
    <!-- 板块一：提案改善中心 -->
    <view class="menu-card">
      <view class="card-header">
        <view class="card-title-wrap">
          <view class="card-mark mark-red"></view>
          <text class="card-title">提案改善中心</text>
        </view>
        <text class="card-subtitle">人人创新 · 全员改善</text>
      </view>
      <view class="action-grid">
        <view class="action-item" data-url="/pages/suggests/sub/index" data-auth="true" bindtap="navTo">
          <view class="action-icon-box icon-orange">
            <van-icon name="edit" size="44rpx" color="#ff7a00" />
          </view>
          <view class="action-text">
            <text class="action-title">我要提建议</text>
            <text class="action-desc">提报改善，赢取奖励</text>
          </view>
        </view>
        <view class="action-item" data-url="/pages/suggests/index/index" data-auth="true" bindtap="navTo">
          <view class="action-icon-box icon-red">
            <van-icon name="orders-o" size="44rpx" color="#d81e06" />
          </view>
          <view class="action-text">
            <text class="action-title">我的提案记录</text>
            <text class="action-desc">流转跟踪与认领动态</text>
          </view>
        </view>
        <view class="action-item" bindtap="suggestManage">
          <view class="action-icon-box icon-purple">
            <van-icon name="manager-o" size="44rpx" color="#722ed1" />
          </view>
          <view class="action-text">
            <view class="title-with-tag">
              <text class="action-title">改良委工作台</text>
              <text class="action-tag">管理</text>
            </view>
            <text class="action-desc">提案认领与落地评审</text>
          </view>
        </view>
        <view class="action-item" data-url="/pages/suggests/index/index?active=3" data-auth="true" bindtap="navTo">
          <view class="action-icon-box icon-green">
            <van-icon name="award-o" size="44rpx" color="#36ba73" />
          </view>
          <view class="action-text">
            <text class="action-title">优秀成果展</text>
            <text class="action-desc">已落地成效与标杆</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 板块二：生产现场与日常协同 -->
    <view class="menu-card">
      <view class="card-header">
        <view class="card-title-wrap">
          <view class="card-mark mark-blue"></view>
          <text class="card-title">生产执行与协同</text>
        </view>
        <text class="card-subtitle">现场报工 · 任务流转</text>
      </view>
      <view class="action-grid">
        <view class="action-item" data-url="/pages/production/workbench/index" data-auth="true" bindtap="navTo">
          <view class="action-icon-box icon-blue">
            <van-icon name="chart-trending-o" size="44rpx" color="#1890ff" />
          </view>
          <view class="action-text">
            <text class="action-title">生产工作台</text>
            <text class="action-desc">看板概况与生产趋势</text>
          </view>
        </view>
        <view class="action-item" data-url="/pages/production/my-tasks/index" data-auth="true" bindtap="navTo">
          <view class="action-icon-box icon-indigo">
            <van-icon name="send-gift-o" size="44rpx" color="#2f54eb" />
          </view>
          <view class="action-text">
            <text class="action-title">我的生产任务</text>
            <text class="action-desc">现场派工与领料报工</text>
          </view>
        </view>
        <view class="action-item" data-url="/pages/my/report/index/index" data-auth="true" bindtap="navTo">
          <view class="action-icon-box icon-cyan">
            <van-icon name="description-o" size="44rpx" color="#13c2c2" />
          </view>
          <view class="action-text">
            <text class="action-title">工作日报汇报</text>
            <text class="action-desc">日志填报与团队汇总</text>
          </view>
        </view>
        <view class="action-item" data-url="/pages/my/needs/needs" data-auth="true" bindtap="navTo">
          <view class="action-icon-box icon-amber">
            <van-icon name="newspaper-o" size="44rpx" color="#fa8c16" />
          </view>
          <view class="action-text">
            <text class="action-title">需求与水质方案</text>
            <text class="action-desc">客户需求收集与归档</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 板块三：服务与设置 -->
    <view class="menu-card">
      <view class="card-header">
        <view class="card-title-wrap">
          <view class="card-mark mark-gray"></view>
          <text class="card-title">个人服务与支持</text>
        </view>
      </view>
      <view class="cell-list">
        <view class="cell-row" data-url="/pages/mall/score/index" data-auth="true" bindtap="navTo">
          <view class="cell-row-left">
            <view class="cell-mini-icon icon-yellow"><van-icon name="balance-list-o" size="32rpx" color="#faad14" /></view>
            <text class="cell-row-title">积分收支明细</text>
          </view>
          <view class="cell-row-right">
            <text class="cell-row-value">{{userInfo.is_login ? score + ' 分' : '去查看'}}</text>
            <van-icon name="arrow" size="24rpx" color="#b0b8c5" />
          </view>
        </view>
        <view class="cell-row" data-url="/pages/mall/index/index" data-tab="true" bindtap="navTo">
          <view class="cell-row-left">
            <view class="cell-mini-icon icon-red"><van-icon name="bag-o" size="32rpx" color="#ff4d4f" /></view>
            <text class="cell-row-title">积分礼品商城</text>
          </view>
          <view class="cell-row-right">
            <text class="cell-row-value">超多礼品兑换</text>
            <van-icon name="arrow" size="24rpx" color="#b0b8c5" />
          </view>
        </view>
        <view class="cell-row" data-url="/pages/ucenter/help/help" bindtap="navTo">
          <view class="cell-row-left">
            <view class="cell-mini-icon icon-blue"><van-icon name="question-o" size="32rpx" color="#1890ff" /></view>
            <text class="cell-row-title">使用帮助与指南</text>
          </view>
          <view class="cell-row-right">
            <van-icon name="arrow" size="24rpx" color="#b0b8c5" />
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<LoginPopup class="LoginPopup"></LoginPopup>
<van-notify id="van-notify" />
