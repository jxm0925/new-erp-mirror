page, .container {
  width: 100%;
  min-height: 100vh;
  background-color: #f3f6f9;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
  box-sizing: border-box;
}

.container {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 顶部个人信息 Banner */
.container .user-section {
  position: relative;
  height: 290rpx;
  padding: 80rpx 32rpx 0;
  box-sizing: border-box;
  background: linear-gradient(140deg, #cf1b06 0%, #e82e18 55%, #fa4c35 100%);
  overflow: hidden;
}

.user-header-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 70%);
}

.bg-circle-1 {
  width: 380rpx;
  height: 380rpx;
  top: -120rpx;
  right: -60rpx;
}

.bg-circle-2 {
  width: 260rpx;
  height: 260rpx;
  bottom: -90rpx;
  left: 40rpx;
}

.user-info-box{display:flex;align-items:center;gap:22rpx;min-width: 0;position:relative;z-index:2;}

.portrait-box{display:flex;flex: 0 0 auto;align-items:center;justify-content:center;position:relative;}

.user-info-box .portrait {
  display: block;
  width: 126rpx;
  height: 126rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.16);
  box-sizing: border-box;
  background: #ffffff;
}

.info-box{flex: 1 1 auto;min-width: 0;display:flex;flex-direction:column;gap:8rpx;}

.name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.user-info-box .username {
  display: inline-block;
  max-width: 100%;
  overflow: hidden;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  text-overflow: ellipsis;
  white-space: nowrap;
  vertical-align: middle;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
}

.bind-btn {
  height: 42rpx !important;
  line-height: 42rpx !important;
  padding: 0 16rpx !important;
  font-size: 20rpx !important;
  color: #d81e06 !important;
  background: #ffffff !important;
  border: none !important;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.role-pill {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(4px);
}

.role-pill text {
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 500;
  white-space: nowrap;
}

.sub-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.points {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.login-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-logout{flex: 0 0 auto;width:116rpx;height:56rpx;margin:0;padding:0;color:#d81e06;background:#ffffff;border-radius:28rpx;font-size:24rpx;font-weight:600;line-height:56rpx;text-align:center;box-shadow:0 4rpx 14rpx rgba(0,0,0,0.12);transition:opacity 0.15s ease, transform 0.15s ease;}

.profile-logout:active {
  opacity: 0.85;
  transform: scale(0.96);
}

.profile-logout::after {
  border: none;
}

/* 核心数据资产悬浮卡片 */
.stats-card {
  position: relative;
  z-index: 3;
  margin: -48rpx 24rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 32rpx rgba(35, 48, 70, 0.08);
  border: 1rpx solid #edf1f7;
  padding: 24rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-sizing: border-box;
}

.stats-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  cursor: pointer;
}

.stats-item:active {
  opacity: 0.75;
}

.stats-num {
  font-size: 38rpx;
  font-weight: 800;
  color: #1a202c;
  line-height: 1.15;
}

.stats-icon-num {
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stats-label {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #718096;
}

.stats-divider {
  width: 1rpx;
  height: 48rpx;
  background: #edf1f7;
  flex: 0 0 auto;
}

/* 功能模块卡片容器 */
.section-container {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-sizing: border-box;
}

.menu-card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(35, 48, 70, 0.05);
  border: 1rpx solid #eef1f6;
  padding: 26rpx 24rpx;
  box-sizing: border-box;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
  min-width: 0;
}

.card-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.card-mark {
  width: 8rpx;
  height: 30rpx;
  border-radius: 6rpx;
  flex: 0 0 auto;
}

.mark-red { background: #d81e06; }
.mark-blue { background: #1890ff; }
.mark-gray { background: #8c9ba5; }

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a202c;
  white-space: nowrap;
}

.card-subtitle {
  font-size: 22rpx;
  color: #8c9ba5;
  white-space: nowrap;
}

/* 2x2 交互功能网格 */
.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 18rpx 16rpx;
  border: 1rpx solid #eef2f6;
  box-sizing: border-box;
  min-width: 0;
  transition: all 0.15s ease;
}

.action-item:active {
  background: #f1f4f8;
  transform: scale(0.985);
}

.action-icon-box {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.icon-orange { background: #fff5eb; }
.icon-red { background: #fff1f0; }
.icon-purple { background: #f9f0ff; }
.icon-green { background: #f0fbf5; }
.icon-blue { background: #e6f7ff; }
.icon-indigo { background: #f0f5ff; }
.icon-cyan { background: #e6fffb; }
.icon-amber { background: #fff7e6; }
.icon-yellow { background: #fffbe6; }

.action-text {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.title-with-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.action-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #262c36;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-tag {
  font-size: 18rpx;
  color: #722ed1;
  background: #f9f0ff;
  border: 1rpx solid rgba(114, 46, 209, 0.2);
  padding: 1rpx 8rpx;
  border-radius: 8rpx;
  flex: 0 0 auto;
  line-height: 1.2;
}

.action-desc {
  font-size: 21rpx;
  color: #8c98a9;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 列表式菜单条目 */
.cell-list {
  display: flex;
  flex-direction: column;
}

.cell-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 8rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #f2f4f7;
  cursor: pointer;
}

.cell-row:last-child {
  border-bottom: none;
  padding-bottom: 6rpx;
}

.cell-row:first-child {
  padding-top: 6rpx;
}

.cell-row:active {
  opacity: 0.7;
}

.cell-row-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.cell-mini-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.cell-row-title {
  font-size: 27rpx;
  color: #2b3341;
  font-weight: 500;
}

.cell-row-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 0 0 auto;
}

.cell-row-value {
  font-size: 23rpx;
  color: #8c98a9;
}

/* 响应式断点规则（2026-09-08 规范锁定） */
@media screen and (max-width: 360px) {
  .container .user-section {
    padding-left: 24rpx;
    padding-right: 24rpx;
    height: 270rpx;
  }
  .user-info-box {
    gap: 16rpx;
  }
  .user-info-box .portrait {
    width: 112rpx;
    height: 112rpx;
  }
  .user-info-box .username {
    font-size: 30rpx;
  }
  .profile-logout {
    width: 100rpx;
    height: 52rpx;
    line-height: 52rpx;
    font-size: 22rpx;
  }
  .stats-card {
    margin-left: 18rpx;
    margin-right: 18rpx;
    padding: 20rpx 8rpx;
  }
  .stats-num {
    font-size: 32rpx;
  }
  .stats-label {
    font-size: 20rpx;
  }
  .section-container {
    padding: 0 18rpx;
    gap: 20rpx;
  }
  .menu-card {
    padding: 22rpx 18rpx;
  }
  .action-grid {
    gap: 14rpx;
  }
  .action-item {
    padding: 16rpx 12rpx;
    gap: 12rpx;
  }
  .action-icon-box {
    width: 66rpx;
    height: 66rpx;
  }
  .action-title {
    font-size: 24rpx;
  }
  .action-desc {
    font-size: 19rpx;
  }
}

@media screen and (min-width: 430px) {
  .section-container,
  .stats-card {
    max-width: 860rpx;
    margin-left: auto;
    margin-right: auto;
  }
  .stats-card {
    margin-top: -48rpx;
  }
}
