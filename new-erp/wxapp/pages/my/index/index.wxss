page ,.container{
  width: 100%;
  height: 100%;
  background-color: #f4f4f4;
}
.container .user-section {
  height: 200rpx;
  position: relative;
  padding: 100rpx 30rpx 0;
}
.user-section .bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0.9;
}

.user-info-box{
  height: 180rpx;
  display:flex;
  align-items:center;
  position:relative;
  z-index: 1;
}

.user-info-box .portrait{
  width: 130rpx;
  height: 130rpx;
  border:5rpx solid #fff;
  border-radius: 50%;
}
.user-info-box .username{
  font-size: 30rpx;
  color: #303133;
  margin-left: 20rpx;
}
.points{
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #303133;
}
.bind-phone{
  font-size: 24rpx;
  margin-left: 30rpx;
  color: #FF690D;
}
.points-class{
  font-size: 26rpx;
}
.points-text-class{
  font-size: 23rpx;
  padding-top: 10rpx;
}
.func-area{
  margin-top: 20rpx;
}
.erp-auth-card{margin:20rpx 24rpx;padding:24rpx;background:#fff;border-radius:16rpx;box-shadow:0 6rpx 22rpx rgba(30,40,60,.05);position:relative;z-index:2}
.erp-auth-title{display:flex;justify-content:space-between;align-items:center;font-size:28rpx;font-weight:600}
.erp-state{font-size:22rpx;color:#909399;font-weight:400}.erp-state.online{color:#20a53a}
.erp-login-form{display:grid;grid-template-columns:1fr 1fr 150rpx;gap:12rpx;margin-top:20rpx}
.erp-login-form input{height:66rpx;border:1rpx solid #dfe2e7;border-radius:8rpx;padding:0 14rpx;font-size:23rpx;box-sizing:border-box}
.erp-login-form button,.erp-outline{height:66rpx;line-height:66rpx;padding:0;border-radius:8rpx;font-size:23rpx}
.erp-login-form button{background:#d81e06;color:#fff}.erp-login-form button::after,.erp-outline::after{border:0}
.erp-user-row{display:flex;align-items:center;margin-top:18rpx}.erp-user-row>view{display:flex;flex-direction:column;gap:5rpx;flex:1}.erp-user-row text{font-size:21rpx;color:#8a9099}
.erp-outline{width:130rpx;color:#d81e06;background:#fff;border:1rpx solid #d81e06}
