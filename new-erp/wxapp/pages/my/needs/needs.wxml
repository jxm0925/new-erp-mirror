<view class="container">
  
  <view class="header-simple" style="padding: 30rpx 32rpx 20rpx; display: flex; justify-content: space-between; align-items: center;">
    <text style="font-size: 36rpx; font-weight: 900; color: #333;">净水设备需求评估单</text>
    <van-tag type="{{isIterating ? 'warning' : 'primary'}}" size="medium" round>V {{currentVersion}} 版</van-tag>
  </view>

  <view class="archive-entry-card" bindtap="goToArchiveList">
    <view class="entry-header">
      <view class="left-section">
        <van-icon name="orders-o" color="#1989fa" size="36rpx" />
        <text class="header-text">需求单档案库</text>
      </view>
      <van-icon name="arrow" color="#1989fa" size="28rpx" />
    </view>
  </view>

  <view class="form-body">
    
    <view class="custom-card" style="margin-bottom: 24rpx; overflow: visible;">
      <view class="card-header">
        <text class="card-title">1. 关联客户档案</text>
        <text class="required-star">*</text>
      </view>
      <view class="card-content" style="position: relative; padding: 24rpx;">
        
        <view class="search-box">
          <van-icon name="search" color="#999" size="32rpx" style="margin-right: 12rpx;" />
          <van-field
            value="{{ customerName }}"
            placeholder="请输入或搜索客户名称"
            border="{{ false }}"
            bind:input="onCustomerInput"
            custom-style="flex: 1; padding: 0; background: transparent; font-size: 28rpx;"
          />
        </view>

        <view class="dropdown-list" wx:if="{{ showCustomerList && customerOptions.length > 0 }}">
          <view class="dropdown-item" wx:for="{{customerOptions}}" wx:key="index" bindtap="selectCustomer" data-name="{{item}}">
            <van-icon name="user-o" style="margin-right: 12rpx; color: #999;" />
            <text>{{item}}</text>
          </view>
        </view>

        <view style="font-size: 24rpx; color: #999; margin-top: 16rpx;">
          <text wx:if="{{!isIterating}}">输入关联历史，将生成新版本的需求单</text>
          <text wx:else style="color: #ff976a;">已关联成功！提交将生成全新的 V{{currentVersion}} 方案</text>
        </view>
      </view>
    </view>

    <block wx:for="{{formConfig}}" wx:key="id">
      <view class="custom-card">
        
        <view class="card-header">
          <text class="card-title">{{index + 2}}. {{item.label}}</text>
          <text wx:if="{{item.required}}" class="required-star">*</text>
        </view>

        <view class="card-content" style="padding: 0;">
          
          <van-field
            wx:if="{{item.type === 'text' || item.type === 'number'}}"
            value="{{formData[item.id]}}"
            type="{{item.type === 'number' ? 'number' : 'text'}}"
            placeholder="{{item.placeholder}}"
            border="{{false}}"
            bind:input="onFieldInput"
            data-id="{{item.id}}"
            custom-style="padding: 24rpx; background-color: transparent; font-size: 28rpx;"
          />

          <view wx:elif="{{item.type === 'radio'}}" class="tag-group">
            <view
              wx:for="{{item.options}}" wx:key="*this" wx:for-item="option"
              class="tag-item {{formData[item.id] === option ? 'tag-active' : ''}}"
              bindtap="onTagClick"
              data-id="{{item.id}}"
              data-val="{{option}}"
            >
              <text>{{option}}</text>
              <van-icon name="cross" class="tag-close-icon" wx:if="{{formData[item.id] === option}}" catchtap="onTagClear" data-id="{{item.id}}" />
            </view>
          </view>

          <view wx:elif="{{item.type === 'textarea'}}" style="padding: 24rpx;">
            <textarea
              value="{{formData[item.id]}}"
              placeholder="{{item.placeholder}}"
              placeholder-style="color: #c8c9cc; font-size: 28rpx;"
              auto-height="true"
              maxlength="-1"
              disable-default-padding="true"
              bindinput="onFieldInput"
              data-id="{{item.id}}"
              style="width: 100%; min-height: 80rpx; line-height: 40rpx; font-size: 28rpx; color: #333;"
            />
          </view>

        </view>
      </view>
    </block>
  </view>

  <view class="bottom-action">
    <van-button 
      custom-class="submit-btn" 
      color="#1989fa" 
      bind:click="submitForm" 
      block 
      round
      loading="{{ isSubmitting }}"
      loading-text="正在生成中..."
      disabled="{{ isSubmitting }}"
    >
      {{isIterating ? '保存全新的 V'+currentVersion+' 方案' : '保存 V1.0 首版方案'}}
    </van-button>
  </view>

</view>