page {
    background-color: #f2f4f7; 
    padding-bottom: 160rpx; /* 💥 留出底部空间，防挡住 */
  }
  
  /* 💥 新增：搜索框吸顶样式 💥 */
  .search-wrap {
    background: #fff;
    padding-bottom: 10rpx;
    position: sticky;
    top: 0;
    z-index: 10;
  }
  
  .list-container {
    padding: 24rpx;
  }
  
  .customer-card {
    position: relative; /* 💥 为右侧绝对定位的小箭头做准备 */
    background: #ffffff;
    border-radius: 16rpx;
    padding: 32rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
    transition: all 0.2s;
  }
  .customer-card:active {
    transform: scale(0.98);
    background: #fcfcfd;
  }
  
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24rpx;
    border-bottom: 1rpx dashed #eee;
    padding-bottom: 24rpx;
    padding-right: 40rpx; /* 💥 给右侧箭头留出呼吸空间 */
  }
  
  .c-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-right: 20rpx;
  }
  
  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-right: 40rpx; /* 💥 给右侧箭头留出呼吸空间 */
  }
  
  .info-item {
    display: flex;
    align-items: center;
  }
  
  .info-text {
    font-size: 24rpx;
    color: #666;
    margin-left: 8rpx;
  }
  
  /* 💥 卡片右侧指示箭头 💥 */
  .card-arrow {
    position: absolute;
    right: 32rpx;
    top: 50%;
    transform: translateY(-50%);
    font-size: 32rpx;
  }
  
  /* 💥 全新胶囊添加按钮 (替换了原本的圆形加号) 💥 */
  .pill-add-btn {
    position: fixed;
    right: 40rpx;
    bottom: 80rpx;
    background: linear-gradient(135deg, #1989fa 0%, #0066cc 100%);
    color: #fff;
    padding: 0 40rpx;
    height: 90rpx;
    border-radius: 45rpx;
    display: flex;
    align-items: center;
    font-size: 28rpx;
    font-weight: bold;
    box-shadow: 0 10rpx 24rpx rgba(25, 137, 250, 0.3);
    z-index: 99;
    transition: all 0.2s;
  }
  .pill-add-btn:active {
    transform: scale(0.92);
  }