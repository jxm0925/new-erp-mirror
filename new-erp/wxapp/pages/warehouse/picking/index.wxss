@import "../shared.wxss";
.picking-section-title { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.picking-section-title .warehouse-title { margin: 16rpx 0; }
.picking-material-heading { display: flex; gap: 15rpx; align-items: flex-start; margin-bottom: 16rpx; }
.picking-number { width: 44rpx; height: 44rpx; line-height: 44rpx; flex-shrink: 0; text-align: center; color: white; background: #ed100a; border-radius: 50%; }
.picking-material-name { flex: 1; line-height: 1.5; word-break: break-all; font-weight: 500; }
.picking-material-name .warehouse-muted { font-size: 24rpx; font-weight: 400; }
.picking-badge { background: #fff0f0; color: #ed100a; border-radius: 6rpx; padding: 7rpx 10rpx; font-size: 24rpx; flex-shrink: 0; }
.picking-quantities { display: flex; background: #f5f7fa; border-radius: 7rpx; padding: 14rpx 6rpx; margin: 16rpx -8rpx; gap: 0; font-size: 25rpx; }
.picking-quantities > view { flex: 1; padding: 0 10rpx; border-right: 1rpx solid #dfe5ee; line-height: 1.6; word-break: break-all; }
.picking-quantities > view:last-child { border: 0; }
.picking-quantities .warehouse-muted { font-size: 23rpx; }
.picking-qty-value { background: white; border: 1rpx solid #dbe2ed; border-radius: 5rpx; text-align: center; }
.picking-source-title { font-size: 26rpx; font-weight: 500; margin: 16rpx 0; }
.picking-source { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 0; border-top: 1rpx solid #e5e9ef; }
.picking-source-body { flex: 1; font-size: 24rpx; line-height: 1.7; }
.picking-source-body > view { display: flex; justify-content: space-between; gap: 14rpx; }
.picking-source-body text { word-break: break-all; }.picking-source-body text:last-child { flex-shrink: 0; }
.picking-remove { padding: 12rpx 13rpx; background: white; border: 1rpx solid #ed100a; color: #ed100a; font-size: 24rpx; flex-shrink: 0; }
.picking-source-button { padding: 13rpx; margin-top: 16rpx; font-size: 26rpx; }
.picking-selected-total { margin: 14rpx 0; text-align: right; color: #69768b; }
.picking-status { flex: 0 0 105rpx; text-align: right; }
.picking-actual-row { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; flex-wrap: wrap; margin: 20rpx 0 8rpx; }
.picking-actual { display: flex; align-items: center; gap: 12rpx; }
.picking-input-unit { display: flex; align-items: center; border: 1rpx solid #dce2ea; border-radius: 8rpx; background: #fbfcfe; overflow: hidden; }
.picking-input-unit input { width: 110rpx; text-align: center; height: 65rpx; font-size: 27rpx; }.picking-input-unit text { padding: 9rpx 12rpx; border-left: 1rpx solid #dce2ea; }
.picking-identity { margin-top: 20rpx; padding: 14rpx 20rpx; }
.picking-actions { display: flex; flex-direction: column; gap: 18rpx; }
.picking-dialog-title { justify-content: center; }.picking-cancel-text { line-height: 1.8; text-align: center; margin: 10rpx 0 40rpx; }.picking-cancel-label { margin-bottom: 16rpx; color: #617089; }
@media (max-width: 350px) { .warehouse-card { padding: 20rpx; }.warehouse-label { width: 135rpx; }.picking-quantities > view { padding: 0 6rpx; }.picking-source-body > view { gap: 8rpx; }.picking-source-body { font-size: 23rpx; }.picking-source-body text:last-child { flex-shrink: 1; }.picking-badge { padding: 7rpx; } }
