@import "../shared.wxss";
.public-tabs, .public-pages, .public-actions { display: flex; gap: 16rpx; flex-wrap: wrap; align-items: center; margin: 20rpx 0; }
.public-tabs button, .public-pages button, .public-actions button { flex: 1 1 160rpx; margin: 0; min-width: 0; }
.public-pages { flex-wrap: nowrap; }
.public-pages text { flex: none; }
.public-selected { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding: 16rpx 0; overflow-wrap: anywhere; }
.public-selected text:first-child { min-width: 0; flex: 1; }
.public-selected text:last-child { flex: none; }
.warehouse-card { overflow-wrap: anywhere; }
.public-draft { min-width: 0; border-bottom: 1rpx solid #e5e9ef; padding-bottom: 16rpx; }
.public-cut-source { min-width: 0; padding: 14rpx 0; font-size: 25rpx; line-height: 1.7; }
.public-cut-source .warehouse-field { flex-wrap: wrap; gap: 12rpx; }
.public-cut-source input { min-width: 160rpx; flex: 1; width: auto; }
