<view class="warehouse-page">
  <view wx:if="{{error}}" class="warehouse-error">{{error}}</view>
  <block wx:if="{{!id}}">
    <view class="public-tabs"><button wx:if="{{canViewDemands}}" class="{{view==='demands'?'warehouse-primary':'warehouse-secondary'}}" data-view="demands" bindtap="switchView">待配需求</button><button class="{{view==='tasks'?'warehouse-primary':'warehouse-secondary'}}" data-view="tasks" bindtap="switchView">公共配料任务</button></view>
    <view class="warehouse-field"><input class="warehouse-input" value="{{keyword}}" bindinput="keywordInput" placeholder="单号、物料名称或规格" confirm-type="search" bindconfirm="search" /><button class="warehouse-secondary" bindtap="search">查询</button></view>
    <button wx:if="{{canProcure}}" class="warehouse-secondary" bindtap="openProcurement">提交采购需求</button>
    <view wx:if="{{view==='demands' && canCreate}}" class="warehouse-card">
      <view class="warehouse-field" bindtap="chooseWarehouse"><text>配料仓库</text><text>{{warehouse.warehouse_name || '请选择仓库'}} ></text></view>
      <view>已选 {{selectedCount}} 条需求（翻页保留）</view>
      <view wx:for="{{selected}}" wx:key="id" class="public-selected"><text>{{item.label}} · {{item.quantity}}</text><text data-id="{{item.id}}" bindtap="removeSelection">移除</text></view>
      <button class="warehouse-primary" disabled="{{busy || loading || (!pendingCreate && !selectedCount)}}" loading="{{busy}}" bindtap="create">{{pendingCreate?'核对上次创建':'生成公共配料任务'}}</button>
    </view>
    <button wx:if="{{pendingCreate && view!=='demands'}}" class="warehouse-primary" loading="{{busy}}" bindtap="create">核对上次创建</button>
    <view class="warehouse-card" wx:for="{{rows}}" wx:key="id">
      <block wx:if="{{view==='demands'}}"><view class="warehouse-title">{{item.item_code}} {{item.item_name}}</view><view>{{item.spec}}</view><view>来源：{{item.work_order_no}}</view><view>接收工序：{{item.target_operation_name}}</view><view>待配：{{item.remainingText}} {{item.unit_name}} · {{item.fulfillmentText}}</view><button wx:if="{{canCreate}}" class="warehouse-secondary" data-id="{{item.id}}" bindtap="chooseStock">选择库存来源</button></block>
      <block wx:else><view class="warehouse-title">{{item.task_no}}</view><view>{{item.warehouse.warehouse_name}}</view><view>{{item.tasks_count}} 张工单 · {{item.statusText}}</view><button class="warehouse-secondary" data-id="{{item.id}}" bindtap="openTask">查看公共配料任务</button></block>
    </view>
  </block>
  <block wx:elif="{{task}}">
    <view class="warehouse-card"><view class="warehouse-title">{{task.task_no}} · {{task.statusText}}</view><view>仓库：{{task.warehouse.warehouse_name}}</view><view>拣货人：{{task.assigned_picker_name || '待领取'}}</view><button wx:if="{{pendingAction}}" class="warehouse-primary" disabled="{{busy}}" bindtap="recoverAction">核对上次提交</button></view>
    <view class="warehouse-card" wx:for="{{rows}}" wx:key="id">
      <view class="warehouse-title">{{item.item_code}} {{item.item_name}}</view><view>{{item.spec}}</view><view>来源：{{item.work_order_no}}</view><view>计划：{{item.planned_pick_qty}} {{item.unit_name_snapshot}} · {{item.fulfillmentText}}</view>
      <block wx:if="{{task.status==='PICKING'}}"><view class="warehouse-field"><text>实际拣货</text><input class="warehouse-input" type="digit" value="{{item.actualInput}}" data-id="{{item.id}}" bindinput="quantityInput" placeholder="未拣填写0" /></view><button wx:if="{{item.material_management_mode==='physical'}}" class="warehouse-secondary" data-id="{{item.id}}" data-kind="physical" bindtap="chooseTracked">选择板材（{{item.physicalCount}}张）</button><button wx:if="{{item.serial_control_type!=='none'}}" class="warehouse-secondary" data-id="{{item.id}}" data-kind="serial" bindtap="chooseTracked">选择序列号（{{item.serialCount}}件）</button></block>
      <view wx:else>已拣：{{item.actual_pick_qty}} {{item.unit_name_snapshot}}</view>
    </view>
    <view class="public-actions">
      <button wx:if="{{task.status==='WAIT_PICK' && !task.assigned_picker_legacy_id && canPick}}" class="warehouse-primary" data-action="claim" disabled="{{busy || pendingAction}}" bindtap="simpleAction">领取配料</button>
      <button wx:if="{{task.status==='WAIT_PICK' && task.assigned_picker_legacy_id===userId && canPick}}" class="warehouse-primary" data-action="start" disabled="{{busy || pendingAction}}" bindtap="simpleAction">开始拣货</button>
      <button wx:if="{{task.status==='WAIT_PICK' && canAssign}}" class="warehouse-secondary" disabled="{{busy || pendingAction}}" bindtap="assign">分配拣货人</button>
      <button wx:if="{{task.status==='PICKING' && task.assigned_picker_legacy_id===userId && canPick}}" class="warehouse-primary" loading="{{busy}}" disabled="{{busy || pendingAction}}" bindtap="confirm">确认实拣出库</button>
      <button wx:if="{{(task.status==='WAIT_PICK'||task.status==='PICKING') && canCancel}}" class="warehouse-secondary" disabled="{{busy || pendingAction}}" bindtap="openCancel">取消任务</button>
    </view>
    <view class="warehouse-card"><view class="warehouse-title">工单配料记录</view><view wx:for="{{task.children}}" wx:key="id" class="public-selected" data-id="{{item.id}}" bindtap="openChild">{{item.task_no}} ></view></view>
  </block>
  <view wx:if="{{loading}}" class="warehouse-empty">正在加载</view><view wx:elif="{{!rows.length}}" class="warehouse-empty">暂无符合条件的记录</view>
  <view class="public-pages"><button class="warehouse-secondary" disabled="{{page<=1 || loading}}" data-delta="-1" bindtap="turnPage">上一页</button><text>{{page}} / {{lastPage}}</text><button class="warehouse-secondary" disabled="{{page>=lastPage || loading}}" data-delta="1" bindtap="turnPage">下一页</button></view>
</view>
<warehouse-picker open="{{pickerOpen}}" title="{{pickerTitle}}" mode="{{pickerMode}}" query="{{pickerQuery}}" selected="{{pickerSelected}}" multiple="{{pickerMultiple}}" quantity="{{pickerQuantity}}" bindconfirm="pickerConfirm" bindcancel="closePicker" />
<view wx:if="{{cancelOpen}}" class="warehouse-overlay" catchtouchmove="stop"><view class="warehouse-dialog"><view class="warehouse-dialog-header">取消公共配料任务</view><view class="warehouse-dialog-body"><textarea class="warehouse-input" value="{{cancelReason}}" bindinput="cancelInput" placeholder="填写取消原因" maxlength="500" /></view><view class="warehouse-dialog-footer"><button class="warehouse-secondary" bindtap="closeCancel">返回</button><button class="warehouse-primary" loading="{{busy}}" bindtap="cancel">确认取消</button></view></view></view>
