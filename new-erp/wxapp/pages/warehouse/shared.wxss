page {
  background: #f5f6f8;
  color: #1f2329;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

view,
text,
input,
textarea,
button,
scroll-view,
picker,
label {
  box-sizing: border-box;
}

.warehouse-page {
  padding: 20rpx 24rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 统一白底圆角卡片 */
.warehouse-card {
  background: #ffffff;
  border-radius: 26rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid rgba(15, 23, 42, 0.05);
}

.warehouse-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1f2329;
  margin: 22rpx 0 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.warehouse-title::before {
  content: '';
  width: 6rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: #d81e06;
  flex-shrink: 0;
}

.warehouse-card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2329;
  margin-bottom: 16rpx;
  line-height: 1.4;
  word-break: break-all;
}

/* 左右键值行 */
.warehouse-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 12rpx 0;
  line-height: 1.5;
  font-size: 26rpx;
}

.warehouse-label {
  width: 168rpx;
  color: #64748b;
  flex-shrink: 0;
  font-size: 25rpx;
}

.warehouse-value {
  flex: 1;
  min-width: 0;
  color: #1e293b;
  font-weight: 600;
  text-align: right;
  word-break: break-all;
}

.warehouse-field .warehouse-input.warehouse-value,
.warehouse-field textarea.warehouse-input {
  text-align: left;
  font-weight: 500;
}

.warehouse-muted {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.warehouse-danger {
  color: #d81e06;
  font-weight: 700;
}

/* 输入框与只读框 */
.warehouse-input,
.warehouse-readonly {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #dbe2ea;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  background: #ffffff;
  min-height: 74rpx;
  font-size: 26rpx;
  color: #1e293b;
  display: flex;
  align-items: center;
}

textarea.warehouse-input {
  min-height: 132rpx;
  line-height: 1.5;
  display: block;
}

.warehouse-readonly {
  background: #f8fafc;
  border-color: #e2e8f0;
  color: #475569;
}

.warehouse-kv-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  color: #1e293b;
}

/* 按钮体系（彻底解决微信原生 button 文字偏移/飞字问题） */
.warehouse-primary,
.warehouse-secondary {
  width: 100% !important;
  min-height: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0 28rpx;
  line-height: 1.2;
  margin: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
}

.warehouse-primary::after,
.warehouse-secondary::after,
.warehouse-close::after,
.warehouse-pager button::after,
.warehouse-search button::after {
  border: 0;
}

.warehouse-primary {
  background: linear-gradient(135deg, #d81e06 0%, #ef1008 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(216, 30, 6, 0.2);
}

.warehouse-primary[disabled] {
  background: #f5a39b !important;
  color: #ffffff !important;
  box-shadow: none;
}

.warehouse-secondary {
  background: #fff5f5;
  color: #d81e06;
  border: 1rpx solid #ffccc7;
}

.warehouse-secondary[disabled] {
  background: #f8fafc !important;
  color: #94a3b8 !important;
  border-color: #e2e8f0 !important;
}

.warehouse-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
  align-items: center;
}

.warehouse-actions > button {
  flex: 1;
  min-width: 0;
}

/* 搜索栏 */
.warehouse-search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 999rpx;
  padding: 8rpx 10rpx 8rpx 24rpx;
}

.warehouse-search input {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  font-size: 26rpx;
  color: #1f2329;
}

.warehouse-search button {
  width: auto !important;
  min-height: 60rpx;
  height: 60rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #d81e06 0%, #ef1008 100%);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.2;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 分页栏 */
.warehouse-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin: 22rpx 0 8rpx;
  color: #475569;
  font-size: 25rpx;
}

.warehouse-pager button {
  width: auto !important;
  min-height: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 26rpx;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.2;
  background: #ffffff;
  color: #334155;
  border: 1rpx solid #dbe2ea;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.warehouse-pager button[disabled] {
  background: #f8fafc !important;
  color: #cbd5e1 !important;
  border-color: #e2e8f0 !important;
}

/* 提示与异常状态 */
.warehouse-error {
  color: #cf1322;
  background: #fff1f0;
  border: 1rpx solid #ffccc7;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  margin: 14rpx 0;
  line-height: 1.5;
  word-break: break-all;
}

.warehouse-error:empty {
  display: none;
}

.warehouse-note {
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-left: 6rpx solid #f59e0b;
  color: #92400e;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 18rpx;
  font-size: 25rpx;
  line-height: 1.55;
}

.warehouse-empty {
  text-align: center;
  color: #64748b;
  padding: 72rpx 28rpx;
  background: #ffffff;
  border-radius: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

/* 弹窗体系 */
.warehouse-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.52);
  backdrop-filter: blur(2px);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  box-sizing: border-box;
}

.warehouse-dialog {
  width: 100%;
  max-width: 660rpx;
  max-height: calc(100vh - 96rpx);
  background: #ffffff;
  border-radius: 30rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.24);
  position: relative;
}

.warehouse-dialog::before {
  content: '';
  display: block;
  height: 8rpx;
  background: linear-gradient(90deg, #d81e06 0%, #ff4d3a 100%);
  flex-shrink: 0;
}

.warehouse-dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
  font-size: 31rpx;
  font-weight: 800;
  color: #1f2329;
}

.warehouse-dialog-body {
  padding: 24rpx 28rpx;
  overflow-y: auto;
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

.warehouse-dialog-footer {
  display: flex;
  gap: 18rpx;
  padding: 20rpx 28rpx 26rpx;
  border-top: 1rpx solid #f1f5f9;
  background: #ffffff;
}

.warehouse-dialog-footer > button {
  flex: 1;
  min-width: 0;
}

.warehouse-close {
  width: 56rpx !important;
  height: 56rpx !important;
  min-height: 56rpx !important;
  border-radius: 50%;
  background: #f1f5f9;
  color: #64748b;
  padding: 0;
  margin: 0;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 表格 */
.warehouse-table-scroll {
  overflow-x: auto;
  margin-top: 14rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
}

.warehouse-table {
  min-width: 520rpx;
}

.warehouse-tr {
  display: flex;
  border-bottom: 1rpx solid #f1f5f9;
}

.warehouse-tr:last-child {
  border-bottom: none;
}

.warehouse-th {
  background: #f8fafc;
  font-weight: 700;
  color: #475569;
  border-bottom: 1rpx solid #e2e8f0;
}

.warehouse-td {
  flex: 1;
  padding: 14rpx 16rpx;
  font-size: 24rpx;
  word-break: break-all;
}

/* 通用业务阶段样式（Phase 系列） */
.phase-user {
  background: linear-gradient(135deg, #d81e06 0%, #ef1008 60%, #ff4d3a 100%);
  color: #ffffff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 28rpx 24rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.phase-tabs {
  display: flex;
  gap: 10rpx;
  overflow-x: auto;
  background: #f1f5f9;
  padding: 8rpx;
  border-radius: 20rpx;
  margin: 18rpx 0;
}

.phase-tabs > view {
  flex: 1 0 auto;
  text-align: center;
  padding: 14rpx 22rpx;
  border-radius: 14rpx;
  color: #64748b;
  font-size: 25rpx;
  font-weight: 600;
  white-space: nowrap;
  transition: all 0.15s ease;
}

.phase-tabs > .active {
  background: #ffffff;
  color: #d81e06;
  font-weight: 800;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.06);
}

.phase-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
  font-size: 29rpx;
  font-weight: 800;
  color: #1f2329;
  margin-bottom: 16rpx;
  position: relative;
  padding-left: 18rpx;
  word-break: break-all;
}

.phase-heading::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 7rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: #d81e06;
}

.phase-tag {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #fff1f0;
  color: #d81e06;
  font-size: 22rpx;
  font-weight: 700;
}

.phase-metrics {
  display: flex;
  gap: 14rpx;
  margin: 18rpx 0;
}

.phase-metrics > view {
  flex: 1;
  min-width: 0;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 18rpx;
  padding: 16rpx 12rpx;
  color: #64748b;
  font-size: 22rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.phase-metrics text {
  display: block;
  color: #1e293b;
  font-size: 28rpx;
  font-weight: 800;
  word-break: break-all;
}

.phase-metrics .available {
  color: #059669;
}

.phase-metrics .locked {
  color: #d97706;
}

.phase-line,
.phase-entry {
  border-top: 1rpx solid #f1f5f9;
  padding: 22rpx 0;
}

.phase-line:first-of-type,
.phase-entry:first-of-type {
  border-top: none;
}

.phase-line-title {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
  margin-bottom: 10rpx;
  word-break: break-all;
}

.phase-line-title > text:last-child {
  color: #d81e06;
  font-weight: 800;
  flex-shrink: 0;
}

.phase-pick {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.phase-inline {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 12rpx 0;
}

.phase-inline > scan-input,
.phase-inline > input,
.phase-entry-name {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.phase-inline > button,
.phase-entry button {
  width: auto !important;
  flex-shrink: 0;
  padding: 0 26rpx;
  min-height: 68rpx;
  height: 68rpx;
  font-size: 25rpx;
}

.phase-entry .chosen {
  background: linear-gradient(135deg, #d81e06 0%, #ef1008 100%) !important;
  color: #ffffff !important;
  border-color: transparent !important;
}

.phase-checked {
  color: #059669;
  background: #ecfdf5;
  border: 1rpx solid #a7f3d0;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-size: 23rpx;
  font-weight: 600;
  margin-top: 10rpx;
  display: inline-flex;
  align-items: center;
}

.phase-audit {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  background: #f8fafc;
  border-radius: 14rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.55;
  word-break: break-all;
}

.phase-audit text {
  color: #1e293b;
  font-weight: 600;
}

.phase-progress {
  height: 14rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  overflow: hidden;
  margin: 16rpx 0;
}

.phase-progress > view {
  height: 100%;
  background: linear-gradient(90deg, #d81e06 0%, #ff4d3a 100%);
  border-radius: 999rpx;
}

.phase-result {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 24rpx;
  border-top: 1rpx solid #f1f5f9;
  padding-top: 18rpx;
  margin-top: 16rpx;
  color: #d81e06;
  font-size: 25rpx;
  font-weight: 700;
}
