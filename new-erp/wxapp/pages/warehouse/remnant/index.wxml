<view class="warehouse-page">
  <view wx:if="{{loading}}" class="warehouse-empty"><van-loading color="#ef1008"/></view>
  <block wx:else>
    <view wx:if="{{error}}" class="warehouse-error">{{error}}</view>
    <view wx:if="{{pending}}" class="warehouse-note">上次入库结果尚未确认，请继续核对原操作。</view>
    <block wx:if="{{mode === 'list'}}">
      <view class="warehouse-field remnant-status"><text>状态</text><picker mode="selector" range="{{statuses}}" range-key="name" value="{{statusIndex}}" bindchange="changeStatus"><view class="warehouse-input">{{statuses[statusIndex].name}} <van-icon name="arrow-down"/></view></picker></view>
      <view class="warehouse-card"><view class="warehouse-field"><text class="warehouse-label">来源加工单</text><text class="warehouse-value">{{orderNo}}</text></view><view class="warehouse-field"><text class="warehouse-label">来源工单</text><text class="warehouse-value">{{workOrderNos || '—'}}</text></view></view>
      <view wx:if="{{sourceLast > 1}}" class="warehouse-pager"><text>来源工单</text><button disabled="{{sourcePage <= 1 || loading}}" data-delta="-1" bindtap="turnSource">上一页</button><text>{{sourcePage}} / {{sourceLast}}</text><button disabled="{{sourcePage >= sourceLast || loading}}" data-delta="1" bindtap="turnSource">下一页</button></view>
      <view wx:if="{{statusIndex === 0 && canPost}}" class="warehouse-card remnant-check-all"><van-checkbox bind:change="togglePage" value="{{allPageSelected}}" disabled="{{pending || busy}}" checked-color="#ef1008" shape="square"/><text bindtap="togglePage">全选本页（已选 {{selectedCount}} 块）</text></view>
      <view wx:if="{{!rows.length}}" class="warehouse-empty">暂无{{statuses[statusIndex].name}}余料</view>
      <view wx:for="{{rows}}" wx:key="id" class="warehouse-card remnant-row">
        <view wx:if="{{statusIndex === 0 && canPost}}" class="remnant-checkbox" ><van-checkbox data-id="{{item.id}}" bind:change="toggleRow" value="{{item.checked}}" disabled="{{!item.receivable || pending || busy}}" checked-color="#ef1008" shape="square"/></view>
        <view class="remnant-row-main"><view class="warehouse-card-title">{{item.remnant_no}}</view>
          <view class="warehouse-field"><text class="warehouse-label">物料编码</text><text class="warehouse-value">{{item.item_code}}</text></view><view class="warehouse-field"><text class="warehouse-label">物料名称</text><text class="warehouse-value">{{item.item_name}}</text></view>
          <view class="warehouse-field"><text class="warehouse-label">规格尺寸</text><text class="warehouse-value">{{item.dimensionText}} mm</text></view><view class="warehouse-field"><text class="warehouse-label">数量</text><text class="warehouse-value">{{item.quantityText}} {{item.unit_name}}</text></view>
          <view class="warehouse-field"><text class="warehouse-label">金额</text><text class="warehouse-value">{{item.total_cost}}</text></view><view class="warehouse-field"><text class="warehouse-label">来源用料批次</text><text class="warehouse-value">{{item.source_batch_no}}</text></view>
          <view wx:if="{{item.unavailable_reason}}" class="warehouse-error">{{item.unavailable_reason}}</view><button wx:if="{{item.receipt_id}}" class="warehouse-secondary" data-id="{{item.receipt_id}}" bindtap="openReceipt">查看入库记录</button>
        </view>
      </view>
      <view class="remnant-list-bottom"><view wx:if="{{canPost && statusIndex === 0}}"><view>已选 <text class="warehouse-danger">{{selectedCount}}</text> 块</view><view>合计金额 <text class="remnant-total">{{selectedAmount === null ? '待核对' : selectedAmount}}</text></view></view><view class="warehouse-pager"><button disabled="{{page <= 1}}" data-delta="-1" bindtap="turnPage"><van-icon name="arrow-left"/></button><text>{{page}} / {{lastPage}}</text><button disabled="{{page >= lastPage}}" data-delta="1" bindtap="turnPage"><van-icon name="arrow"/></button></view></view>
      <button wx:if="{{canPost && (statusIndex === 0 || pending)}}" class="warehouse-primary" disabled="{{(!selectedCount && !pending) || busy}}" loading="{{busy}}" bindtap="openConfirm">{{pending ? '继续上次入库' : '办理入库（' + selectedCount + '）'}}</button>
    </block>
    <block wx:elif="{{mode === 'confirm'}}">
      <view class="warehouse-card"><view class="warehouse-field"><text class="warehouse-label">来源加工单</text><text class="warehouse-value">{{orderNo}}</text></view><view class="warehouse-field"><text class="warehouse-label">来源工单</text><text class="warehouse-value">{{workOrderNos || '—'}}</text></view>
        <view class="warehouse-field"><text class="warehouse-label">仓库 / 库位</text><view class="warehouse-value warehouse-kv-select" bindtap="openLocator"><text>{{locator.location_id ? locator.warehouse_name + ' / ' + locator.location_name : '请选择仓库和库位'}}</text><van-icon name="arrow"/></view></view><view class="warehouse-error">{{locatorError}}</view>
        <view class="warehouse-field"><text class="warehouse-label">来源用料批次</text><text class="warehouse-value">{{sourceBatches}}</text></view><view class="warehouse-field"><text class="warehouse-label">备注</text><textarea class="warehouse-value warehouse-input" value="{{remark}}" disabled="{{busy || pending}}" maxlength="1000" placeholder="选填，请输入备注内容" bindinput="remarkInput"/></view>
      </view><view class="warehouse-title">入库明细（{{selectedCount}}）</view>
      <view wx:for="{{selectedRows}}" wx:key="id" class="warehouse-card"><view class="remnant-confirm-title"><text class="warehouse-card-title">{{item.remnant_no}}</text><button class="remnant-remove" disabled="{{busy || pending}}" data-id="{{item.id}}" bindtap="removeSelected">移除</button></view>
        <view class="warehouse-field"><text class="warehouse-label">物料编码</text><text class="warehouse-value">{{item.item_code}}</text></view><view class="warehouse-field"><text class="warehouse-label">物料名称</text><text class="warehouse-value">{{item.item_name}}</text></view><view class="warehouse-field"><text class="warehouse-label">规格尺寸</text><text class="warehouse-value">{{item.dimensionText}} mm</text></view><view class="warehouse-field"><text class="warehouse-label">数量</text><text class="warehouse-value">{{item.quantityText}} {{item.unit_name}}</text></view><view class="warehouse-field"><text class="warehouse-label">金额</text><text class="warehouse-value">{{item.total_cost}}</text></view><view class="warehouse-field"><text class="warehouse-label">入库批次</text><text class="warehouse-value">{{item.remnant_no}}</text></view>
      </view><view>共 <text class="warehouse-danger">{{selectedCount}}</text> 块</view><view>合计金额 <text class="remnant-total">{{selectedAmount}}</text></view><view class="warehouse-actions"><button class="warehouse-secondary" disabled="{{busy}}" bindtap="returnToList">返回核对</button><button class="warehouse-primary" loading="{{busy}}" disabled="{{busy || (!selectedCount && !pending)}}" bindtap="submit">确认入库</button></view>
    </block>
    <view wx:elif="{{mode === 'receipt' && !receipt}}" class="warehouse-card"><view>入库凭证暂未加载，请重试查询。</view><button class="warehouse-primary" bindtap="retryReceipt">重新加载凭证</button><button class="warehouse-secondary" bindtap="returnToList">返回列表</button></view>
    <block wx:elif="{{mode === 'receipt' && receipt}}">
      <view class="warehouse-card"><view class="warehouse-field"><text class="warehouse-label">入库单号</text><text class="warehouse-value">{{receipt.receipt_no}}</text></view><view class="warehouse-field"><text class="warehouse-label">单据状态</text><text class="warehouse-value warehouse-danger">已入库</text></view><view class="warehouse-field"><text class="warehouse-label">来源加工单</text><text class="warehouse-value">{{receipt.header_snapshot.cutting_order_no}}</text></view><view class="warehouse-field"><text class="warehouse-label">来源工单</text><text class="warehouse-value">{{receipt.workOrderNos || '—'}}</text></view><view class="warehouse-field"><text class="warehouse-label">仓库 / 库位</text><text class="warehouse-value">{{receipt.header_snapshot.warehouse_name}} / {{receipt.header_snapshot.location_name}}</text></view><view class="warehouse-field"><text class="warehouse-label">操作人</text><text class="warehouse-value">{{receipt.header_snapshot.operator_name}}</text></view><view class="warehouse-field"><text class="warehouse-label">入库时间</text><text class="warehouse-value">{{receipt.posted_at}}</text></view></view>
      <view class="warehouse-title">入库明细（{{receipt.piece_count}}）</view><view wx:for="{{receipt.lines}}" wx:key="id" class="warehouse-card"><view class="warehouse-card-title">{{item.remnant_no}}</view><view class="warehouse-field"><text class="warehouse-label">物料编码</text><text class="warehouse-value">{{item.item_code}}</text></view><view class="warehouse-field"><text class="warehouse-label">物料名称</text><text class="warehouse-value">{{item.item_name}}</text></view><view class="warehouse-field"><text class="warehouse-label">规格尺寸</text><text class="warehouse-value">{{item.dimensionText}} mm</text></view><view class="warehouse-field"><text class="warehouse-label">数量</text><text class="warehouse-value">{{item.quantityText}} {{item.unit_name}}</text></view><view class="warehouse-field"><text class="warehouse-label">金额</text><text class="warehouse-value">{{item.total_cost}}</text></view><view class="warehouse-field"><text class="warehouse-label">入库批次</text><text class="warehouse-value">{{item.batch_no}}</text></view></view>
      <view class="remnant-receipt-total"><text>共 <text class="warehouse-danger">{{receipt.piece_count}}</text> 块</text><text>合计金额 <text class="remnant-total">{{receipt.posted_cost}}</text></text></view><button class="warehouse-primary" bindtap="returnToList">返回列表</button>
    </block>
  </block>
</view>
<warehouse-locator open="{{locatorOpen}}" value="{{locator}}" bind:confirm="chooseLocator" bind:cancel="closeLocator"/>
<view wx:if="{{resultDialog}}" class="warehouse-overlay" catchtouchmove="stop"><view class="warehouse-dialog"><view class="warehouse-dialog-header">{{pending ? '结果尚未确认' : '余料状态已变化'}}</view><view class="warehouse-dialog-body">{{pending ? '本次提交结果尚未确认，请先查询原操作结果。' : resultMessage}}</view><view class="warehouse-dialog-footer"><button class="warehouse-secondary" bindtap="closeResult">返回核对</button><button wx:if="{{pending}}" class="warehouse-primary" loading="{{busy}}" bindtap="retry">查询原结果</button></view></view></view>
