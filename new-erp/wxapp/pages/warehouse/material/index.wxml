<warehouse-context />

<view class="warehouse-page">
  <view wx:if="{{loading}}" class="warehouse-empty">
    <van-loading color="#d81e06" size="44rpx" />
    <text class="warehouse-muted">正在加载配料/退料单据...</text>
  </view>

  <view wx:elif="{{error}}" class="warehouse-empty">
    <van-icon name="warning-o" size="68rpx" color="#d81e06" />
    <view class="warehouse-error">{{error}}</view>
    <button class="warehouse-secondary mat-retry-btn" bindtap="load">重新加载</button>
    <button wx:if="{{kind === 'material_preparation' && selections.length}}" class="warehouse-secondary" bindtap="resetSelection" disabled="{{saving}}">清空已选，重新选料</button>
  </view>

  <block wx:else>
    <!-- 单据头部卡片 -->
    <view class="warehouse-card">
      <view class="phase-heading">
        <text>{{header.delivery_no || header.return_no || header.work_order_no}}</text>
        <text class="phase-tag">{{header.status_label}}</text>
      </view>
      <view wx:if="{{kind !== 'material_preparation'}}" class="warehouse-field">
        <text class="warehouse-label">关联工单</text>
        <text class="warehouse-value">{{header.work_order_no}}</text>
      </view>
      <view class="warehouse-field">
        <text class="warehouse-label">产品 / 工序</text>
        <text class="warehouse-value">{{header.product_name || header.item_name}} · {{header.operation_name}}</text>
      </view>
      <block wx:if="{{kind === 'material_preparation' || kind === 'material_delivery'}}">
        <block wx:for="{{header.sales_orders}}" wx:key="sales_order_id" wx:for-item="order">
          <view class="warehouse-field">
            <text class="warehouse-label">订单客户</text>
            <text class="warehouse-value">{{order.customer_name || '未记录客户'}}</text>
          </view>
          <view class="warehouse-field">
            <text class="warehouse-label">销售订单号</text>
            <text class="warehouse-value">{{order.sales_order_no || '未记录订单号'}}</text>
          </view>
          <view class="warehouse-field">
            <text class="warehouse-label">销售人员</text>
            <text class="warehouse-value">{{order.sales_user_name || '未指定销售'}}</text>
          </view>
        </block>
        <view wx:if="{{!header.sales_orders.length}}" class="warehouse-field">
          <text class="warehouse-label">订单归属</text>
          <text class="warehouse-value">{{header.sales_source_label || '未关联销售订单'}}</text>
        </view>
      </block>
      <view wx:if="{{header.unit_qty}}" class="warehouse-field">
        <text class="warehouse-label">配料数量</text>
        <text class="warehouse-value warehouse-danger">{{header.unit_qty}} 台</text>
      </view>
      <view wx:if="{{kind === 'material_return' && header.cost_status_label}}" class="warehouse-field">
        <text class="warehouse-label">成本状态</text>
        <text class="warehouse-value">{{header.cost_status_label}}</text>
      </view>
      <view wx:if="{{header.disposition_plan.review_status}}" class="phase-audit">
        处置方案：{{header.disposition_plan.review_status === 'approved' ? '已通过，待仓库接收后执行' : header.disposition_plan.review_status === 'rejected' ? '已驳回' : '待负责人审核'}}
        <view wx:if="{{header.disposition_plan.reviewed_at}}">{{header.disposition_plan.reviewed_by_name}} {{header.disposition_plan.reviewed_at}} {{header.disposition_plan.review_remark}}</view>
      </view>
      <block wx:if="{{kind === 'material_return'}}">
        <view class="warehouse-field">
          <text class="warehouse-label">退料类型</text>
          <text class="warehouse-value">{{header.return_type_label}}</text>
        </view>
        <view class="warehouse-field">
          <text class="warehouse-label">退料原因</text>
          <text class="warehouse-value">{{header.reason}}</text>
        </view>
      </block>
      <block wx:if="{{preview}}">
        <view class="phase-metrics">
          <view>计划数量<text>{{preview.planned_qty}} 台</text></view>
          <view>已齐套<text class="locked">{{preview.covered_units}} 台</text></view>
          <view>本次配料<text class="available">{{preview.target_units - preview.covered_units}} 台</text></view>
        </view>
        <view class="warehouse-field"><text class="warehouse-label">本次配料编号</text><text class="warehouse-value">{{unitSelectionExplicit ? '已选择 ' + productionUnits.length + ' 个' : '剩余全部可配编号'}}</text></view>
        <view class="material-unit-actions"><button class="warehouse-secondary" bindtap="openProductionUnits" disabled="{{saving || loading || pendingActions.length}}">选择具体编号</button><button class="warehouse-secondary" bindtap="useAllProductionUnits" disabled="{{saving || loading || pendingActions.length}}">配齐剩余全部</button></view>
        <view wx:for="{{productionUnits}}" wx:key="id" class="phase-audit">{{item.serial_no || ('第' + item.unit_no + '个')}}</view>
        <view wx:if="{{shortages.length}}" class="material-shortage-box">
          <view wx:for="{{shortages}}" wx:key="item_id" class="material-shortage-row">
            <view class="material-shortage-title"><text>{{item.name}}</text><text>缺 {{item.shortText}} {{item.unit}}</text></view>
            <view>本次需配 {{item.qtyText}} {{item.unit}} · 可配 {{item.availableText}} {{item.unit}}</view>
          </view>
          <view wx:if="{{purchaseMessage}}" class="material-purchase-message">{{purchaseMessage}}</view>
          <button class="warehouse-primary material-purchase-button" bindtap="requestPurchase" loading="{{saving}}" disabled="{{!canPurchase || saving || loading || pendingActions.length || purchaseCompleted || purchaseUncertain}}">{{purchaseCompleted ? '已生成采购需求单' : '生成采购需求单'}}</button>
          <view wx:if="{{!canPurchase}}" class="material-purchase-message">当前账号无生成采购需求单权限</view>
        </view>
        <block wx:elif="{{preview.short.length}}"><view wx:for="{{preview.short}}" wx:key="*this" class="warehouse-error">{{item}}</view></block>
      </block>
    </view>

    <!-- 物料明细与核对卡片 -->
    <view class="warehouse-card">
      <view class="phase-heading">
        <text>{{kind === 'material_return' ? '退料物料' : '物料明细'}}</text>
        <text class="warehouse-muted">共 {{total}} 种</text>
      </view>

      <view wx:if="{{!lines.length}}" class="warehouse-empty">暂无物料明细</view>

      <block wx:if="{{kind === 'material_preparation'}}">
        <view wx:for="{{lines}}" wx:key="id" class="phase-line material-preparation-row" data-line="{{item.id}}" bindtap="toggleLine">
          <view class="material-preparation-title">
            <text>{{item.component_item_name || item.item_name}}</text>
            <button wx:if="{{actions.prepare}}" class="material-select-button" data-line="{{item.id}}" catchtap="openPicker" disabled="{{saving || loading || pendingActions.length}}">选料 <van-icon name="arrow" /></button>
          </view>
          <view wx:if="{{item.spec || item.component_item_spec}}" class="warehouse-muted">{{item.spec || item.component_item_spec}}</view>
          <view class="material-preparation-quantities">
            <view>本次配 <text class="warehouse-danger">{{item.qtyText}} {{item.unit_name}}</text></view>
            <view>库存剩余 <text>{{item.remainingText}} {{item.unit_name}}</text></view>
          </view>
          <button class="material-selection-summary" data-line="{{item.id}}" catchtap="toggleLine" aria-label="{{expandedLines[item.id] ? '收起已选批次' : '展开已选批次'}}"><text>{{item.picks.length ? '已选 ' + item.picks.length + ' 个批次' : '未选批次'}}</text><van-icon name="{{expandedLines[item.id] ? 'arrow-up' : 'arrow-down'}}" /></button>
          <block wx:if="{{expandedLines[item.id]}}">
            <view wx:for="{{item.picks}}" wx:for-item="pick" wx:key="balance_id" class="phase-pick material-selected-pick">
              <view class="warehouse-field"><text class="warehouse-label">批次号</text><text class="warehouse-value">{{pick.batch_no || '—'}}</text></view>
              <view class="warehouse-field"><text class="warehouse-label">本次取量</text><text class="warehouse-value warehouse-danger">{{pick.qtyText}} {{item.unit_name}}</text></view>
              <view class="warehouse-field"><text class="warehouse-label">来源仓库</text><text class="warehouse-value">{{pick.warehouse_name || '—'}}</text></view>
              <view class="warehouse-field"><text class="warehouse-label">来源库位</text><text class="warehouse-value">{{pick.location_code || '—'}} {{pick.location_name}}</text></view>
              <view wx:if="{{pick.serialText}}" class="warehouse-field"><text class="warehouse-label">序列号</text><text class="warehouse-value">{{pick.serialText}}</text></view>
            </view>
            <view wx:if="{{!item.picks.length}}" class="warehouse-muted material-selection-empty">暂无已选批次</view>
          </block>
        </view>
      </block>
      <block wx:else>
      <view wx:for="{{lines}}" wx:key="id" class="phase-line">
        <block wx:if="{{kind === 'material_delivery'}}">
          <view class="material-preparation-title" data-line="{{item.id}}" bindtap="toggleLine">
            <text>{{item.component_item_name || item.item_name}}</text>
          </view>
          <view wx:if="{{item.spec || item.component_item_spec}}" class="warehouse-muted">{{item.spec || item.component_item_spec}}</view>
          <view class="material-preparation-quantities">
            <view>本次配 <text class="warehouse-danger">{{item.qtyText}} {{item.unit_name}}</text></view>
          </view>
          <button class="material-selection-summary" data-line="{{item.id}}" catchtap="toggleLine" aria-label="{{expandedLines[item.id] ? '收起已配批次' : '展开查看已配批次'}}"><text>已配 {{item.picks.length}} 个批次 · {{expandedLines[item.id] ? '收起' : '展开查看'}}</text><van-icon name="{{expandedLines[item.id] ? 'arrow-up' : 'arrow-down'}}" /></button>
        </block>
        <block wx:else>
        <view class="phase-line-title">
          <text>{{item.component_item_name || item.item_name}}</text>
          <text>{{item.qtyText}} {{item.unit_name}}</text>
        </view>
        <view wx:if="{{item.component_item_code}}" class="warehouse-field">
          <text class="warehouse-label">物料编码</text>
          <text class="warehouse-value">{{item.component_item_code}}</text>
        </view>
        <view wx:if="{{item.spec || item.component_item_spec}}" class="warehouse-field">
          <text class="warehouse-label">规格型号</text>
          <text class="warehouse-value">{{item.spec || item.component_item_spec}}</text>
        </view>
        </block>

        <block wx:if="{{kind !== 'material_return'}}">
          <block wx:if="{{expandedLines[item.id]}}">
          <view wx:if="{{item.component_item_code}}" class="warehouse-field">
            <text class="warehouse-label">物料编码</text>
            <text class="warehouse-value">{{item.component_item_code}}</text>
          </view>
          <view
            wx:for="{{item.picks}}"
            wx:for-item="pick"
            wx:for-index="pickIndex"
            wx:key="balance_id"
            class="phase-pick"
          >
            <view class="warehouse-field">
              <text class="warehouse-label">来源仓库</text>
              <text class="warehouse-value">{{pick.warehouse_name}}</text>
            </view>
            <view class="warehouse-field">
              <text class="warehouse-label">拣货库位</text>
              <text class="warehouse-value">{{pick.location_code}} {{pick.location_name}}</text>
            </view>
            <view class="warehouse-field">
              <text class="warehouse-label">批次号</text>
              <text class="warehouse-value">{{pick.batch_no || '—'}}</text>
            </view>
            <view class="warehouse-field">
              <text class="warehouse-label">拣货数量</text>
              <text class="warehouse-value warehouse-danger">{{pick.qtyText}} {{item.unit_name}}</text>
            </view>
            <view wx:if="{{pick.serialText}}" class="warehouse-field">
              <text class="warehouse-label">序列号</text>
              <text class="warehouse-value">{{pick.serialText}}</text>
            </view>
            <block wx:if="{{actions.recall && canConfirmInbound}}">
              <button class="warehouse-secondary" data-line="{{item.id}}" data-pick="{{pickIndex}}" bindtap="openManual" disabled="{{saving || loading || pendingActions.length}}">手动核对物料 / 库位 / 编号</button>
              <scan-input
                wx:if="{{pick.serial_nos.length}}"
                id="pick-serial-{{item.id}}-{{pickIndex}}"
                clear-after-resolve
                compact
                class="material-scan"
                placeholder="逐个扫描序列号核对"
                types="{{['serial']}}"
                data-line="{{item.id}}"
                data-pick="{{pickIndex}}"
                bind:resolved="verifyPick"
                disabled="{{saving || pendingActions.length}}"
              />
              <view wx:if="{{pick.locationChecked}}" class="phase-checked">✓ 已核对库位 {{pick.location_code}}</view>
              <view wx:if="{{pick.serial_nos.length && pick.serialChecked}}" class="phase-checked">✓ 序列号核对完成</view>
            </block>
          </view>
          </block>
        </block>

        <block wx:else>
          <view class="warehouse-field">
            <text class="warehouse-label">原库位</text>
            <text class="warehouse-value">{{item.source_location || '—'}}</text>
          </view>
          <view class="warehouse-field">
            <text class="warehouse-label">批次号</text>
            <text class="warehouse-value">{{item.batch_no || '—'}}</text>
          </view>
          <view wx:if="{{item.serial_no}}" class="warehouse-field">
            <text class="warehouse-label">序列号</text>
            <text class="warehouse-value">{{item.serial_no}}</text>
          </view>
          <view wx:if="{{item.location}}" class="warehouse-field">
            <text class="warehouse-label">入库库位</text>
            <text class="warehouse-value">{{item.location}}</text>
          </view>
          <block wx:if="{{actions.approve}}">
            <view class="warehouse-title">物料核对</view>
            <button class="warehouse-secondary" data-line="{{item.id}}" bindtap="openManual" disabled="{{saving || loading || pendingActions.length}}">手动选择并核对本项</button>
            <scan-input
              class="material-scan"
              compact
              next-input="{{item.serial_no ? '#return-serial-' + item.id : '#return-location'}}"
              placeholder="请扫描物料条码"
              types="{{['item']}}"
              data-line="{{item.id}}"
              bind:resolved="verifyReturn"
              disabled="{{saving || pendingActions.length}}"
            />
            <scan-input
              wx:if="{{item.serial_no}}"
              id="return-serial-{{item.id}}"
              clear-after-resolve
              next-input="#return-location"
              class="material-scan"
              compact
              placeholder="请扫描序列号"
              types="{{['serial']}}"
              data-line="{{item.id}}"
              bind:resolved="verifyReturn"
              disabled="{{saving || pendingActions.length}}"
            />
            <view wx:if="{{checks[item.id].complete}}" class="phase-checked">✓ 实物核对完成</view>
          </block>
          <block wx:if="{{actions.dispose && item.held_qty > 0}}">
            <view class="warehouse-field">
              <text class="warehouse-label">待处置数量</text>
              <text class="warehouse-value warehouse-danger">{{item.heldText}} {{item.unit_name}}</text>
            </view>
            <view class="warehouse-title">处置方式</view>
            <view class="material-choice">
              <view
                wx:for="{{dispositionOptions}}"
                wx:for-item="option"
                wx:key="value"
                class="{{item.disposition.action === option.value ? 'chosen' : ''}}"
                data-id="{{item.id}}"
                data-field="action"
                data-value="{{option.value}}"
                bindtap="disposition"
              >{{option.label}}</view>
            </view>
            <view class="warehouse-field">
              <text class="warehouse-label">处置数量</text>
              <input
                class="warehouse-input warehouse-value"
                type="digit"
                value="{{item.disposition.qty}}"
                data-id="{{item.id}}"
                data-field="qty"
                bindinput="disposition"
                disabled="{{saving || pendingActions.length}}"
              />
            </view>
          </block>
          <view wx:if="{{item.dispositions.length}}" class="warehouse-title">处置历史</view>
          <view wx:for="{{item.dispositions}}" wx:for-item="history" wx:key="id" class="phase-audit">
            <view><text>{{history.action_label}} {{history.qty}} {{item.unit_name}}</text></view>
            <view>{{history.created_at}} · {{history.created_by_name}}</view>
            <view>{{history.remark}}</view>
            <view wx:if="{{history.document_no}}">关联单据：{{history.document_no}}</view>
          </view>
        </block>
      </view>
      </block>

      <view class="warehouse-pager">
        <button disabled="{{page <= 1 || loading || saving}}" data-delta="-1" bindtap="turn">上一页</button>
        <text>{{page}} / {{lastPage}}</text>
        <button disabled="{{page >= lastPage || loading || saving}}" data-delta="1" bindtap="turn">下一页</button>
      </view>

      <view wx:if="{{actions.recall && canConfirmInbound}}" class="material-section mat-recall-check" bindtap="toggleRecallReceive">
        <checkbox checked="{{recallConfirmInbound}}" color="#d81e06" disabled="{{saving || pendingActions.length}}" />
        <text>收回时同时接收入库</text>
      </view>

      <view wx:if="{{actions.approve || (actions.recall && canConfirmInbound && recallConfirmInbound)}}" class="material-section">
        <view class="phase-heading">实际入库库位</view>
        <view class="phase-inline">
          <scan-input
            id="return-location"
            compact
            placeholder="扫描入库库位"
            value="{{locator.location_code}}"
            types="{{['location']}}"
            bind:resolved="scanLocator"
            disabled="{{saving || pendingActions.length}}"
          />
          <button class="warehouse-secondary" bindtap="openLocator" disabled="{{saving || pendingActions.length}}">选择</button>
        </view>
        <view wx:if="{{locator.location_id}}" class="phase-audit">{{locator.warehouse_name}} · {{locator.location_code}} {{locator.location_name}}</view>
      </view>

      <view wx:if="{{header.prepared_at || header.reviewed_at}}" class="material-section">
        <view class="phase-heading">处理记录</view>
        <view wx:if="{{header.prepared_at}}" class="phase-audit">配料人 <text>{{header.prepared_by_name}}</text> {{header.prepared_at}}</view>
        <view wx:if="{{header.dispatched_at}}" class="phase-audit">发出人 <text>{{header.dispatched_by_name}}</text> {{header.dispatched_at}}</view>
        <view wx:if="{{header.rejected_at}}" class="phase-audit">拒收人 <text>{{header.rejected_by_name}}</text> {{header.rejected_at}}</view>
        <view wx:if="{{header.signed_at}}" class="phase-audit">签收人 <text>{{header.signed_by_name}}</text> {{header.signed_at}}</view>
        <view wx:if="{{header.closed_at}}" class="phase-audit">处理人 <text>{{header.closed_by_name}}</text> {{header.closed_at}}</view>
        <view wx:if="{{header.reviewed_at}}" class="phase-audit">接收人 <text>{{header.reviewed_by_name}}</text> {{header.reviewed_at}}</view>
      </view>

      <view wx:if="{{header.reject_reason}}" class="material-section">
        <view class="warehouse-title">拒收原因</view>
        <view class="warehouse-note">{{header.reject_reason}}</view>
      </view>
      <view wx:if="{{header.close_remark || header.review_remark}}" class="warehouse-note">{{header.close_remark || header.review_remark}}</view>
      <view wx:for="{{header.source_problems}}" wx:key="*this" class="warehouse-error">{{item}}，请重新拣货后发出。</view>
      <view wx:if="{{planReviewRequired}}" class="warehouse-note">不良处置方案待生产负责人审核，请在生产任务内处理。</view>

      <view wx:if="{{actions.prepare || actions.dispatch || actions.redeliver || actions.approve || actions.dispose}}" class="material-section">
        <view class="phase-heading">{{actions.dispose ? '处置说明' : '备注说明'}}</view>
        <textarea
          class="warehouse-input"
          maxlength="200"
          placeholder="请输入说明（选填）"
          value="{{remark}}"
          data-field="remark"
          bindinput="input"
          disabled="{{saving || pendingActions.length}}"
        />
      </view>

      <view class="warehouse-error">{{formError}}</view>

      <view wx:for="{{pendingActions}}" wx:key="action" class="warehouse-actions">
        <button class="warehouse-secondary" data-action="{{item.action}}" bindtap="recover" loading="{{saving}}" disabled="{{saving}}">核对上次{{item.label}}结果</button>
      </view>
      <view wx:if="{{actions.prepare}}" class="warehouse-actions">
        <button class="warehouse-secondary" data-action="material_delivery.prepare" bindtap="requestAction" disabled="{{saving || pendingActions.length}}">生成配料单</button>
        <button class="warehouse-primary" data-action="material_delivery.prepare" data-dispatch="true" bindtap="requestAction" disabled="{{saving || pendingActions.length}}">配好直接发出</button>
      </view>
      <view wx:if="{{actions.dispatch}}" class="warehouse-actions">
        <button class="warehouse-secondary" data-action="material_delivery.repick" bindtap="requestAction" disabled="{{saving || pendingActions.length}}">重新拣货</button>
        <button class="warehouse-primary" data-action="material_delivery.dispatch" bindtap="requestAction" disabled="{{saving || pendingActions.length || header.source_problems.length}}">确认发出</button>
      </view>
      <view wx:if="{{actions.cancel && kind === 'material_delivery'}}" class="warehouse-actions">
        <button class="warehouse-secondary" data-action="material_delivery.cancel" bindtap="requestAction" disabled="{{saving || pendingActions.length}}">取消配料单</button>
      </view>
      <view wx:if="{{actions.redeliver || actions.recall}}" class="warehouse-actions">
        <button wx:if="{{actions.redeliver}}" class="warehouse-primary" data-action="material_delivery.redeliver" bindtap="requestAction" disabled="{{saving || pendingActions.length}}">重新送达</button>
        <button wx:if="{{actions.recall}}" class="warehouse-secondary" data-action="material_delivery.recall" bindtap="requestAction" disabled="{{saving || pendingActions.length}}">整单收回</button>
      </view>
      <view wx:if="{{actions.approve || actions.reject}}" class="warehouse-actions">
        <button wx:if="{{actions.reject}}" class="warehouse-secondary" data-action="material_return.reject" bindtap="requestAction" disabled="{{saving || pendingActions.length}}">驳回</button>
        <button wx:if="{{actions.approve}}" class="warehouse-primary" data-action="material_return.approve" bindtap="requestAction" disabled="{{saving || pendingActions.length}}">确认接收入库</button>
      </view>
      <view wx:if="{{actions.dispose}}" class="warehouse-actions">
        <button class="warehouse-primary" data-action="material_return.dispose" bindtap="requestAction" disabled="{{saving || pendingActions.length}}">确认处置</button>
      </view>
      <view wx:if="{{actions.cancel && kind === 'material_return'}}" class="warehouse-actions">
        <button class="warehouse-secondary" data-action="material_return.cancel" bindtap="requestAction" disabled="{{saving || pendingActions.length}}">撤回申请</button>
      </view>
    </view>
  </block>
</view>

<warehouse-locator open="{{locatorOpen}}" value="{{locator}}" bind:confirm="chooseLocator" bind:cancel="closeLocator" />
<warehouse-material-picker open="{{pickerOpen}}" work-order-id="{{header.work_order_id}}" operation-id="{{id}}" line="{{pickerLine}}" other-picks="{{pickerOtherPicks}}" initial-scan="{{pickerScan}}" error-message="{{pickerError}}" locked="{{saving || loading || pendingActions.length > 0}}" bind:confirm="confirmPicker" bind:cancel="closePicker" />
<warehouse-select open="{{manualOpen}}" title="{{manualTitle}}" rows="{{manualRows}}" selected="{{manualSelected}}" scope-key="{{manualScope}}" multiple maximum="{{manualRows.length}}" locked="{{saving || loading || pendingActions.length > 0}}" bind:confirm="confirmManual" bind:cancel="closeManual" />
<warehouse-select open="{{unitPickerOpen}}" title="选择本次配料的设备 / 子件" mode="production_unit" context="{{unitPickerContext}}" selected="{{productionUnits}}" scope-key="{{unitPickerScope}}" multiple maximum="{{1000}}" locked="{{saving || loading || pendingActions.length > 0}}" bind:confirm="applyProductionUnits" bind:cancel="closeProductionUnits" />

<view wx:if="{{dialog}}" class="warehouse-overlay" catchtouchmove="stop">
  <view class="warehouse-dialog">
    <view class="warehouse-dialog-header">
      <text>{{dialog.title}}</text>
      <button class="warehouse-close" bindtap="closeDialog" disabled="{{saving || pendingActions.length}}">
        <van-icon name="cross" />
      </button>
    </view>
    <view class="warehouse-dialog-body">
      <view class="mat-dialog-msg">{{dialog.message}}</view>
      <view wx:if="{{dialog.required}}" class="warehouse-title">原因（必填）</view>
      <textarea
        wx:if="{{dialog.required}}"
        class="warehouse-input"
        placeholder="请输入原因"
        maxlength="200"
        value="{{dialog.reason}}"
        bindinput="dialogInput"
        disabled="{{saving || pendingActions.length}}"
      />
      <view class="warehouse-error">{{dialog.error}}</view>
    </view>
    <view class="warehouse-dialog-footer">
      <button class="warehouse-secondary" bindtap="closeDialog" disabled="{{saving || pendingActions.length}}">取消</button>
      <button class="warehouse-primary" bindtap="confirmAction" loading="{{saving}}" disabled="{{saving || pendingActions.length}}">确认</button>
    </view>
  </view>
</view>
