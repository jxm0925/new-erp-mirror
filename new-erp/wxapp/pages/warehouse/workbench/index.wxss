@import "../shared.wxss";
.warehouse-workbench { padding-top: 24rpx; }.workspace-scan-tip { color: #8a95aa; margin-top: 14rpx; font-size: 25rpx; }
.workspace-shortcuts { display: flex; flex-wrap: wrap; margin: 8rpx -10rpx -12rpx; }.workspace-shortcut { width: 33.333%; padding: 18rpx 6rpx 24rpx; display: flex; flex-direction: column; align-items: center; gap: 14rpx; font-size: 27rpx; font-weight: 600; text-align: center; border-right: 1rpx solid #edf0f5; border-bottom: 1rpx solid #edf0f5; }.workspace-shortcut:nth-child(3n) { border-right: 0; }
.workspace-icon { width: 82rpx; height: 82rpx; flex-shrink: 0; background: #fff1f0; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; }
.workspace-section { display: flex; justify-content: space-between; align-items: baseline; color: #8995a9; }.workspace-section .phase-heading { color: #10223e; }
.workspace-todo { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid #e9edf4; }.workspace-todo:last-child { border: 0; }.workspace-todo-main { flex: 1; min-width: 0; color: #8794aa; font-size: 24rpx; line-height: 1.6; word-break: break-all; }.workspace-todo-title { color: #10223e; font-size: 27rpx; font-weight: 600; margin: 5rpx 0; }.workspace-todo-button { background: #ee1908; color: #fff; padding: 16rpx 18rpx; font-size: 24rpx; flex-shrink: 0; }
.workspace-freeze { background: #fff6e8; color: #b86d1f; padding: 18rpx; border-radius: 12rpx; margin-bottom: 18rpx; font-size: 24rpx; line-height: 1.7; }.workspace-freeze.overdue { background: #fff0ed; color: #da2815; }.workspace-freeze-title { font-weight: 600; }
