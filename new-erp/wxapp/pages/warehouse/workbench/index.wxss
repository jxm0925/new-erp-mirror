@import "../shared.wxss";
.warehouse-workbench { padding-bottom: calc(132rpx + env(safe-area-inset-bottom)); }
.workspace-totals { display: flex; align-items: center; justify-content: space-around; padding: 56rpx 20rpx 42rpx; background: #ef1008; color: #fff; border-radius: 14rpx; margin: 12rpx 0 34rpx; text-align: center; }
.workspace-total { display: flex; align-items: baseline; justify-content: center; gap: 14rpx; margin-top: 14rpx; }
.workspace-total text:first-child { font-size: 68rpx; font-weight: 600; line-height: 1; }
.workspace-divider { height: 84rpx; border-left: 2rpx solid rgba(255,255,255,.75); }
.workspace-shortcuts { display: flex; flex-wrap: wrap; gap: 18rpx; margin-bottom: 44rpx; }
.workspace-shortcut { flex: 1 1 180rpx; min-width: 0; padding: 42rpx 6rpx; background: #fff; border-radius: 16rpx; display: flex; flex-direction: column; gap: 24rpx; align-items: center; font-size: 30rpx; }
.workspace-section { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28rpx; }
.workspace-section > text { font-size: 34rpx; font-weight: 600; }
.workspace-section > view { font-size: 26rpx; color: #5b6881; }
.workspace-todo { display: flex; align-items: flex-start; gap: 16rpx; padding: 26rpx 22rpx; }
.workspace-todo-main { flex: 1; color: #596780; font-size: 25rpx; line-height: 1.7; word-break: break-all; }
.workspace-todo-title { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10rpx; font-size: 29rpx; margin-bottom: 10rpx; color: #151e2e; font-weight: 600; }
.workspace-todo-title text:last-child { color: #ef1008; font-weight: 400; }
.workspace-navigation { position: fixed; bottom: 0; width: 100%; z-index: 20; display: flex; background: white; border-top: 1rpx solid #e7ebf1; padding: 16rpx 16rpx calc(14rpx + env(safe-area-inset-bottom)); }
.workspace-navigation > view { flex: 1; display: flex; flex-direction: column; align-items: center; color: #91979f; gap: 6rpx; font-size: 25rpx; }
.workspace-navigation > view.active { color: #ef1008; }
