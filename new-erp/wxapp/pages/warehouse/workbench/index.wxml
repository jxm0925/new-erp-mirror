<view wx:if="{{authenticated}}" class="phase-user"><text>{{actorName}} · 仓库</text><text>{{today}}</text></view>
<view class="warehouse-page warehouse-workbench">
  <view wx:if="{{!authenticated && !loading}}" class="warehouse-card warehouse-empty"><view>请先登录仓库账号</view><button class="warehouse-primary" bindtap="openLogin">立即登录</button></view>
  <view wx:elif="{{loading}}" class="warehouse-empty"><van-loading color="#ee160b"/></view>
  <view wx:elif="{{error}}" class="warehouse-empty"><text>{{error}}</text><button class="warehouse-secondary" bindtap="load">重新加载</button></view>
  <block wx:elif="{{summary}}">
    <view class="warehouse-card workspace-scan"><scan-input focus clear-after-resolve placeholder="扫码或输入编码" bind:resolved="resolved"/><view class="workspace-scan-tip">输入后回车查询</view></view>
    <view class="warehouse-card"><view class="phase-heading">快速操作</view><view class="workspace-shortcuts"><view wx:for="{{shortcuts}}" wx:key="url" class="workspace-shortcut" data-url="{{item.url}}" bindtap="openShortcut"><view class="workspace-icon"><van-icon name="{{item.icon}}" size="48rpx" color="#e91a08"/></view><text>{{item.label}}</text></view></view></view>
    <view wx:if="{{freezes.length}}" class="workspace-freeze {{freezeOverdue ? 'overdue' : ''}}"><view class="workspace-freeze-title">{{freezeOverdue ? '盘点已超期，请尽快完成' : '盘点范围暂停出入库'}}</view><view wx:for="{{freezes}}" wx:key="id" class="workspace-freeze-row">{{item.warehouse.warehouse_name}} · {{item.location ? item.location.location_name : '全仓'}} · {{item.stocktake_no}}</view></view>
    <view class="warehouse-card"><view class="workspace-section"><view class="phase-heading">待办事项</view><view bindtap="openList">全部 <van-icon name="arrow"/></view></view>
      <view wx:if="{{!todos.length}}" class="warehouse-empty">暂无待办理单据</view>
      <view wx:for="{{todos}}" wx:key="key" class="workspace-todo" data-key="{{item.key}}" bindtap="openTodo"><view class="workspace-icon"><van-icon name="{{item.icon}}" size="42rpx" color="#e91a08"/></view><view class="workspace-todo-main"><text class="phase-tag">{{item.title}}</text><view class="workspace-todo-title">{{item.displayTitle}}</view><view>{{item.detailText}}<text wx:if="{{item.quantityText}}"> · {{item.quantityText}} {{item.unit_name}}</text></view></view><button class="workspace-todo-button">{{item.actionText}}</button><van-icon name="arrow" color="#8a98aa"/></view>
    </view>
  </block>
</view>
<LoginPopup class="LoginPopup" default-mode="production"></LoginPopup><van-notify id="van-notify"/>
