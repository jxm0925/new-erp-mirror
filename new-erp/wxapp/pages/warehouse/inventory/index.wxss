@import "../shared.wxss";
.inventory-item { display: flex; gap: 22rpx; align-items: center; }.inventory-icon { background: #fff1ef; border-radius: 15rpx; padding: 20rpx; flex-shrink: 0; }.inventory-item-main { flex: 1; min-width: 0; }.inventory-item-main .warehouse-card-title { margin-bottom: 6rpx; }.inventory-item-main .warehouse-field { margin: 2rpx 0; }.inventory-item-main .warehouse-label { width: 60rpx; }.inventory-filters { display: flex; justify-content: space-between; gap: 16rpx; margin: 18rpx 0; color: #6b7b94; }.inventory-filters > view { flex: 1; background: #fff; border: 1rpx solid #dbe3ed; padding: 16rpx; border-radius: 8rpx; }.inventory-filter-actions { margin-top: 20rpx; }.inventory-back { color: #7485a0; padding: 4rpx 0 22rpx; }
