<view class="warehouse-page">
  <view wx:if="{{loading}}" class="warehouse-empty"><van-loading color="#ef1008"/></view>
  <block wx:else>
    <view wx:if="{{error}}" class="warehouse-error">{{error}}</view>
    <button wx:if="{{!header.id && error}}" class="warehouse-secondary" bindtap="load">重新加载</button>
    <block wx:if="{{header.id}}">
      <view wx:if="{{readonly && !receipt}}" class="warehouse-note">当前单据暂无可办理操作，可查看以下信息。</view>
      <view class="warehouse-card"><view wx:for="{{headerFields}}" wx:key="label" class="warehouse-field"><text class="warehouse-label">{{item.label}}</text><text class="warehouse-value {{item.label === '单据状态' || item.label === '工单状态' ? 'warehouse-danger' : ''}}">{{item.value}}</text></view></view>
      <view wx:if="{{receipt}}" class="warehouse-card document-result"><view class="warehouse-card-title document-success">已办理</view><view class="warehouse-field"><text class="warehouse-label">凭证单号</text><text class="warehouse-value">{{receipt.receipt_no || receipt.transaction_no}}</text></view><view wx:if="{{receipt.posted_at || receipt.created_at}}" class="warehouse-field"><text class="warehouse-label">办理时间</text><text class="warehouse-value">{{receipt.posted_at || receipt.created_at}}</text></view><view wx:if="{{receipt.posted_base_qty || receipt.posted_qty}}" class="warehouse-field"><text class="warehouse-label">入库数量</text><text class="warehouse-value">{{receipt.posted_base_qty || receipt.posted_qty}} {{item.unit.unit_name}}</text></view><view wx:if="{{receipt.warehouse_name}}" class="warehouse-field"><text class="warehouse-label">仓库 / 库位</text><text class="warehouse-value">{{receipt.warehouse_name}} / {{receipt.location_name}}</text></view><view wx:if="{{receipt.batch_no}}" class="warehouse-field"><text class="warehouse-label">批次</text><text class="warehouse-value">{{receipt.batch_no}}</text></view></view>
      <block wx:if="{{kind === 'output' || kind === 'cutting_product'}}">
        <view class="warehouse-card"><view class="warehouse-card-title">{{kind === 'output' ? '工单信息' : '物料信息'}}</view><view class="warehouse-field"><text class="warehouse-label">{{kind === 'output' ? '产品名称' : '物料名称'}}</text><text class="warehouse-value">{{item.item_name}}</text></view><view class="warehouse-field"><text class="warehouse-label">物料编码</text><text class="warehouse-value">{{item.item_code}}</text></view><view class="warehouse-field"><text class="warehouse-label">规格型号</text><text class="warehouse-value">{{item.spec || '—'}}</text></view><view class="warehouse-field"><text class="warehouse-label">待入库数量</text><text class="warehouse-value">{{header.remaining_qty}} {{item.unit.unit_name}}</text></view>
          <view wx:if="{{mainAction}}" class="warehouse-field"><text class="warehouse-label">本次入库数量</text><input class="warehouse-input warehouse-value" type="digit" value="{{quantity}}" bindinput="quantityInput" disabled="{{busy || pendingAction}}"/><text>{{item.unit.unit_name}}</text></view><view class="warehouse-error">{{fieldErrors.quantity}}</view><view class="warehouse-field"><text class="warehouse-label">{{kind === 'output' ? '生产批次' : '入库批次'}}</text><text class="warehouse-value warehouse-readonly">{{header.batch_no || '—'}}</text></view><view class="warehouse-error">{{fieldErrors.batch}}</view></view>
        <view wx:if="{{mainAction}}" class="warehouse-card"><view class="warehouse-card-title">入库信息</view><view class="warehouse-field"><text class="warehouse-label">仓库及库位</text><view class="warehouse-value warehouse-input warehouse-kv-select" bindtap="openLocator"><text>{{locator.location_id ? locator.warehouse_name + ' / ' + locator.location_name : '请选择仓库和库位'}}</text><van-icon name="arrow"/></view></view><view class="warehouse-error">{{fieldErrors.locator}}</view></view>
        <view wx:if="{{hasMaterialCost}}" class="warehouse-card"><view class="warehouse-card-title">其他信息</view><view class="warehouse-field"><text class="warehouse-label">材料金额</text><text class="warehouse-value warehouse-readonly">{{header.material_total_cost}} 元</text></view></view>
      </block>
      <block wx:for="{{lines}}" wx:for-item="line" wx:key="id">
        <view class="document-section-heading"><text>{{kind === 'sales_return' ? '退货物品' : kind === 'sales_shipment' ? '出库物料' : kind === 'purchase_return' ? '退货物料' : '物料信息'}}</text></view>
        <view class="warehouse-card"><view class="warehouse-field"><text class="warehouse-label">物料编码</text><text class="warehouse-value">{{line.itemCode}}</text></view><view class="warehouse-field"><text class="warehouse-label">物料名称</text><text class="warehouse-value">{{line.itemName}}</text></view><view class="warehouse-field"><text class="warehouse-label">规格说明</text><text class="warehouse-value">{{line.spec}}</text></view><view class="warehouse-field"><text class="warehouse-label">计量单位</text><text class="warehouse-value">{{line.unit}}</text></view>
          <view wx:if="{{line.sourceShipments}}" class="warehouse-field"><text class="warehouse-label">原发货单号</text><text class="warehouse-value">{{line.sourceShipments}}</text></view>
          <view wx:if="{{kind === 'purchase_receipt'}}" class="document-stats"><view>验收数量 <text class="warehouse-danger">{{line.qualified_base_qty}} {{line.unit}}</text></view><view>可入库数量 <text class="warehouse-danger">{{line.final_stockable_base_qty}} {{line.unit}}</text></view></view>
          <block wx:if="{{kind === 'production_return'}}"><view class="warehouse-field"><text class="warehouse-label">退回数量</text><text class="warehouse-value">{{line.return_base_qty}} {{line.unit}}</text></view><view class="warehouse-field"><text class="warehouse-label">批次</text><text class="warehouse-value">{{line.batch_no}}</text></view></block>
          <block wx:if="{{kind === 'sales_return' && stage === 'post'}}"><view class="warehouse-field"><text class="warehouse-label">已收货数量</text><text class="warehouse-value">{{line.received_base_qty}} {{line.unit}}</text></view><view class="warehouse-field"><text class="warehouse-label">生产批次</text><text class="warehouse-value">{{line.batch_no || '—'}}</text></view></block>
        </view>
        <block wx:if="{{kind === 'purchase_receipt'}}">
          <view class="document-section-heading"><text>分配明细</text><button wx:if="{{canAllocate}}" class="warehouse-secondary document-small-button" data-id="{{line.id}}" bindtap="openAllocation" disabled="{{busy || pendingAction}}">调整分配</button></view>
          <view wx:for="{{line.allocations}}" wx:for-item="allocation" wx:key="id" class="warehouse-card"><view class="warehouse-field"><text class="warehouse-label">仓库</text><text class="warehouse-value">{{allocation.warehouse.warehouse_name}}</text></view><view class="warehouse-field"><text class="warehouse-label">库位</text><text class="warehouse-value">{{allocation.location.location_name}}（{{allocation.location.location_code}}）</text></view><view class="warehouse-field"><text class="warehouse-label">本次入库数量</text><text class="warehouse-value">{{allocation.base_qty}} {{line.unit}}</text></view><view class="warehouse-field"><text class="warehouse-label">批次号</text><text class="warehouse-value">{{line.batch_no}}</text></view>
            <view wx:if="{{allocation.physical_entries.length}}" class="warehouse-table-scroll"><view class="warehouse-table"><view class="warehouse-tr warehouse-th"><text class="warehouse-td">序号</text><text class="warehouse-td">尺寸（mm）</text><text class="warehouse-td">数量</text></view><view wx:for="{{allocation.physical_entries}}" wx:for-item="physical" wx:for-index="pi" wx:key="id" class="warehouse-tr"><text class="warehouse-td">{{pi + 1}}</text><text class="warehouse-td">{{physical.dimensionText}}</text><text class="warehouse-td">1 {{line.unit}}</text></view></view></view>
            <view wx:if="{{allocation.serial_nos.length}}" class="warehouse-field"><text class="warehouse-label">序列号</text><view class="warehouse-value"><view wx:for="{{allocation.serial_nos}}" wx:key="*this">{{item}}</view></view></view>
          </view><view wx:if="{{!line.allocations.length}}" class="warehouse-card warehouse-muted">尚未分配仓库和库位</view>
        </block>
        <block wx:if="{{kind === 'sales_return' && stage === 'receive'}}">
          <view class="warehouse-card"><view class="warehouse-field"><text class="warehouse-label">应退数量</text><text class="warehouse-value">{{line.requested_base_qty}} {{line.unit}}</text></view><view class="warehouse-field"><text class="warehouse-label">待收数量</text><text class="warehouse-value">{{line.remaining_receivable_qty}} {{line.unit}}</text></view>
            <view class="warehouse-field" data-id="{{line.id}}" bindtap="openReturnSerial"><text class="warehouse-label">本次实收数量</text><view wx:if="{{line.serialTracked}}" class="warehouse-input warehouse-value warehouse-readonly">{{line.draft.received_base_qty || '0'}}</view><input wx:else class="warehouse-input warehouse-value" type="digit" value="{{line.draft.received_base_qty}}" data-id="{{line.id}}" data-field="received_base_qty" bindinput="returnInput" disabled="{{busy || pendingAction || !mainAction}}"/><text>{{line.unit}}</text></view></view>
          <view class="warehouse-card"><view class="warehouse-card-title">处理去向</view><view class="warehouse-muted">各处理数量合计须等于本次实收数量</view>
            <view class="warehouse-field" data-id="{{line.id}}" bindtap="openReturnSerial"><text class="warehouse-label">可重新入库</text><view wx:if="{{line.serialTracked}}" class="warehouse-input warehouse-value warehouse-readonly">{{line.draft.restock_base_qty || '0'}}</view><input wx:else class="warehouse-input warehouse-value" type="digit" value="{{line.draft.restock_base_qty}}" data-id="{{line.id}}" data-field="restock_base_qty" bindinput="returnInput" disabled="{{busy || pendingAction || !mainAction}}"/><text>{{line.unit}}</text></view>
            <view class="warehouse-field" data-id="{{line.id}}" bindtap="openReturnSerial"><text class="warehouse-label">待检</text><view wx:if="{{line.serialTracked}}" class="warehouse-input warehouse-value warehouse-readonly">{{line.draft.pending_base_qty || '0'}}</view><input wx:else class="warehouse-input warehouse-value" type="digit" value="{{line.draft.pending_base_qty}}" data-id="{{line.id}}" data-field="pending_base_qty" bindinput="returnInput" disabled="{{busy || pendingAction || !mainAction}}"/><text>{{line.unit}}</text></view>
            <view class="warehouse-field" data-id="{{line.id}}" bindtap="openReturnSerial"><text class="warehouse-label">报废</text><view wx:if="{{line.serialTracked}}" class="warehouse-input warehouse-value warehouse-readonly">{{line.draft.scrap_base_qty || '0'}}</view><input wx:else class="warehouse-input warehouse-value" type="digit" value="{{line.draft.scrap_base_qty}}" data-id="{{line.id}}" data-field="scrap_base_qty" bindinput="returnInput" disabled="{{busy || pendingAction || !mainAction}}"/><text>{{line.unit}}</text></view>
            <view class="warehouse-field" data-id="{{line.id}}" bindtap="openReturnSerial"><text class="warehouse-label">拒收</text><view wx:if="{{line.serialTracked}}" class="warehouse-input warehouse-value warehouse-readonly">{{line.draft.rejected_base_qty || '0'}}</view><input wx:else class="warehouse-input warehouse-value" type="digit" value="{{line.draft.rejected_base_qty}}" data-id="{{line.id}}" data-field="rejected_base_qty" bindinput="returnInput" disabled="{{busy || pendingAction || !mainAction}}"/><text>{{line.unit}}</text></view>
            <view class="warehouse-field"><text class="warehouse-label">仓库 / 库位</text><view class="warehouse-value warehouse-input warehouse-kv-select" data-target="return" data-id="{{line.id}}" bindtap="openLocator"><text>{{line.draft.locator.location_id ? line.draft.locator.warehouse_name + ' / ' + line.draft.locator.location_name : '请选择'}}</text><van-icon name="arrow"/></view></view>
            <view class="warehouse-field"><text class="warehouse-label">生产批次</text><view wx:if="{{line.serialTracked}}" class="warehouse-input warehouse-value warehouse-readonly">{{line.draft.batch_no || '—'}}</view><input wx:else class="warehouse-input warehouse-value" value="{{line.draft.batch_no}}" data-id="{{line.id}}" data-field="batch_no" bindinput="returnInput" disabled="{{busy || pendingAction || !mainAction}}"/></view><view class="warehouse-field"><text class="warehouse-label">检验说明</text><textarea class="warehouse-input warehouse-value" value="{{line.draft.inspection_remark}}" data-id="{{line.id}}" data-field="inspection_remark" bindinput="returnInput" maxlength="1000" disabled="{{busy || pendingAction || !mainAction}}"/></view>
          </view>
        </block>
        <view wx:if="{{kind === 'production_return' || (kind === 'sales_return' && stage === 'post')}}" class="warehouse-card"><view class="warehouse-card-title">入库信息</view><view class="warehouse-field"><text class="warehouse-label">仓库及库位</text><text class="warehouse-value warehouse-readonly">{{line.warehouseName || '—'}} / {{line.locationName || '—'}}</text></view><block wx:if="{{kind === 'sales_return'}}"><view class="warehouse-field"><text class="warehouse-label">可重新入库</text><text class="warehouse-value">{{line.restock_base_qty}} {{line.unit}}</text></view><view class="warehouse-field"><text class="warehouse-label">待检 / 报废 / 拒收</text><text class="warehouse-value">{{line.pending_base_qty}} / {{line.scrap_base_qty}} / {{line.rejected_base_qty}} {{line.unit}}</text></view></block></view>
        <block wx:if="{{kind === 'sales_shipment' || kind === 'purchase_return'}}">
          <view class="warehouse-card"><view class="warehouse-card-title">{{kind === 'sales_shipment' ? '出库明细' : '物料明细'}}</view><view class="warehouse-field"><text class="warehouse-label">批次号</text><text class="warehouse-value">{{line.batch_no}}</text></view><view wx:if="{{line.serialNos}}" class="warehouse-field"><text class="warehouse-label">序列号</text><text class="warehouse-value">{{line.serialNos}}</text></view><view wx:for="{{line.physicals}}" wx:for-item="physical" wx:key="id" class="warehouse-field"><text class="warehouse-value">{{physical.physical_no}}</text><text class="warehouse-value">{{physical.dimensionText}} mm</text></view></view>
          <view class="warehouse-card"><view class="warehouse-card-title">仓库信息</view><view class="warehouse-field"><text class="warehouse-label">仓库</text><text class="warehouse-value">{{line.warehouseName}}</text></view><view class="warehouse-field"><text class="warehouse-label">库位</text><text class="warehouse-value">{{line.locationName}}</text></view></view>
          <view class="warehouse-card"><view class="warehouse-card-title">数量信息</view><view class="document-stats"><view wx:if="{{kind === 'sales_shipment'}}">已预留数量 <text>{{line.reservation.reserved_qty}} {{line.unit}}</text></view><view>{{kind === 'sales_shipment' ? '本次出库数量' : '本次退货数量'}} <text>{{kind === 'sales_shipment' ? line.base_qty : line.approved_base_qty}} {{line.unit}}</text></view></view></view>
        </block>
      </block>
      <view wx:if="{{total > 10}}" class="warehouse-pager"><text>共 {{total}} 项</text><button disabled="{{page <= 1 || busy}}" data-delta="-1" bindtap="turnPage">上一页</button><text>{{page}} / {{lastPage}}</text><button disabled="{{page >= lastPage || busy}}" data-delta="1" bindtap="turnPage">下一页</button></view>
      <view wx:if="{{kind === 'production_return' && header.return_type === 'quality_return'}}" class="warehouse-card"><view class="warehouse-card-title">其他信息</view><view class="document-warning">接收后进入待检，检验通过后转为可用库存。</view></view>
      <block wx:if="{{kind === 'sales_shipment'}}"><view class="warehouse-title">物流信息</view><view class="warehouse-card"><view class="warehouse-field"><text class="warehouse-label">承运商</text><text class="warehouse-value">{{header.carrier_name_snapshot || '—'}}</text></view><view class="warehouse-field"><text class="warehouse-label">运单号</text><text class="warehouse-value">{{header.tracking_no || '—'}}</text></view><view class="warehouse-field"><text class="warehouse-label">包裹数量</text><text class="warehouse-value">{{packagesTotal}} 件</text></view></view><view wx:for="{{packages}}" wx:key="id" class="warehouse-card"><view class="warehouse-field"><text class="warehouse-label">承运商</text><text class="warehouse-value">{{item.carrier_name || header.carrier_name_snapshot || '—'}}</text></view><view class="warehouse-field"><text class="warehouse-label">包裹编号</text><text class="warehouse-value">{{item.package_no}}</text></view><view class="warehouse-field"><text class="warehouse-label">运单号</text><text class="warehouse-value">{{item.tracking_no || '—'}}</text></view></view><view wx:if="{{packagesLast > 1}}" class="warehouse-pager"><button disabled="{{packagesPage <= 1}}" data-delta="-1" bindtap="turnPackages">上一页</button><text>{{packagesPage}} / {{packagesLast}}</text><button disabled="{{packagesPage >= packagesLast}}" data-delta="1" bindtap="turnPackages">下一页</button></view><view class="warehouse-card"><view class="warehouse-card-title">发运进度</view><view wx:if="{{header.confirmed_at}}" class="document-timeline">已确认<view class="warehouse-muted">{{header.confirmed_at}}　{{header.confirmed_by}}</view></view><view wx:if="{{header.outbound_posted_at}}" class="document-timeline">已出库<view class="warehouse-muted">{{header.outbound_posted_at}}　{{header.outbound_posted_by}}</view></view><view wx:if="{{header.shipped_at}}" class="document-timeline">已发运<view class="warehouse-muted">{{header.shipped_at}}　{{header.shipped_by}}</view></view></view></block>
      <block wx:if="{{kind === 'purchase_receipt' && header.order}}"><view class="warehouse-title">相关单据</view><view class="warehouse-card document-related" bindtap="openRelated"><text>采购订单</text><text>{{header.order.purchase_order_no}}</text><van-icon name="arrow"/></view></block>
      <view wx:if="{{postingEligibility && !postingEligibility.can_post}}" class="warehouse-error">{{postingEligibility.reason_text}}</view>
      <button wx:if="{{mainAction || pendingAction}}" class="warehouse-primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">{{pendingAction ? '查询原操作结果' : mainLabel}}</button>
      <button wx:elif="{{receipt}}" class="warehouse-primary" bindtap="back">返回列表</button>
    </block>
  </block>
</view>
<view wx:if="{{allocationOpen}}" class="warehouse-overlay" catchtouchmove="stop"><view class="warehouse-dialog"><view class="warehouse-dialog-header"><text>补充分配</text><button class="warehouse-close" disabled="{{busy}}" bindtap="closeAllocation"><van-icon name="cross"/></button></view><scroll-view scroll-y class="warehouse-dialog-body">
  <view wx:for="{{allocations}}" wx:for-item="allocation" wx:for-index="ai" wx:key="uid" class="document-allocation"><view class="warehouse-field"><text class="warehouse-label">选择仓库及库位</text><view class="warehouse-value warehouse-input warehouse-kv-select" data-target="allocation" data-index="{{ai}}" bindtap="openLocator"><text>{{allocation.locator.location_id ? allocation.locator.warehouse_name + ' / ' + allocation.locator.location_name : '请选择'}}</text><van-icon name="arrow"/></view></view><view class="warehouse-field"><text class="warehouse-label">本次入库数量</text><input class="warehouse-input warehouse-value" type="digit" value="{{allocation.base_qty}}" data-index="{{ai}}" data-field="base_qty" bindinput="allocationInput" disabled="{{busy}}"/><text>{{allocationLine.unit}}</text></view>
    <block wx:if="{{allocationLine.physical}}"><view class="warehouse-title">实物明细</view><view wx:for="{{allocation.physical_entries}}" wx:for-item="physical" wx:for-index="pi" wx:key="uid" class="document-allocation"><view class="document-section-heading"><text>实物 {{pi + 1}}</text><button class="warehouse-secondary document-small-button" disabled="{{busy}}" data-index="{{ai}}" data-piece="{{pi}}" bindtap="removePhysical">移除</button></view><view class="document-piece-fields"><view>长度（mm）<input class="warehouse-input" type="digit" value="{{physical.dimensions.length_mm}}" data-index="{{ai}}" data-piece="{{pi}}" data-field="length_mm" bindinput="allocationInput" disabled="{{busy}}"/></view><view>宽度（mm）<input class="warehouse-input" type="digit" value="{{physical.dimensions.width_mm}}" data-index="{{ai}}" data-piece="{{pi}}" data-field="width_mm" bindinput="allocationInput" disabled="{{busy}}"/></view><view>厚度（mm）<input class="warehouse-input" type="digit" value="{{physical.dimensions.thickness_mm}}" data-index="{{ai}}" data-piece="{{pi}}" data-field="thickness_mm" bindinput="allocationInput" disabled="{{busy}}"/></view><view>数量<view class="warehouse-readonly">1</view></view></view></view><button class="warehouse-secondary" disabled="{{busy}}" data-index="{{ai}}" bindtap="addPhysical">＋ 添加实物</button></block>
    <view wx:if="{{allocationLine.serialTracked}}" class="warehouse-field"><text class="warehouse-label">序列号</text><textarea class="warehouse-input warehouse-value document-serials" value="{{allocation.serialText}}" data-index="{{ai}}" data-field="serialText" bindinput="allocationInput" placeholder="每行一个序列号" disabled="{{busy}}"/></view><button wx:if="{{allocations.length > 1}}" class="warehouse-secondary" disabled="{{busy}}" data-index="{{ai}}" bindtap="removeAllocation">移除此分配</button>
  </view><button class="warehouse-secondary" disabled="{{busy}}" bindtap="addAllocation">＋ 添加库位分配</button><view class="warehouse-error">{{allocationError}}</view>
</scroll-view><view class="warehouse-dialog-footer"><button class="warehouse-secondary" disabled="{{busy}}" bindtap="closeAllocation">取消</button><button class="warehouse-primary" disabled="{{busy}}" loading="{{busy}}" bindtap="saveAllocation">保存分配</button></view></view></view>
<warehouse-locator open="{{locatorOpen}}" value="{{locatorValue}}" bind:confirm="chooseLocator" bind:cancel="closeLocator"/>
<warehouse-return-serial open="{{returnSerialOpen}}" return-id="{{id}}" line="{{returnSerialLine}}" value="{{returnSerialValue}}" excluded="{{returnSerialExcluded}}" locked="{{busy || pendingAction}}" conflict="{{returnSerialConflict}}" bind:confirm="confirmReturnSerial" bind:cancel="cancelReturnSerial"/>
<view wx:if="{{conflictOpen}}" class="warehouse-overlay" catchtouchmove="stop"><view class="warehouse-dialog"><view class="warehouse-dialog-header">{{pendingAction ? '操作结果待确认' : '单据或库存已变化'}}</view><view class="warehouse-dialog-body">{{error}}</view><view class="warehouse-dialog-footer"><button class="warehouse-secondary" bindtap="closeConflict">返回核对</button><button class="warehouse-primary" loading="{{busy}}" bindtap="refreshConflict">{{pendingAction ? '查询结果' : '刷新单据'}}</button></view></view></view>
<view wx:if="{{relatedOpen}}" class="warehouse-overlay" catchtouchmove="stop"><view class="warehouse-dialog"><view class="warehouse-dialog-header"><text>采购订单</text><button class="warehouse-close" bindtap="closeRelated"><van-icon name="cross"/></button></view><view class="warehouse-dialog-body"><view class="warehouse-field"><text class="warehouse-label">订单编号</text><text class="warehouse-value">{{header.order.purchase_order_no}}</text></view><view class="warehouse-field"><text class="warehouse-label">供应商</text><text class="warehouse-value">{{header.supplier.supplier_name}}</text></view><view class="warehouse-field"><text class="warehouse-label">备注</text><text class="warehouse-value">{{header.order.remark || '—'}}</text></view></view></view></view>
