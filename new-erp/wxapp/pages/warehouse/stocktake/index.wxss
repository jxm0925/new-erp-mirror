@import "../shared.wxss";

.stocktake-row-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2329;
}

.stocktake-row-title > text:first-child {
  word-break: break-all;
}

.stocktake-info-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.stk-wh-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #1e293b;
}

.stocktake-date {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #64748b;
  font-size: 25rpx;
  margin: 10rpx 0;
}

.stk-progress-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
}

.stocktake-number {
  width: 164rpx;
  text-align: center;
  font-weight: 800;
}

.stocktake-count {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: center;
  margin: 18rpx 0;
  color: #64748b;
  font-size: 25rpx;
}

.stk-book-val {
  color: #1e293b;
  font-weight: 700;
}

.stocktake-count > view {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stk-entry-btn {
  width: auto !important;
  min-height: 64rpx;
  height: 64rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
}

.stocktake-note {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #64748b;
  font-size: 25rpx;
}

.stk-note-lbl {
  flex-shrink: 0;
}

.stocktake-note input {
  flex: 1;
}

.stocktake-progress {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  color: #475569;
  font-size: 25rpx;
  font-weight: 600;
  margin: 20rpx 0;
  padding: 16rpx 20rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
}

.stocktake-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.stocktake-detail-back {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  color: #d81e06;
  font-weight: 700;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  background: #fff1f0;
  border-radius: 999rpx;
  margin-bottom: 18rpx;
}

.stk-clear-loc {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 18rpx;
  border-radius: 14rpx;
  background: #fff5f5;
  border: 1rpx solid #ffccc7;
  color: #d81e06;
  font-size: 24rpx;
  font-weight: 600;
  margin: 12rpx 0;
}

.stocktake-entry-overlay .warehouse-dialog {
  max-width: 680rpx;
}

.stk-dialog-title {
  margin-bottom: 0;
}

.stocktake-entry-body {
  max-height: calc(100vh - 280rpx);
}

.stk-entry-search {
  margin-top: 14rpx;
}

.stk-entry-filter-wrap {
  margin: 14rpx 0 10rpx;
}

.stk-entry-code {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.stocktake-supplement {
  border-top: 1rpx solid #e2e8f0;
  padding-top: 20rpx;
  margin-top: 18rpx;
}

.stocktake-physical-fields {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.stocktake-physical-fields input {
  flex: 1 1 44%;
}

.stocktake-confirm {
  z-index: 1100;
}

.stocktake-confirm .warehouse-dialog {
  max-width: 580rpx;
}

.stocktake-confirm .warehouse-dialog-body {
  text-align: center;
  padding: 42rpx 32rpx;
  line-height: 1.7;
}

.stocktake-confirm-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2329;
  margin: 20rpx 0 10rpx;
}

.stk-empty-title {
  font-size: 29rpx;
  font-weight: 800;
  color: #1f2329;
}

.stk-retry-btn {
  max-width: 320rpx;
}
