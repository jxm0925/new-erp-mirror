@import "../shared.wxss";
.stocktake-row-title { display: flex; justify-content: space-between; gap: 18rpx; margin-bottom: 16rpx; font-size: 31rpx; font-weight: 600; }.stocktake-row-title > text:first-child { word-break: break-all; }.stocktake-date { color: #7d8da5; margin: 14rpx 0; }.stocktake-number { width: 156rpx; text-align: center; }.stocktake-count { display: flex; justify-content: space-between; gap: 16rpx; align-items: center; margin: 20rpx 0; color: #7b8aa3; }.stocktake-count > view { display: flex; align-items: center; gap: 12rpx; }.stocktake-count button { padding: 15rpx; width: auto; }.stocktake-note { display: flex; align-items: center; gap: 16rpx; color: #7b8aa3; }.stocktake-note input { flex: 1; }.stocktake-progress { display: flex; justify-content: space-between; gap: 16rpx; color: #7989a2; font-size: 25rpx; margin: 20rpx 0; padding: 12rpx; background: #f0f4f9; border-radius: 8rpx; }.stocktake-footer { display: flex; justify-content: flex-end; }.stocktake-footer button { width: auto; }.stocktake-detail-back { color: #7485a0; padding: 4rpx 0 20rpx; }.stocktake-entry-overlay .warehouse-dialog { max-width: 680px; }.stocktake-entry-body { max-height: calc(100vh - 260rpx); }.stocktake-entry-list { margin: 18rpx 0; }.stocktake-supplement { border-top: 1rpx solid #e7edf4; padding-top: 20rpx; margin-top: 18rpx; }.stocktake-physical-fields { display: flex; flex-wrap: wrap; gap: 12rpx; }.stocktake-physical-fields input { flex: 1 1 42%; }.stocktake-confirm { z-index: 1100; }.stocktake-confirm .warehouse-dialog { max-width: 540px; }.stocktake-confirm .warehouse-dialog-body { text-align: center; padding: 42rpx 30rpx; line-height: 1.7; }.stocktake-confirm-title { font-size: 36rpx; font-weight: 600; margin: 22rpx 0; }.stocktake-confirm .warehouse-dialog-footer { flex-wrap: wrap; }.stocktake-confirm .warehouse-dialog-footer button { min-width: 40%; }
