<warehouse-context />

<view class="warehouse-page">
  <!-- 盘点列表筛选卡片 -->
  <view wx:if="{{!id}}" class="warehouse-card">
    <view class="phase-heading">我的盘点</view>
    <view class="warehouse-search">
      <van-icon name="search" color="#64748b" size="32rpx" />
      <input
        value="{{keyword}}"
        placeholder="请输入盘点单号或仓库名称"
        bindinput="input"
        bindconfirm="search"
      />
      <button bindtap="search">搜索</button>
    </view>
    <view class="phase-tabs">
      <view
        class="{{status === 'counting' ? 'active' : ''}}"
        data-status="counting"
        bindtap="switchStatus"
      >进行中（{{stats.counting || 0}}）</view>
      <view
        class="{{status === 'completed' ? 'active' : ''}}"
        data-status="completed"
        bindtap="switchStatus"
      >已完成（{{stats.completed || 0}}）</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="warehouse-empty">
    <van-loading color="#d81e06" size="44rpx" />
    <text class="warehouse-muted">正在加载盘点数据...</text>
  </view>

  <view wx:elif="{{error}}" class="warehouse-empty">
    <van-icon name="warning-o" size="68rpx" color="#d81e06" />
    <view class="warehouse-error">{{error}}</view>
    <button class="warehouse-secondary stk-retry-btn" bindtap="load">重新加载</button>
  </view>

  <!-- 盘点任务列表 -->
  <block wx:elif="{{!id}}">
    <view wx:if="{{!rows.length}}" class="warehouse-card warehouse-empty">
      <van-icon name="records" size="84rpx" color="#cbd5e1" />
      <view class="stk-empty-title">暂无盘点任务</view>
    </view>
    <view wx:for="{{rows}}" wx:key="id" class="warehouse-card">
      <view class="stocktake-row-title">
        <text>{{item.stocktake_no}}</text>
        <text class="phase-tag">{{item.stocktake_status === 'counting' ? '盘点期间库存冻结' : '已完成'}}</text>
      </view>
      <view class="stocktake-info-row">
        <van-icon name="wap-home-o" color="#d81e06" size="30rpx" />
        <text class="stk-wh-name">{{item.warehouse.warehouse_name}}</text>
      </view>
      <view class="stocktake-date">
        <van-icon name="location-o" color="#64748b" size="28rpx" />
        <text>{{item.location ? item.location.location_code + ' · ' + item.location.location_name : '全仓盘点'}}</text>
      </view>
      <view class="stocktake-date">
        <van-icon name="calendar-o" color="#64748b" size="28rpx" />
        <text>{{item.dateText}}</text>
      </view>
      <view class="stk-progress-head">
        <text class="warehouse-muted">已录 {{item.counted_lines_count || 0}} / {{item.line_count}} 项</text>
        <text class="warehouse-danger">{{item.progress}}%</text>
      </view>
      <view class="phase-progress">
        <view style="width:{{item.progress}}%;" />
      </view>
      <view class="stocktake-footer">
        <button class="warehouse-primary" data-id="{{item.id}}" bindtap="open">
          <text>{{item.stocktake_status === 'counting' ? '继续盘点' : '查看盘点'}}</text>
          <van-icon name="arrow" />
        </button>
      </view>
    </view>
  </block>

  <!-- 盘点录入详情 -->
  <block wx:elif="{{header}}">
    <view class="stocktake-detail-back" bindtap="closeDetail">
      <van-icon name="arrow-left" size="28rpx" />
      <text>返回我的盘点</text>
    </view>

    <view class="warehouse-card">
      <view class="phase-heading">
        <text>盘点录入</text>
        <text class="warehouse-muted">{{header.stocktake_no}}</text>
      </view>
      <view class="stocktake-date">
        <van-icon name="wap-home-o" color="#d81e06" size="28rpx" />
        <text>{{header.warehouse.warehouse_name}} · {{header.location ? header.location.location_code : '全仓盘点'}}</text>
      </view>
      <view class="stocktake-date">
        <van-icon name="calendar-o" color="#64748b" size="28rpx" />
        <text>{{header.dateText}}</text>
      </view>
    </view>

    <view class="warehouse-card">
      <view class="phase-heading">扫描库位</view>
      <view class="phase-inline">
        <scan-input
          focus
          compact
          placeholder="扫描库位条码或输入库位"
          value="{{locator.location_code}}"
          types="{{['location']}}"
          bind:resolved="scanLocation"
          disabled="{{saving}}"
        />
        <button class="warehouse-secondary" bindtap="openLocator" disabled="{{saving}}">选择</button>
      </view>
      <view wx:if="{{locator.location_id}}" class="stk-clear-loc" bindtap="clearLocation">
        <van-icon name="location-o" color="#d81e06" />
        <text>{{locator.location_code}} {{locator.location_name}} · 点击清除筛选</text>
      </view>

      <view class="phase-tabs">
        <view class="{{!lineStatus ? 'active' : ''}}" data-status="" bindtap="lineFilter">全部（{{summary.total_lines || 0}}）</view>
        <view class="{{lineStatus === 'uncounted' ? 'active' : ''}}" data-status="uncounted" bindtap="lineFilter">未盘（{{summary.uncounted_lines || 0}}）</view>
        <view class="{{lineStatus === 'diff' ? 'active' : ''}}" data-status="diff" bindtap="lineFilter">有差异（{{summary.diff_lines || 0}}）</view>
      </view>

      <view wx:if="{{!lines.length}}" class="warehouse-empty">当前范围暂无明细</view>

      <view wx:for="{{lines}}" wx:key="id" class="phase-line">
        <view class="phase-line-title">
          <text>{{item.item.item_name}} {{item.item.spec}}</text>
          <text>{{item.location.location_code}}</text>
        </view>
        <view wx:if="{{item.batch_no}}" class="warehouse-muted">批次：{{item.batch_no}}</view>
        <view class="stocktake-count">
          <text class="stk-book-lbl">账面：<text class="stk-book-val">{{item.bookText}} {{item.unit.unit_name}}</text></text>
          <view wx:if="{{item.count_mode === 'quantity'}}">
            <text>实盘</text>
            <input
              class="warehouse-input stocktake-number"
              type="digit"
              value="{{item.countedText}}"
              placeholder="未录入"
              data-id="{{item.id}}"
              data-field="counted_qty"
              bindinput="lineInput"
              disabled="{{!canCount || saving || pendingCounts || pendingComplete}}"
            />
            <text>{{item.unit.unit_name}}</text>
          </view>
          <view wx:else>
            <text>已确认 {{item.confirmed}} / {{item.entryCount}}</text>
            <button class="warehouse-secondary stk-entry-btn" data-id="{{item.id}}" bindtap="openEntries" disabled="{{saving}}">
              <text>逐件盘点</text>
              <van-icon name="arrow" />
            </button>
          </view>
        </view>
        <view class="stocktake-note">
          <text class="stk-note-lbl">备注</text>
          <input
            class="warehouse-input"
            placeholder="请输入备注"
            value="{{item.remarkText}}"
            data-id="{{item.id}}"
            data-field="remark"
            bindinput="lineInput"
            disabled="{{!canCount || saving || pendingCounts || pendingComplete}}"
          />
        </view>
        <view wx:if="{{item.differenceText !== '' && item.differenceText !== '0'}}" class="warehouse-error">
          差异：{{item.differenceText}} {{item.unit.unit_name}}
        </view>
      </view>

      <view class="stocktake-progress">
        <text>已保存 {{summary.counted_lines || 0}} / {{summary.total_lines || 0}} 项</text>
        <text class="warehouse-danger">{{progress}}%</text>
      </view>
      <view class="warehouse-error">{{formError}}</view>
      <view wx:if="{{pendingCounts}}" class="warehouse-actions">
        <button class="warehouse-secondary" bindtap="save" loading="{{saving}}" disabled="{{saving}}">核对上次保存结果</button>
      </view>
      <view wx:if="{{pendingComplete}}" class="warehouse-actions">
        <button class="warehouse-secondary" bindtap="complete" loading="{{saving}}" disabled="{{saving}}">核对上次完成结果</button>
      </view>
      <view class="warehouse-actions">
        <button wx:if="{{canCount}}" class="warehouse-secondary" bindtap="save" disabled="{{saving || pendingCounts || pendingComplete}}">保存本次</button>
        <button wx:if="{{canComplete}}" class="warehouse-primary" bindtap="requestComplete" disabled="{{saving || pendingCounts || pendingComplete}}">完成盘点</button>
      </view>
    </view>
  </block>

  <view wx:if="{{!error}}" class="warehouse-pager">
    <button disabled="{{page <= 1 || loading || saving}}" data-delta="-1" bindtap="turn">上一页</button>
    <text>{{page}} / {{lastPage}}</text>
    <button disabled="{{page >= lastPage || loading || saving}}" data-delta="1" bindtap="turn">下一页</button>
  </view>
</view>

<warehouse-locator open="{{locatorOpen}}" value="{{locator}}" bind:confirm="chooseLocator" bind:cancel="closeLocator" />

<!-- 逐件盘点弹窗 -->
<view wx:if="{{entry}}" class="warehouse-overlay stocktake-entry-overlay" catchtouchmove="stop">
  <view class="warehouse-dialog">
    <view class="warehouse-dialog-header">
      <view class="phase-heading stk-dialog-title">{{entry.item.item_name}} · 逐件盘点</view>
      <button class="warehouse-close" bindtap="closeEntries" disabled="{{saving}}">
        <van-icon name="cross" />
      </button>
    </view>
    <scroll-view scroll-y class="warehouse-dialog-body stocktake-entry-body">
      <view class="warehouse-card-title">{{entry.count_mode === 'serial' ? '扫描序列号' : '扫描实物编号'}}</view>
      <scan-input
        focus
        clear-after-resolve
        compact
        placeholder="请输入或扫描编号"
        types="{{entry.count_mode === 'serial' ? ['serial'] : ['physical']}}"
        bind:resolved="scanEntry"
        disabled="{{entryLoading || saving || !canCount || pendingCounts || pendingComplete}}"
      />
      <view class="warehouse-search stk-entry-search">
        <van-icon name="search" color="#64748b" size="30rpx" />
        <input
          value="{{entryKeyword}}"
          data-field="entryKeyword"
          placeholder="搜索编号"
          bindinput="input"
          bindconfirm="entrySearch"
        />
        <button bindtap="entrySearch">搜索</button>
      </view>
      <view class="stk-entry-filter-wrap">
        <production-select
          options="{{entryFilters}}"
          label-key="label"
          value="{{entryFilterIndex}}"
          prefix="状态筛选："
          icon="filter-o"
          bind:change="entryFilter"
        />
      </view>

      <view wx:if="{{entryLoading}}" class="warehouse-empty">加载中</view>
      <view wx:elif="{{!entryRows.length}}" class="warehouse-empty">暂无逐件明细</view>
      <view wx:for="{{entryRows}}" wx:key="id" class="phase-entry">
        <view class="phase-inline">
          <view class="phase-entry-name">
            <view class="stk-entry-code">{{item.serial_no || item.physical_label}}</view>
            <view class="warehouse-muted">{{item.dimensionsText ? item.dimensionsText + ' mm' : ''}}</view>
            <text class="phase-tag">{{item.statusText}}</text>
            <view wx:if="{{canAmount && item.costText}}" class="warehouse-muted">{{item.costText}}</view>
          </view>
          <text wx:if="{{item.is_locked}}" class="warehouse-muted">按账面</text>
          <block wx:elif="{{item.is_new}}">
            <text>在</text>
            <button wx:if="{{canCount}}" class="warehouse-secondary" data-id="{{item.id}}" bindtap="removeEntry" disabled="{{saving || pendingCounts || pendingComplete}}">删除</button>
          </block>
          <block wx:else>
            <button
              class="warehouse-secondary {{item.present === true ? 'chosen' : ''}}"
              data-id="{{item.id}}"
              data-present="true"
              bindtap="present"
              disabled="{{!canCount || saving || pendingCounts || pendingComplete}}"
            >在</button>
            <button
              class="warehouse-secondary {{item.present === false ? 'chosen' : ''}}"
              data-id="{{item.id}}"
              data-present="false"
              bindtap="present"
              disabled="{{!canCount || saving || pendingCounts || pendingComplete}}"
            >不在</button>
          </block>
        </view>
      </view>

      <block wx:if="{{canCount}}">
        <view class="warehouse-title">批量操作</view>
        <view class="warehouse-actions">
          <button class="warehouse-secondary" data-present="true" bindtap="markAllEntries" disabled="{{saving || pendingCounts || pendingComplete}}">全部在</button>
          <button class="warehouse-secondary" data-present="false" bindtap="markAllEntries" disabled="{{saving || pendingCounts || pendingComplete}}">全部不在</button>
        </view>
        <view class="stocktake-supplement">
          <view class="warehouse-title">补充说明</view>
          <block wx:if="{{entry.count_mode === 'serial'}}">
            <view class="phase-inline">
              <input
                class="warehouse-input"
                placeholder="请输入账外编号"
                value="{{supplementNo}}"
                data-field="supplementNo"
                bindinput="input"
                bindconfirm="addSerial"
                disabled="{{saving || pendingCounts || pendingComplete}}"
              />
              <button class="warehouse-secondary" bindtap="addSerial" disabled="{{saving || pendingCounts || pendingComplete}}">补录编号</button>
            </view>
            <view class="warehouse-field">
              <text class="warehouse-label">无编号实盘数</text>
              <input
                class="warehouse-input warehouse-value"
                type="number"
                value="{{unnumbered}}"
                placeholder="未录入"
                bindinput="unnumberedInput"
                disabled="{{saving || pendingCounts || pendingComplete}}"
              />
            </view>
          </block>
          <block wx:elif="{{canAmount}}">
            <view class="stocktake-physical-fields">
              <input class="warehouse-input" placeholder="长 mm" type="digit" data-field="length_mm" value="{{physical.length_mm}}" bindinput="physicalInput" />
              <input class="warehouse-input" placeholder="宽 mm" type="digit" data-field="width_mm" value="{{physical.width_mm}}" bindinput="physicalInput" />
              <input class="warehouse-input" placeholder="厚 mm" type="digit" data-field="thickness_mm" value="{{physical.thickness_mm}}" bindinput="physicalInput" />
              <input class="warehouse-input" placeholder="库存成本（元）" type="digit" data-field="total_cost" value="{{physical.total_cost}}" bindinput="physicalInput" />
            </view>
            <view class="warehouse-actions">
              <button class="warehouse-secondary" bindtap="addPhysical" disabled="{{saving || pendingCounts || pendingComplete}}">补录实物</button>
            </view>
          </block>
          <view wx:for="{{newEntries}}" wx:key="index" class="phase-inline phase-entry">
            <text class="phase-entry-name">待补录：{{item.serial_no || item.label}}</text>
            <button class="warehouse-secondary" data-index="{{index}}" bindtap="removePending" disabled="{{saving}}">移除</button>
          </view>
        </view>
      </block>
      <view class="warehouse-error">{{entryError}}</view>
      <view class="warehouse-pager">
        <button disabled="{{entryPage <= 1 || entryLoading}}" data-delta="-1" bindtap="entryTurn">上一页</button>
        <text>{{entryPage}} / {{entryLast}}</text>
        <button disabled="{{entryPage >= entryLast || entryLoading}}" data-delta="1" bindtap="entryTurn">下一页</button>
      </view>
    </scroll-view>
    <view class="warehouse-dialog-footer">
      <button class="warehouse-secondary" bindtap="closeEntries" disabled="{{saving}}">取消</button>
      <button wx:if="{{canCount}}" class="warehouse-primary" bindtap="saveEntries" loading="{{saving}}" disabled="{{saving || pendingCounts || pendingComplete}}">保存逐件结果</button>
    </view>
  </view>
</view>

<!-- 确认弹窗 -->
<view wx:if="{{confirmation}}" class="warehouse-overlay stocktake-confirm" catchtouchmove="stop">
  <view class="warehouse-dialog">
    <view class="warehouse-dialog-body">
      <van-icon name="warning-o" size="76rpx" color="#d81e06" />
      <view class="stocktake-confirm-title">{{confirmation.title}}</view>
      <view class="warehouse-muted">{{confirmation.message}}</view>
    </view>
    <view class="warehouse-dialog-footer">
      <button wx:if="{{confirmation.mode !== 'incomplete' && confirmation.mode !== 'conflict'}}" class="warehouse-secondary" bindtap="closeConfirmation" disabled="{{saving}}">取消</button>
      <button class="warehouse-primary" bindtap="confirmDialog" loading="{{saving}}" disabled="{{saving}}">{{confirmation.mode === 'incomplete' ? '继续录入' : confirmation.mode === 'conflict' ? '重新核对' : '确认'}}</button>
    </view>
  </view>
</view>
