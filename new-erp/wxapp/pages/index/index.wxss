page,
.container {
  width: 100%;
  min-height: 100vh;
  background-color: #f4f4f4;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
}

.banner-wrap {
  padding: 16rpx 16rpx 0;
}

.banner {
  width: 100%;
  height: 392rpx;
  border-radius: 30rpx;
  overflow: hidden;
  transform: translateY(0);
  box-shadow: 0 8rpx 24rpx rgba(216, 30, 6, 0.14);
}

.banner image {
  width: 100%;
  height: 392rpx;
}

.notice-wrap {
  margin-top: 12rpx;
}

.home-grid {
  margin-top: 16rpx;
  background: #ffffff;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1rpx solid #f0f1f4;
}

.home-grid-item {
  height: 224rpx;
  border-right: 1rpx solid #f2f3f5;
  border-bottom: 1rpx solid #f2f3f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  position: relative;
  background: #ffffff;
  padding: 12rpx 8rpx;
}

.home-grid-item:nth-child(3n) {
  border-right: none;
}

.home-grid-item-hover {
  background: #fafafa;
}

.home-grid-item.highlight {
  background: linear-gradient(180deg, #fff8f7 0%, #ffffff 100%);
}

.grid-badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  background: #d81e06;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 3rpx 12rpx;
  border-radius: 16rpx 16rpx 16rpx 4rpx;
  box-shadow: 0 4rpx 10rpx rgba(216, 30, 6, 0.22);
}

.grid-icon-box {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff2f0;
}

.home-grid-item.highlight .grid-icon-box {
  background: linear-gradient(135deg, #ef1008 0%, #d81e06 100%);
  box-shadow: 0 8rpx 20rpx rgba(216, 30, 6, 0.26);
}

.grid-title {
  font-size: 27rpx;
  color: #1f2738;
  font-weight: 500;
}

.home-grid-item.highlight .grid-title {
  color: #d81e06;
  font-weight: 700;
}

.grid-sub {
  font-size: 21rpx;
  color: #8c95a6;
  margin-top: -10rpx;
  white-space: nowrap;
}
