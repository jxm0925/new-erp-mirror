<!--pages/work/products/index.wxml-->
<view class="container">
    <view class="top-area">
        <van-cell-group inset>
            <van-cell>
                <van-row>
                    <van-col span="5" class="col-class">工单号</van-col>
                    <van-col span="8" class="col-class">
                        {{(info.type=='testing' || info.type=='assemble')?info.order_no:info.works_no}}
                    </van-col>
                    <van-col span="10" class="col-class">
                            <van-tag type="danger" wx:if="{{info.quickly}}">加急</van-tag>
                            <van-tag style="margin-left:10rpx;" type="success" wx:if="{{info.customized}}">定制</van-tag>
                            <van-tag style="margin-left:10rpx;" type="warning" wx:if="{{info.delay}}">延时</van-tag>
                    </van-col>
                </van-row>
            </van-cell>
            <van-cell>
                <van-row>
                    <van-col span="5" class="col-class">客户名</van-col>
                    <van-col span="19" class="col-class">{{info.o_accerpt}}({{info.o_mobile}})</van-col>
                </van-row>
            </van-cell>
            <van-cell>
                <van-row>
                    <van-col span="5" class="col-class">备注</van-col>
                    <van-col span="17" class="col-class">
                        <view class="{{noteExpanded ? 'note-full' : 'note-limit'}}">{{info.order_note}}</view>
                    </van-col>
                    <van-col span="2" class="col-class" bind:tap="toggleNote">
                        <text class="note-toggle">{{noteExpanded ? '收起' : '更多'}}</text>
                    </van-col>
                </van-row>
            </van-cell>
        </van-cell-group>
        <van-tabs active="{{activeTab}}" bind:change="onTabChange">
            <van-tab wx:for="{{process}}" name="{{item.code}}" wx:key="key" title="{{item.name}}">
            </van-tab>
        </van-tabs>
    </view>

    <scroll-view
        scroll-y 
        style="height: {{scrollHeight}}px;" 
        scroll-top="{{scrollTop}}" 
        bindscrolltolower="loadMore"
    >
        <van-empty wx:if="{{!list.length}}" description="暂无工单" />
        <van-cell-group inset custom-class="order-card" wx:for="{{list}}" wx:key="id">
            <van-cell bind:tap="goDetail" data-id="{{item.id}}" title-class="card-title" value-class="{{item.step_status=='wait'?'card-value-processing':'card-value-wait'}}" value="{{item.step_status=='wait'?'待接单':'进行中'}}">
                <view slot="title">
                    <view class="van-cell-text">{{item.device_sn}}</view>
                </view>
            </van-cell>
            
            <van-cell border="{{ false }}">
                <view data-id="{{item.id}}" bind:tap="goDetail">
                    <!-- <van-row>
                        <van-col span="24" style="text-align: left;"><van-icon name="orders-o" size="30rpx"/>单号：{{item.order_no}}({{item.platform.name}})</van-col>
                    </van-row>
                    <van-row>
                        <van-col span="24" style="text-align: left;"><van-icon name="service-o" size="30rpx"/>销售：{{item.salesman}}</van-col>
                    </van-row>
                    <van-row>
                        <van-col span="24" style="text-align: left;"><van-icon name="contact-o" size="30rpx"/>客户：{{item.o_accerpt}}</van-col>
                    </van-row>
                    <van-row>
                        <van-col span="24" style="text-align: left;"><van-icon name="guide-o" size="30rpx"/>地址：{{item.address}}</van-col>
                    </van-row>
                    <van-divider dashed /> -->
                    <van-row>
                        <van-col span="24" style="text-align: left;"><van-icon name="cart-o" size="30rpx"/>产品：{{item.name}}</van-col>
                    </van-row>
                    <van-divider dashed />
                    <van-row>
                        <van-col span="24" style="text-align: left;"><van-icon name="description-o" size="30rpx"/>备注：{{item.remark?item.remark:'无备注'}}</van-col>
                    </van-row>
                    <!-- <van-row>
                        <van-col span="24" style="text-align: left;"><van-icon name="clock-o" size="30rpx"/>下单时间：{{item.create_date}}</van-col>
                    </van-row> -->
                </view>
                
                <van-row custom-class="van-card-button" >
                    <van-col span="24" style="text-align: right;">
                        <van-button wx:if="{{item.step_status=='primary'}}" round type="primary" bind:click="cancel" data-id="{{item.id}}" size="small" color="linear-gradient(to right, #d81e06, #d81e06)">
                        取消
                        </van-button>
                        <van-button wx:if="{{item.step_status=='wait'}}" style="margin-left: 10rpx;" round type="primary" bind:click="accept" data-id="{{item.id}}" size="small" color="linear-gradient(to right, #d81e06, #d81e06)">
                        接单
                        </van-button>
                    </van-col>
                </van-row>
            </van-cell>
        </van-cell-group>
    </scroll-view>
</view>
<van-submit-bar
  button-text="提交订单"
  bind:submit="onSubmit"
/>
<van-dialog id="van-dialog" />
<van-notify id="van-notify" />