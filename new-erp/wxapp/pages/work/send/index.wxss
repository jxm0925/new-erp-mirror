/* pages/orders/detail/index.wxss */
page,.order-details{
    background-color: #f4f4f4;
    width: 100%;
    height: 95%;
}
.order-header{
    background-color: #d81e06 !important;
    display: flex;  
    align-items: center;  
    justify-content: center; 
    flex-wrap: wrap;
    padding:0 30rpx;
    height:150rpx;
}
.order-details-data{
    color: rgba(255,255,255,0.8);
    font-size: 24rpx;
    margin-left: 27rpx;
}
.order-details-state {
    font-size: 30rpx;
    font-weight: bold;
    color: #fff;
    margin-bottom: 7rpx;
}
.detail-title{
    flex:auto !important;
    width: 80%;
}
.detail-sub-title{
    font-size: 25rpx !important;
    color: #a7a4a4 !important;
}
.detail-label{
    color: #fc3535 !important;
}
.detail-label-note{
    color: #1ca301 !important;
}
.detail-value{
    width: 10%;
    color: #b8b8b8 !important;
}
.remark-label{
    color: #fc3535 !important;
    font-weight: bolder;
    font-size: 35rpx !important;
}
.line{width:100%;height:3rpx;}
.line image{width:100%;height:100%;display:block;}
.order-details .address{font-size:26rpx;color:#868686;background-color:#fff;margin-top:13rpx;padding:35rpx 30rpx;}
.order-details .address .name{font-size:30rpx;color:#282828;margin-bottom:15rpx;}
.order-details .address .name .phone{margin-left:40rpx;}
.check-custom{
    margin-top: 10rpx;
    padding-bottom: 10rpx;
    border-bottom: 1rpx solid #f4f4f4;
    text-align: left;
}
.check-custom1{
    margin-top: 10rpx;
    text-align: left;
}

