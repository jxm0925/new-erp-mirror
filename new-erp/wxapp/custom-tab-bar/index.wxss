.tabbar { position: fixed; z-index: 100; left: 0; right: 0; bottom: 0; height: calc(102rpx + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); box-sizing: border-box; background: rgba(255,255,255,.97); display: grid; grid-template-columns: repeat(4,1fr); border-top: 1rpx solid #ebecef; box-shadow: 0 -8rpx 24rpx rgba(30,40,60,.05); }
.tab-item { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3rpx; color: #858991; font-size: 21rpx; }
.tab-item.active { color: #d81e06; }
