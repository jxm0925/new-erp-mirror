/* custom-tab-bar/index.wxss */

.tabbar {
  position: fixed;
  z-index: 999;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border-top: 1rpx solid #ebecef;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.tab-item {
  position: relative;
  flex: 1 1 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  cursor: pointer;
  box-sizing: border-box;
  padding: 8rpx 0;
}

.tab-item-hover {
  opacity: 0.7;
}

/* 确保子元素不拦截事件，点击必然被 tab-item 捕获 */
.tab-item van-icon,
.tab-item text {
  pointer-events: none;
}

.tab-icon {
  display: block !important;
  line-height: 1 !important;
}

.tab-text {
  font-size: 22rpx;
  line-height: 1.2;
  color: #858991;
  font-weight: 400;
  transition: color 0.15s ease;
}

.tab-item.active .tab-text {
  color: #d81e06;
  font-weight: 600;
}
